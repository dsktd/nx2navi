From edd103e536c3056c9b74b327ae0348c373daff2d Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:55:04 -0500
Subject: [PATCH] vk_memory: compare the write-back pages outside shadow_lock

The fence write-back compared every bound writable range with the shadow
while holding shadow_lock. The render thread takes that lock for each
writable binding, each first resolve of a pool and each submit, so it
waited on the completion thread's compare (about 2.6 ms per frame in
Kokiri). Find the changed runs first, then copy them under the lock.

Haze replay: 51.9 -> 59.3 fps mean, p99 22.7 -> 19.9 ms.
---
 runtime/vk_memory.c | 46 ++++++++++++++++++++++++++++++++++++---------
 1 file changed, 37 insertions(+), 9 deletions(-)

diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 847cdfc..6d6efc1 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -1095,19 +1095,46 @@ static void shadow_put(PoolRec *r, uint64_t a, uint64_t b) {
 // leaves guest memory byte for byte what the plain copy left (copying equal bytes changes nothing), so the guarantees
 // of the copy-back stay as they were, including a page the CPU and the GPU both wrote keeping the GPU's bytes; only
 // the page is not reported written, and no consumer of the stamps needs to see bytes that did not change.
-static void shadow_write_back(PoolRec *r, uint64_t a, uint64_t b) {
-    if (w_hi && a < w_hi && b > w_lo) vk_watch("wb-fence", a, b - a, 0, r->smap + (w_lo - r->import_lo));
+typedef struct { uint64_t lo, hi; } WbRun;
+static _Thread_local WbRun *wb_runs;
+static _Thread_local int nwb_runs, cwb_runs;
+
+// pool_lock held (shared), shadow_lock not held: lists the runs of [a, b) whose 4 KiB pages differ from the shadow.
+// The compare reads tens of MiB per frame; under shadow_lock it stalled the replay thread, which takes that lock for
+// every writable binding (vk_mem_gpu_pending), each first resolve of a pool and each submit.
+static void shadow_diff(PoolRec *r, uint64_t a, uint64_t b) {
+    nwb_runs = 0;
     uint64_t run = 0;
     for (uint64_t x = a; x < b;) {
         uint64_t y = (x | 0xfffull) + 1;
         if (y > b) y = b;
-        const uint8_t *src = r->smap + (x - r->import_lo);
-        int same = !memcmp((const void *)(uintptr_t)x, src, y - x);
+        int same = !memcmp((const void *)(uintptr_t)x, r->smap + (x - r->import_lo), y - x);
         if (!same && !run) run = x;
-        if (same && run) shadow_put(r, run, x), run = 0;
+        if ((same || y == b) && run) {
+            if (nwb_runs == cwb_runs) grow((void **)&wb_runs, &cwb_runs, sizeof *wb_runs);
+            wb_runs[nwb_runs++] = (WbRun){run, same ? x : b};
+            run = 0;
+        }
         x = y;
     }
-    if (run) shadow_put(r, run, b);
+}
+
+// shadow_lock held: copies the shadow's [a, b) into guest memory, page by page (4 KiB, by address), leaving out the
+// pages whose guest bytes already equal the shadow's (shadow_diff, run before the lock), and stamps only the pages it
+// wrote (vk_guest_written).
+// A written range is what the replay bound as writable, not what the shaders wrote: a storage buffer reached through a
+// pointer binds to the end of its backing, and the outdoor areas bind 4-15 MiB storage ranges of which the compute
+// passes change a few KiB (about 76 MiB of written ranges per frame, 2026-11-08). Copied and stamped whole, every
+// page came back dirty: the next vk_mem_shadow_sync copied the same bytes into the shadow again, the mirror re-uploaded
+// them, and the textures over them were checked again; 40 GB each way per 1200 frames, ~23 fps. Skipping an equal page
+// leaves guest memory byte for byte what the plain copy left (copying equal bytes changes nothing), so the guarantees
+// of the copy-back stay as they were, including a page the CPU and the GPU both wrote keeping the GPU's bytes; only
+// the page is not reported written, and no consumer of the stamps needs to see bytes that did not change. A page that
+// changes between the compare and the lock is a race the plain copy had too (the guest threads never take the lock);
+// a sync that copied the CPU's bytes into the shadow meanwhile makes the copy a no-op.
+static void shadow_write_back(PoolRec *r, uint64_t a, uint64_t b) {
+    if (w_hi && a < w_hi && b > w_lo) vk_watch("wb-fence", a, b - a, 0, r->smap + (w_lo - r->import_lo));
+    for (int i = 0; i < nwb_runs; i++) shadow_put(r, wb_runs[i].lo, wb_runs[i].hi);
 }
 
 void vk_gpu_written(uint64_t addr, uint64_t size) {
@@ -1115,16 +1142,17 @@ void vk_gpu_written(uint64_t addr, uint64_t size) {
         plat_mutex_lock_shared(&pool_lock);
         const pidx_ent *e = pidx_find(&pool_index, addr, size);
         PoolRec *r = e ? e->buf : NULL;
+        int wb = r && r->smap && addr >= r->import_lo && addr + size <= r->import_hi;
+        if (wb) shadow_diff(r, addr, addr + size);
         plat_mutex_lock(&shadow_lock);
-        int done = 0;
-        if (r && r->smap && addr >= r->import_lo && addr + size <= r->import_hi) shadow_write_back(r, addr, addr + size), done = 1;
+        if (wb) shadow_write_back(r, addr, addr + size);
         int k = -1;   // the submitted entry, not a newer part's equal one
         for (int i = 0; i < nspend && (k < 0 || !spend[k].sub); i++)
             if (spend[i].lo == addr && spend[i].hi == addr + size) k = i;
         if (k >= 0) spend[k] = spend[--nspend];
         plat_mutex_unlock(&shadow_lock);
         plat_mutex_unlock_shared(&pool_lock);
-        if (done) return;
+        if (wb) return;
     }
     vk_guest_written(addr, size);
 }
-- 
2.56.0

