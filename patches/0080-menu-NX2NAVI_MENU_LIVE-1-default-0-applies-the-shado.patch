 runtime/cfg.h              |  3 +++
 runtime/host.h             |  1 +
 runtime/resolution.c       | 13 +++++++++++--
 runtime/ui/menu.cpp        | 22 +++++++++++++++++++---
 runtime/ui/option_rows.cpp | 26 +++++++++++++++++++-------
 runtime/ui/option_rows.h   |  6 +++++-
 runtime/ui_text.c          |  1 +
 runtime/ui_text.h          |  1 +
 9 files changed, 77 insertions(+), 15 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
