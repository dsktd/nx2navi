 }
 
 static void row_gpu(void) {
@@ -1142,13 +1145,26 @@ static void layout_menu(uint32_t w, uint32_t h, float scale) {
         menu_art_draw(ImGui::GetWindowDrawList(), MENU_ART_GUIDE_BAR, ImVec2(win_p.x + st.WindowPadding.x, sy),
                       ImVec2(win_p.x + win_s.x - st.WindowPadding.x, sy + fh), IM_COL32(96, 70, 36, 170));
     }
+    // NX2NAVI_MENU_LIVE=1: changes hold in the running game at once; a Save button left of Continue writes nx2navi.ini
+    bool save_btn = cfg_bool("NX2NAVI_MENU_LIVE") != 0;
     if (!cfg_last_save_ok()) {   // stays until a save succeeds; the settings hold for the session
         ImGui::SetCursorPosY(y + st.FramePadding.y);
         ImGui::TextColored(ImVec4(0.95f, 0.45f, 0.35f, 1), "%s", menu_text(UI_MENU_SAVE_FAILED));
+    } else if (save_btn && opt_unsaved()) {
+        ImGui::SetCursorPosY(y + st.FramePadding.y);
+        ImGui::TextColored(ImVec4(0.93f, 0.76f, 0.33f, 1), "%s", menu_text(UI_MENU_UNSAVED));
     }
-    const char *cont = menu_text(UI_MENU_CONTINUE), *quit = menu_text(UI_MENU_QUIT);
+    const char *cont = menu_text(UI_MENU_CONTINUE), *quit = menu_text(UI_MENU_QUIT), *save = menu_text(UI_MENU_SAVE);
     float bw = fmaxf(ImGui::CalcTextSize(cont).x, ImGui::CalcTextSize(quit).x) + st.FramePadding.x * 4;
-    ImGui::SetCursorPos(ImVec2(ImGui::GetWindowWidth() - st.WindowPadding.x - bw * 2 - st.ItemSpacing.x, y));
+    if (save_btn) bw = fmaxf(bw, ImGui::CalcTextSize(save).x + st.FramePadding.x * 4);
+    int nb = save_btn ? 3 : 2;
+    ImGui::SetCursorPos(ImVec2(ImGui::GetWindowWidth() - st.WindowPadding.x - bw * nb - st.ItemSpacing.x * (nb - 1), y));
+    if (save_btn) {
+        ImGui::BeginDisabled(!opt_unsaved());
+        if (ImGui::Button(save, ImVec2(bw, 0)) && opt_save_now()) menu_sound_play(MENU_SOUND_CURSOR);
+        ImGui::EndDisabled();
+        ImGui::SameLine();
+    }
     if (ImGui::Button(cont, ImVec2(bw, 0))) set_open(0);
     ImGui::SameLine();
     if (ImGui::Button(quit, ImVec2(bw, 0))) gfx_window_request_close();
