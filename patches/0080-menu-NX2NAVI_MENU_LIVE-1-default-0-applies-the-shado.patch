@@ -158,6 +158,7 @@ static const CfgMeta metas[] = {
     {"MOUSE_SENS", "1", "0..10", LIVE}, {"MENU_CURSOR", "1", "0|1", LIVE},
     {"WALK_KEY", "none", NULL, LIVE}, {"WALK_SCALE", "0.51", "0.2..0.9", LIVE},
     {"MENU_LANG", "", "en|ru|pt-BR|zh-Hans", LIVE},
+    {"MENU_LIVE", "0", "0|1", LIVE},   // cfg_live: rows that take effect at once, and the menu's Save button
     {"AMIIBO_DIR", "", NULL, LIVE},
     // Discord Rich Presence (discord_rpc.c): off by default, the Menu tab of the settings menu switches it. The
     // application's id and art key default to discord_app.h's NX2NAVI_DISCORD_*_DEFAULT.
@@ -437,6 +438,19 @@ const char *cfg_default(const char *key) {
     return m ? m->def : NULL;
 }
 
+// NX2NAVI_MENU_LIVE=1: these read-at-start rows are applied in the running game too (ui/menu.cpp says how).
+static const char *const LIVE_WITH_MENU_LIVE[] = {"SHADOW_RANGE"};
+
+int cfg_live(const char *key) {
+    const CfgMeta *m = cfg_meta(key);
+    if (!m) return 1;
+    if (m->live) return 1;
+    if (!cfg_bool("NX2NAVI_MENU_LIVE")) return 0;
+    for (size_t i = 0; i < sizeof LIVE_WITH_MENU_LIVE / sizeof *LIVE_WITH_MENU_LIVE; i++)
+        if (!strcmp(LIVE_WITH_MENU_LIVE[i], m->key)) return 1;
+    return 0;
+}
+
 const CfgMeta *cfg_meta_at(int i) { return i >= 0 && (size_t)i < sizeof metas / sizeof *metas ? &metas[i] : NULL; }
 
 const char *cfg_value(const char *name) {
