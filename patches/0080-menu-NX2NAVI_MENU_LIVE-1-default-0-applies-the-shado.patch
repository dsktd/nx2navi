diff --git a/runtime/resolution.c b/runtime/resolution.c
index 34748b8..9bc212b 100644
--- a/runtime/resolution.c
+++ b/runtime/resolution.c
@@ -308,10 +308,17 @@ static uint64_t pack(unsigned w, unsigned h) { return (uint64_t)h << 32 | w; }
 // NX2NAVI_SHADOW_RANGE (percent, 50 to 400; 100 = the game's): the sun's shadow cascades end at 20, 40, 80 and 160 m.
 // Other values multiply those distances through the cascade patch set (recomp/patches-v143.txt), so the sharp first
 // cascade reaches further and the visible steps between cascades move away from the player, at the cost of shadow
-// texels per metre (NX2NAVI_SHADOW_SCALE pays that back).
+// texels per metre (NX2NAVI_SHADOW_SCALE pays that back). The patched code loads the distances from the page each time
+// it runs, so res_shadow_range_live (the menu, with NX2NAVI_MENU_LIVE=1) takes a new value in the running game.
 static void res_shadow_range(void) {
     int pct = cfg_int("NX2NAVI_SHADOW_RANGE"), set = rt_patch_set("cascade");
-    if (pct == 100) return;
+    if (pct == 100) {
+        if (set >= 0 && rt_patch_enabled(set)) {
+            rt_patch_switch(set, 0);
+            rt_log("resolution: shadow cascades at the game's 20, 40, 80 and 160 m");
+        }
+        return;
+    }
     if (set < 0) {
         rt_log("resolution: the generated C has no cascade patch set; shadow_range stays 100");
         return;
@@ -322,6 +329,8 @@ static void res_shadow_range(void) {
     rt_log("resolution: shadow cascades end at %g, %g, %g and %g m", d[0], d[1], d[2], d[3]);
 }
 
+void res_shadow_range_live(void) { res_shadow_range(); }
+
 void res_init(void) {
     res_shadow_range();
     if (!res_adjustable()) {
