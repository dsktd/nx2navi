     return row_text(id, label, desc, v, movable);
 }
 
-// ---- writing a setting: at once in memory (live settings follow), to nx2navi.ini a moment later (opt_save_tick)
-static uint64_t g_save_at;   // plat_now_ns deadline of the pending write; 0 none
+// ---- writing a setting: at once in memory (live settings follow), to nx2navi.ini a moment later (opt_save_tick); with
+// NX2NAVI_MENU_LIVE=1 only when the menu's Save button is pressed (opt_save_now)
+static uint64_t g_save_at;   // plat_now_ns deadline of the pending write (MENU_LIVE: a change not yet saved); 0 none
 static bool g_save_logged;
 
 static void apply(const char *key, const char *value) {
@@ -261,16 +262,27 @@ static void apply(const char *key, const char *value) {
 
 void opt_save_soon(void) { g_save_at = plat_now_ns() + 400000000ull; }
 
-int opt_save_tick(int force) {
-    if (!g_save_at || (!force && plat_now_ns() < g_save_at)) return g_save_at != 0;
+static int save_now(void) {
     g_save_at = 0;
-    if (!cfg_save() && !g_save_logged) {
+    int ok = cfg_save();
+    if (!ok && !g_save_logged) {
         g_save_logged = true;
         rt_log("menu: could not write nx2navi.ini; the changed settings hold for this session");
     }
+    return ok;
+}
+
+int opt_save_tick(int force) {
+    if (cfg_bool("NX2NAVI_MENU_LIVE")) return g_save_at != 0;   // the Save button writes
+    if (!g_save_at || (!force && plat_now_ns() < g_save_at)) return g_save_at != 0;
+    save_now();
     return 0;
 }
 
+int opt_unsaved(void) { return g_save_at != 0; }
+
+int opt_save_now(void) { return save_now(); }
+
 // ---- rows
 
 bool opt_toggle(const char *key, UiTextId label, UiTextId desc, bool inverted) {
