--- a/runtime/cfg.h
+++ b/runtime/cfg.h
@@ -48,6 +48,9 @@ void cfg_each_active(void (*cb)(const char *key, const char *value, int from_env
 typedef struct { const char *key, *def, *values; int live; } CfgMeta;
 // The row of key (prefix and case ignored); NULL for a key the menu does not show.
 const CfgMeta *cfg_meta(const char *key);
+// The setting takes effect in the running game: its row is live, or NX2NAVI_MENU_LIVE=1 applies it there (cfg.c
+// LIVE_WITH_MENU_LIVE). 1 for a key without a row.
+int cfg_live(const char *key);
 // The i-th row (0-based, table order); NULL past the last.
