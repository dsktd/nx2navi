From 7499e223f1adecef465da20810eda0e6d63335ca Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:58:40 -0500
Subject: [PATCH] platform: plat_fault_guard, so a driver fault inside
 vkCreate*Pipelines fails that one pipeline instead of ending the game (#141)

RADV (Mesa 26.2.6 radv_shader_spirv_to_nir) writes through the NULL that spirv_to_nir returns for a module it
rejects (libvulkan_radeon.so+0x19be92, writing 0x40): the 2026-11-09 22:31 play session ended there. vk_pipeline's
create_pipeline (its call sites went into the previous commit by accident, together with a test line this commit
removes) arms the guard: on Linux the fault handler jumps back for a fault of the guarded thread outside this
executable, the pipeline is not built, its draws are skipped, and the log names its shaders. Proven with every 7th
module truncated to its header: same fault offset, 4 caught, the replay to frame 1500 completes.
---
 runtime/platform/linux.c    | 14 ++++++++++++++
 runtime/platform/platform.h | 16 ++++++++++++++++
 runtime/vk_pipeline.c       | 22 +++++++++++++++++++---
 3 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/runtime/platform/linux.c b/runtime/platform/linux.c
index de4b4ae6..3c387f1b 100644
--- a/runtime/platform/linux.c
+++ b/runtime/platform/linux.c
@@ -1242,6 +1242,8 @@ static int (*fault_hook)(uint64_t addr);
 static int (*access_hook)(uint64_t addr, int write, uint64_t ip);   // every read or write fault, before fault_hook
 static void (*crash_fn)(const PlatCrash *c);
 static __thread const char *crash_ctx;   // plat_crash_context: what this thread is doing, for the crash report
+static __thread PlatFaultJmp *fault_guard;   // plat_fault_guard: where a fault in another module jumps back to
+void plat_fault_guard_set(PlatFaultJmp *j) { fault_guard = j; }
 
 static void fault_handler(int sig, siginfo_t *si, void *uc) {
     ucontext_t *u = uc;
@@ -1252,6 +1254,18 @@ static void fault_handler(int sig, siginfo_t *si, void *uc) {
     if (sig == SIGSEGV && fault_hook && (err & 2) && fault_hook((uint64_t)(uintptr_t)si->si_addr)) return;
     uintptr_t rip = (uintptr_t)u->uc_mcontext.gregs[REG_RIP];
     Dl_info at, self;
+    if (fault_guard && (sig == SIGSEGV || sig == SIGBUS) && dladdr((void *)rip, &at) && at.dli_fname &&
+        dladdr((void *)plat_crash_hook, &self) && at.dli_fbase != self.dli_fbase) {
+        PlatFaultJmp *j = fault_guard;
+        fault_guard = NULL;
+        const char *m = strrchr(at.dli_fname, '/');
+        char b[320];
+        int n = snprintf(b, sizeof b, "[host] fault caught at %s+%#llx, address %#llx: the thread was %s\n",
+                         m ? m + 1 : at.dli_fname, (unsigned long long)(rip - (uintptr_t)at.dli_fbase),
+                         (unsigned long long)(uintptr_t)si->si_addr, crash_ctx ? crash_ctx : "in a guarded call");
+        if (n > 0 && write(2, b, (size_t)(n < (int)sizeof b ? n : (int)sizeof b - 1)) < 0) {}
+        siglongjmp(j->b, 1);   // restores the signal mask; leaves the signal stack
+    }
     if (crash_fn) {
         int found = dladdr((void *)rip, &at) && at.dli_fname;
         PlatCrash c = {sig == SIGSEGV ? "access violation" : sig == SIGBUS ? "bus error"
diff --git a/runtime/platform/platform.h b/runtime/platform/platform.h
index 12612420..298dde66 100644
--- a/runtime/platform/platform.h
+++ b/runtime/platform/platform.h
@@ -297,6 +297,22 @@ void plat_crash_context(const char *s);
 // place (who: that filter's module and offset), 0 when it was still there. Windows only; 0 elsewhere.
 int plat_crash_filter_reassert(char *who, size_t n);
 const char *plat_crash_context_get(void);   // the calling thread's note, for the crash report (NULL: none)
+// A fault guard around a call into another module (the GPU driver): plat_fault_guard(j) returns 0 and arms the guard;
+// a fault of this thread at an instruction outside this executable then comes back to it a second time with 1 (the
+// guard is disarmed, the fault is noted on stderr with the crash context) instead of ending the process. What the
+// faulting call held is leaked. plat_fault_unguard() disarms it after the call; the function that armed it must still
+// be running. Linux only: on Windows the guard never fires.
+#ifdef _WIN32
+typedef int PlatFaultJmp;
+#define plat_fault_guard(j) ((void)(j), 0)
+#define plat_fault_unguard() ((void)0)
+#else
+#include <setjmp.h>
+typedef struct { sigjmp_buf b; } PlatFaultJmp;
+void plat_fault_guard_set(PlatFaultJmp *j);
+#define plat_fault_guard(j) (plat_fault_guard_set(&(j)), sigsetjmp((j).b, 1))
+#define plat_fault_unguard() plat_fault_guard_set(NULL)
+#endif
 int plat_mem_read(uint64_t addr, void *out, size_t n);    // copies n bytes, 0 instead of faulting on unmapped memory
 int plat_mem_readable(uint64_t addr, uint64_t n);         // every page of [addr, addr + n) can be read; no fault
 void *plat_aligned_alloc(size_t size, size_t align);      // free with plat_aligned_free; NULL on failure
diff --git a/runtime/vk_pipeline.c b/runtime/vk_pipeline.c
index c5431962..5d49b2c7 100644
--- a/runtime/vk_pipeline.c
+++ b/runtime/vk_pipeline.c
@@ -583,9 +583,24 @@ static volatile uint32_t cache_merges;
 // everything goes into P.cache as before.
 static int prep_mode;   // a preparation mode (set before ensure_init): no play cache
 
+static __thread const char *pipe_note;   // crash_note's text of the pipeline this thread builds
+
+// A driver fault inside the create (RADV writes through the NULL spirv_to_nir returns for a module it rejects,
+// libvulkan_radeon.so+0x19be92) fails this one pipeline instead of ending the game (platform.h plat_fault_guard, Linux):
+// what the driver held is leaked, the pipeline's draws are skipped, and the log names its shaders.
 static VkResult pipe_create_one(int kind, void *ci, VkPipeline *pipe, VkPipelineCache cache) {
-    return kind == 2 ? vkCreateComputePipelines(P.device, cache, 1, ci, NULL, pipe)
-                     : vkCreateGraphicsPipelines(P.device, cache, 1, ci, NULL, pipe);
+    PlatFaultJmp j;
+    if (plat_fault_guard(j)) {
+        static volatile int32_t n_faults;
+        *pipe = VK_NULL_HANDLE;
+        rt_log("vk_pipeline: the driver faulted %s: not built (%d so far)", pipe_note ? pipe_note : "building a pipeline",
+               plat_inc32(&n_faults));
+        return VK_ERROR_UNKNOWN;
+    }
+    VkResult r = kind == 2 ? vkCreateComputePipelines(P.device, cache, 1, ci, NULL, pipe)
+                           : vkCreateGraphicsPipelines(P.device, cache, 1, ci, NULL, pipe);
+    plat_fault_unguard();
+    return r;
 }
 
 static VkResult pipe_create_in(int kind, void *ci, VkPipeline *pipe, VkPipelineCache cache) {
@@ -2682,6 +2697,7 @@ static void crash_note(const char *what, const GfxShader *a, const GfxShader *b,
                           k[4], k[5], k[6], k[7]);
         }
     plat_crash_context(buf);
+    pipe_note = buf;
 }
 
 // One past the highest binding a shader uses (1 with no resources: binding 0 is the support buffer).
@@ -4093,7 +4109,7 @@ static VkPipeline gpl_link(const VkPipeState *s, const GKey *k, const Layout *lc
                  "vertex outputs added %#x)", s->fs ? "yes" : "none", k->n_color, k->depth, k->stencil, k->samples,
                  pk.missing);
         crash_note(what, s->vs, s->fs, NULL);
-        if (vkCreateGraphicsPipelines(P.device, VK_NULL_HANDLE, 1, &pi, NULL, &pipe) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
+        if (pipe_create_one(1, &pi, &pipe, VK_NULL_HANDLE) != VK_SUCCESS) pipe = VK_NULL_HANDLE;
         plat_crash_context(NULL);
         double ms = ms_since(t1);   // the link alone: library builds are counted apart
         if (build) plat_mutex_lock(&P.lock);
