From 3a6242f90593ca834775fc54d1da0a80c613c1e1 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:21:26 -0500
Subject: [PATCH] vk_pipeline: map the RGBX, sRGB and BGRX vertex formats; log
 an attribute without a mapping

An NVN vertex attribute whose format had no entry in the table read the zero
binding (0, 0, 0, 1) with no log line, which collapses any shape that carries
such an attribute. The RGBX8/16/32 family (four components stored, the fourth
unused), the 8-bit sRGB formats and BGRX8 now read as their 4-component UNORM,
SNORM, UINT, SINT or SFLOAT format. Candidate for the close-LOD leaf cards of
bushes (#138), not yet A/B tested: the lab replays lose the device before the
frame.
---
 runtime/vk_pipeline.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/runtime/vk_pipeline.c b/runtime/vk_pipeline.c
index 8fde28b..c543196 100644
--- a/runtime/vk_pipeline.c
+++ b/runtime/vk_pipeline.c
@@ -1195,7 +1195,7 @@ typedef struct { VkFormat vk; uint8_t type; } VtxFmt;
 #define F(v) {VK_FORMAT_##v, GFX_TYPE_FLOAT}
 #define U(v) {VK_FORMAT_##v, GFX_TYPE_UINT}
 #define I(v) {VK_FORMAT_##v, GFX_TYPE_SINT}
-static const VtxFmt vtx_formats[0x9B] = {
+static const VtxFmt vtx_formats[0x9D] = {
     [0x01] = F(R8_UNORM), [0x02] = F(R8_SNORM), [0x03] = U(R8_UINT), [0x04] = I(R8_SINT), [0x05] = F(R16_SFLOAT),
     [0x06] = F(R16_UNORM), [0x07] = F(R16_SNORM), [0x08] = U(R16_UINT), [0x09] = I(R16_SINT), [0x0A] = F(R32_SFLOAT),
     [0x0B] = U(R32_UINT), [0x0C] = I(R32_SINT), [0x0D] = F(R8G8_UNORM), [0x0E] = F(R8G8_SNORM), [0x0F] = U(R8G8_UINT),
@@ -1220,6 +1220,14 @@ static const VtxFmt vtx_formats[0x9B] = {
     [0x61] = U(R32G32B32_UINT), [0x62] = I(R32G32B32_SINT), [0x67] = U(R32G32B32A32_UINT), [0x68] = I(R32G32B32A32_SINT),
     [0x69] = F(A2B10G10R10_SNORM_PACK32), [0x6A] = I(A2B10G10R10_SINT_PACK32), [0x6B] = F(A2B10G10R10_USCALED_PACK32),
     [0x6C] = F(A2B10G10R10_SSCALED_PACK32), [0x9A] = F(B8G8R8A8_UNORM),
+    // RGBX: four components stored, the fourth ignored by the game (read as the 4-component format; sRGB has no vertex
+    // format: read as UNORM). An unmapped format read (0, 0, 0, 1) silently, which collapsed every shape with such an
+    // attribute: the close-LOD leaf cards of bushes and trees.
+    [0x37] = F(R8G8B8A8_UNORM), [0x38] = F(R8G8B8A8_UNORM), [0x6D] = F(R8G8B8A8_UNORM), [0x6E] = F(R8G8B8A8_SNORM),
+    [0x6F] = U(R8G8B8A8_UINT), [0x70] = I(R8G8B8A8_SINT), [0x71] = F(R16G16B16A16_SFLOAT), [0x72] = F(R16G16B16A16_UNORM),
+    [0x73] = F(R16G16B16A16_SNORM), [0x74] = U(R16G16B16A16_UINT), [0x75] = I(R16G16B16A16_SINT),
+    [0x76] = F(R32G32B32A32_SFLOAT), [0x77] = U(R32G32B32A32_UINT), [0x78] = I(R32G32B32A32_SINT),
+    [0x99] = F(B8G8R8A8_UNORM), [0x9B] = F(B8G8R8A8_UNORM), [0x9C] = F(B8G8R8A8_UNORM),
 };
 #undef F
 #undef U
@@ -1339,6 +1347,8 @@ static void vertex_input(const VkPipeState *s, VtxInput *v) {
             a->binding = va.stream, a->format = f, a->offset = va.offset;
             streams |= 1u << va.stream;
         } else {
+            if (va.fmt) LOG_ONCE("vk_pipeline: vertex attribute %d of vs %p has NVN format %#x without a vertex format: read as 0 (first)", l,
+                                 (const void *)s->vs, (unsigned)va.fmt);
             a->binding = VK_PIPE_ZERO_BINDING, a->format = zero_format(io[l].type);
             zero = 1;
         }
-- 
2.56.0

