From 74851f1fc5de35c4d216dadaa8e99be9e06a92a2 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:51:10 -0500
Subject: [PATCH] build_xlate: expect 41 patches, upstream's 0041 CAS limit
 beside our 0041 texel-fetch clamp

---
 tools/build_xlate.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/build_xlate.py b/tools/build_xlate.py
index 3f74b07..a485ad0 100644
--- a/tools/build_xlate.py
+++ b/tools/build_xlate.py
@@ -99,8 +99,8 @@ def prepare_sources() -> Path:
     for junk in list(src.glob("src/*/obj")) + list(src.glob("src/*/bin")):
         shutil.rmtree(junk)
     patches = sorted((XLATE / "patches").glob("*.patch"))
-    if len(patches) != 40:
-        sys.exit(f"expected 40 patches, found {len(patches)}")
+    if len(patches) != 41:
+        sys.exit(f"expected 41 patches, found {len(patches)}")
     # build/xlate is inside this checkout, and git inside a repository reads a "diff --git" patch's paths from the
     # repository's top: those hunks fall outside the directory handed to --directory, git skips every file of the patch
     # and still exits 0. GIT_CEILING_DIRECTORIES stops git from walking up to the checkout, so it reads each patch as it
-- 
2.56.0

