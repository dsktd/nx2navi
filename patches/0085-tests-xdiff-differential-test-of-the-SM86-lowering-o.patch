+            try:
+                words, ub = lower_py.lower(w, bugs)
+            except lower_py.Fail:
+                stats[fam]["refused"] += 1
+                continue
+            low = xdiff.Lowering(words, ub)
+            for _c in range(cases):
+                s = rng.getrandbits(32)
+                o = xdiff.run_case(w, low, s)
+                stats[fam][o.kind] += 1
+                if o.kind in ("mismatch", "undefined") and fam not in examples:
+                    examples[fam] = (w, s, o)
+    if verbose or True:
+        for fam, k in sorted(stats.items()):
+            print(f"  {fam:6} " + ", ".join(f"{a} {b}" for a, b in sorted(k.items())))
+    for fam, (w, s, o) in examples.items():
+        print(f"  {fam}: {o.kind} {o.detail} --words \"{xdiff.fmt_insn(w)}\" seed {s}: "
+              + "; ".join(f"{a} sm86 {b:08x} lowered {c:08x}" for a, b, c in o.diffs[:3]))
+    return stats, examples
