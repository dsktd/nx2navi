+"""Machine state shared by the SM86 and Maxwell reference interpreters: one thread's registers and predicates, the
+uniform file (SM86) and the constant banks."""
+
+from __future__ import annotations
+
+import random
+import struct
+
+RZ, PT, URZ, UPT = 255, 7, 63, 7
+
+
+class Unsupported(Exception):
+    """An instruction or form the reference interpreter does not model; the case is skipped, not counted as a mismatch."""
+
+
+class State:
+    def __init__(self):
+        self.r = [0] * 256
+        self.p = [False] * 8
+        self.ur = [0] * 64
+        self.up = [False] * 8
+        self.cc = 0               # Maxwell condition code carry (IADD.CC / IADD.X)
+        self.seed = 0             # constant bank words are a function of (seed, bank, word offset): copies agree
+        self.bank_alias = {}      # Maxwell bank -> SM86 bank it holds (17 -> 24, AmpereLowering Bank)
+
+    def copy(self):
+        s = State()
+        s.r, s.p, s.ur, s.up, s.cc, s.seed = self.r[:], self.p[:], self.ur[:], self.up[:], self.cc, self.seed
+        s.bank_alias = dict(self.bank_alias)
+        return s
+
+    # registers
+    def R(self, n):
+        return 0 if n == RZ else self.r[n]
+
+    def setR(self, n, v):
+        if n != RZ:
+            self.r[n] = v & 0xFFFFFFFF
+
+    def UR(self, n):
+        return 0 if n == URZ else self.ur[n]
+
+    def setUR(self, n, v):
+        if n != URZ:
+            self.ur[n] = v & 0xFFFFFFFF
+
+    def P(self, n):
+        return True if n == PT else self.p[n]
+
+    def setP(self, n, v):
+        if n != PT:
+            self.p[n] = bool(v)
+
+    def UP(self, n):
+        return True if n == UPT else self.up[n]
+
+    def setUP(self, n, v):
+        if n != UPT:
+            self.up[n] = bool(v)
+
+    def word(self, bank, index):
+        bank = self.bank_alias.get(bank, bank)
+        return random_word(random.Random(f"{self.seed}:{bank}:{index}"))
+
+    def cbuf(self, bank, offset, size=4):
+        """size bytes at a byte offset (little endian, any alignment, zero-extended)."""
+        data = b"".join(self.word(bank, i).to_bytes(4, "little") for i in range(offset >> 2, (offset + size + 3) >> 2))
+        return int.from_bytes(data[offset & 3:(offset & 3) + size], "little")
+
+
+# Values that find conversion and sign bugs: zeros, ones, sign bits, half and byte boundaries, float specials.
+INT_EDGES = [0, 1, 2, 0xFFFFFFFF, 0xFFFFFFFE, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFF, 0x8000, 0x7FFF, 0xFFFF8000,
+             0xFF, 0x80, 0x7F, 0xFFFFFF80, 0x10000, 31, 32, 33, 63, 64, 0x12345678, 0xDEADBEEF]
+F32_EDGES = [0x00000000, 0x80000000, 0x3F800000, 0xBF800000, 0x3F000000, 0x40490FDB, 0x7F800000, 0xFF800000, 0x7FC00000,
+             0x00000001, 0x807FFFFF, 0x00800000, 0x7F7FFFFF, 0x4B000000, 0x4B000001, 0x3EFFFFFF, 0x3FC00000, 0xC0200000,
+             0x4F000000, 0xCF000000, 0x4F800000, 0x477FE000, 0x477FF000, 0x33800000, 0x38800000]
+
+
+def random_word(rng: random.Random):
+    k = rng.random()
+    if k < 0.25:
+        return rng.choice(INT_EDGES)
+    if k < 0.5:
+        return rng.choice(F32_EDGES)
+    if k < 0.75:   # an ordinary float in a few decades around 1
+        x = rng.uniform(-1, 1) * 10 ** rng.randint(-3, 4)
+        return struct.unpack("<I", struct.pack("<f", x))[0]
+    if k < 0.85:   # a small integer, either sign
+        return rng.randint(-300, 300) & 0xFFFFFFFF
+    return rng.getrandbits(32)
+
+
+def random_state(rng: random.Random):
+    s = State()
+    s.seed = rng.getrandbits(48)
+    s.r = [random_word(rng) for _ in range(256)]
+    s.r[RZ] = 0
+    s.p = [rng.random() < 0.5 for _ in range(7)] + [True]
+    s.ur = [random_word(rng) for _ in range(64)]
+    s.ur[URZ] = 0
+    # uniform predicates start false in every lowered program (AmpereLowering Run: Mov32i(RUP, 0))
+    s.up = [False] * 7 + [True]
+    return s
