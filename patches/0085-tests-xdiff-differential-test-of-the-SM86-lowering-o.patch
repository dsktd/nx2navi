+++ b/docs/building.md
@@ -262,6 +262,14 @@ A change to the SM86 tensor lowering (`tools/xlate/AmpereLowering.cs` Hmma, Ldsm
 `tests\maxwell_warp_emu.py`, a model of what the shader translator makes of Maxwell code (the docstring names the
 vector file and what is checked). `tests\maxwell_warp_emu_selftest.py` checks the emulator itself. No game files.
 
+A change to the rest of the SM86 lowering (ALU, conversions, moves, the uniform datapath) passes
+`python tests\xdiff\xdiff.py --cache <shader-cache>`: it lowers real instructions of every form the game's shaders use
+(read from the cache's stored translation inputs) with `nx2navi_xlate --lower`, runs each on random inputs through an
+SM86 reference and the lowered Maxwell words through a Maxwell reference that decodes them with the translator's own
+decoder tables, and writes `build\xdiff\report.txt` with the discrepancies ranked by the shaders they reach and a
+`--words ... --case N` repro for each. `python tests\xdiff\selftest.py` checks the checker without the translator
+binary (on `tests\xdiff\lower_py.py`, a transcription of the lowering, which must be kept in step with the C#).
+
 ## Reverse engineering (optional)
 
 - Ghidra 12.1.2 with the Ghidra-Switch-Loader extension in `toolchain\ghidra\` (JDK 21) opens the game modules (NSO).
diff --git a/tests/xdiff/census.py b/tests/xdiff/census.py
new file mode 100644
index 0000000..a082b40
--- /dev/null
+++ b/tests/xdiff/census.py
@@ -0,0 +1,139 @@
+"""The SM86 instructions of the game's shaders, from the runtime's stored translation inputs.
+
+Every translation the runtime makes stores its inputs as <shader-cache>/in/<input id>.in (runtime/gfx_shader.c
+in_store: header {magic "TKSI", version, stage, length, c1 length, answers size}, the answers, the 0x880-byte control
+section, the code, c1); tools/pack_shader_cache.py folds them into shader-cache.pack (kind 4). An NVN2 program
+(control magic 0x98761234) is SM86 code: its size is at control +0x38, and graphics, task and mesh programs start
+with a 0x80-byte header (AmpereLowering.Lower).
+
+programs(cache) yields (input id, stage name, [128-bit instruction words]) for every distinct NVN2 program; forms()
+groups the instructions by form (opcode and modifiers, with register numbers, immediates, constant offsets and
+predicate indices masked out) and counts the shaders each form occurs in."""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "tools"))
+from pack_shader_cache import PACK, loose_files, read_pack  # noqa: E402
+
+import sm86  # noqa: E402
+
+IN_MAGIC = 0x49534B54
+NVN2_MAGIC = 0x98761234
+CONTROL_SIZE = 0x880
+STAGES = {0: "vs", 4: "ps", 5: "cs", 6: "ts", 7: "ms"}   # runtime/gfx.h GFX_STAGE_*
+
+
+def parse_in(data: bytes):
+    """(stage name, [128-bit words]) of an NVN2 program's stored inputs, or None."""
+    if len(data) < 24:
+        return None
+    magic, version, stage, length, c1_len, asize = struct.unpack_from("<6I", data)
+    if magic != IN_MAGIC or stage not in STAGES:
+        return None
+    control = data[24 + asize:24 + asize + CONTROL_SIZE]
+    code = data[24 + asize + CONTROL_SIZE:24 + asize + CONTROL_SIZE + length]
+    if len(control) < CONTROL_SIZE or struct.unpack_from("<I", control)[0] != NVN2_MAGIC:
+        return None
+    size = struct.unpack_from("<I", control, 0x38)[0]
+    header = 0 if STAGES[stage] == "cs" else 0x80
+    if size > len(code) or size <= header or (size - header) % 16:
+        return None
+    words = [int.from_bytes(code[k:k + 16], "little") for k in range(header, size, 16)]
+    return STAGES[stage], words
+
+
+def programs(cache: Path, limit: int | None = None):
+    """Distinct NVN2 programs (by code) of a shader cache folder, loose and packed inputs."""
+    seen = set()
+    sources = []
+    for (kind, name), path in sorted(loose_files(cache).items()):
+        if kind == 4:
+            sources.append((name.hex(), lambda p=path: p.read_bytes()))
+    pack = cache / PACK
+    entries = read_pack(pack) if pack.is_file() else {}
+    if entries:
+        fh = open(pack, "rb")
+
+        def reader(off, size):
+            fh.seek(off)
+            return fh.read(size)
+        for (kind, name), (off, size) in sorted(entries.items()):
+            if kind == 4:
+                sources.append((name.hex(), lambda o=off, s=size: reader(o, s)))
+    n = 0
+    for iid, read in sources:
+        parsed = parse_in(read())
+        if not parsed:
+            continue
+        stage, words = parsed
+        h = hashlib.sha256(b"".join(w.to_bytes(16, "little") for w in words)).digest()
+        if h in seen:   # the same code under other answers
+            continue
+        seen.add(h)
+        yield iid, stage, words
+        n += 1
+        if limit and n >= limit:
+            return
+
+
+# Predicate index fields (3 bits; the negate bit above them stays in the form) per family.
+PRED_FIELDS = {
+    "FSETP": (81, 84, 87), "ISETP": (81, 84, 87, 68), "IADD3": (81, 84, 87, 77), "UIADD3": (81, 84, 87, 77),
+    "LEA": (81, 87), "ULEA": (81, 87), "LOP3": (81, 87), "ULOP3": (81, 87), "SEL": (87,), "USEL": (87,),
+    "FSEL": (87,), "FMNMX": (87,), "IMNMX": (87,), "IMAD": (87,), "UIMAD": (87,), "PLOP3": (81, 84, 87, 77, 68),
+    "UPLOP3": (81, 84, 87, 77, 68), "FSET": (87,), "UISETP": (81, 84, 87, 68),
+}
+M128 = (1 << 128) - 1
+
+
+def field_mask(off, n):
+    return ((1 << n) - 1) << off
+
+
+def form_key(w: int) -> int:
+    """The instruction with what differs between uses of one form masked out."""
+    op = w & 0xFFF
+    form = (w >> 9) & 7
+    m = M128 & ~field_mask(12, 20) & ~field_mask(105, 23)   # guard, Rd, Ra; scheduling and reuse bits
+    if form == 1:
+        m &= ~field_mask(32, 8) & ~field_mask(64, 8)
+    elif form in (2, 4):
+        m &= ~field_mask(32, 32) & ~field_mask(64, 8)
+    elif form in (3, 5):
+        m &= ~field_mask(38, 16) & ~field_mask(64, 8)
+    elif form in (6, 7):
+        m &= ~field_mask(32, 6) & ~field_mask(64, 8)
+    for off in PRED_FIELDS.get(sm86.mnemonic(op), ()):
+        m &= ~field_mask(off, 3)
+    return w & m
+
+
+KEEP = 32   # distinct example instructions kept per form
+
+
+def forms(progs):
+    """({form key: {"shaders": set of program indices, "count": uses, "insns": [up to KEEP distinct words]}},
+    [input id of each program index], instruction count) over (id, stage, words)."""
+    out = defaultdict(lambda: {"shaders": set(), "count": 0, "insns": []})
+    ids = []
+    ninsn = 0
+    for iid, _stage, words in progs:
+        n = len(ids)
+        ids.append(iid)
+        for w in words:
+            if (w >> 12) & 15 == 15:   # @!PT: compiler padding, never runs
+                continue
+            ninsn += 1
+            e = out[form_key(w)]
+            e["shaders"].add(n)
+            e["count"] += 1
+            if len(e["insns"]) < KEEP and w not in e["insns"]:
+                e["insns"].append(w)
+    return out, ids, ninsn
diff --git a/tests/xdiff/fake_xlate.py b/tests/xdiff/fake_xlate.py
new file mode 100644
index 0000000..bad601e
--- /dev/null
+++ b/tests/xdiff/fake_xlate.py
@@ -0,0 +1,40 @@
+"""Stands in for `nx2navi_xlate --lower <file>` (tools/xlate/Program.cs LowerFile) with the Python transcription
+lower_py.py, so the xdiff driver can be checked end to end where the translator binary is not at hand:
+
+  python tests/xdiff/xdiff.py --xlate tests/xdiff/fake_xlate.py --cache <folder>
+
+Same output: the Maxwell words one per line, the closing EXIT, "urbase N"; a refusal goes to stderr with exit 1.
+XDIFF_FAKE_BUGS=i2f-bit12 injects a known bug."""
+
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import lower_py  # noqa: E402
+
+
+def main():
+    if len(sys.argv) != 3 or sys.argv[1] != "--lower":
+        sys.exit("usage: fake_xlate.py --lower <file>")
+    words = []
+    for line in Path(sys.argv[2]).read_text().splitlines():
+        line = line.split("#")[0].strip()
+        if line:
+            words.append(sum(int(x.removeprefix("0x"), 16) << (32 * k) for k, x in enumerate(line.split())))
+    if len(words) != 1:
+        print("fake_xlate lowers one instruction", file=sys.stderr)
+        return 1
+    try:
+        out, ub = lower_py.lower(words[0], [b for b in os.environ.get("XDIFF_FAKE_BUGS", "").split(",") if b])
+    except lower_py.Fail as e:
+        print(f"LoweringException: {e}", file=sys.stderr)
+        return 1
+    for w in out + [0xE30000000007000F]:   # EXIT under PT
+        print(f"{w:016x}")
+    print(f"urbase {ub}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/xdiff/fp.py b/tests/xdiff/fp.py
new file mode 100644
index 0000000..1694262
--- /dev/null
+++ b/tests/xdiff/fp.py
@@ -0,0 +1,350 @@
+"""Exact IEEE helpers for the reference interpreters (stdlib only): f32 and f16 bit patterns to exact values and back
+under the four rounding modes, flush to zero, and the NVIDIA conventions both ISAs share (canonical NaN 0x7fffffff,
+min/max return the non-NaN operand, saturation sends NaN to 0)."""
+
+from __future__ import annotations
+
+import math
+from fractions import Fraction
+
+M32 = 0xFFFFFFFF
+QNAN = 0x7FFFFFFF
+RN, RM, RP, RZ = 0, 1, 2, 3          # SM86 and Maxwell rounding field order: nearest even, down, up, toward zero
+
+
+class Fmt:
+    def __init__(self, ebits, mbits):
+        self.ebits, self.mbits = ebits, mbits
+        self.bias = (1 << (ebits - 1)) - 1
+        self.emax = self.bias
+        self.emin = 1 - self.bias
+        self.sign = 1 << (ebits + mbits)
+        self.expmask = ((1 << ebits) - 1) << mbits
+        self.inf = self.expmask
+        self.qnan = self.expmask | (1 << (mbits - 1)) | ((1 << (mbits - 1)) - 1)
+        self.mask = (1 << (ebits + mbits + 1)) - 1
+
+
+F32, F16, F64 = Fmt(8, 23), Fmt(5, 10), Fmt(11, 52)
+
+
+def is_nan(bits, f=F32):
+    return (bits & f.expmask) == f.expmask and (bits & ((1 << f.mbits) - 1)) != 0
+
+
+def is_inf(bits, f=F32):
+    return (bits & ~f.sign & f.mask) == f.inf
+
+
+def is_denorm(bits, f=F32):
+    return (bits & f.expmask) == 0 and (bits & ((1 << f.mbits) - 1)) != 0
+
+
+def ftz(bits, on, f=F32):
+    return bits & f.sign if on and is_denorm(bits, f) else bits
+
+
+def value(bits, f=F32):
+    """Exact value of a finite pattern as a Fraction; ('inf', sign) / 'nan' otherwise."""
+    s = -1 if bits & f.sign else 1
+    e = (bits & f.expmask) >> f.mbits
+    m = bits & ((1 << f.mbits) - 1)
+    if e == (1 << f.ebits) - 1:
+        return "nan" if m else ("inf", s)
+    if e == 0:
+        return s * Fraction(m, 1 << (f.mbits - f.emin))
+    return s * Fraction((1 << f.mbits) | m) * Fraction(2) ** (e - f.bias - f.mbits)
+
+
+def _round_int(q: Fraction, mode):
+    """q rounded to an integer under mode (q may be negative)."""
+    fl = q.numerator // q.denominator
+    rem = q - fl
+    if rem == 0:
+        return fl
+    if mode == RM:
+        return fl
+    if mode == RP:
+        return fl + 1
+    if mode == RZ:
+        return fl + 1 if q < 0 else fl
+    if rem > Fraction(1, 2) or (rem == Fraction(1, 2) and fl & 1):
+        return fl + 1
+    return fl
+
+
+def pack(q, mode=RN, f=F32, neg_zero=False):
+    """Bits of the exact value q (Fraction, 'nan', ('inf', s)) rounded into format f."""
+    if q == "nan":
+        return f.qnan if f is not F32 else QNAN
+    if isinstance(q, tuple):
+        return f.inf | (f.sign if q[1] < 0 else 0)
+    if q == 0:
+        return f.sign if neg_zero else 0
+    sign = f.sign if q < 0 else 0
+    a = -q if q < 0 else q
+    e = a.numerator.bit_length() - a.denominator.bit_length()
+    if Fraction(2) ** e > a:
+        e -= 1
+    e = max(e, f.emin)
+    scale = Fraction(2) ** (e - f.mbits)
+    # round the magnitude, with the direction of RM/RP taken from the sign
+    m_mode = mode
+    if sign and mode in (RM, RP):
+        m_mode = RP if mode == RM else RM
+    m = _round_int(a / scale, m_mode)
+    if m >= 1 << (f.mbits + 1):
+        m >>= 1
+        e += 1
+    if e > f.emax:
+        up = m_mode == RN or m_mode == RP
+        return sign | (f.inf if up else (f.expmask - (1 << f.mbits)) | ((1 << f.mbits) - 1))
+    if m < 1 << f.mbits:            # subnormal (e == emin) or zero after rounding
+        return sign | m
+    return sign | ((e + f.bias) << f.mbits) | (m & ((1 << f.mbits) - 1))
+
+
+def f2bits(x: float) -> int:
+    import struct
+    return struct.unpack("<I", struct.pack("<f", x))[0]
+
+
+def bits2f(b: int) -> float:
+    import struct
+    return struct.unpack("<f", struct.pack("<I", b & M32))[0]
+
+
+def same(a, b, isfloat=True):
+    """Equal results: identical bits, or both NaN for a float result (payloads are undefined in SPIR-V)."""
+    return a == b or (isfloat and is_nan(a) and is_nan(b))
+
+
+# ---- arithmetic on f32 bit patterns ----------------------------------------------------------------------------
+
+def neg(b, on=True):
+    return b ^ 0x80000000 if on else b
+
+
+def fabs(b, on=True):
+    return b & 0x7FFFFFFF if on else b
+
+
+def _special(*vals):
+    return any(v == "nan" for v in vals)
+
+
+def fadd(a, b, mode=RN, fz=False):
+    a, b = ftz(a, fz), ftz(b, fz)
+    va, vb = value(a), value(b)
+    if _special(va, vb):
+        return QNAN
+    if isinstance(va, tuple) or isinstance(vb, tuple):
+        if isinstance(va, tuple) and isinstance(vb, tuple) and va[1] != vb[1]:
+            return QNAN
+        return pack(va if isinstance(va, tuple) else vb)
+    s = va + vb
+    if s == 0:   # exact zero: -0 only for -0 + -0, or under RM
+        nz = (a & b & 0x80000000) != 0 if (va == 0 and vb == 0) else mode == RM
+        return 0x80000000 if nz else 0
+    return ftz(pack(s, mode), fz)
+
+
+def fmul(a, b, mode=RN, fz=False):
+    a, b = ftz(a, fz), ftz(b, fz)
+    va, vb = value(a), value(b)
+    sign = (a ^ b) & 0x80000000
+    if _special(va, vb):
+        return QNAN
+    if isinstance(va, tuple) or isinstance(vb, tuple):
+        if va == 0 or vb == 0:
+            return QNAN
+        return F32.inf | sign
+    p = va * vb
+    if p == 0:
+        return sign
+    return ftz(pack(p, mode), fz)
+
+
+def ffma(a, b, c, mode=RN, fz=False):
+    a, b, c = ftz(a, fz), ftz(b, fz), ftz(c, fz)
+    va, vb, vc = value(a), value(b), value(c)
+    psign = (a ^ b) & 0x80000000
+    if _special(va, vb, vc):
+        return QNAN
+    if isinstance(va, tuple) or isinstance(vb, tuple):
+        if va == 0 or vb == 0:
+            return QNAN
+        pinf = ("inf", -1 if psign else 1)
+        if isinstance(vc, tuple) and vc[1] != pinf[1]:
+            return QNAN
+        return pack(pinf)
+    if isinstance(vc, tuple):
+        return pack(vc)
+    p = va * vb
+    s = p + vc
+    if s == 0:
+        if p == 0 and vc == 0:
+            nz = psign != 0 and (c & 0x80000000) != 0
+        else:
+            nz = mode == RM
+        return 0x80000000 if nz else 0
+    return ftz(pack(s, mode), fz)
+
+
+def sat(b):
+    if is_nan(b):
+        return 0
+    v = value(b)
+    if isinstance(v, tuple):
+        return 0x3F800000 if v[1] > 0 else 0
+    if v <= 0:
+        return 0
+    return 0x3F800000 if v >= 1 else b
+
+
+def _mnmx(a, b, want_min):
+    if is_nan(a):
+        return QNAN if is_nan(b) else b
+    if is_nan(b):
+        return a
+    if flt(a, b):
+        return a if want_min else b
+    if flt(b, a):
+        return b if want_min else a
+    if a != b:   # +0 and -0: min is -0, max is +0
+        return (a | b) if want_min else (a & b)
+    return a
+
+
+def fmin(a, b):
+    return _mnmx(a, b, True)
+
+
+def fmax(a, b):
+    return _mnmx(a, b, False)
+
+
+def flt(a, b):
+    """a < b for non-NaN patterns (+0 == -0); a Python float holds every f32 exactly."""
+    return bits2f(a) < bits2f(b)
+
+
+def fcomp(code, a, b):
+    """The 4-bit float compare shared by SM86 FSETP/FSET and Maxwell: F LT EQ LE GT NE GE NUM NAN LTU EQU LEU GTU NEU
+    GEU T."""
+    unordered = is_nan(a) or is_nan(b)
+    if code == 0:
+        return False
+    if code == 15:
+        return True
+    if code == 7:
+        return not unordered
+    if code == 8:
+        return unordered
+    if unordered:
+        return code >= 9
+    lt, gt = flt(a, b), flt(b, a)
+    eq = not lt and not gt
+    base = code - 8 if code >= 9 else code
+    return {1: lt, 2: eq, 3: lt or eq, 4: gt, 5: not eq, 6: gt or eq}[base]
+
+
+def icomp(code, a, b, signed):
+    """3-bit integer compare: F LT EQ LE GT NE GE T."""
+    if signed:
+        a, b = s32(a), s32(b)
+    return [False, a < b, a == b, a <= b, a > b, a != b, a >= b, True][code]
+
+
+def boolop(op, x, y):
+    return [x and y, x or y, x != y][op]
+
+
+def s32(v):
+    v &= M32
+    return v - (1 << 32) if v & 0x80000000 else v
+
+
+def frnd(b, mode, fz=False):
+    """Round to an integral f32 value."""
+    b = ftz(b, fz)
+    v = value(b)
+    if v == "nan":
+        return QNAN
+    if isinstance(v, tuple):
+        return b
+    r = _round_int(v, mode)
+    if r == 0:
+        return b & 0x80000000
+    return pack(Fraction(r))
+
+
+def f2i(b, mode, bits, signed, fz=False, src=F32):
+    """Saturating float to integer (NaN gives 0), as NVIDIA F2I."""
+    b = ftz(b, fz, src)
+    v = value(b, src)
+    lo, hi = (-(1 << (bits - 1)), (1 << (bits - 1)) - 1) if signed else (0, (1 << bits) - 1)
+    if v == "nan":
+        return 0
+    if isinstance(v, tuple):
+        r = hi if v[1] > 0 else lo
+    else:
+        r = min(max(_round_int(v, mode), lo), hi)
+    return r & M32
+
+
+def i2f(v, signed, mode, dst=F32):
+    if signed:
+        v = s32(v)
+    if v == 0:
+        return 0
+    return pack(Fraction(v), mode, dst)
+
+
+def f32_to_f16(b, mode=RN):
+    v = value(b)
+    if v == "nan":
+        return 0x7FFF
+    return pack(v, mode, F16, neg_zero=bool(b & 0x80000000))
+
+
+def f16_to_f32(h):
+    v = value(h & 0xFFFF, F16)
+    if v == "nan":
+        return QNAN
+    return pack(v, RN, F32, neg_zero=bool(h & 0x8000))
+
+
+def mufu(op, b):
+    """MUFU in Maxwell numbering on an f32 pattern (radians for SIN/COS); returns float or None for NaN."""
+    x = bits2f(b)
+    try:
+        if math.isnan(x):
+            return math.nan
+        if op == 0:
+            return math.cos(x) if math.isfinite(x) else math.nan
+        if op == 1:
+            return math.sin(x) if math.isfinite(x) else math.nan
+        if op == 2:
+            return 2.0 ** x if x < 200 else math.inf
+        if op == 3:
+            return math.log2(x) if x > 0 else (-math.inf if x == 0 else math.nan)
+        if op == 4:
+            return 1.0 / x if x != 0 else math.copysign(math.inf, x)
+        if op == 5:
+            return 1.0 / math.sqrt(x) if x > 0 else (math.copysign(math.inf, x) if x == 0 else math.nan)
+        if op == 8:
+            return math.sqrt(x) if x >= 0 else (x if x == 0 else math.nan)
+    except OverflowError:
+        return math.inf
+    raise ValueError(f"MUFU {op}")
+
+
+def close(a, b, rel=2e-6, absol=4e-5):
+    """MUFU results: approximations on both sides, compared with a tolerance."""
+    fa, fb = bits2f(a), bits2f(b)
+    if math.isnan(fa) or math.isnan(fb):
+        return math.isnan(fa) and math.isnan(fb)
+    if math.isinf(fa) or math.isinf(fb):
+        return fa == fb or (abs(fa) > 3e38 and abs(fb) > 3e38 and (fa > 0) == (fb > 0))
+    return abs(fa - fb) <= max(absol, rel * max(abs(fa), abs(fb)))
diff --git a/tests/xdiff/isa.py b/tests/xdiff/isa.py
new file mode 100644
index 0000000..05e89fc
--- /dev/null
+++ b/tests/xdiff/isa.py
@@ -0,0 +1,100 @@
+"""The translator's Maxwell decoder, read from its own sources.
+
+decode(word) gives what the shader translator (Ryujinx.Graphics.Shader) sees in one 64-bit Maxwell instruction: the
+table entry Decoders/InstTable.cs matches (the entry with the fewest don't-care bits among the top 14 wins, the first
+added on a tie, as InstTable.Add does) and every field its Decoders/InstDecoders.cs struct defines, evaluated from
+the C# expression itself. So a lowering that puts a field at the wrong bit (I2F's signed flag in bit 12, patch 0064)
+decodes here exactly as the translator decodes it.
+
+  insn = decode(0x5cb8000000002a02)
+  insn.name, insn.emitter, insn.f['ISrcFmt'], insn.f['Dest']
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+SHADER_SRC = ROOT / "tools" / "vendor" / "ryujinx" / "src" / "Ryujinx.Graphics.Shader"
+
+ENCODING_BITS = 14
+_ADD = re.compile(r'Add\("([01x]{64})",\s*InstName\.(\w+),\s*InstEmit\.(\w+)')
+_STRUCT = re.compile(r"readonly struct Inst(\w+)\s*\{(.*?)\n    \}", re.S)
+_PROP = re.compile(r"public (\w+) (\w+) => (.*?);\s*$", re.M)
+_CAST = re.compile(r"\((?:int|uint|long|ulong|bool|[A-Z]\w*)\)(?=\s*[\(_])")
+
+
+@dataclass
+class Insn:
+    word: int
+    name: str          # InstName, e.g. "I2f"
+    emitter: str       # InstEmit method, e.g. "I2fR" (also the decoder struct name without "Inst")
+    f: dict = field(default_factory=dict)
+
+    def __getitem__(self, key):
+        return self.f[key]
+
+
+class Isa:
+    def __init__(self, src: Path = SHADER_SRC):
+        table = (src / "Decoders" / "InstTable.cs").read_text(encoding="utf-8")
+        decoders = (src / "Decoders" / "InstDecoders.cs").read_text(encoding="utf-8")
+        self.table: list = [None] * (1 << ENCODING_BITS)
+        for enc, name, emitter in _ADD.findall(table):
+            top = enc[:ENCODING_BITS]
+            xbits = top.count("x")
+            xs = [ENCODING_BITS - 1 - i for i, ch in enumerate(top) if ch == "x"]
+            base = int(top.replace("x", "0"), 2)
+            for k in range(1 << len(xs)):
+                v = base
+                for j, bit in enumerate(xs):
+                    if k >> j & 1:
+                        v |= 1 << bit
+                cur = self.table[v]
+                if cur is None or cur[2] > xbits:
+                    self.table[v] = (name, emitter, xbits)
+        self.fields: dict[str, list] = {}
+        for sname, body in _STRUCT.findall(decoders):
+            props = []
+            for ctype, pname, expr in _PROP.findall(body):
+                if "_opcode" not in expr:
+                    continue
+                py = _CAST.sub("", expr).replace("_opcode", "op")
+                code = compile(py, f"Inst{sname}.{pname}", "eval")
+                props.append((pname, ctype, code))
+            self.fields[sname] = props
+
+    def decode(self, word: int) -> Insn | None:
+        e = self.table[word >> (64 - ENCODING_BITS)]
+        if e is None:
+            return None
+        name, emitter, _ = e
+        f = {}
+        for pname, ctype, code in self.fields.get(emitter, ()):
+            v = eval(code, {}, {"op": word})
+            if ctype == "bool":
+                v = bool(v)
+            elif ctype == "int":
+                v &= 0xFFFFFFFF
+                if v >= 0x80000000:
+                    v -= 1 << 32
+            f[pname] = int(v) if not isinstance(v, bool) else v
+        return Insn(word, name, emitter, f)
+
+
+_isa: Isa | None = None
+
+
+def isa(src: Path | None = None) -> Isa:
+    global _isa
+    if src is not None:
+        return Isa(src)
+    if _isa is None:
+        _isa = Isa()
+    return _isa
+
+
+def decode(word: int) -> Insn | None:
+    return isa().decode(word)
