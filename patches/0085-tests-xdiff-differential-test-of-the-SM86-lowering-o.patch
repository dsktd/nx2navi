+    for x in words:
+        d = isa.decode(x)
+        print(f"  {x:016x} {d.emitter if d else '?'} " + (" ".join(f"{k}={v}" for k, v in d.f.items()) if d else ""))
+    rng = random.Random(a.seed)
+    bad = 0
+    for c in range(a.cases):
+        s = rng.getrandbits(32)
+        o = xdiff.run_case(w, xdiff.Lowering(words, ub), s)
+        if o.kind != "ok":
+            bad += 1
+            print(f"  case {c} seed {s}: {o.kind} {o.detail} {xdiff.inputs_of(w, random_state(random.Random(s)))}")
+            for n, x, y in o.diffs:
+                print(f"    {n}: sm86 {x:08x} lowered {y:08x}")
+    print(f"{a.cases - bad}/{a.cases} agree")
+    return 1 if bad else 0
+
