+"""Reference semantics of the SM86 (Ampere) ALU, conversion and move instructions the game's shaders use, for one
+thread. execute(word, state) runs one 128-bit instruction (bits 0-127 as an int) on a state.State.
+
+Field layout (the SM70+ encoding): opcode 0-11 (form 9-11: 1 B and C registers, 2 C immediate, 3 C constant, 4 B
+immediate, 5 B constant, 6 B uniform, 7 C uniform), guard 12-15, Rd 16-23, Ra 24-31, B register 32-39 or immediate
+32-63 or constant (byte offset 38-53, bank 54-58) or uniform register 32-37, C register 64-71, modifiers from 72,
+scheduling from 105. These positions are the ones tools/xlate/AmpereLowering.cs reads too (no public SM86 reference
+exists to take them from), so a lowering that misreads an SM86 field the same way is invisible here; what this
+checks is everything after the read: the Maxwell fields the lowering writes (decoded with the translator's own
+decoder, isa.py), the operand routing, and the semantics of the Maxwell sequence a lowering emits.
+
+Unsupported raises state.Unsupported (the case is skipped and counted as not modelled)."""
+
+from __future__ import annotations
+
+import fp
+from fp import M32, s32
+from state import RZ, PT, URZ, Unsupported
+
+# opcode (bits 0-11) -> mnemonic, for reports; the base (bits 0-8) names the family.
+FAMILY = {
+    0x002: "MOV", 0x082: "UMOV", 0x0B9: "ULDC", 0x0BB: "ULDC", 0x021: "FADD", 0x020: "FMUL", 0x023: "FFMA",
+    0x009: "FMNMX", 0x108: "MUFU", 0x007: "SEL", 0x008: "FSEL", 0x107: "FRND", 0x00B: "FSETP", 0x00C: "ISETP",
+    0x00A: "FSET", 0x045: "I2FP", 0x106: "I2F", 0x105: "F2I", 0x010: "IADD3", 0x024: "IMAD", 0x025: "IMAD.WIDE",
+    0x027: "IMAD.HI", 0x012: "LOP3", 0x017: "IMNMX", 0x019: "SHF", 0x011: "LEA", 0x016: "PRMT", 0x109: "POPC",
+    0x100: "FLO", 0x101: "BREV", 0x013: "IABS", 0x01A: "SGXT", 0x03E: "F2FP", 0x01C: "PLOP3", 0x003: "P2R",
+    0x004: "R2P", 0x090: "UIADD3", 0x0A4: "UIMAD", 0x0A5: "UIMAD.WIDE", 0x092: "ULOP3", 0x099: "USHF",
+    0x091: "ULEA", 0x087: "USEL", 0x08C: "UISETP", 0x096: "UPRMT", 0x09C: "UPLOP3", 0x0BD: "UFLO", 0x0BE: "UBREV",
+    0x0BF: "UPOPC", 0x083: "UP2UR", 0x043: "F2IP", 0x03C: "HMMA", 0x03A: "MOVM", 0x030: "HADD2", 0x032: "HMUL2",
+    0x031: "HFMA2", 0x040: "HMNMX2", 0x034: "HSETP2", 0x060: "TEX", 0x161: "TEX", 0x166: "TLD", 0x163: "TLD4",
+    0x16C: "TXD", 0x16F: "TXQ", 0x169: "TMML", 0x16A: "TMML", 0x170: "TXQ", 0x181: "LDG", 0x186: "STG",
+    0x182: "LDC", 0x184: "LDS", 0x188: "STS", 0x187: "STL", 0x183: "LDL", 0x18C: "ATOMS",
+    0x1A8: "ATOMG", 0x18E: "RED", 0x189: "SHFL", 0x19B: "SULD", 0x197: "SUST", 0x19F: "SURED", 0x121: "ALD",
+    0x122: "AST", 0x126: "IPA", 0x005: "CS2R", 0x119: "S2R", 0x1C3: "S2UR", 0x127: "ISBEWR", 0x123: "ISBERD",
+    0x149: "BRX", 0x158: "BRX", 0x15B: "KILL", 0x14D: "EXIT", 0x147: "BRA", 0x144: "CALL", 0x150: "RET",
+    0x1C2: "R2UR", 0x006: "VOTE", 0x1A1: "MATCH", 0x1C4: "REDUX", 0x022: "FSWZADD", 0x11D: "BAR",
+    0x192: "MEMBAR", 0x118: "NOP", 0x11A: "DEPBAR", 0x145: "BSSY", 0x141: "BSYNC", 0x142: "BREAK",
+    0x148: "WARPSYNC", 0x1AB: "ERRBAR", 0x03B: "LDSM",
+}
