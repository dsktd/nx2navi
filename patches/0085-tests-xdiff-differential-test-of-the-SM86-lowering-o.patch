new file mode 100644
index 0000000..33001c2
--- /dev/null
+++ b/tests/xdiff/lower_py.py
@@ -0,0 +1,762 @@
+"""A line-by-line Python transcription of the ALU, conversion and move lowerings of tools/xlate/AmpereLowering.cs
+(Lowerer: Raw, Mat, Fadd ... I2f), plain register layout only. selftest.py runs the checker on it where the translator
+binary is not at hand, and injects known bugs into it (I2F's signed flag in bit 12, patch 0064) to show they are
+caught. It is a copy: the real check is xdiff.py on `nx2navi_xlate --lower`; keep the two in step when the C# changes.
+
+lower(w) -> (Maxwell words, urbase), as LowerFile prints them (closing EXIT left out)."""
+
+from __future__ import annotations
+
+RZ, PT = 255, 7
+SA, SB, SC, SX = 252, 253, 254, 239
+RUP = 238
+U = 0xFFFFFFFFFFFFFFFF
+
+
+class Fail(Exception):
+    pass
+
+
+class Lowerer:
+    def __init__(self, w, bugs=()):
+        self.w, self.out, self.bugs = w, [], set(bugs)
+        hi = -1
+        for r in (self.bits(16, 8), self.bits(24, 8)):
+            if r < RZ:
+                hi = max(hi, r)
+        b = self.bits(0, 12) & 0x1FF
+        if b < 0x080:
+            r = self.bits(64, 8)
+            if r < RZ:
+                hi = max(hi, r)
+        if self.bits(9, 3) == 1 and self.bits(32, 8) < RZ:
+            hi = max(hi, self.bits(32, 8))
+        if hi >= 237:   # Lowerer: RegisterPressureException, lowered again in spill mode (not transcribed)
+            raise Fail("spill mode")
+        self.urbase = (hi + 2) & ~1
+        self.guard = self.bits(12, 4) << 16
+
+    def bits(self, o, n):
+        return (self.w >> o) & ((1 << n) - 1)
+
+    def bit(self, o):
+        return (self.w >> o) & 1
+
+    @property
+    def form(self):
+        return self.bits(9, 3)
+
+    @property
+    def W1(self):
+        return self.bits(32, 32)
+
+    @property
+    def W2(self):
+        return self.bits(64, 32)
+
+    # building blocks
+    def emit(self, x):
+        self.out.append(x & U)
+
+    def emitg(self, x):
+        self.out.append((x | self.guard) & U)
+
+    def unguarded(self, x):
+        return x | (PT << 16)
+
+    def put(self, x, guarded):
+        self.out.append((x | self.guard) if guarded else self.unguarded(x))
+
+    def mov(self, d, s, guarded=True):
+        self.put(0x5c98000000000000 | (15 << 39) | (s << 20) | d, guarded)
+
+    def mov32i(self, d, imm, guarded=False):
+        self.put(0x0100000000000000 | (15 << 12) | (imm << 20) | d, guarded)
+
+    def movc(self, d, bank, off, guarded=False):
+        self.put(0x4c98000000000000 | (15 << 39) | ((off // 4) << 20) | (bank << 34) | d, guarded)
+
+    def lop32i(self, d, a, imm, op):
+        self.emit(self.unguarded(0x0400000000000000 | (op << 53) | (imm << 20) | (a << 8) | d))
+
+    def fmul32i(self, d, a, imm):
+        self.emit(self.unguarded(0x1e00000000000000 | (imm << 20) | (a << 8) | d))
+
+    def iadd3(self, d, a, b, c, guarded, negB=False):
+        self.put(0x5cc0000000000000 | (c << 39) | (b << 20) | (a << 8) | d | ((1 << 50) if negB else 0), guarded)
+
+    def sel(self, d, a, b, p, guarded):
+        self.put(0x5ca0000000000000 | ((p & 7) << 39) | ((p >> 3) << 42) | (b << 20) | (a << 8) | d, guarded)
+
+    def isetp_ltu(self, pd, a, b):
+        self.emitg(0x5b60000000000000 | (1 << 49) | (PT << 39) | (a << 8) | (b << 20) | (pd << 3) | PT)
+
+    # operands
+    uniform = False
+
+    def gpr(self, r):
+        if self.uniform:
+            return RZ if r == RZ else self.ur(r)
+        return r
+
+    def ur(self, r):
+        if r == 63:
+            return RZ
+        if r > 62 or self.urbase + r >= 237:
+            raise Fail("spill mode")
+        return self.urbase + r
+
+    def cbuf(self):
+        bank, off = self.bits(54, 5), self.bits(38, 16)
+        bank = 17 if bank == 24 else bank
+        if bank >= 18 or off & 3 or (self.bit(91) and not self.uniform):
+            raise Fail("constant operand")
+        return bank, off
+
+    def raw(self, which, scratch):
+        if which == 0:
+            return self.gpr(self.bits(24, 8)), self.bit(73), self.bit(72)
+        form = self.form
+        if form == 0:
+            raise Fail("form 0")
+        wide = form in (4, 5, 6) if which == 1 else form in (2, 3, 7)
+        if wide:
+            if form in (4, 2):
+                self.mov32i(scratch, self.W1)
+                return scratch, 0, 0
+            if form in (5, 3):
+                bank, off = self.cbuf()
+                self.movc(scratch, bank, off)
+                return scratch, self.bit(62), self.bit(63)
+            return self.ur(self.bits(32, 8)), self.bit(62), self.bit(63)
+        upper = which == 2 or form in (2, 3, 7)
+        return ((self.gpr(self.bits(64, 8)), self.bit(74), self.bit(75)) if upper
+                else (self.gpr(self.bits(32, 8)), self.bit(62), self.bit(63)))
+
+    def second(self):
+        return 2 if self.form in (2, 3, 7) else 1
+
+    def mat(self, reg, a, n, scratch):
+        if not a and not n:
+            return reg
+        if a:
+            self.lop32i(scratch, reg, 0x7fffffff, 0)
+            reg = scratch
+        if n:
+            self.lop32i(scratch, reg, 0x80000000, 2)
+            reg = scratch
+        return reg
+
+    def plain(self, which, scratch):
+        return self.raw(which, scratch)[0]
+
+    def floatmat(self, which, scratch):
+        r, a, n = self.raw(which, scratch)
+        return self.mat(r, a, n, scratch)
+
+    @property
+    def dst(self):
+        return self.gpr(self.bits(16, 8))
+
+    # instructions
+    def fadd(self):
+        if self.bits(81, 10):
+            raise Fail("FADD mode")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(self.second(), SB)
+        self.emitg(0x5c58000000000000 | (b << 20) | (a << 8) | self.dst | (an << 48) | (aa << 46) | (bn << 45)
+                   | (ba << 49) | (self.bits(78, 2) << 39) | (self.bits(80, 1) << 44) | (self.bits(77, 1) << 50))
+
+    SCALE = [0, 3, 2, 1, 0, 6, 5, 4]
+
+    def fmul(self):
+        if self.bit(76) or self.bits(81, 3) or self.bits(87, 4) or self.bits(84, 3) == 0:
+            raise Fail("FMUL mode")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(1, SB)
+        a = self.mat(a, aa, 0, SA)
+        b = self.mat(b, ba, 0, SB)
+        self.emitg(0x5c68000000000000 | (b << 20) | (a << 8) | self.dst | ((an != bn) << 48)
+                   | (self.SCALE[self.bits(84, 3)] << 41) | (self.bits(78, 2) << 39) | (self.bits(80, 1) << 44)
+                   | (self.bits(77, 1) << 50))
+
+    def ffma(self):
+        if self.bit(76) or self.bits(81, 10):
+            raise Fail("FFMA mode")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(1, SB)
+        c, ca, cn = self.raw(2, SC)
+        a, b, c = self.mat(a, aa, 0, SA), self.mat(b, ba, 0, SB), self.mat(c, ca, 0, SC)
+        self.emitg(0x5980000000000000 | (c << 39) | (b << 20) | (a << 8) | self.dst | ((an != bn) << 48) | (cn << 49)
+                   | (self.bits(77, 1) << 50) | (self.bits(78, 2) << 51) | (self.bits(80, 1) << 53))
+
+    def fmnmx(self):
+        if self.bits(74, 6) or self.bits(81, 6):
+            raise Fail("FMNMX mode")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(self.second(), SB)
+        self.emitg(0x5c60000000000000 | (b << 20) | (a << 8) | self.dst | (an << 48) | (aa << 46) | (bn << 45)
+                   | (ba << 49) | (self.bits(87, 3) << 39) | (self.bits(90, 1) << 42) | (self.bits(80, 1) << 44))
+
+    def frnd(self):
+        if self.bits(75, 2) != 2 or self.bits(84, 2) != 2 or self.bits(81, 3) or self.bits(86, 6):
+            raise Fail("FRND format")
+        b, ba, bn = self.raw(1, SB)
+        self.emitg(0x5ca8000000000000 | (2 << 8) | (2 << 10) | (b << 20) | self.dst | ((8 + self.bits(78, 2)) << 39)
+                   | (self.bits(80, 1) << 44) | (bn << 45) | (ba << 49))
+
+    def setp(self, floating):
+        if not floating and self.bit(72):
+            raise Fail("ISETP.EX not transcribed")
+        combine = self.bits(74, 2)
+        if combine > 2:
+            raise Fail("combine")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(1, SB)
+        w = ((0x5bb0000000000000 if floating else 0x5b60000000000000) | self.bits(84, 3) | (self.bits(81, 3) << 3)
+             | (a << 8) | (b << 20) | (self.bits(87, 3) << 39) | (self.bits(90, 1) << 42) | (combine << 45))
+        if floating:
+            w |= (self.bits(80, 1) << 47) | (self.bits(76, 4) << 48) | (an << 43) | (aa << 7) | (bn << 6) | (ba << 44)
+        else:
+            w |= (self.bits(73, 1) << 48) | (self.bits(76, 3) << 49)
+        self.emitg(w)
+
+    def fset(self):
+        if self.bits(64, 8) or self.bits(74, 2) == 3 or self.bits(81, 6):
+            raise Fail("FSET mode")
+        a, aa, an = self.raw(0, SA)
+        b, ba, bn = self.raw(1, SB)
+        self.emitg(0x5800000000000000 | (b << 20) | (a << 8) | self.dst | (self.bits(87, 3) << 39)
+                   | (self.bits(90, 1) << 42) | (self.bits(74, 2) << 45) | (self.bits(76, 4) << 48) | (1 << 52)
+                   | (self.bits(80, 1) << 55) | (an << 43) | (bn << 53) | (aa << 54) | (ba << 44))
+
+    def sel_(self, floating):
+        a = self.floatmat(0, SA) if floating else self.plain(0, SA)
+        b = self.floatmat(1, SB) if floating else self.plain(1, SB)
+        self.sel(self.dst, a, b, self.bits(87, 4), True)
+
+    def i2fp(self):
+        w2 = self.W2 & ~(0x400 | 0xc000 | 0x08000000)
+        if w2 != 0x00201000:
+            raise Fail("I2FP format")
+        b = self.plain(1, SB)
+        self.emitg(0x5cb8000000000000 | (2 << 8) | (2 << 10) | (self.bits(74, 1) << (12 if "i2f-bit12" in self.bugs else 13))
+                   | (b << 20) | (self.bits(78, 2) << 39) | self.dst)
+
+    def iadd3_(self):
+        op = self.bits(0, 12)
+        negA, negC, ext = self.bit(72), self.bit(75), self.bit(74)
+        negB = int(op != 0x810 and self.bit(63) and self.form not in (2, 3))
+        c1, c2 = self.bits(81, 3), self.bits(84, 3)
+        a, b, c = self.plain(0, SA), self.plain(1, SB), self.plain(2, SC)
+        d = self.dst
+        if self.form in (2, 3) and (self.bit(63) or negC):
+            raise Fail("IADD3 negation with a wide third source")
+        if not ext and c1 == 7 and c2 == 7:
+            self.emitg(0x5cc0000000000000 | (c << 39) | (b << 20) | (a << 8) | d | (negA << 51) | (negB << 50)
+                       | (negC << 49))
+            return
+        lo, hi, one = 244, 245, 246
+
+        def inv(r, n, t):
+            if not n:
+                return r
+            self.lop32i(t, r, 0xffffffff, 2)
+            return t
+        a, b, c = inv(a, negA, 241), inv(b, negB, 242), inv(c, negC, 243)
+
+        def addc(r):
+            self.emit(self.unguarded(0x5c10000000000000 | (1 << 47) | (r << 20) | (lo << 8) | lo))
+            self.emit(self.unguarded(0x5c10000000000000 | (1 << 43) | (RZ << 20) | (hi << 8) | hi))
+        self.emit(self.unguarded(0x5c10000000000000 | (1 << 47) | (b << 20) | (a << 8) | lo))
+        self.emit(self.unguarded(0x5c10000000000000 | (1 << 43) | (RZ << 20) | (RZ << 8) | hi))
+        addc(c)
+        if ext:
+            for p in (self.bits(87, 4), self.bits(77, 4)):
+                if p == 15:
+                    continue
+                self.mov32i(one, 1)
+                if p != 7:
+                    self.sel(one, one, RZ, p, False)
+                addc(one)
+        elif negA or negB or negC:
+            self.mov32i(one, negA + negB + negC)
+            addc(one)
+        if d != RZ:
+            self.mov(d, lo)
+        guard = self.bits(12, 3)
+        for k in ((1, 0) if guard == c1 else (0, 1)):
+            p = c1 if k == 0 else c2
+            if p == 7:
+                continue
+            self.lop32i(one, hi, 1 if k == 0 else 2, 0)
+            self.emitg(0x5b60000000000000 | (5 << 49) | (PT << 39) | (RZ << 20) | (one << 8) | (p << 3) | PT)
+
+    def imad(self):
+        known = 0xff | 1 << 9 | 1 << 10 | 1 << 11 | 7 << 17 | 0xf << 23 | ((1 << 27) if self.form in (6, 7) else 0)
+        x = self.bit(74)
+        if (self.W2 & ~known) or self.bits(81, 3) != 7 or (not x and self.bits(87, 4) != 15):
+            raise Fail("IMAD mode")
+        a, b, c = self.plain(0, SA), self.plain(1, SB), self.plain(2, SC)
+        if self.bit(75) and c != RZ:
+            if x:
+                self.lop32i(SC, c, 0xffffffff, 2)
+            else:
+                self.iadd3(SC, RZ, c, RZ, False, negB=True)
+            c = SC
+        signed = ((1 << 48) | (1 << 53)) if self.bit(73) else 0
+        d = self.dst
+
+        def imad(dst):
+            return 0x5a00000000000000 | (c << 39) | (b << 20) | (a << 8) | dst | signed
+        if not x:
+            self.emitg(imad(d))
+            return
+        self.mov32i(SX, 1)
+        self.sel(SX, SX, RZ, self.bits(87, 4), False)
+        self.emit(self.unguarded(imad(SA)))
+        self.iadd3(d, SA, SX, RZ, True)
+
+    def lop3(self):
+        if self.bit(80) or self.bits(87, 4) != 15:
+            raise Fail("LOP3 predicate mode")
+        a, b, c = self.plain(0, SA), self.plain(1, SB), self.gpr(self.bits(64, 8))
+        p = self.bits(81, 3)
+        self.emitg(0x5be0000000000000 | (c << 39) | (b << 20) | (a << 8) | self.dst | (self.bits(72, 8) << 28)
+                   | ((0 if p == 7 else 3) << 36) | (p << 48))
+
+    def imnmx(self):
+        a, b = self.plain(0, SA), self.plain(1, SB)
+        self.emitg(0x5c20000000000000 | (b << 20) | (a << 8) | self.dst | (self.bits(87, 3) << 39)
+                   | (self.bits(90, 1) << 42) | (self.bits(73, 1) << 48))
+
+    def shf(self):
+        if self.bits(81, 10):
+            raise Fail("SHF mode")
+        t = self.bits(73, 2)
+        wrap, right, hi = self.bit(75), self.bit(76), self.bit(80)
+        wide, signed = t <= 1, t in (0, 2)
+        low, s, high = self.plain(0, SA), self.plain(1, SB), self.plain(2, SC)
+        d = self.dst
+        ms = 3 if t == 0 else 2 if t == 1 else 0
+        if not right and hi:
+            self.emitg(0x5bf8000000000000 | (high << 39) | (s << 20) | (low << 8) | d | (wrap << 50) | (ms << 37))
+        elif not right:
+            if wrap and wide:
+                raise Fail("SHF.L.W 64")
+            self.emitg(0x5c48000000000000 | (s << 20) | (low << 8) | d | (wrap << 39))
+        elif not hi:
+            self.emitg(0x5cf8000000000000 | (high << 39) | (s << 20) | (low << 8) | d | (wrap << 50) | (ms << 37))
+        else:
+            if wrap and wide:
+                raise Fail("SHF.R.W 64")
+            self.emitg(0x5c28000000000000 | (s << 20) | (high << 8) | d | (wrap << 39) | (signed << 48))
+
+    def lea(self):
+        op = self.bits(0, 12)
+        a, b, d = self.plain(0, SA), self.plain(1, SB), self.dst
+        shift, carry = self.bits(75, 5), self.bits(81, 3)
+        negB = int(op != 0x811 and self.bit(63))
+        if self.bit(72):
+            raise Fail("LEA negated a")
+        if not self.bit(80):
+            if self.bit(74):
+                raise Fail("LEA.X without .HI")
+
+            def iscadd(dst, bb):
+                return 0x5c18000000000000 | (shift << 39) | (bb << 20) | (a << 8) | dst | (negB << 48)
+            if carry == 7:
+                self.emitg(iscadd(d, b))
+                return
+            if negB:
+                raise Fail("LEA carry with negated b")
+            self.mov(SX, b, False)
+            self.emit(self.unguarded(iscadd(SC, SX)))
+            if d != RZ:
+                self.mov(d, SC)
+            self.isetp_ltu(carry, SC, SX)
+            return
+        if carry != 7:
+            raise Fail("LEA.HI carry out")
+        high = self.gpr(self.bits(64, 8))
+        self.mov32i(SX, 32 - shift if high == RZ else shift)
+        if high == RZ:
+            self.emitg(0x5c28000000000000 | (SX << 20) | (a << 8) | SC | (self.bit(73) << 48))
+        else:
+            self.emitg(0x5bf8000000000000 | (high << 39) | (SX << 20) | (a << 8) | SC)
+        if self.bit(74):
+            self.mov32i(SX, 1)
+            self.sel(SX, SX, RZ, self.bits(87, 4), False)
+            self.iadd3(SC, SC, SX, RZ, True)
+        self.iadd3(d, SC, b, RZ, True, bool(negB))
+
+    def f2i(self):
+        op = self.bits(0, 12)
+        known = 1 << 8 | 3 << 11 | 1 << 13 | 3 << 14 | 1 << 16 | 3 << 20
+        w2 = self.W2 & ~(0x08000000 if op == 0xd05 else 0)
+        dsz, ssz = self.bits(75, 2), self.bits(84, 2)
+        if (w2 & ~known) or dsz > 2 or ssz not in (1, 2) or (ssz == 1 and self.bits(60, 2)):
+            raise Fail("F2I format")
+        if op == 0x905:
+            self.mov32i(SB, self.W1)
+            b, ab, nb = SB, 0, 0
+        else:
+            b, ab, nb = self.raw(1, SB)
+        fmt = dsz | (4 if self.bit(72) else 0)
+        self.emitg(0x5cb0000000000000 | (b << 20) | self.dst | ((fmt & 3) << 8) | ((fmt >> 2) << 12) | (ssz << 10)
+                   | (self.bits(78, 2) << 39) | (self.bits(80, 1) << 44) | (nb << 45) | (ab << 49))
+
+    def i2f(self):
+        op = self.bits(0, 12)
+        known = 1 << 10 | 3 << 11 | 3 << 14 | 3 << 20
+        w2 = self.W2 & ~(0x08000000 if op == 0xd06 else 0)
+        src, dst, sel = self.bits(84, 2), self.bits(75, 2), self.bits(60, 2)
+        if (w2 & ~known) or src == 3 or dst == 0 or (op != 0xb06 and (self.W1 & 0xcfffff00)):
+            raise Fail("I2F format")
+        b = self.plain(1, SB) if op == 0xb06 else self.ur(self.bits(32, 8)) if op == 0xd06 else self.gpr(self.bits(32, 8))
+        bytesel = sel if src == 0 else sel * 2 if src == 1 else 0
+        self.emitg(0x5cb8000000000000 | (dst << 8) | (src << 10) | (self.bits(74, 1) << (12 if "i2f-bit12" in self.bugs else 13))
+                   | (b << 20) | (bytesel << 41) | (self.bits(78, 2) << 39) | self.dst)
+
+    def prmt(self):
+        if self.bits(72, 4) or self.bits(76, 15):
+            raise Fail("PRMT mode")
+        a, s, c = self.plain(0, SA), self.plain(1, SB), self.plain(2, SC)
+        self.emitg(0x5bc0000000000000 | (c << 39) | (s << 20) | (a << 8) | self.dst)
+
+    def popc(self):
+        if self.W2 & ~0x08000000:
+            raise Fail("POPC mode")
+        b, _, inv = self.raw(1, SB)
+        self.emitg(0x5c08000000000000 | (b << 20) | (inv << 40) | self.dst)
+
+    def flo(self):
+        if (self.W2 & ~(0x600 | 0x08000000)) != 0x000e0000:
+            raise Fail("FLO mode")
+        b, _, inv = self.raw(1, SB)
+        self.emitg(0x5c30000000000000 | (b << 20) | (inv << 40) | (self.bits(74, 1) << 41) | (self.bits(73, 1) << 48)
+                   | self.dst)
+
+    def f2fp(self):
+        if (self.bits(62, 2) or self.bits(73, 5) or self.bits(79, 2) or self.bits(81, 10) or self.bit(91)
+                or self.bit(72)):
+            raise Fail("F2FP mode")
+        merge = self.bit(78)
+        a = self.plain(2, SC) if merge else self.plain(0, SA)
+        b = self.plain(1, SB)
+        if merge:
+            self.mov(247, a, False)
+        else:
+            self.emit(self.unguarded(0x5ca8000000000000 | (1 << 8) | (2 << 10) | (a << 20) | 247))
+        self.emit(self.unguarded(0x5ca8000000000000 | (1 << 8) | (2 << 10) | (b << 20) | 246))
+        self.emitg(0x5c18000000000000 | (16 << 39) | (246 << 20) | (247 << 8) | self.dst)
+
+    def mov_(self):
+        op = self.bits(0, 12)
+        if self.bits(72, 4) != 15:
+            raise Fail("MOV lane mask")
+        d = self.dst
+        if op == 0x802:
+            self.mov32i(d, self.W1, True)
+        elif op == 0x202:
+            self.mov(d, self.gpr(self.bits(32, 8)))
+        elif op == 0xc02:
+            self.mov(d, self.ur(self.bits(32, 8)))
+        else:
+            bank, off = self.cbuf()
+            self.movc(d, bank, off, True)
+
+    def imad_wide(self):
+        op = self.bits(0, 12)
+        wide, signed = op in (0x225, 0x625, 0x825), self.bit(73)
+        if (self.W2 & ~0x000e02ff) != 0x07800000 or self.bits(81, 3) != 7:
+            raise Fail("IMAD.HI/WIDE mode")
+        a = self.gpr(self.bits(24, 8))
+        if op in (0x825, 0x827):
+            self.mov32i(SB, self.W1)
+            b = SB
+        elif op == 0xa27:
+            bank, off = self.cbuf()
+            self.movc(SB, bank, off)
+            b = SB
+        else:
+            b = self.gpr(self.bits(64 if op == 0x625 else 32, 8))
+        if op == 0x625:
+            bank, off = self.cbuf()
+            self.movc(SC, bank, off)
+            self.movc(SX, bank, off + 4)
+            clo, chi = SC, SX
+        else:
+            c = self.gpr(self.bits(64, 8))
+            if c != RZ and c & 1:
+                raise Fail("odd addend pair")
+            clo, chi = c, (RZ if c == RZ else c + 1)
+        d = self.dst
+        if wide and (d == RZ or d & 1):
+            raise Fail("destination pair")
+        sign = ((1 << 40) | (1 << 41)) if signed else 0
+        self.emit(self.unguarded(0x5c38000000000000 | (b << 20) | (a << 8) | 247 | sign))
+        self.emit(self.unguarded(0x5c38000000000000 | (1 << 39) | (b << 20) | (a << 8) | 248 | sign))
+        self.emit(self.unguarded(0x5c10000000000000 | (1 << 47) | (clo << 20) | (247 << 8) | 247))
+        self.emit(self.unguarded(0x5c10000000000000 | (1 << 43) | (chi << 20) | (248 << 8) | 248))
+        if wide:
+            self.mov(d, 247)
+            self.mov(d + 1, 248)
+        else:
+            self.mov(d, 248)
+
+    def iabs(self):
+        op = self.bits(0, 12)
+        if self.W2 & ~(0x08000000 if op == 0xc13 else 0):
+            raise Fail("IABS mode")
+        b = self.plain(1, SB)
+        self.iadd3(SX, RZ, b, RZ, False, negB=True)
+        self.emitg(0x5c20000000000000 | (SX << 20) | (b << 8) | self.dst | (15 << 39) | (1 << 48))
+
+    def sgxt(self):
+        if (self.W2 & ~0x200) or self.W1 > 32:
+            raise Fail("SGXT mode")
+        self.emitg(0x3800000000000000 | ((self.W1 << 8) << 20) | (self.bits(73, 1) << 48)
+                   | (self.gpr(self.bits(24, 8)) << 8) | self.dst)
+
+    def brev(self):
+        if self.W2 or self.W1 > 255:
+            raise Fail("BREV mode")
+        self.emitg(0x3828000000000000 | (self.gpr(self.bits(32, 8)) << 8) | (1 << 39) | (1 << 40) | self.dst)
+
+    def mufu(self):
+        op = self.bits(0, 12)
+        operation = self.bits(74, 6)
+        if operation > 8 or operation in (6, 7) or self.bit(73):
+            raise Fail("MUFU operation")
+        if op == 0x908:
+            self.mov32i(SB, self.W1)
+            src, ab, ng = SB, 0, 0
+        else:
+            src, ab, ng = self.raw(1, SB)
+        if operation <= 1:
+            src = self.mat(src, ab, ng, SB)
+            self.fmul32i(SB, src, 0x40c90fdb)
+            src, ab, ng = SB, 0, 0
+        self.emitg(0x5080000000000000 | (operation << 20) | (src << 8) | self.dst | (ab << 46) | (ng << 48))
+
+    def setp_extended(self):
+        cmp, combine, low = self.bits(76, 3), self.bits(74, 2), self.bits(68, 4)
+        if cmp in (0, 7) or combine == 3:
+            raise Fail("ISETP.EX mode")
+        a = self.raw(0, SA)[0]
+        b = self.raw(1, SB)[0]
+        t = 6
+        while t >= 0 and t in (low & 7, self.bits(87, 3), self.bits(12, 3), self.bits(81, 3), self.bits(84, 3)):
+            t -= 1
+        if t < 0:
+            raise Fail("no scratch predicate")
+        self.emit(self.unguarded(0x38e8000000000000 | (1 << (20 + t)) | (RZ << 8) | SX))
+
+        def isetp(c, inp, bop, sg):
+            return (0x5b60000000000000 | (t << 3) | PT | (a << 8) | (b << 20) | ((inp & 7) << 39) | ((inp >> 3) << 42)
+                    | (bop << 45) | ((1 << 48) if sg else 0) | (c << 49))
+        sg = self.bit(73)
+        And, Or, Lt, Eq, Gt, Ne = 0, 1, 1, 2, 4, 5
+        if cmp == Eq:
+            self.emitg(isetp(Eq, low, And, sg))
+        elif cmp == Ne:
+            self.emitg(isetp(Ne, low, Or, sg))
+        else:
+            self.emitg(isetp(Eq, low, And, sg))
+            self.emitg(isetp(Lt if cmp <= 3 else Gt, t, Or, sg))
+        self.emitg(0x5090000000000000 | self.bits(84, 3) | (self.bits(81, 3) << 3) | (t << 12) | (PT << 29)
+                   | (self.bits(87, 3) << 39) | (self.bits(90, 1) << 42) | (combine << 45))
+        self.emit(self.unguarded(0x38f0000000000000 | (1 << (20 + t)) | (SX << 8)))
+
+    def plop3(self):
+        lut = self.bits(64, 3) | self.bits(72, 5) << 3
+        t1, t2, lut2 = self.bits(81, 3), self.bits(84, 3), self.bits(16, 8)
+        ones, ra, rb, rc, r1, r2 = 240, 241, 242, 243, 244, 245
+        self.mov32i(ones, 0xffffffff)
+        self.sel(ra, ones, RZ, self.bits(87, 4), False)
+        self.sel(rb, ones, RZ, self.bits(77, 4), False)
+        c = self.bits(68, 4)
+        if self.bit(67) and not self.uniform:
+            if (c & 7) == 7:
+                self.mov(rc, ones, False)
+            else:
+                self.emit(self.unguarded(0x3828000000000000 | ((c & 7) << 20) | (RUP << 8) | rc))
+                self.lop32i(rc, rc, 1, 0)
+                self.iadd3(rc, RZ, rc, RZ, False, negB=True)
+            if c & 8:
+                self.lop32i(rc, rc, 0xffffffff, 2)
+        else:
+            self.sel(rc, ones, RZ, c, False)
+
+        def lop3(dst, table):
+            return self.unguarded(0x5be0000000000000 | (rc << 39) | (rb << 20) | (ra << 8) | dst | (table << 28) | (7 << 48))
+        self.emit(lop3(r1, lut))
+        if t2 != 7:
+            self.emit(lop3(r2, lut2))
+
+        def ne(p, r):
+            return 0x5b60000000000000 | (5 << 49) | (PT << 39) | (RZ << 20) | (r << 8) | (p << 3) | PT
+        if t1 != 7:
+            self.emitg(ne(t1, r1))
+        if t2 != 7:
+            self.emitg(ne(t2, r2))
+
+    def predicate_register(self, to_reg):
+        if self.W1 > 0x7f or (self.W2 & ~0x3000) or (not to_reg and self.bits(16, 8)):
+            raise Fail("P2R/R2P mode")
+        w = ((0x38e8000000000000 | self.dst) if to_reg else 0x38f0000000000000) \
+            | (self.gpr(self.bits(24, 8)) << 8) | (self.W1 << 20) | (self.bits(76, 2) << 41)
+        self.emitg(w)
+
+    def umov(self):
+        op = self.bits(0, 12)
+        d = self.ur(self.bits(16, 8))
+        if d == RZ:
+            return
+        if op == 0x882:
+            self.mov32i(d, self.W1, True)
+        else:
+            self.emitg(0x5c98000000000000 | (15 << 39) | (self.ur(self.bits(32, 8)) << 20) | d)
+
+    def uldc(self):
+        width = self.bits(73, 3)
+        d = self.ur(self.bits(16, 8))
+        if width < 4:
+            cb, at = self.bits(54, 5), self.bits(38, 16)
+            cb = 17 if cb == 24 else cb
+            if cb >= 18 or at >= 0x8000:
+                raise Fail("ULDC narrow")
+            if d != RZ:
+                self.emitg(0xef90000000000000 | (RZ << 8) | (at << 20) | (cb << 36) | (width << 48) | d)
+            return
+        bank, off = self.cbuf()
+        if width == 4:
+            if d != RZ:
+                self.movc(d, bank, off, True)
+            return
+        if width == 5 and (self.bits(16, 8) & 1) == 0:
+            if d != RZ:
+                self.movc(d, bank, off, True)
+                self.movc(d + 1, bank, off + 4, True)
+            return
+        raise Fail("ULDC width")
+
+    def uniform_predicates(self):
+        op = self.bits(0, 12)
+        if not ((0x080 <= (op & 0x1ff) <= 0x0bf and op != 0x886) or op == 0x9c3):
+            return 0, 0
+        inp = out = 0
+
+        def use(mask, p):
+            return mask | (1 << (p & 7)) if (p & 7) != 7 else mask
+        inp = use(inp, self.bits(12, 3))
+        b = op & 0x1ff
+        if b == 0x08c:
+            out = use(use(out, self.bits(81, 3)), self.bits(84, 3))
+            inp = use(inp, self.bits(87, 3))
+        elif b == 0x09c:
+            out = use(use(out, self.bits(81, 3)), self.bits(84, 3))
+            inp = use(use(use(inp, self.bits(87, 3)), self.bits(77, 3)), self.bits(68, 3))
+        elif b == 0x090:
+            out = use(use(out, self.bits(81, 3)), self.bits(84, 3))
+            if self.bit(74):
+                inp = use(use(inp, self.bits(87, 3)), self.bits(77, 3))
+        elif b == 0x092:
+            out = use(out, self.bits(81, 3))
+            inp = use(inp, self.bits(87, 3))
+        elif b == 0x087:
+            inp = use(inp, self.bits(87, 3))
+        elif b in (0x091, 0x0a4, 0x0a5):
+            out = use(out, self.bits(81, 3))
+            if self.bit(74):
+                inp = use(inp, self.bits(87, 3))
+        return inp, out
+
+    def lower_one(self):
+        op = self.bits(0, 12)
+        if op in (0x882, 0xc82):
+            return self.umov()
+        if op == 0xab9:
+            return self.uldc()
+        if op in (0x290, 0x890, 0xa90, 0x2a4, 0x4a4, 0x8a4, 0xaa4, 0x2a5, 0x8a5, 0x292, 0x892, 0xa92, 0x299, 0x499,
+                  0x899, 0x291, 0x891, 0x287, 0x887, 0x28c, 0x88c, 0xa8c, 0x89c, 0x296, 0x896):
+            twin = (op & 0x1ff) - 0x80
+            saved = self.w
+            self.w = (self.w & ~0x1ff) | twin
+            self.w &= ~(1 << 91)
+            self.uniform = True
+            try:
+                return self.lower_one()
+            finally:
+                self.uniform = False
+                self.w = saved
+        table = {
+            (0x225, 0x227, 0x625, 0x825, 0x827, 0xa27): self.imad_wide,
+            (0x213, 0xa13, 0xc13): self.iabs,
+            (0x81a,): self.sgxt,
+            (0x301,): self.brev,
+            (0x308, 0x908, 0xb08, 0xd08): self.mufu,
+            (0x81c,): self.plop3,
+            (0x803,): lambda: self.predicate_register(True),
+            (0x804,): lambda: self.predicate_register(False),
+        }
+        for ops, fn in table.items():
+            if op in ops:
+                return fn()
+        if op in (0x20c, 0x40c, 0x60c, 0x80c, 0xa0c, 0xc0c) and self.bit(72):
+            return self.setp_extended()
+        return self.lower_basic(op)
+
+    def run(self):
+        self.mov32i(RUP, 0)
+        if self.bits(12, 4) == 15:
+            return self.out
+        inp, out = self.uniform_predicates()
+        m = inp | out
+        if m:
+            self.emit(self.unguarded(0x38e8000000000000 | (m << 20) | (RZ << 8) | 237))
+            self.emit(self.unguarded(0x38f0000000000000 | (m << 20) | (RUP << 8)))
+        self.lower_one()
+        if m:
+            if out:
+                self.emit(self.unguarded(0x38e8000000000000 | (out << 20) | (RUP << 8) | RUP))
+            self.emit(self.unguarded(0x38f0000000000000 | (m << 20) | (237 << 8)))
+        return self.out
+
+    def lower_basic(self, op):
+        table = {
+            (0x221, 0x421, 0x621, 0x821, 0xa21, 0xc21, 0xe21): self.fadd,
+            (0x220, 0x420, 0x620, 0x820, 0xa20, 0xc20): self.fmul,
+            (0x223, 0x423, 0x623, 0x823, 0xa23, 0xc23, 0xe23): self.ffma,
+            (0x209, 0x409, 0x609, 0x809, 0xa09, 0xc09): self.fmnmx,
+            (0x307, 0xb07): self.frnd,
+            (0x20b, 0x40b, 0x60b, 0x80b, 0xa0b, 0xc0b): lambda: self.setp(True),
+            (0x20c, 0x40c, 0x60c, 0x80c, 0xa0c, 0xc0c): lambda: self.setp(False),
+            (0x20a, 0x40a, 0x60a, 0x80a, 0xa0a, 0xc0a): self.fset,
+            (0x207, 0x807, 0xa07, 0xc07): lambda: self.sel_(False),
+            (0x208, 0x808, 0xa08, 0xc08): lambda: self.sel_(True),
+            (0x245, 0x845, 0xa45, 0xc45): self.i2fp,
+            (0x210, 0x410, 0x610, 0x810, 0xa10, 0xc10): self.iadd3_,
+            (0x224, 0x424, 0x624, 0x824, 0xa24, 0xc24, 0xe24): self.imad,
+            (0x212, 0x812, 0xa12, 0xc12): self.lop3,
+            (0x217, 0x817, 0xa17, 0xc17): self.imnmx,
+            (0x219, 0x419, 0x619, 0x819, 0xa19, 0xc19): self.shf,
+            (0x211, 0x811, 0xa11, 0xc11): self.lea,
+            (0x305, 0x905, 0xb05, 0xd05): self.f2i,
+            (0x306, 0xb06, 0xd06): self.i2f,
+            (0x216, 0x416, 0x616, 0x816, 0xa16, 0xc16): self.prmt,
+            (0x309, 0xd09): self.popc,
+            (0x300, 0xd00): self.flo,
+            (0x23e, 0x43e, 0x83e, 0xa3e, 0xc3e): self.f2fp,
+            (0x202, 0x802, 0xa02, 0xc02): self.mov_,
+        }
+        for ops, fn in table.items():
+            if op in ops:
+                return fn()
+        raise Fail(f"op {op:03x} not transcribed")
+
+
+def lower(w, bugs=()):
+    lw = Lowerer(w, bugs)
+    return lw.run(), lw.urbase
