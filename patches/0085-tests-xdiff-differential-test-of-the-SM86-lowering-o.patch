+        insns = [w for _, w in families(rng) if rng.random() < 0.3]
+        code = b"".join(w.to_bytes(16, "little") for w in insns)
+        control = bytearray(census.CONTROL_SIZE)
+        struct.pack_into("<I", control, 0, census.NVN2_MAGIC)
+        struct.pack_into("<I", control, 0x38, len(code))
+        answers = bytes(16)
+        data = struct.pack("<6I", census.IN_MAGIC, 1, 5, len(code), 0, len(answers)) + answers + bytes(control) + code
