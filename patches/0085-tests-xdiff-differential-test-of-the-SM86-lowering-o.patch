+"""Reference semantics of the Maxwell instructions AmpereLowering.cs emits for the ALU, conversion and move
+families, for one thread, with fields decoded by the translator's own decoder (isa.py).
+
+This follows what each instruction means on Maxwell hardware, which is what the lowering relies on. Where the shader
+translator's emitter deviates (FTZ/FMZ ignored, F2I out-of-range values undefined in SPIR-V, ...) that is a translator
+question for the SPIR-V stage, not for this one. An encoding the translator reads as an undefined format (an F2I
+destination format outside IDstFmt, say) raises Undefined: the lowering produced something the translator cannot
+mean, which the driver reports as a mismatch."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+
+import fp
+from fp import M32, s32
+from isa import decode
+from state import RZ, PT, Unsupported
+
+
+class Undefined(Exception):
+    """The translator decodes the word to a format or mode with no defined meaning."""
+
+
+IDST = {1: (16, False), 2: (32, False), 5: (16, True), 6: (32, True)}          # IDstFmt U16 U32 S16 S32
+ISRC = {0: (8, False), 1: (16, False), 2: (32, False), 4: (8, True), 5: (16, True), 6: (32, True)}
+FFMT = {1: fp.F16, 2: fp.F32, 3: fp.F64}
+
+
+def run(words, st, limit=4096):
+    """Executes Maxwell words in order (no branches) until EXIT or the end."""
+    for n, w in enumerate(words):
+        if n >= limit:
+            raise Unsupported("too many lowered instructions")
+        insn = decode(w)
+        if insn is None:
+            raise Undefined(f"{w:016x} matches no translator table entry")
+        if insn.name == "Exit":
+            if insn.f.get("Pred", 7) == 7 and not insn.f.get("PredInv"):
+                return
+            raise Unsupported("predicated EXIT")
+        f = insn.f
+        if "Pred" in f:
+            g = st.P(f["Pred"]) != f.get("PredInv", False)
+            if not g:
+                continue
+        fn = OPS.get(insn.emitter)
+        if fn is None:
+            raise Unsupported(f"Maxwell {insn.emitter} not modelled")
+        fn(st, f)
+
+
+def _dst(st, f, v):
+    st.setR(f["Dest"], v)
+
+
+def _fneg_abs(v, a, n):
+    return fp.neg(fp.fabs(v, a), n)
+
+
+def _fmz(f):
+    return f.get("Fmz", 0) in (1, 2) or f.get("Ftz", False)
+
+
+def mov32i(st, f):
+    _dst(st, f, f["Imm32"])
+
+
+def movr(st, f):
+    _dst(st, f, st.R(f["SrcA"]))
+
+
+def movc(st, f):
+    _dst(st, f, st.cbuf(f["CbufSlot"], f["CbufOffset"] * 4))
+
+
+def lop32i(st, f):
+    a = st.R(f["SrcA"]) ^ (M32 if f["NegA"] else 0)
+    b = (f["Imm32"] & M32) ^ (M32 if f["NegB"] else 0)
+    if f["X"] or f["WriteCC"]:
+        raise Unsupported("LOP32I.X/CC")
+    _dst(st, f, [a & b, a | b, a ^ b, b][f["LogicOp"]])
+
+
+def fmul32i(st, f):
+    fz = _fmz(f)
+    r = fp.fmul(st.R(f["SrcA"]), f["Imm32"] & M32, fp.RN, fz)
+    _dst(st, f, fp.sat(r) if f["Sat"] else r)
+
+
+def iadd3r(st, f):
+    if f["X"] or f["WriteCC"] or f["Lrs"] or f["Apart"] or f["Bpart"] or f["Cpart"]:
+        raise Unsupported("IADD3 X/CC/parts")
+    v = [st.R(f[k]) for k in ("SrcA", "SrcB", "SrcC")]
+    neg = [f["NegA"], f["NegB"], f["NegC"]]
+    _dst(st, f, sum(-x if n else x for x, n in zip(v, neg)))
+
+
+def iaddr(st, f):
+    a, b = st.R(f["SrcA"]), st.R(f["SrcB"])
+    avg = f["AvgMode"]
+    if f["Sat"] or avg == 3:
+        raise Unsupported("IADD sat/plus one")
+    if avg == 2:
+        a = (~a + 1) & M32 if not f["X"] else ~a & M32
+    if avg == 1:
+        b = (~b + 1) & M32 if not f["X"] else ~b & M32
+    s = a + b + (st.cc if f["X"] else 0)
+    if f["WriteCC"]:
+        st.cc = s >> 32 & 1
+    _dst(st, f, s)
+
+
+def iscaddr(st, f):
+    a, b = st.R(f["SrcA"]), st.R(f["SrcB"])
+    a = (a << f["Imm5"]) & M32
+    avg = f["AvgMode"]
+    if avg == 3 or f["WriteCC"]:
+        raise Unsupported("ISCADD mode")
+    if avg == 2:
+        a = -a
+    if avg == 1:
+        b = -b
+    _dst(st, f, a + b)
+
+
+def _setp_out(st, f, r):
+    pc = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    bop = f["Bop"]
+    if bop == 3:
+        raise Undefined("BoolOp 3")
+    st.setP(f["DestPred"], fp.boolop(bop, r, pc))
+    st.setP(f["DestPredInv"], fp.boolop(bop, not r, pc))
+
+
+def isetpr(st, f):
+    if f["X"]:
+        raise Unsupported("ISETP.X")
+    _setp_out(st, f, fp.icomp(f["IComp"], st.R(f["SrcA"]), st.R(f["SrcB"]), f["Signed"]))
+
+
+def fsetpr(st, f):
+    fz = f["Ftz"]
+    a = fp.ftz(_fneg_abs(st.R(f["SrcA"]), f["AbsA"], f["NegA"]), fz)
+    b = fp.ftz(_fneg_abs(st.R(f["SrcB"]), f["AbsB"], f["NegB"]), fz)
+    _setp_out(st, f, fp.fcomp(f["FComp"], a, b))
+
+
+def fsetr(st, f):
+    fz = f["Ftz"]
+    a = fp.ftz(_fneg_abs(st.R(f["SrcA"]), f["AbsA"], f["NegA"]), fz)
+    b = fp.ftz(_fneg_abs(st.R(f["SrcB"]), f["AbsB"], f["NegB"]), fz)
+    pc = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    r = fp.boolop(f["Bop"], fp.fcomp(f["FComp"], a, b), pc)
+    _dst(st, f, (0x3F800000 if f["BVal"] else M32) if r else 0)
+
+
+def selr(st, f):
+    p = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    _dst(st, f, st.R(f["SrcA"]) if p else st.R(f["SrcB"]))
+
+
+def psetp(st, f):
+    a = st.P(f["Src1Pred"]) != f["Src1PredInv"]
+    b = st.P(f["Src2Pred"]) != f["Src2PredInv"]
+    c = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    ab = fp.boolop(f["BoolOpAB"], a, b)
+    st.setP(f["DestPred"], fp.boolop(f["BoolOpC"], ab, c))
+    st.setP(f["DestPredInv"], fp.boolop(f["BoolOpC"], not ab, c))
+
+
+def i2fr(st, f):
+    if f["ISrcFmt"] not in ISRC:
+        raise Undefined(f"I2F ISrcFmt {f['ISrcFmt']}")
+    if f["DstFmt"] not in FFMT:
+        raise Undefined(f"I2F DstFmt {f['DstFmt']}")
+    size, signed = ISRC[f["ISrcFmt"]]
+    b = st.R(f["SrcB"])
+    if size < 32:
+        b = b >> (8 * f["ByteSel"]) & ((1 << size) - 1)
+        if signed and b >> (size - 1):
+            b -= 1 << size
+    if f["AbsB"]:
+        b = abs(s32(b))
+    if f["NegB"]:
+        b = -s32(b) if signed else -b
+    b &= M32
+    r = fp.i2f(b, signed, f["RoundMode"], FFMT[f["DstFmt"]])
+    if f["DstFmt"] == 3:
+        st.setR(f["Dest"], r & M32)
+        if f["Dest"] != RZ:
+            st.setR(f["Dest"] + 1, r >> 32)
+    else:
+        _dst(st, f, r)
+
+
+def f2ir(st, f):
+    if f["IDstFmt"] not in IDST:
+        raise Undefined(f"F2I IDstFmt {f['IDstFmt']} (no such Maxwell destination format)")
+    if f["SrcFmt"] not in (1, 2):
+        raise Unsupported("F2I source format")
+    bits, signed = IDST[f["IDstFmt"]]
+    src = FFMT[f["SrcFmt"]]
+    b = st.R(f["SrcB"])
+    if src is fp.F16:
+        b &= 0xFFFF
+        b = fp.f16_to_f32(b)
+    b = _fneg_abs(b, f["AbsB"], f["NegB"])
+    _dst(st, f, fp.f2i(b, f["RoundMode"], bits, signed, f["Ftz"]))
+
+
+def f2fr(st, f):
+    if f["SrcFmt"] not in FFMT or f["DstFmt"] not in FFMT:
+        raise Undefined("F2F format")
+    if f["SrcFmt"] == 3 or f["DstFmt"] == 3:
+        raise Unsupported("F2F.F64")
+    b = st.R(f["SrcB"])
+    if f["SrcFmt"] == 1:
+        b = fp.f16_to_f32(b & 0xFFFF)
+    b = fp.ftz(_fneg_abs(b, f["AbsB"], f["NegB"]), f["Ftz"])
+    rnd = f["RoundMode"]
+    if rnd >= 4:
+        if f["SrcFmt"] != f["DstFmt"]:
+            raise Unsupported("F2F integer rounding across formats")
+        b = fp.frnd(b, rnd - 4)
+        rnd = fp.RN
+    if f["Sat"]:
+        b = fp.sat(b)
+    if f["DstFmt"] == 1:
+        _dst(st, f, fp.f32_to_f16(b, rnd & 3))
+    else:
+        _dst(st, f, b)
+
+
+def faddr(st, f):
+    a = _fneg_abs(st.R(f["SrcA"]), f["AbsA"], f["NegA"])
+    b = _fneg_abs(st.R(f["SrcB"]), f["AbsB"], f["NegB"])
+    r = fp.fadd(a, b, f["RoundMode"], f["Ftz"])
+    _dst(st, f, fp.sat(r) if f["Sat"] else r)
+
+
+SCALE = {0: 0, 1: -1, 2: -2, 3: -3, 4: 3, 5: 2, 6: 1}
+
+
+def fmulr(st, f):
+    fz = _fmz(f)
+    if f["Scale"] not in SCALE:
+        raise Undefined("FMUL scale 7")
+    a, b = st.R(f["SrcA"]), st.R(f["SrcB"])
+    a = fp.neg(a, f["NegA"])
+    r = fp.fmul(a, b, f["RoundMode"], fz)
+    sc = SCALE[f["Scale"]]
+    if sc:
+        va, vb = fp.value(fp.ftz(a, fz)), fp.value(fp.ftz(b, fz))
+        if not isinstance(va, (tuple, str)) and not isinstance(vb, (tuple, str)) and va * vb != 0:
+            r = fp.ftz(fp.pack(va * vb * Fraction(2) ** sc, f["RoundMode"]), fz)
+    _dst(st, f, fp.sat(r) if f["Sat"] else r)
+
+
+def ffmar(st, f):
+    a = fp.neg(st.R(f["SrcA"]), f["NegA"])
+    c = fp.neg(st.R(f["SrcC"]), f["NegC"])
+    r = fp.ffma(a, st.R(f["SrcB"]), c, f["RoundMode"], _fmz(f))
+    _dst(st, f, fp.sat(r) if f["Sat"] else r)
+
+
+def fmnmxr(st, f):
+    fz = f["Ftz"]
+    a = fp.ftz(_fneg_abs(st.R(f["SrcA"]), f["AbsA"], f["NegA"]), fz)
+    b = fp.ftz(_fneg_abs(st.R(f["SrcB"]), f["AbsB"], f["NegB"]), fz)
+    p = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    _dst(st, f, fp.fmin(a, b) if p else fp.fmax(a, b))
+
+
+def mufu(st, f):
+    op = f["MufuOp"]
+    a = _fneg_abs(st.R(f["SrcA"]), f.get("AbsA", False), f.get("NegA", False))
+    if op not in (0, 1, 2, 3, 4, 5, 8):
+        raise Unsupported(f"MUFU {op}")
+    r = fp.mufu(op, a)
+    try:
+        bits = fp.f2bits(r)
+    except OverflowError:
+        bits = 0x7F800000 if r > 0 else 0xFF800000
+    _dst(st, f, fp.sat(bits) if f.get("Sat") else bits)
+
+
+def imnmxr(st, f):
+    if f["XMode"]:
+        raise Unsupported("IMNMX XMode")
+    a, b = st.R(f["SrcA"]), st.R(f["SrcB"])
+    ka, kb = (s32(a), s32(b)) if f["Signed"] else (a, b)
+    p = st.P(f["SrcPred"]) != f["SrcPredInv"]
+    _dst(st, f, (a if ka <= kb else b) if p else (a if ka >= kb else b))
+
+
+def imadr(st, f):
+    if f["Hilo"] or f["Sat"] or f["AvgMode"] or f["WriteCC"]:
+        raise Unsupported("IMAD mode")
+    a, b, c = st.R(f["SrcA"]), st.R(f["SrcB"]), st.R(f["SrcC"])
+    _dst(st, f, a * b + c + (st.cc if f["X"] else 0))
+
+
+def imulr(st, f):
+    a, b = st.R(f["SrcA"]), st.R(f["SrcB"])
+    if f["ASigned"]:
+        a = s32(a)
+    if f["BSigned"]:
+        b = s32(b)
+    p = a * b
+    _dst(st, f, (p >> 32) if f["Hilo"] else p)
+
+
+def lop3r(st, f):
+    if f["X"] or f["WriteCC"]:
+        raise Unsupported("LOP3.X")
+    a, b, c = st.R(f["SrcA"]), st.R(f["SrcB"]), st.R(f["SrcC"])
+    lut = f["Imm"]
+    r = 0
+    for k in range(8):
+        if lut >> k & 1:
+            r |= ~((a ^ (M32 if k & 4 else 0)) | (b ^ (M32 if k & 2 else 0)) | (c ^ (M32 if k & 1 else 0))) & M32
+    _dst(st, f, r)
+    pop = f["PredicateOp"]
+    st.setP(f["DestPred"], [False, True, r == 0, r != 0][pop])
+
+
+def _shf(st, f, left):
+    if f["XModeShf"] or f["WriteCC"]:
+        raise Unsupported("SHF XMode")
+    lo, s, hi = st.R(f["SrcA"]), st.R(f["SrcB"]), st.R(f["SrcC"])
+    ms = f["MaxShift"]
+    width = 64 if ms in (2, 3) else 32
+    s = s & (width - 1) if f["M"] else min(s, width)
+    v = hi << 32 | lo
+    if left:
+        r = (v << s) >> 32
+    else:
+        if ms == 3 and hi & 0x80000000:
+            v -= 1 << 64
+        r = v >> s
+    _dst(st, f, r & M32)
+
+
+def _shl(st, f, b):
+    if f["X"] or f["WriteCC"]:
+        raise Unsupported("SHL.X")
+    s = b & 31 if f["M"] else b
+    _dst(st, f, (st.R(f["SrcA"]) << s) & M32 if s < 32 else 0)
+
+
+def _shr(st, f, b):
+    if f["XMode"] or f["WriteCC"]:
+        raise Unsupported("SHR.X")
+    a = st.R(f["SrcA"])
+    if f["Brev"]:
+        a = int(f"{a:032b}"[::-1], 2)
+    s = b & 31 if f["M"] else min(b, 32)
+    v = s32(a) if f["Signed"] else a
+    _dst(st, f, (v >> s) & M32)
+
+
+def prmtr(st, f):
+    if f["PMode"]:
+        raise Unsupported("PRMT mode")
+    a, sel, c = st.R(f["SrcA"]), st.R(f["SrcB"]), st.R(f["SrcC"])
+    src = c << 32 | a
+    r = 0
+    for k in range(4):
+        n = sel >> (4 * k) & 15
+        byte = src >> (8 * (n & 7)) & 0xFF
+        if n & 8:
+            byte = 0xFF if byte & 0x80 else 0
+        r |= byte << (8 * k)
+    _dst(st, f, r)
+
+
+def flor(st, f):
+    b = st.R(f["SrcB"]) ^ (M32 if f["NegB"] else 0)
+    if f["Signed"] and b & 0x80000000:
+        b = ~b & M32
+    if b == 0:
+        r = M32
+    else:
+        r = b.bit_length() - 1
+        if f["Sh"]:
+            r = 31 - r
+    _dst(st, f, r)
+
+
+def popcr(st, f):
+    _dst(st, f, bin(st.R(f["SrcB"]) ^ (M32 if f["NegB"] else 0)).count("1"))
+
+
+def p2ri(st, f):
+    if f["Ccpr"]:
+        raise Unsupported("P2R CC")
+    sh = 8 * f["ByteSel"]
+    mask = (f["Imm20"] & 0xFF) << sh
+    preds = sum(int(st.P(k)) << k for k in range(7)) << sh
+    _dst(st, f, (st.R(f["SrcA"]) & ~mask) | (preds & mask))
+
+
+def r2pi(st, f):
+    if f["Ccpr"]:
+        raise Unsupported("R2P CC")
+    sh = 8 * f["ByteSel"]
+    v = st.R(f["SrcA"]) >> sh
+    mask = f["Imm20"] & 0xFF
+    for k in range(7):
+        if mask >> k & 1:
+            st.setP(k, v >> k & 1)
+
+
+def bfei(st, f):
+    if f["Brev"] or f["WriteCC"]:
+        raise Unsupported("BFE.BREV")
+    pos, length = f["Imm20"] & 0xFF, f["Imm20"] >> 8 & 0xFF
+    a = st.R(f["SrcA"])
+    if length == 0 or pos >= 32:
+        r = 0 if not (f["Signed"] and pos >= 32 and a & 0x80000000) else M32
+    else:
+        top = min(pos + length, 32)
+        v = (a >> pos) & ((1 << (top - pos)) - 1)
+        if f["Signed"] and v >> (top - pos - 1) & 1:
+            v -= 1 << (top - pos)
+        r = v
+    _dst(st, f, r)
+
+
+def ldc(st, f):
+    if f["AddressMode"] or f["SrcA"] != RZ:
+        raise Unsupported("LDC with an index")
+    size = f["LsSize"]
+    nbytes = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 8}.get(size)
+    if nbytes is None:
+        raise Undefined("LDC size")
+    v = st.cbuf(f["CbufSlot"], f["CbufOffset"], nbytes)
+    if size in (1, 3) and v >> (8 * nbytes - 1):
+        v -= 1 << (8 * nbytes)
+    if nbytes == 8:
+        st.setR(f["Dest"], v & M32)
+        if f["Dest"] != RZ:
+            st.setR(f["Dest"] + 1, v >> 32)
+    else:
+        _dst(st, f, v)
+
+
+def nop(st, f):
+    pass
+
+
+OPS = {
+    "Mov32i": mov32i, "MovR": movr, "MovC": movc, "Lop32i": lop32i, "Fmul32i": fmul32i, "Iadd3R": iadd3r,
+    "IaddR": iaddr, "IscaddR": iscaddr, "IsetpR": isetpr, "FsetpR": fsetpr, "FsetR": fsetr, "SelR": selr,
+    "Psetp": psetp, "I2fR": i2fr, "F2iR": f2ir, "F2fR": f2fr, "FaddR": faddr, "FmulR": fmulr, "FfmaR": ffmar,
+    "FmnmxR": fmnmxr, "Mufu": mufu, "ImnmxR": imnmxr, "ImadR": imadr, "ImulR": imulr, "Lop3R": lop3r,
+    "ShfLR": lambda st, f: _shf(st, f, True), "ShfRR": lambda st, f: _shf(st, f, False),
+    "ShlR": lambda st, f: _shl(st, f, st.R(f["SrcB"])), "ShlI": lambda st, f: _shl(st, f, f["Imm20"] & M32),
+    "ShrR": lambda st, f: _shr(st, f, st.R(f["SrcB"])), "ShrI": lambda st, f: _shr(st, f, f["Imm20"] & M32),
+    "PrmtR": prmtr, "FloR": flor, "PopcR": popcr, "P2rI": p2ri, "R2pI": r2pi, "BfeI": bfei, "Ldc": ldc,
+    "Nop": nop,
+}
