+    ap.add_argument("--cases", type=int, default=6)
+    ap.add_argument("--family", default="")
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("-v", action="store_true")
+    ap.add_argument("--words", help="one SM86 instruction (four hex words): lower it with lower_py and run it verbosely")
+    ap.add_argument("--bug", action="append", default=[], help="inject a known bug into lower_py (i2f-bit12)")
+    ap.add_argument("--make-cache", type=Path, help="write a synthetic shader-cache folder (for fake_xlate.py runs)")
+    ap.add_argument("--programs", type=int, default=200)
