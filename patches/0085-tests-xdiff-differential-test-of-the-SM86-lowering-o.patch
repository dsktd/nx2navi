+
+def mnemonic(op):
+    return FAMILY.get(op & 0x1FF, f"op{op:03x}")
+
+
+def is_uniform(op):
+    return (0x080 <= (op & 0x1FF) <= 0x0BF and op != 0x886) or op == 0x9C3
+
+
+class Insn:
+    def __init__(self, w: int, st, uniform=False):
+        self.w, self.st, self.uniform = w, st, uniform
+
+    def bits(self, o, n):
+        return (self.w >> o) & ((1 << n) - 1)
+
+    def bit(self, o):
+        return (self.w >> o) & 1
+
+    @property
+    def op(self):
+        return self.bits(0, 12)
+
+    @property
+    def form(self):
+        return self.bits(9, 3)
+
+    # registers of the instruction's datapath (uniform twins read and write uniform registers)
+    def rd(self, n):
+        if self.uniform:
+            return 0 if n in (RZ, URZ) else self.st.UR(n)
+        return self.st.R(n)
+
+    def wr(self, n, v):
+        if self.uniform:
+            if n not in (RZ, URZ):
+                self.st.setUR(n, v)
+        else:
+            self.st.setR(n, v)
+
+    def pr(self, field4):
+        """A 4-bit predicate operand (index, negate in bit 3)."""
+        v = self.st.UP(field4 & 7) if self.uniform else self.st.P(field4 & 7)
+        return v != bool(field4 & 8)
+
+    def pw(self, n, v):
+        (self.st.setUP if self.uniform else self.st.setP)(n, v)
+
+    def cbuf(self):
+        bank, off = self.bits(54, 5), self.bits(38, 16)
+        if self.bit(91) and not self.uniform:
+            raise Unsupported("constant operand indexed by a uniform register")
+        return self.st.cbuf(bank, off)
+
+    # operands -----------------------------------------------------------------------------------------------------
+    def A(self):
+        return self.rd(self.bits(24, 8))
+
+    def src(self, which):
+        """(value, abs, neg) of source 1 (B) or 2 (C) under the instruction's form."""
+        form = self.form
+        if form == 0:
+            raise Unsupported("form 0")
+        wide = form in (4, 5, 6) if which == 1 else form in (2, 3, 7)
+        if wide:
+            if form in (2, 4):
+                return self.bits(32, 32), False, False
+            if form in (3, 5):
+                return self.cbuf(), bool(self.bit(62)), bool(self.bit(63))
+            return self.st.UR(self.bits(32, 6)) if self.bits(32, 6) != URZ else 0, bool(self.bit(62)), bool(self.bit(63))
+        upper = which == 2 or form in (2, 3, 7)
+        if upper:
+            return self.rd(self.bits(64, 8)), bool(self.bit(74)), bool(self.bit(75))
+        return self.rd(self.bits(32, 8)), bool(self.bit(62)), bool(self.bit(63))
+
+    def B(self):
+        return self.src(1)[0]
+
+    def C(self):
+        return self.src(2)[0]
+
+    def second_slot(self):
+        return 2 if self.form in (2, 3, 7) else 1
+
+
+def fmod_(v, a, n):
+    return fp.neg(fp.fabs(v, a), n)
+
+
+def execute(w: int, st):
+    op = w & 0xFFF
+    uniform = False
+    if is_uniform(op):
+        if op in (0x882, 0xC82):
+            return _umov(Insn(w, st, True))
+        if op == 0xAB9:
+            return _uldc(Insn(w, st, True))
+        twin = (op & 0x1FF) - 0x80
+        w = (w & ~0x1FF) | twin
+        w &= ~(1 << 91)
+        uniform = True
+    I = Insn(w, st, uniform)
+    if not I.pr(I.bits(12, 4)):
+        return
+    op = I.op
+    fn = OPS.get(op)
+    if fn is None:
+        raise Unsupported(f"opcode {op:03x} not modelled")
+    fn(I)
+
+
+# ---- moves -----------------------------------------------------------------------------------------------------------
+def _mov(I):
+    if I.bits(72, 4) != 15:
+        raise Unsupported("MOV lane mask")
+    I.wr(I.bits(16, 8), I.B())
+
+
+def _umov(I):
+    if not I.pr(I.bits(12, 4)):
+        return
+    I.wr(I.bits(16, 8), I.bits(32, 32) if I.op == 0x882 else I.st.UR(I.bits(32, 6)))
+
+
+def _uldc(I):
+    if not I.pr(I.bits(12, 4)):
+        return
+    width, bank, off, d = I.bits(73, 3), I.bits(54, 5), I.bits(38, 16), I.bits(16, 8)
+    if width < 4:
+        size = 1 if width < 2 else 2
+        v = I.st.cbuf(bank, off, size)
+        if width & 1 and v >> (8 * size - 1):
+            v -= 1 << (8 * size)
+        I.wr(d, v)
+    elif width == 4:
+        I.wr(d, I.st.cbuf(bank, off))
+    elif width == 5:
+        if d != URZ:
+            I.wr(d, I.st.cbuf(bank, off))
+            I.wr(d + 1, I.st.cbuf(bank, off + 4))
+    else:
+        raise Unsupported("ULDC width")
+
+
+# ---- float -----------------------------------------------------------------------------------------------------------
+def _fadd(I):
+    if I.bits(81, 10):
+        raise Unsupported("FADD mode")
+    a = fmod_(I.A(), I.bit(73), I.bit(72))
+    b, ba, bn = I.src(I.second_slot())
+    r = fp.fadd(a, fmod_(b, ba, bn), I.bits(78, 2), bool(I.bit(80)))
+    I.wr(I.bits(16, 8), fp.sat(r) if I.bit(77) else r)
+
+
+FMUL_SCALE = {1: -3, 2: -2, 3: -1, 4: 0, 5: 1, 6: 2, 7: 3}
+
+
+def _fmul(I):
+    if I.bit(76) or I.bits(81, 3) or I.bits(87, 4) or I.bits(84, 3) == 0:
+        raise Unsupported("FMUL mode")
+    a = fmod_(I.A(), I.bit(73), I.bit(72))
+    b, ba, bn = I.src(1)
+    fz = bool(I.bit(80))
+    r = fp.fmul(a, fmod_(b, ba, bn), I.bits(78, 2), fz)
+    sc = FMUL_SCALE[I.bits(84, 3)]
+    if sc:   # the scale applies to the exact product before rounding
+        va, vb = fp.value(fp.ftz(a, fz)), fp.value(fp.ftz(fmod_(b, ba, bn), fz))
+        if not isinstance(va, (tuple, str)) and not isinstance(vb, (tuple, str)) and va * vb != 0:
+            r = fp.ftz(fp.pack(va * vb * fp.Fraction(2) ** sc, I.bits(78, 2)), fz)
+    I.wr(I.bits(16, 8), fp.sat(r) if I.bit(77) else r)
+
+
+def _ffma(I):
+    if I.bit(76) or I.bits(81, 10):
+        raise Unsupported("FFMA mode")
+    a = fmod_(I.A(), I.bit(73), I.bit(72))
+    b, ba, bn = I.src(1)
+    c, ca, cn = I.src(2)
+    r = fp.ffma(a, fmod_(b, ba, bn), fmod_(c, ca, cn), I.bits(78, 2), bool(I.bit(80)))
+    I.wr(I.bits(16, 8), fp.sat(r) if I.bit(77) else r)
+
+
+def _fmnmx(I):
+    if I.bits(74, 6) or I.bits(81, 6):
+        raise Unsupported("FMNMX mode")
+    fz = bool(I.bit(80))
+    a = fp.ftz(fmod_(I.A(), I.bit(73), I.bit(72)), fz)
+    b, ba, bn = I.src(I.second_slot())
+    b = fp.ftz(fmod_(b, ba, bn), fz)
+    I.wr(I.bits(16, 8), fp.fmin(a, b) if I.pr(I.bits(87, 4)) else fp.fmax(a, b))
+
+
+def _mufu(I):
+    operation = I.bits(74, 6)
+    if operation > 8 or operation in (6, 7) or I.bit(73):
+        raise Unsupported(f"MUFU {operation}")
+    if I.op == 0x908:
+        b = I.bits(32, 32)
+    else:
+        b, ba, bn = I.src(1)
+        b = fmod_(b, ba, bn)
+    x = fp.bits2f(b)
+    import math
+    if operation <= 1:   # SM70+ SIN/COS take turns
+        if not math.isfinite(x) or abs(x) > 64:
+            # The lowering multiplies by 2pi in f32 (the translator's SIN/COS take radians): an argument this far out
+            # loses its fraction of a turn there, by design, so it is not compared.
+            raise Unsupported("MUFU.SIN/COS beyond 64 turns")
+        else:
+            t = math.fmod(x, 1.0) * 2 * math.pi
+            r = math.cos(t) if operation == 0 else math.sin(t)
+    else:
+        r = fp.mufu(operation, b)
+    try:
+        bits = fp.f2bits(r)
+    except OverflowError:
+        bits = 0x7F800000 if r > 0 else 0xFF800000
+    I.wr(I.bits(16, 8), bits)
+
+
+def _frnd(I):
+    if I.bits(75, 2) != 2 or I.bits(84, 2) != 2 or I.bits(81, 3) or I.bits(86, 6):
+        raise Unsupported("FRND format")
+    b, ba, bn = I.src(1)
+    I.wr(I.bits(16, 8), fp.frnd(fmod_(b, ba, bn), I.bits(78, 2), bool(I.bit(80))))
+
+
+def _setp(I, floating):
+    if not floating and I.bit(72):
+        return _isetp_ex(I)
+    combine = I.bits(74, 2)
+    if combine > 2:
+        raise Unsupported("predicate combination")
+    a = I.A()
+    b, ba, bn = I.src(1)
+    if floating:
+        fz = bool(I.bit(80))
+        a = fp.ftz(fmod_(a, I.bit(73), I.bit(72)), fz)
+        b = fp.ftz(fmod_(b, ba, bn), fz)
+        r = fp.fcomp(I.bits(76, 4), a, b)
+    else:
+        r = fp.icomp(I.bits(76, 3), a, b, bool(I.bit(73)))
+    pc = I.pr(I.bits(87, 4))
+    I.pw(I.bits(81, 3), fp.boolop(combine, r, pc))
+    I.pw(I.bits(84, 3), fp.boolop(combine, not r, pc))
+
+
+def _isetp_ex(I):
+    """ISETP.EX: the 64-bit compare's high words; Pl (68-71) is the low words' result."""
+    cmp, combine = I.bits(76, 3), I.bits(74, 2)
+    if cmp in (0, 7) or combine == 3:
+        raise Unsupported("ISETP.EX mode")
+    a, b = I.A(), I.B()
+    low = I.pr(I.bits(68, 4))
+    signed = bool(I.bit(73))
+    eq = a == b
+    lt = fp.icomp(1, a, b, signed)
+    gt = fp.icomp(4, a, b, signed)
+    r = {1: lt or (eq and low), 2: eq and low, 3: lt or (eq and low), 4: gt or (eq and low), 5: not eq or low,
+         6: gt or (eq and low)}[cmp]
+    pc = I.pr(I.bits(87, 4))
+    I.pw(I.bits(81, 3), fp.boolop(combine, r, pc))
+    I.pw(I.bits(84, 3), fp.boolop(combine, not r, pc))
+
+
+def _fset(I):
+    if I.bits(64, 8) or I.bits(74, 2) == 3 or I.bits(81, 6):
+        raise Unsupported("FSET output mode")
+    fz = bool(I.bit(80))
+    a = fp.ftz(fmod_(I.A(), I.bit(73), I.bit(72)), fz)
+    b, ba, bn = I.src(1)
+    b = fp.ftz(fmod_(b, ba, bn), fz)
+    r = fp.boolop(I.bits(74, 2), fp.fcomp(I.bits(76, 4), a, b), I.pr(I.bits(87, 4)))
+    I.wr(I.bits(16, 8), 0x3F800000 if r else 0)
+
+
+def _sel(I, floating):
+    a = I.A()
+    b, ba, bn = I.src(1)
+    if floating:
+        a = fmod_(a, I.bit(73), I.bit(72))
+        b = fmod_(b, ba, bn)
+    I.wr(I.bits(16, 8), a if I.pr(I.bits(87, 4)) else b)
+
+
+# ---- conversions -----------------------------------------------------------------------------------------------------
+def _i2fp(I):
+    if (I.bits(64, 32) & ~(0x400 | 0xC000 | 0x08000000)) != 0x00201000:
+        raise Unsupported("I2FP format")
+    I.wr(I.bits(16, 8), fp.i2f(I.B(), bool(I.bit(74)), I.bits(78, 2)))
+
+
+def _i2f(I):
+    src, dst, sel = I.bits(84, 2), I.bits(75, 2), I.bits(60, 2)
+    if src == 3 or dst == 0:
+        raise Unsupported("I2F format")
+    if I.op == 0xB06:
+        b = I.B()
+    elif I.op == 0xD06:
+        b = I.st.UR(I.bits(32, 6)) if I.bits(32, 6) != URZ else 0
+    else:
+        b = I.rd(I.bits(32, 8))
+    signed = bool(I.bit(74))
+    if src < 2:
+        size = 8 << src
+        v = (b >> (sel * size)) & ((1 << size) - 1)
+        if signed and v >> (size - 1):
+            v -= 1 << size
+        b = v & M32
+    fmt = {1: fp.F16, 2: fp.F32, 3: fp.F64}[dst]
+    r = fp.i2f(b, signed, I.bits(78, 2), fmt)
+    d = I.bits(16, 8)
+    if dst == 3:
+        if d != RZ:
+            I.wr(d, r & M32)
+            I.wr(d + 1, r >> 32)
+    else:
+        I.wr(d, r)
+
+
+def _f2i(I):
+    dst, src = I.bits(75, 2), I.bits(84, 2)
+    if dst > 2 or src not in (1, 2):
+        raise Unsupported("F2I format")
+    if I.op == 0x905:
+        b = I.bits(32, 32)
+    else:
+        b, ba, bn = I.src(1)
+        b = fmod_(b, ba, bn) if src == 2 else b
+    srcfmt = fp.F32 if src == 2 else fp.F16
+    if src == 1:
+        b &= 0xFFFF
+    r = fp.f2i(b, I.bits(78, 2), 8 << dst, bool(I.bit(72)), bool(I.bit(80)), srcfmt)
+    I.wr(I.bits(16, 8), r)
+
+
+def _f2fp(I):
+    if I.bits(62, 2) or I.bits(73, 5) or I.bits(79, 2) or I.bits(81, 10) or I.bit(91) or I.bit(72):
+        raise Unsupported("F2FP mode")
+    lo = fp.f32_to_f16(I.B())
+    hi = (I.C() & 0xFFFF) if I.bit(78) else fp.f32_to_f16(I.A())
+    I.wr(I.bits(16, 8), hi << 16 | lo)
+
+
+# ---- integer ---------------------------------------------------------------------------------------------------------
+def _iadd3(I):
+    op = I.op
+    negA, negC, x = I.bit(72), I.bit(75), I.bit(74)
+    negB = op != 0x810 and I.bit(63) and I.form not in (2, 3)
+    a, b, c = I.A(), I.B(), I.C()
+    if I.form in (2, 3) and (I.bit(63) or negC):
+        raise Unsupported("IADD3 negation with a wide third source")
+    if x:
+        s = (a ^ (M32 if negA else 0)) + (b ^ (M32 if negB else 0)) + (c ^ (M32 if negC else 0))
+        s += int(I.pr(I.bits(87, 4))) + int(I.pr(I.bits(77, 4)))
+    else:
+        s = (a ^ (M32 if negA else 0)) + (b ^ (M32 if negB else 0)) + (c ^ (M32 if negC else 0)) + negA + negB + negC
+    I.wr(I.bits(16, 8), s)
+    c1, c2 = I.bits(81, 3), I.bits(84, 3)
+    if c1 != PT:
+        I.pw(c1, (s >> 32) & 1)
+    if c2 != PT:
+        I.pw(c2, (s >> 33) & 1)
+
+
+def _imad(I):
+    x = I.bit(74)
+    if I.bits(81, 3) != 7 or (not x and I.bits(87, 4) != 15):
+        raise Unsupported("IMAD mode")
+    a, b, c = I.A(), I.B(), I.C()
+    if I.bit(75):
+        c = (~c if x else -c) & M32
+    r = a * b + c + (int(I.pr(I.bits(87, 4))) if x else 0)
+    I.wr(I.bits(16, 8), r)
+
+
+def _imad_wide(I):
+    op = I.op
+    if I.bits(81, 3) != 7:
+        raise Unsupported("IMAD.HI/WIDE mode")
+    a = I.rd(I.bits(24, 8))
+    if op in (0x825, 0x827):
+        b = I.bits(32, 32)
+    elif op == 0xA27:
+        b = I.cbuf()
+    else:
+        b = I.rd(I.bits(64 if op == 0x625 else 32, 8))
+    if op == 0x625:
+        bank, off = I.bits(54, 5), I.bits(38, 16)
+        c = I.st.cbuf(bank, off) | I.st.cbuf(bank, off + 4) << 32
+    else:
+        cr = I.bits(64, 8)
+        c = 0 if cr == RZ else I.rd(cr) | I.rd(cr + 1) << 32
+    if I.bit(73):
+        a, b = s32(a), s32(b)
+    r = (a * b + c) & ((1 << 64) - 1)
+    d = I.bits(16, 8)
+    if op in (0x225, 0x625, 0x825):
+        if d == RZ or d & 1:
+            raise Unsupported("IMAD.WIDE pair")
+        I.wr(d, r & M32)
+        I.wr(d + 1, r >> 32)
+    else:
+        I.wr(d, r >> 32)
+
+
+def _iabs(I):
+    I.wr(I.bits(16, 8), abs(s32(I.B())))
+
+
+def _lop3(I):
+    if I.bit(80) or I.bits(87, 4) != 15:
+        raise Unsupported("LOP3 predicate mode")
+    a, b, c = I.A(), I.B(), I.rd(I.bits(64, 8))
+    lut = I.bits(72, 8)
+    r = 0
+    for k in range(8):
+        if lut >> k & 1:
+            ta = M32 if k & 4 else 0
+            tb = M32 if k & 2 else 0
+            tc = M32 if k & 1 else 0
+            r |= ~((a ^ ta) | (b ^ tb) | (c ^ tc)) & M32
+    I.wr(I.bits(16, 8), r)
+    if I.bits(81, 3) != PT:
+        I.pw(I.bits(81, 3), r != 0)
+
+
+def _imnmx(I):
+    a, b = I.A(), I.B()
+    signed = bool(I.bit(73))
+    ka, kb = (s32(a), s32(b)) if signed else (a, b)
+    I.wr(I.bits(16, 8), (a if ka <= kb else b) if I.pr(I.bits(87, 4)) else (a if ka >= kb else b))
+
+
+def _shf(I):
+    if I.bits(81, 10):
+        raise Unsupported("SHF mode")
+    typ = I.bits(73, 2)
+    wrap, right, hi = I.bit(75), I.bit(76), I.bit(80)
+    width = 64 if typ <= 1 else 32
+    signed = typ in (0, 2)
+    low, s, high = I.A(), I.B(), I.C()
+    s = s & (width - 1) if wrap else min(s, width)
+    val = high << 32 | low
+    if right:
+        if signed and high & 0x80000000:
+            val -= 1 << 64
+        r = val >> s
+    else:
+        r = val << s
+    r &= (1 << 64) - 1
+    I.wr(I.bits(16, 8), r >> 32 if hi else r & M32)
+
+
+def _lea(I):
+    op = I.op
+    a, b = I.A(), I.B()
+    shift, carry = I.bits(75, 5), I.bits(81, 3)
+    negB = op != 0x811 and I.bit(63)
+    if I.bit(72):
+        raise Unsupported("LEA negated a")
+    if not I.bit(80):
+        if I.bit(74):
+            raise Unsupported("LEA.X without .HI")
+        if carry != PT and negB:
+            raise Unsupported("LEA carry with negated b")
+        s = ((a << shift) & M32) + ((-b) & M32 if negB else b)
+        I.wr(I.bits(16, 8), s)
+        if carry != PT:
+            I.pw(carry, s >> 32 & 1)
+        return
+    if carry != PT:
+        raise Unsupported("LEA.HI carry out")
+    high = I.rd(I.bits(64, 8))
+    if I.bits(64, 8) == RZ:
+        v = s32(a) if I.bit(73) else a
+        h = (v >> (32 - shift)) & M32 if shift else (M32 if (I.bit(73) and v < 0) else 0)
+    else:
+        h = ((high << 32 | a) << shift) >> 32 & M32
+    if I.bit(74):
+        h += int(I.pr(I.bits(87, 4)))
+    I.wr(I.bits(16, 8), h + ((-b) & M32 if negB else b))
+
+
+def _prmt(I):
+    if I.bits(72, 4) or I.bits(76, 15):
+        raise Unsupported("PRMT mode")
+    a, sel, c = I.A(), I.B(), I.C()
+    src = c << 32 | a
+    r = 0
+    for k in range(4):
+        n = sel >> (4 * k) & 15
+        byte = src >> (8 * (n & 7)) & 0xFF
+        if n & 8:
+            byte = 0xFF if byte & 0x80 else 0
+        r |= byte << (8 * k)
+    I.wr(I.bits(16, 8), r)
+
+
+def _popc(I):
+    b, _, inv = I.src(1)
+    I.wr(I.bits(16, 8), bin((~b if inv else b) & M32).count("1"))
+
+
+def _flo(I):
+    b, _, inv = I.src(1)
+    b = (~b if inv else b) & M32
+    if I.bit(73) and b & 0x80000000:
+        b = ~b & M32
+    if b == 0:
+        r = M32
+    else:
+        r = b.bit_length() - 1
+        if I.bit(74):
+            r = 31 - r
+    I.wr(I.bits(16, 8), r)
+
+
+def _brev(I):
+    b = I.rd(I.bits(32, 8))
+    I.wr(I.bits(16, 8), int(f"{b:032b}"[::-1], 2))
+
+
+def _sgxt(I):
+    n = I.bits(32, 32)
+    a = I.A()
+    if n == 0:
+        r = 0
+    else:
+        v = a & ((1 << n) - 1) if n < 32 else a
+        if I.bit(73) and n < 32 and v >> (n - 1) & 1:
+            v -= 1 << n
+        r = v
+    I.wr(I.bits(16, 8), r)
+
+
+def _plop3(I):
+    lut = I.bits(64, 3) | I.bits(72, 5) << 3
+    lut2 = I.bits(16, 8)
+    a, b = I.pr(I.bits(87, 4)), I.pr(I.bits(77, 4))
+    cf = I.bits(68, 4)
+    if I.bit(67) and not I.uniform:   # C names a uniform predicate
+        c = I.st.UP(cf & 7) != bool(cf & 8)
+    else:
+        c = I.pr(cf)
+    k = a << 2 | b << 1 | c
+    for dest, table in ((I.bits(81, 3), lut), (I.bits(84, 3), lut2)):
+        if dest != PT:
+            I.pw(dest, table >> k & 1)
+
+
+def _p2r(I, to_reg):
+    mask = I.bits(32, 32)
+    if mask > 0x7F or I.bits(64, 32) & ~0x3000:
+        raise Unsupported("P2R/R2P mode")
+    sh = 8 * I.bits(76, 2)
+    pv = I.st.UP if I.uniform else I.st.P
+    if to_reg:
+        a = I.A()
+        bits = sum(int(pv(k)) << k for k in range(7))
+        m = mask << sh
+        I.wr(I.bits(16, 8), (a & ~m) | ((bits << sh) & m))
+    else:
+        v = I.A() >> sh
+        for k in range(7):
+            if mask >> k & 1:
+                I.pw(k, v >> k & 1)
+
+
+OPS = {}
+for ops, fn in [
+    ((0x202, 0x802, 0xA02, 0xC02), _mov),
+    ((0x221, 0x421, 0x621, 0x821, 0xA21, 0xC21, 0xE21), _fadd),
+    ((0x220, 0x420, 0x620, 0x820, 0xA20, 0xC20), _fmul),
+    ((0x223, 0x423, 0x623, 0x823, 0xA23, 0xC23, 0xE23), _ffma),
+    ((0x209, 0x409, 0x609, 0x809, 0xA09, 0xC09), _fmnmx),
+    ((0x308, 0x908, 0xB08, 0xD08), _mufu),
+    ((0x307, 0xB07), _frnd),
+    ((0x20B, 0x40B, 0x60B, 0x80B, 0xA0B, 0xC0B), lambda I: _setp(I, True)),
+    ((0x20C, 0x40C, 0x60C, 0x80C, 0xA0C, 0xC0C), lambda I: _setp(I, False)),
+    ((0x20A, 0x40A, 0x60A, 0x80A, 0xA0A, 0xC0A), _fset),
+    ((0x207, 0x807, 0xA07, 0xC07), lambda I: _sel(I, False)),
+    ((0x208, 0x808, 0xA08, 0xC08), lambda I: _sel(I, True)),
+    ((0x245, 0x845, 0xA45, 0xC45), _i2fp),
+    ((0x306, 0xB06, 0xD06), _i2f),
+    ((0x305, 0x905, 0xB05, 0xD05), _f2i),
+    ((0x23E, 0x43E, 0x83E, 0xA3E, 0xC3E), _f2fp),
+    ((0x210, 0x410, 0x610, 0x810, 0xA10, 0xC10), _iadd3),
+    ((0x224, 0x424, 0x624, 0x824, 0xA24, 0xC24, 0xE24), _imad),
+    ((0x225, 0x227, 0x625, 0x825, 0x827, 0xA27), _imad_wide),
+    ((0x213, 0xA13, 0xC13), _iabs),
+    ((0x212, 0x812, 0xA12, 0xC12), _lop3),
+    ((0x217, 0x817, 0xA17, 0xC17), _imnmx),
+    ((0x219, 0x419, 0x619, 0x819, 0xA19, 0xC19), _shf),
+    ((0x211, 0x811, 0xA11, 0xC11), _lea),
+    ((0x216, 0x416, 0x616, 0x816, 0xA16, 0xC16), _prmt),
+    ((0x309, 0xD09), _popc),
+    ((0x300, 0xD00), _flo),
+    ((0x301,), _brev),
+    ((0x81A,), _sgxt),
+    ((0x81C,), _plop3),
+    ((0x803,), lambda I: _p2r(I, True)),
+    ((0x804,), lambda I: _p2r(I, False)),
+]:
+    for o in ops:
+        OPS[o] = fn
