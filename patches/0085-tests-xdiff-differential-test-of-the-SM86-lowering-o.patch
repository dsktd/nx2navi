@@ -0,0 +1,279 @@
+"""Checks the checker without the translator binary.
+
+1. Synthesises SM86 instructions of every modelled family and form (random registers, guards and modifiers in the
+   ranges the lowering accepts), lowers them with lower_py.py (a transcription of AmpereLowering.cs) and runs the
+   SM86 and Maxwell references on random inputs: any disagreement is a bug in a reference, in the transcription, or
+   in the lowering itself.
+2. Injects the I2F signed-flag bug of patch 0064 (bit 12 for 13) into the transcription and requires it to be caught.
+
+  python tests/xdiff/selftest.py [--n 300] [--cases 6] [--family I2F] [--seed 1] [-v]
+"""
+
+from __future__ import annotations
+
+import argparse
+import random
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import census  # noqa: E402
+import lower_py  # noqa: E402
+import sm86  # noqa: E402
+import xdiff  # noqa: E402
+
+
+def R(rng, lo=0, hi=20):
+    return rng.choice([rng.randint(lo, hi)] * 7 + [255])
+
+
+def ins(op, rng, mods=(), c_reg=True, b_reg=True, guard=None):
+    """An SM86 word: opcode, guard, Rd, Ra, the B/C operand of its form, then modifiers [(offset, value)]."""
+    w = op
+    w |= (guard if guard is not None else rng.choice([7, 7, 7, 0, 1, 2, 8, 9, 15 - 8 + 8 * 0]) & 15) << 12
+    w |= rng.randint(0, 20) << 16
+    w |= R(rng) << 24
+    form = (op >> 9) & 7
+    if form == 1:
+        w |= R(rng) << 32
+        if c_reg:
+            w |= R(rng) << 64
+    elif form in (2, 4):
+        w |= rng.getrandbits(32) << 32
+        w |= R(rng) << 64
+    elif form in (3, 5):
+        w |= rng.choice([0, 3, 24]) << 54 | (rng.randint(0, 0x3ff) * 4) << 38
+        w |= R(rng) << 64
+    elif form in (6, 7):
+        w |= rng.choice([0, 1, 2, 5, 9, 63]) << 32
+        w |= R(rng) << 64
+    for off, val in mods:
+        w &= ~(((1 << val.bit_length()) - 1 if isinstance(val, int) else 0) << off)
+        w |= val << off
+    return w
+
+
+def bits(rng, *spec):
+    """[(offset, random value in range)] from (offset, choices)."""
+    return [(off, rng.choice(ch)) for off, ch in spec]
+
+
+B2 = [0, 1]
+
+
+def families(rng):
+    pick = rng.choice
+    p4 = list(range(16))
+    yield "FADD", ins(pick([0x221, 0x421, 0x621, 0x821, 0xa21, 0xc21, 0xe21]), rng,
+                      bits(rng, (72, B2), (73, B2), (77, B2), (78, range(4)), (80, B2)))
+    yield "FMUL", ins(pick([0x220, 0x820, 0xa20, 0xc20]), rng,
+                      bits(rng, (72, B2), (73, B2), (77, B2), (78, range(4)), (80, B2), (84, range(1, 8))))
+    yield "FFMA", ins(pick([0x223, 0x423, 0x623, 0x823, 0xa23, 0xc23, 0xe23]), rng,
+                      bits(rng, (72, B2), (73, B2), (74, B2), (75, B2), (77, B2), (78, range(4)), (80, B2)))
+    yield "FMNMX", ins(pick([0x209, 0x809, 0xa09, 0xc09]), rng, bits(rng, (72, B2), (73, B2), (80, B2), (87, p4)))
+    yield "FRND", ins(0x307, rng, [(75, 2), (84, 2)] + bits(rng, (78, range(4)), (80, B2), (62, B2), (63, B2)))
+    yield "FSETP", ins(pick([0x20b, 0x80b, 0xa0b, 0xc0b]), rng,
+                       bits(rng, (72, B2), (73, B2), (74, range(3)), (76, p4), (80, B2), (81, range(8)),
+                            (84, range(8)), (87, p4)))
+    yield "ISETP", ins(pick([0x20c, 0x80c, 0xa0c, 0xc0c]), rng,
