+def check(n, cases, family, seed, bugs=(), verbose=False):
+    rng = random.Random(seed)
+    stats = defaultdict(lambda: defaultdict(int))
+    examples = {}
+    for _ in range(n):
+        for fam, w in families(rng):
+            if family and fam != family:
