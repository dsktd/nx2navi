+"""Differential test of the SM86 lowering over the game's own shader instructions.
+
+For each instruction form the game's shaders use (census.py, from the runtime's stored translation inputs), a few
+real instructions of that form are lowered by `nx2navi_xlate --lower` (tools/xlate/Program.cs LowerFile) and run on
+random but valid inputs twice: the SM86 instruction by the SM86 reference (sm86.py), and the Maxwell words the
+lowering emitted by the Maxwell reference (maxwell.py, fields decoded by the translator's own decoder, isa.py). Every
+guest register, uniform register, predicate and uniform predicate must come out the same. Mismatches are clustered
+by family, form and the output that differs, and ranked by the number of shaders whose code holds that form.
+
+  python tests/xdiff/xdiff.py --cache <shader-cache> [--xlate EXE] [--shaders N] [--opcode X] [--cases K]
+                              [--per-form M] [--out build/xdiff] [--seed S] [--jobs J]
+  python tests/xdiff/xdiff.py --words "w0 w1 w2 w3" [...]    one instruction, verbose (a minimal repro)
+  python tests/xdiff/xdiff.py --selftest                      no translator needed: checks the checker
+
+--opcode takes a mnemonic (I2F, IADD3, ...) or a 3-digit hex opcode (306). Writes <out>/report.txt and report.json.
+This stage checks the lowering (SM86 -> Maxwell). The translator's Maxwell -> SPIR-V step is not executed here:
+its FTZ, F2I range and NaN behaviour are the SPIR-V stage's subject (see report "not covered")."""
+
+from __future__ import annotations
+
+import argparse
+import concurrent.futures
+import json
+import os
+import random
+import subprocess
+import sys
+import tempfile
+import time
+from collections import defaultdict
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+ROOT = HERE.parents[1]
+
+import census  # noqa: E402
+import fp  # noqa: E402
+import maxwell  # noqa: E402
+import sm86  # noqa: E402
+from state import RZ, Unsupported, random_state  # noqa: E402
+
+DEFAULT_XLATE = ROOT / "build" / "xlate" / ("nx2navi_xlate.exe" if os.name == "nt" else "nx2navi_xlate")
+SCRATCH_FROM = 237   # R237-R254: the lowering's uniform predicate state and scratch registers
+FLOAT_RESULT = {"FADD", "FMUL", "FFMA", "FMNMX", "MUFU", "FRND", "FSEL"}
+HALF_RESULT = {"F2FP"}
+TOLERANT = {"MUFU"}
+
+
+def words_of(w: int):
+    return [(w >> (32 * k)) & 0xFFFFFFFF for k in range(4)]
+
+
+def fmt_insn(w: int):
+    return " ".join(f"{x:08x}" for x in words_of(w))
+
+
+# ---- lowering ------------------------------------------------------------------------------------------------------
+class Lowering:
+    def __init__(self, words=None, urbase=None, spill=False, error=None):
+        self.words, self.urbase, self.spill, self.error = words, urbase, spill, error
+
+
+def lower(xlate: Path, w: int, tmpdir: Path) -> Lowering:
+    fd, path = tempfile.mkstemp(suffix=".txt", dir=tmpdir)
+    try:
+        with os.fdopen(fd, "w") as f:
+            f.write(fmt_insn(w) + "\n")
+        cmd = [sys.executable, str(xlate)] if xlate.suffix == ".py" else [str(xlate)]   # .py: fake_xlate.py
+        p = subprocess.run(cmd + ["--lower", path], capture_output=True, text=True)
+    finally:
+        os.unlink(path)
+    if p.returncode:
+        return Lowering(error=(p.stderr.strip().splitlines() or ["--lower failed"])[-1])
+    out, urbase, spill = [], None, False
+    for line in p.stdout.splitlines():
+        t = line.split()
+        if not t:
+            continue
+        if t[0] == "urbase":
+            urbase = int(t[1])
+        elif t[0] == "local":
+            spill = True
+        else:
+            out.append(int(t[0], 16))
+    return Lowering(out, urbase, spill)
+
+
+# ---- one case --------------------------------------------------------------------------------------------------------
+class Outcome:
+    def __init__(self, kind, detail="", diffs=None):
+        self.kind, self.detail, self.diffs = kind, detail, diffs or []   # kind: ok mismatch undefined unsupported
+
+
+def same_value(fam, a, b):
+    if fam in TOLERANT:
+        return fp.close(a, b)
+    if fam in HALF_RESULT:
+        return all(((a >> s) & 0xFFFF) == ((b >> s) & 0xFFFF) or
+                   (fp.is_nan((a >> s) & 0xFFFF, fp.F16) and fp.is_nan((b >> s) & 0xFFFF, fp.F16)) for s in (0, 16))
+    return fp.same(a, b, fam in FLOAT_RESULT)
+
+
+def run_case(w: int, low: Lowering, seed: int) -> Outcome:
+    rng = random.Random(seed)
+    st0 = random_state(rng)
+    ref = st0.copy()
+    try:
+        sm86.execute(w, ref)
+    except Unsupported as e:
+        return Outcome("unsupported", f"sm86: {e}")
+    if low.spill:
+        return Outcome("unsupported", "spill mode (registers near R237)")
+    ub = low.urbase
+    mx = st0.copy()
+    mx.bank_alias = {17: 24}   # AmpereLowering Bank: c24 is bound as c17
+    for k in range(63):
+        if ub + k < SCRATCH_FROM:
+            mx.r[ub + k] = st0.ur[k]
+    try:
+        maxwell.run(low.words, mx)
+    except Unsupported as e:
+        return Outcome("unsupported", f"maxwell: {e}")
+    except maxwell.Undefined as e:
+        return Outcome("undefined", str(e))
+    fam = sm86.mnemonic(w & 0xFFF)
+    diffs = []
+    for r in range(min(ub, SCRATCH_FROM)):
+        if not same_value(fam, ref.r[r], mx.r[r]):
+            diffs.append((f"R{r}", ref.r[r], mx.r[r]))
+    for k in range(63):
+        if ub + k < SCRATCH_FROM and not same_value(fam, ref.ur[k], mx.r[ub + k]):
+            diffs.append((f"UR{k}", ref.ur[k], mx.r[ub + k]))
+    for k in range(7):
+        if ref.p[k] != mx.p[k]:
+            diffs.append((f"P{k}", int(ref.p[k]), int(mx.p[k])))
+        upm = bool(mx.r[238] >> k & 1)
+        if ref.up[k] != upm:
+            diffs.append((f"UP{k}", int(ref.up[k]), int(upm)))
+    return Outcome("mismatch" if diffs else "ok", diffs=diffs)
+
+
+def inputs_of(w: int, st):
+    """The values an instruction's register fields name (for repros)."""
+    regs = [(w >> 24) & 0xFF, (w >> 32) & 0xFF, (w >> 64) & 0xFF]
+    out = [f"R{r}={st.r[r]:08x}" for r in dict.fromkeys(regs) if r != RZ]
+    out.append("P=" + "".join("1" if st.p[k] else "0" for k in range(7)))
+    return " ".join(out)
+
+
+# ---- the run ---------------------------------------------------------------------------------------------------------
+def matches_opcode(spec, w):
+    if not spec:
+        return True
+    op = w & 0xFFF
+    specs = [s.strip().upper() for s in spec.split(",")]
+    return any(s == sm86.mnemonic(op) or (len(s) == 3 and all(c in "0123456789ABCDEF" for c in s) and int(s, 16) == op)
+               for s in specs)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--cache", type=Path, help="a shader-cache folder (its in/*.in and shader-cache.pack)")
+    ap.add_argument("--xlate", type=Path, default=DEFAULT_XLATE)
+    ap.add_argument("--shaders", type=int, default=0, help="read only the first N distinct programs (0: all)")
+    ap.add_argument("--opcode", default="", help="mnemonic(s) or hex opcode(s), comma separated")
+    ap.add_argument("--cases", type=int, default=12, help="random input sets per instruction")
+    ap.add_argument("--per-form", type=int, default=3, help="distinct real instructions per form")
+    ap.add_argument("--all-forms", action="store_true", help="also forms the SM86 reference does not model")
+    ap.add_argument("--out", type=Path, default=ROOT / "build" / "xdiff")
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--jobs", type=int, default=8)
+    ap.add_argument("--words", help="one SM86 instruction as four hex words (w0 = bits 0-31): run it verbosely")
+    ap.add_argument("--case", type=int, help="with --words: run only the case of this seed (as a report repro names)")
+    ap.add_argument("--selftest", action="store_true")
+    a = ap.parse_args(argv)
+    if a.selftest:
+        import selftest
+        return selftest.main([])
+    if not a.xlate.is_file():
+        sys.exit(f"no translator at {a.xlate} (--xlate)")
+    tmpdir = Path(tempfile.mkdtemp(prefix="xdiff-"))
+    if a.words:
+        ws = [int(x.removeprefix("0x"), 16) for x in a.words.split()]
+        w = sum(x << (32 * k) for k, x in enumerate(ws))
+        return single(a, w, tmpdir)
+    if not a.cache or not a.cache.is_dir():
+        sys.exit("--cache <shader-cache folder> is needed")
+    t0 = time.monotonic()
+    table, ids, ninsn = census.forms(census.programs(a.cache, a.shaders or None))
+    print(f"census: {len(ids)} programs, {ninsn} instructions, {len(table)} forms ({time.monotonic() - t0:.1f} s)",
+          flush=True)
+    rng = random.Random(a.seed)
+    todo = []   # (form key, word)
+    for key, e in table.items():
+        w0 = e["insns"][0]
+        if not matches_opcode(a.opcode, w0):
+            continue
+        if not a.all_forms and (w0 & 0xFFF) not in sm86.OPS and not sm86.is_uniform(w0 & 0xFFF):
+            continue
+        picks = e["insns"] if len(e["insns"]) <= a.per_form else rng.sample(e["insns"], a.per_form)
+        todo += [(key, w) for w in picks]
+    print(f"lowering {len(todo)} instructions of {len({k for k, _ in todo})} forms", flush=True)
+    with concurrent.futures.ThreadPoolExecutor(a.jobs) as pool:
+        lows = dict(zip((w for _, w in todo), pool.map(lambda kw: lower(a.xlate, kw[1], tmpdir), todo)))
+    results = defaultdict(lambda: defaultdict(list))   # form key -> kind -> [(word, seed, outcome)]
+    for key, w in todo:
+        low = lows[w]
+        if low.error:
+            results[key]["refused"].append((w, 0, Outcome("refused", low.error)))
+            continue
+        for c in range(a.cases):
+            seed = rng.getrandbits(32)
+            o = run_case(w, low, seed)
+            results[key][o.kind].append((w, seed, o))
+    report(a, table, ids, ninsn, results, lows, time.monotonic() - t0)
+    return 0
+
+
+def single(a, w, tmpdir):
+    low = lower(a.xlate, w, tmpdir)
+    print(f"sm86 {fmt_insn(w)}  {sm86.mnemonic(w & 0xFFF)}")
+    if low.error:
+        print(f"lowering refused: {low.error}")
+        return 1
+    import isa
+    for x in low.words:
+        d = isa.decode(x)
+        print(f"  {x:016x}  {d.emitter if d else '?'}  " + (" ".join(f"{k}={v}" for k, v in d.f.items()) if d else ""))
+    print(f"  urbase {low.urbase}{'  spill mode' if low.spill else ''}")
+    bad = 0
+    rng = random.Random(a.seed)
+    seeds = [a.case] if a.case is not None else [rng.getrandbits(32) for _ in range(a.cases)]
+    for c, seed in enumerate(seeds):
+        o = run_case(w, low, seed)
+        if o.kind != "ok":
+            bad += 1
+            st = random_state(random.Random(seed))
+            print(f"  case {c} seed {seed}: {o.kind} {o.detail} inputs {inputs_of(w, st)}")
+            for name, want, got in o.diffs:
+                print(f"    {name}: sm86 {want:08x}  lowered {got:08x}")
+    print(f"{len(seeds) - bad}/{len(seeds)} cases agree")
+    return 1 if bad else 0
+
+
+def report(a, table, ids, ninsn, results, lows, elapsed):
+    a.out.mkdir(parents=True, exist_ok=True)
+    clusters = defaultdict(lambda: {"forms": set(), "shaders": set(), "cases": 0, "example": None})
+    per_form = []
+    totals = defaultdict(int)
+    for key, kinds in results.items():
+        e = table[key]
+        fam = sm86.mnemonic(key & 0xFFF)
+        row = {"form": f"{key:032x}", "family": fam, "opcode": f"{key & 0xFFF:03x}", "shaders": len(e["shaders"]),
+               "uses": e["count"]}
+        for kind, items in kinds.items():
+            row[kind] = len(items)
+            totals[kind] += len(items)
+            if kind == "ok":
+                continue
+            for w, seed, o in items:
+                what = o.detail
+                if kind == "mismatch":
+                    what = "differs: " + "/".join(sorted({d[0].rstrip("0123456789") for d in o.diffs}))
+                c = clusters[(fam, f"{key & 0xFFF:03x}", kind, what)]
+                c["forms"].add(key)
+                c["shaders"] |= e["shaders"]
+                c["cases"] += 1
+                if c["example"] is None:
+                    st = random_state(random.Random(seed))
+                    c["example"] = {"insn": fmt_insn(w), "seed": seed, "inputs": inputs_of(w, st),
+                                    "diffs": [(n, f"{x:08x}", f"{y:08x}") for n, x, y in o.diffs[:4]],
+                                    "lowered": [f"{x:016x}" for x in (lows[w].words or [])][:24]}
+        per_form.append(row)
+    ranked = sorted(clusters.items(), key=lambda kv: (-len(kv[1]["shaders"]), -kv[1]["cases"]))
+    lines = [f"xdiff: SM86 lowering against the SM86 reference, {time.strftime('%Y-%m-%d %H:%M')}",
+             f"translator {a.xlate} (id {read_id(a.xlate)}), cache {a.cache}",
+             f"{len(ids)} programs, {ninsn} instructions, {len(table)} forms; tested {len(per_form)} forms, "
+             f"cases: " + ", ".join(f"{k} {v}" for k, v in sorted(totals.items())) + f"; {elapsed:.0f} s", "",
+             "Discrepancies: the lowered code computes something else (mismatch) or something the translator cannot",
+             "mean (undefined); ranked by the shaders whose code holds an affected form:"]
+    bad = [kv for kv in ranked if kv[0][2] in ("mismatch", "undefined")]
+    for n, ((fam, op, kind, what), c) in enumerate(bad, 1):
+        ex = c["example"]
+        lines.append(f"{n:3}. {fam:10} {op} {kind:9} {what}: {len(c['shaders'])} shaders, {len(c['forms'])} forms, "
+                     f"{c['cases']} cases")
+        lines.append(f"     repro: python tests/xdiff/xdiff.py --words \"{ex['insn']}\" --case {ex['seed']}"
+                     f"   inputs {ex['inputs']}")
+        for d in ex["diffs"]:
+            lines.append(f"     {d[0]}: sm86 {d[1]}  lowered {d[2]}")
+    if not bad:
+        lines.append("  none")
+    for title, kind in (("Lowering refusals (the translator rejects these shaders)", "refused"),
+                        ("Not compared (a reference does not model the form or input)", "unsupported")):
+        rows = [kv for kv in ranked if kv[0][2] == kind]
+        lines += ["", f"{title}:"]
+        for (fam, op, _, what), c in rows[:60]:
+            lines.append(f"  {fam:10} {op} {what}: {len(c['shaders'])} shaders, {len(c['forms'])} forms "
+                         f"(e.g. {c['example']['insn']})")
+        if len(rows) > 60:
+            lines.append(f"  ... {len(rows) - 60} more in report.json")
+        if not rows:
+            lines.append("  none")
+    fam_cov = defaultdict(set)
+    for k, e in table.items():
+        if (k & 0xFFF) not in sm86.OPS and not sm86.is_uniform(k & 0xFFF):
+            fam_cov[sm86.mnemonic(k & 0xFFF)] |= e["shaders"]
+    lines += ["", "Not covered (no SM86 reference yet), by shaders: " +
+              ", ".join(f"{f} {len(s)}" for f, s in sorted(fam_cov.items(), key=lambda kv: -len(kv[1])))]
+    (a.out / "report.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
+    js = {"clusters": [{"family": fam, "opcode": op, "kind": kind, "what": what, "shaders": len(c["shaders"]),
+                        "forms": len(c["forms"]), "cases": c["cases"], "example": c["example"]}
+                       for (fam, op, kind, what), c in ranked],
+          "forms": sorted(per_form, key=lambda r: -r["shaders"]), "totals": totals}
+    (a.out / "report.json").write_text(json.dumps(js, indent=1), encoding="utf-8")
+    print("\n".join(lines[:40]))
+    print(f"report: {a.out / 'report.txt'}")
+
+
+def read_id(xlate: Path):
+    p = xlate.with_name("nx2navi_xlate.id")
+    return p.read_text().strip()[:12] if p.is_file() else "?"
+
+
+if __name__ == "__main__":
+    sys.exit(main())
