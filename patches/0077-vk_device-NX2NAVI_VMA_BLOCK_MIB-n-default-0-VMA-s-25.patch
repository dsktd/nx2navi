diff --git a/runtime/vk.h b/runtime/vk.h
index e4b15bc..ff01164 100644
--- a/runtime/vk.h
+++ b/runtime/vk.h
@@ -45,6 +45,7 @@ typedef struct VkCtx {
     // VK_FEEDBACK_RESTART (the pass ends and restarts behind the full barrier).
     int feedback;                           // VK_FEEDBACK_*
     uint32_t min_imported_host_alignment;   // VK_EXT_external_memory_host
+    VkDeviceSize vma_block;                 // NX2NAVI_VMA_BLOCK_MIB in bytes, 0: VMA's default (256 MiB)
     int device_index;                       // index in vkEnumeratePhysicalDevices
 } VkCtx;
 enum { VK_FEEDBACK_OFF, VK_FEEDBACK_RESTART, VK_FEEDBACK_LAYOUT };
diff --git a/runtime/vk_device.c b/runtime/vk_device.c
index 50348bf..e9f26b7 100644
--- a/runtime/vk_device.c
+++ b/runtime/vk_device.c
@@ -412,6 +412,17 @@ static int create_device(void) {
                                  .flags = (g_vk.has_buffer_device_address ? VMA_ALLOCATOR_CREATE_BUFFER_DEVICE_ADDRESS_BIT : 0) |
                                           (g_vk.has_memory_budget ? VMA_ALLOCATOR_CREATE_EXT_MEMORY_BUDGET_BIT : 0),
                                  .pDeviceMemoryCallbacks = vk_headroom_callbacks()};
+    // NX2NAVI_VMA_BLOCK_MIB (default 0: VMA's 256 MiB): the size of VMA's memory blocks in large heaps. A block goes back
+    // to the driver only once every allocation in it is gone, and texture churn leaves many blocks partly used: lab
+    // replays (#160) after 45k frames hold 13.4-14.0 GiB of blocks for 9.0-9.5 GiB of allocations. Smaller blocks empty
+    // sooner, at the cost of more vkAllocateMemory calls.
+    const char *vb = cfg_get("NX2NAVI_VMA_BLOCK_MIB");
+    int vbm = vb && *vb ? atoi(vb) : 0;
+    if (vbm > 0 && vbm <= 1024) {
+        g_vk.vma_block = (VkDeviceSize)vbm << 20;
+        ai.preferredLargeHeapBlockSize = g_vk.vma_block;
+        rt_log("vk: VMA blocks of %d MiB in large heaps (NX2NAVI_VMA_BLOCK_MIB)", vbm);
+    }
     if ((r = vmaCreateAllocator(&ai, &g_vk.vma)) != VK_SUCCESS) { rt_log("vk: vmaCreateAllocator failed (%d)", (int)r); return 0; }
 
     VkSemaphoreTypeCreateInfo st = {.sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
diff --git a/runtime/vk_headroom.c b/runtime/vk_headroom.c
index 7809c64..3a6e1e0 100644
--- a/runtime/vk_headroom.c
+++ b/runtime/vk_headroom.c
@@ -55,7 +55,7 @@ const VmaDeviceMemoryCallbacks *vk_headroom_callbacks(void) {
 
 static VkDeviceSize block_size(const VkCtx *c, uint32_t type) {
     VkDeviceSize heap = c->mem_props.memoryHeaps[c->mem_props.memoryTypes[type].heapIndex].size;
-    return heap <= HR_SMALL_HEAP ? heap / 8 : 256ull << 20;   // VMA's default preferredLargeHeapBlockSize
+    return heap <= HR_SMALL_HEAP ? heap / 8 : c->vma_block ? c->vma_block : 256ull << 20;   // VMA's preferredLargeHeapBlockSize
 }
 
 static int room(const VkCtx *c, uint32_t type, VkDeviceSize block) {
