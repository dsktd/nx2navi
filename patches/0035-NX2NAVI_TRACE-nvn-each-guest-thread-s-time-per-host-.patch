+// ---- NX2NAVI_TRACE=nvn (#132): where the guest threads' frame goes, without a sampler
+// Every host function call and SVC is timed (rdtsc) into a table of its thread, exclusive of the host calls and SVCs
+// made inside it. Every 600 presents the presenting thread logs, for itself and the busiest other threads, per frame:
+// the time in host functions, in SVCs (the waits: 0x34 WaitForAddress, 0x18 WaitSynchronization, 0x1a/0x1c locks and
+// condition variables, 0xb sleep) and the rest, which is lifted guest code (plus waits for a virtual core outside a
+// call: NX2NAVI_TRACE=sched has those), and the entries that took the most time: 15 for the thread with the most guest
+// code, 6 for the others. The blocking calls (present and its pacing, queue and sync waits, pool map and
+// flush, nn::fs) are entries like any other. The thread handles are those of the sched trace. Fiber switches are not
+// timed: the call returns when the fiber is resumed, possibly on another thread. Off, the cost is one branch per call.
+#define ACCT_SVC 256
+#define ACCT_N (MAX_HOSTFN + ACCT_SVC)
+#define ACCT_THREADS 256
+#define ACCT_DEPTH 16
+typedef struct { uint64_t calls, ticks; } Acct;
+typedef struct {
+    Acct a[ACCT_N], prev[ACCT_N];   // since the start; as of the last report (the reporting thread's)
+    uint64_t child;                 // ticks of the timed calls inside the one running
+    // the running calls, innermost last: start, entry, and the ticks of it a report already booked (a wait that runs
+    // through a report: the thread's root is often a host function that never returns, so the innermost one counts)
+    struct { uint64_t t0, credit; int i; } open[ACCT_DEPTH];
+    int32_t depth;
+    uint64_t presents;
+    uint32_t handle;
+} AcctThread;
+static _Thread_local AcctThread *acct_t;
+static AcctThread *acct_all[ACCT_THREADS];
+static int32_t acct_n;
+static uint64_t acct_tsc, acct_ns;   // the last report
+
+__attribute__((noinline)) static AcctThread *acct_thread(void) {   // noinline: read again after a call
+    AcctThread *t = acct_t;
+    if (!t) {
+        if (!(t = acct_t = calloc(1, sizeof *t))) rt_fatal("hostfn: out of memory (NX2NAVI_TRACE=nvn)");
+        t->handle = kern_cur_handle();
+        int i = __atomic_fetch_add(&acct_n, 1, __ATOMIC_RELAXED);
+        if (i < ACCT_THREADS) __atomic_store_n(&acct_all[i], t, __ATOMIC_RELEASE);
+    }
+    return t;
+}
+
+// i: a host function slot, or -1 - n for SVC n.
+uint64_t hostfn_acct_begin(int i, uint64_t *save) {
+    AcctThread *t = acct_thread();
+    *save = t->child, t->child = 0;
+    uint64_t now = __builtin_ia32_rdtsc();
+    int d = t->depth;
+    if (d < ACCT_DEPTH) t->open[d].t0 = now, t->open[d].credit = 0, t->open[d].i = i < 0 ? MAX_HOSTFN + (-1 - i) : i;
+    __atomic_store_n(&t->depth, d + 1, __ATOMIC_RELEASE);
+    return now;
+}
+
+void hostfn_acct_end(int i, uint64_t t0, uint64_t save) {
+    AcctThread *t = acct_thread();
+    uint64_t dt = __builtin_ia32_rdtsc() - t0, own = dt > t->child ? dt - t->child : 0;
+    int d = t->depth - 1;
+    __atomic_store_n(&t->depth, d, __ATOMIC_RELEASE);
+    if (d < ACCT_DEPTH) {   // what a report booked while it ran
+        uint64_t c = __atomic_load_n(&t->open[d].credit, __ATOMIC_RELAXED);
+        own = own > c ? own - c : 0;
+    }
+    Acct *a = &t->a[i < 0 ? MAX_HOSTFN + (-1 - i) : i];
+    a->calls++, a->ticks += own;
+    t->child = save + dt;
+}
+
+static int acct_by_ticks(const void *x, const void *y) {
+    uint64_t a = *(const uint64_t *)x, b = *(const uint64_t *)y;   // {ticks, index}
+    return a < b ? 1 : -(a > b);
+}
+
+static void acct_report(AcctThread *self) {
+    static PlatMutex lock = PLAT_MUTEX_INIT;
+    static uint64_t order[ACCT_N][2], busy[ACCT_THREADS][2];
+    static Acct d[ACCT_N];
+    plat_mutex_lock(&lock);
+    uint64_t now = __builtin_ia32_rdtsc(), ns = plat_now_ns();
+    if (!acct_tsc) {   // the first window has no start: only the snapshots
+        int n = __atomic_load_n(&acct_n, __ATOMIC_RELAXED);
+        for (int i = 0; i < n && i < ACCT_THREADS; i++)
+            if (acct_all[i]) memcpy(acct_all[i]->prev, acct_all[i]->a, sizeof acct_all[i]->a);
+        acct_tsc = now, acct_ns = ns;
+        plat_mutex_unlock(&lock);
+        return;
+    }
+    uint64_t span = now - acct_tsc;
+    double k = (double)(ns - acct_ns) / (double)span / 600e6;   // ticks -> ms per frame
+    int n = __atomic_load_n(&acct_n, __ATOMIC_RELAXED), nb = 0;
+    if (n > ACCT_THREADS) n = ACCT_THREADS;
+    for (int i = 0; i < n; i++) {   // threads by their guest code time
+        AcctThread *t = __atomic_load_n(&acct_all[i], __ATOMIC_ACQUIRE);
+        if (!t) continue;
+        // a call still running (a wait, mostly): its time in this window is booked now and taken off when it ends
+        int dp = __atomic_load_n(&t->depth, __ATOMIC_ACQUIRE);
+        if (dp > 0 && dp <= ACCT_DEPTH && t != self) {
+            uint64_t o = t->open[dp - 1].t0, part = now - (o > acct_tsc ? o : acct_tsc);
+            if (o && o < now) {
+                t->prev[t->open[dp - 1].i].ticks -= part;
+                __atomic_fetch_add(&t->open[dp - 1].credit, part, __ATOMIC_RELAXED);
+            }
+        }
+        uint64_t in = 0;
+        for (int j = 0; j < ACCT_N; j++) in += t->a[j].ticks - t->prev[j].ticks;
+        busy[nb][0] = in < span ? span - in : 0, busy[nb][1] = (uint64_t)i, nb++;
+    }
+    qsort(busy, (size_t)nb, sizeof *busy, acct_by_ticks);
+    rt_log("nvn: presents %llu-%llu, %.2f ms per frame; presenting thread %#x; per thread and frame: guest code, host "
+           "functions, SVCs (waits), and the entries with the most time",
+           (unsigned long long)self->presents - 599, (unsigned long long)self->presents, span * k, self->handle);
+    for (int b = 0, shown = 0; b < nb; b++) {
+        AcctThread *t = acct_all[busy[b][1]];
+        if (shown >= 6 && t != self) {
+            memcpy(t->prev, t->a, sizeof t->a);
+            continue;
+        }
+        uint64_t in[2] = {0}, calls = 0;
+        int m = 0;
+        for (int i = 0; i < ACCT_N; i++) {
+            d[i] = (Acct){t->a[i].calls - t->prev[i].calls, t->a[i].ticks - t->prev[i].ticks};
+            t->prev[i].calls += d[i].calls, t->prev[i].ticks += d[i].ticks;
+            in[i >= MAX_HOSTFN] += d[i].ticks, calls += d[i].calls;
+            if (d[i].ticks) order[m][0] = d[i].ticks, order[m][1] = (uint64_t)i, m++;
+        }
+        qsort(order, (size_t)m, sizeof *order, acct_by_ticks);
+        uint64_t all = in[0] + in[1];
+        rt_log("nvn: thread %#x%s: guest code %.2f ms, host functions %.2f ms, SVCs %.2f ms, %.0f calls", t->handle,
+               t == self ? " (presents)" : "", (all < span ? span - all : 0) * k, in[0] * k, in[1] * k, calls / 600.0);
+        for (int j = 0; j < m && j < (shown ? 6 : 15); j++) {
+            int i = (int)order[j][1];
+            char svc[16];
+            snprintf(svc, sizeof svc, "svc %#x", i - MAX_HOSTFN);
+            rt_log("nvn:   %-56s %8.3f ms %9.1f calls %9.0f ns each", i < MAX_HOSTFN ? slots[i].name : svc,
+                   order[j][0] * k, d[i].calls / 600.0, d[i].calls ? order[j][0] * k * 600e6 / (double)d[i].calls : 0.0);
+        }
+        shown++;
+    }
+    acct_tsc = __builtin_ia32_rdtsc(), acct_ns = plat_now_ns();
+    plat_mutex_unlock(&lock);
+}
+
+__attribute__((noinline)) static void hostfn_timed(Cpu *c, Slot *s, int i) {
+    static int i_present = -1;
+    if (i_present < 0) {
+        int f = MAX_HOSTFN;
+        for (int k = 0; k < nslots; k++)
+            if (!strcmp(slots[k].name, "nvn:nvnQueuePresentTexture")) f = k;
+        i_present = f;
+    }
+    int fiber = s->fiber;
+    uint64_t save = 0, t0 = 0;
+    if (!fiber) t0 = hostfn_acct_begin(i, &save);
+    if (s->blocking) hostfn_blocking(c, s->fn);
+    else if (kern_host_track && c->thread) hostfn_tracked(c, s->fn);
+    else s->fn(c);
+    if (fiber) return;
+    hostfn_acct_end(i, t0, save);
+    if (i == i_present) {
+        AcctThread *t = acct_thread();
+        if (++t->presents % 600 == 0) acct_report(t);
+    }
+}
+
 static void hostfn_entry(Cpu *c) {
     uint64_t i = (c->pc - RT_HOSTFN_BASE) >> 4;
     if (__builtin_expect((c->pc & 15) || i >= (uint64_t)nslots, 0)) bad_entry(c);
     Slot *s = &slots[i];
+    if (__builtin_expect(rt_trace & RT_TRACE_NVN, 0)) {
+        __atomic_fetch_add(&s->calls, 1, __ATOMIC_RELAXED);
+        hostfn_timed(c, s, (int)i);
+        return;
+    }
     uint64_t n = __atomic_fetch_add(&s->calls, 1, __ATOMIC_RELAXED);
     if (__builtin_expect(!n && (rt_trace & RT_TRACE_HOSTCALL), 0)) {
         char lr[96];
