From 9d6b53dce2e19db2d84afc6b3692ccab52aa0878 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:06:03 -0500
Subject: [PATCH] NX2NAVI_WATCH=<addr>:<size>: log what touches a guest range
 (debug)

---
 runtime/vk.h           |  1 +
 runtime/vk_exec_draw.c |  1 +
 runtime/vk_exec_xfer.c |  1 +
 runtime/vk_memory.c    | 29 +++++++++++++++++++++++++++++
 4 files changed, 32 insertions(+)

diff --git a/runtime/vk.h b/runtime/vk.h
index 2c6c1af3..8eb894d6 100644
--- a/runtime/vk.h
+++ b/runtime/vk.h
@@ -420,6 +420,7 @@ void vk_gpu_written(uint64_t addr, uint64_t size);
 // buffer was picked (VK_MEM_USE / VK_MEM_PICK): 1 when [addr, addr+size) lies in one pool whose mirror is on.
 void vk_gpu_written_back(uint64_t addr, uint64_t size);
 int vk_mem_mirrored(uint64_t addr, uint64_t size);
+void vk_watch(const char *what, uint64_t a, uint64_t n, uint64_t v, const uint8_t *shadow);
 int vk_mem_flush_add_probe(void);        // --probe-vkexec: the flush range list; 0 or the number of the failed check
 uint64_t vk_mem_mirror_uploaded(void);   // --probe-vkexec: bytes copied into mirrors since the last summary line
 int vk_mem_mirror_probe(uint64_t addr);   // --probe-vkexec: the pool at addr gets its mirror as on a first buffer use;
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 7a8ae07f..d447cad1 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -7203,6 +7203,7 @@ static void op_update_ub(VkExec *ex, const p_update_ub *u) {
     VK_MEM_PICK(sp);
     VkBufferCopy cp = {o, sp.offset, u->size};
     vkCmdCopyBuffer(ex->cb, b, sp.buffer, 1, &cp);
+    vk_watch("ubupd", u->dst, u->size, u->size >= 4 ? *(const uint32_t *)u->data : 0, NULL);
     // In a submission's tail (vk_exec.c "the early tail") an update of a mirrored block reaches guest memory with the
     // results the game reads, from the bytes here, and takes no write-back: one after the tail would land when the
     // game is already writing the next frame's data. Not with the lazy write-back, where the block's pages may be
diff --git a/runtime/vk_exec_xfer.c b/runtime/vk_exec_xfer.c
index 4b6695c9..43177231 100644
--- a/runtime/vk_exec_xfer.c
+++ b/runtime/vk_exec_xfer.c
@@ -1088,6 +1088,7 @@ static void clear_buf(VkExec *ex, const p_clear_buf *p) {
         // copies (translator patch 0036), and a counter reset here must start from the same value in both.
         VkBuffer twin = vk_mem_guest_twin(&d);
         if (twin) vkCmdFillBuffer(ex->cb, twin, d.offset, n, p->value), ex->recorded++;
+        vk_watch("fill", dst, n, p->value, NULL);
         vk_mem_gpu_wrote(&d, n);
         ex->recorded++;
         vk_mem_count(d.cls, VK_MUSE_GPU_WRITE, n);
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index b3402816..1d237143 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -1223,6 +1223,32 @@ static int query_stamp(uint64_t lo, uint64_t hi, uint32_t g) {
     }
 }
 
+// ---- NX2NAVI_WATCH=<addr>:<size> (debug): log what touches that range, with its guest (and shadow) words.
+static uint64_t w_lo, w_hi;
+static int w_init;
+static volatile int32_t w_n;
+static void watch_init(void) {
+    if (w_init) return;
+    w_init = 1;
+    const char *e = getenv("NX2NAVI_WATCH");
+    if (e && *e) {
+        char *x;
+        w_lo = strtoull(e, &x, 16);
+        w_hi = w_lo + (*x == ':' ? strtoull(x + 1, NULL, 16) : 0x100);
+        rt_log("watch: %#llx..%#llx", (unsigned long long)w_lo, (unsigned long long)w_hi);
+    }
+}
+void vk_watch(const char *what, uint64_t a, uint64_t n, uint64_t v, const uint8_t *shadow) {
+    watch_init();
+    if (!w_hi || a >= w_hi || a + n <= w_lo) return;
+    if (plat_inc32(&w_n) > 6000) return;
+    const uint32_t *g = (const uint32_t *)(uintptr_t)w_lo;
+    const uint32_t *s = (const uint32_t *)shadow;
+    rt_log("watch %s %#llx+%#llx v=%#llx guest w0=%08x w13=%08x w14=%08x w32=%08x%s shadow w13=%08x w14=%08x",
+           what, (unsigned long long)a, (unsigned long long)n, (unsigned long long)v, g[0], g[13], g[14], g[32],
+           s ? "" : " (no", s ? s[13] : 0, s ? s[14] : 0);
+}
+
 // ---------------------------------------------------------------- shadow storage
 // Where importing guest memory costs too much (Linux: re-protecting pages that amdgpu imported as a userptr
 // invalidates the buffer, about 1.3 ms per 16 MiB at the next submit, and the import's write pinning clears the
@@ -1564,6 +1590,7 @@ static void shadow_forget(PoolRec *r) {
 
 // shadow_lock held: copies guest [a, b) into the shadow; of a page with a base copy only the CPU's bytes (merge_page).
 static void shadow_copy(PoolRec *r, uint64_t a, uint64_t b) {
+    if (w_hi && a < w_hi && b > w_lo) vk_watch("cpu->shadow", a, b - a, 0, r->smap + (w_lo - r->import_lo));
     while (a < b) {
         uint64_t e = b;
         uint8_t *base = NULL;
@@ -1656,6 +1683,7 @@ static void shadow_sync_pool(PoolRec *r, uint32_t epoch, int cpu) {
 // Record time: the GPU may write [addr, addr+size) of CPU-visible memory. With shadow storage the pages it covers get
 // their base copies before the submission's copy-in (vk_mem_shadow_sync) can reach them.
 void vk_mem_gpu_pending(uint64_t addr, uint64_t size) {
+    vk_watch("gpu-pending", addr, size, 0, NULL);
     if (!shadow_on || !size) return;
     plat_mutex_lock_shared(&pool_lock);
     const pidx_ent *e = pidx_find(&pool_index, addr, size);
@@ -1730,6 +1758,7 @@ static uint64_t shadow_write_back(uint64_t addr, uint64_t size) {
     PoolRec *r = e ? e->buf : NULL;
     plat_mutex_lock(&shadow_lock);
     if (r && r->smap && addr >= r->import_lo && addr + size <= r->import_hi) {
+        if (w_hi && addr < w_hi && addr + size > w_lo) vk_watch("wb-fence", addr, size, 0, r->smap + (w_lo - r->import_lo));
         uint64_t t0 = qpc();
         mem_thaw(addr, size);
         if (bulk) plat_mem_prepare_write(addr, size);
