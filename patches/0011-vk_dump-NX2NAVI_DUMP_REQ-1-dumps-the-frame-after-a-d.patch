From fd4acc2229f52549723014dcc9b9277c154f808a Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 8 Nov 2026 19:11:37 -0500
Subject: [PATCH] vk_dump: NX2NAVI_DUMP_REQ=1 dumps the frame after a dump.req
 file appears

A file dump.req beside the shader cache asks for a dump of the next frame into
<dump dir>/f<frame>, so a running game can be dumped on request, more than once.
---
 runtime/cfg.c     |  1 +
 runtime/vk_dump.c | 20 +++++++++++++++++---
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 8b155697..dd4758bc 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -87,6 +87,7 @@ static const char *const known[] = {
     "COOP", "COOP_BETA", "COOP_NAME", "COOP_SERVER", "COOP_PORT", "COOP_ROOM", "COOP_AUTO", "COOP_DROP",
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",
     "COOP_TEST_SET", "COOP_ACCEPT", "COOP_REMOVE", "COOP_RESET_POOLS",
+    "DUMP_REQ",
 };
 
 // The nx2navi.ini section a key cfg_set may write goes to when the file lacks it (nx2navi.ini.example's sections).
diff --git a/runtime/vk_dump.c b/runtime/vk_dump.c
index b43263ad..ed026d45 100644
--- a/runtime/vk_dump.c
+++ b/runtime/vk_dump.c
@@ -68,6 +68,8 @@ static uint64_t dump_after;             // NX2NAVI_DUMP_AFTER
 static int dump_key;                    // NX2NAVI_DUMP_KEY: the Windows virtual-key code, 0 off
 static const char *dump_key_name;
 static FILE *passes_f, *images_f;
+static int dump_req;                   // NX2NAVI_DUMP_REQ=1: a file dump.req beside the shader cache dumps the next frame
+static char req_path[600];
 static int seq, finished, copied;      // copied: passes and dispatches of the dump frame whose images were copied
 static int skip_runs, dump_ubo;        // NX2NAVI_DUMP_SKIP_RUNS, NX2NAVI_DUMP_UBO (vec4 per block, 0 for none)
 static int dump_raw, ncopy_shaders;
@@ -1204,7 +1206,11 @@ void vk_dump_init(void) {
             if (!strcasecmp(k, keys[i].n)) dump_key = keys[i].vk, dump_key_name = i ? keys[i].n : "pause";
         if (k && *k && strcmp(k, "0") && !dump_key) rt_log("vk_dump: NX2NAVI_DUMP_KEY=%s: not a key this knows (pause, scrolllock, insert, home, end, pageup, pagedown, f2-f7, f9, f12)", k);
     }
-    if (dump_white || dump_after) {
+    const char *dr = cfg_get("NX2NAVI_DUMP_REQ");
+    dump_req = dr && atoi(dr) == 1 && gfx_shader_beside_cache("dump.req", req_path, sizeof req_path);
+    if (dump_req && !dump_white && !dump_after) {
+        dump_frame = UINT64_MAX;
+    } else if (dump_white || dump_after) {
         dump_frame = UINT64_MAX;
         vk_thumbs_enable(16);
     } else if (movie_k || key_mode || dump_file[0] || dump_key) {
@@ -1239,7 +1245,7 @@ void vk_dump_init(void) {
     snprintf(base_dir, sizeof base_dir, "%s", d && *d ? d : "dump");
     snprintf(dir, sizeof dir, "%s", base_dir);
     char path[600];
-    if (!dump_white && !movie_k && !key_mode && !dump_file[0]) open_files();
+    if (!dump_white && !movie_k && !key_mode && !dump_file[0] && !dump_req) open_files();
     const char *bf = cfg_get("NX2NAVI_DUMP_BUF");
     if (bf && *bf) {
         char *q;
@@ -1349,6 +1355,14 @@ void vk_dump_present(uint64_t frame) {
         dump_frame = frame + 1;
         rt_log("vk_dump: %s: frame %llu goes to %s", dump_key_name, (unsigned long long)dump_frame, dir);
     }
+    if (dump_req && dump_frame == UINT64_MAX && plat_file_exists(req_path)) {   // asked for: dump the next frame
+        plat_file_delete(req_path);
+        dump_frame = frame + 1;
+        snprintf(dir, sizeof dir, "%s/f%llu", base_dir, (unsigned long long)dump_frame);
+        open_files();
+        rt_log("vk_dump: dump.req: frame %llu goes to %s", (unsigned long long)dump_frame, dir);
+        return;
+    }
     if (frame != dump_frame) return;
     plat_mutex_lock(&rec_lock);
     finished = 1;
@@ -1365,7 +1379,7 @@ void vk_dump_present(uint64_t frame) {
     passes_f = NULL;
     rt_log("vk_dump: frame %llu: %d passes and dispatches, about %llu MB of PNGs in %s", (unsigned long long)frame, seq,
            (unsigned long long)(png_bytes >> 20), dir);
-    if (dump_white || movie_k || key_mode || dump_file[0] || dump_key) {   // ready for another dump (vk_dump_present checks a white one's thumbnail 3 presents on)
+    if (dump_white || movie_k || key_mode || dump_file[0] || dump_key || dump_req) {   // ready for another dump (vk_dump_present checks a white one's thumbnail 3 presents on)
         if (dump_white) white_last = frame;
         plat_mutex_lock(&rec_lock);
         seq = copied = 0, last_targets = 0, pass_skip = NULL, png_bytes = 0;
