-    rsh = calloc(SNAP_REGIONS, sizeof *rsh), treg_gen = calloc(SNAP_REGIONS, 4), treg_i = calloc(SNAP_REGIONS, 4);
+    rsh = calloc(SNAP_REGIONS, sizeof *rsh), treg_gen = calloc(SNAP_REGIONS, sizeof *treg_gen), treg_i = calloc(SNAP_REGIONS, 4);
     if (!rsh || !treg_gen || !treg_i) rt_fatal("vk: out of memory for the table's regions");
     return 1;
 }
@@ -2462,7 +2462,7 @@ static uint64_t shadow_write_back(uint64_t addr, uint64_t size) {
