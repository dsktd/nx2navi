-static uint32_t *treg_gen, *treg_i;               // shadow_lock: per region: gen_now after its last visit; 1 + index in tregs
+static uint64_t *treg_gen; static uint32_t *treg_i;             // shadow_lock: per region: gen_now after its last visit; 1 + index in tregs
