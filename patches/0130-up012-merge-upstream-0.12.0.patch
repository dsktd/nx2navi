From 080be8853d65c85017f86048b6934fa1a59facb1 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 15 Nov 2026 20:19:01 -0500
Subject: [PATCH 1/2] up012: shadow page-gen readers take upstream's 64-bit gen
 tables (vk_memory.c 0094/0095 after upstream widened gen_chunk/reg_max)

---
 runtime/vk_memory.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 1aa411d..4259a3e 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -3734,7 +3734,7 @@ static int shadow_pool_pages_clean(const PoolRec *r, uint32_t epoch, int cpu) {
         uint64_t a = k << REG_SHIFT, b = a + (1ull << REG_SHIFT);
         if (a < lo) a = lo;
         if (b > hi) b = hi;
-        const uint32_t *ch = (cpu ? cgen_chunk : gen_chunk)[a >> GEN_CHUNK_SHIFT];
+        const uint64_t *ch = (cpu ? cgen_chunk : gen_chunk)[a >> GEN_CHUNK_SHIFT];
         if (!ch) continue;
         for (uint64_t x = a; x < b; x += 1ull << GEN_PAGE_SHIFT)
             if (ch[(x >> GEN_PAGE_SHIFT) & (GEN_PER_CHUNK - 1)] > r->sgen) return 0;
@@ -3812,7 +3812,7 @@ void vk_mem_shadow_sync(uint64_t fence) {
         uint64_t t1 = qpc(), copied0 = s_copied;
         if (table && tab_dirty) {   // the regions stamped since the last table sync, and their shadows
             uint32_t vis = ++stab_visit;
-            const uint32_t *mx = cpu ? creg_max : reg_max;
+            const uint64_t *mx = cpu ? creg_max : reg_max;
             if (tab_runs) s_queries += snap_tregs_runs(epoch);
             else
                 for (int i = 0; i < ntregs; i++) s_queries += snap_regions(tregs[i], tregs[i], epoch);
-- 
2.56.0


