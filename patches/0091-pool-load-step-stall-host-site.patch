From cc8416c1887c896c66241c196d021c150cd3b093 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:43:20 -0500
Subject: [PATCH] vk_exec_draw: NX2NAVI_POOL_LOAD_STEP=128 (0: old) caps a
 refresh's creations while the pool is loading, so an area load runs over
 frames instead of one 1.3 s replay frame with the game's main thread blocked
 on it; stall lines name each thread's entry and its longest host call (caller
 RVA, game lr)

---
 runtime/cfg.c          |  6 +++---
 runtime/kernel.c       | 22 ++++++++++++++++++++--
 runtime/vk_exec_draw.c | 11 +++++++++--
 3 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 2cc8b8ca..d439a7a4 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -78,7 +78,7 @@ static const char *const known[] = {
     "ZSTD_CHECK", "ZSTD_NATIVE",
     "BIND_REUSE", "DYN_DELTA", "STG_ARENA", "SUBMIT_BATCH", "SUBMIT_THREAD", "ASTC_GPU_DESWIZZLE", "ASTC_SCRATCH_KEEP", "ASTC_ARENA", "ASTC_BC1",
     "TEXUP_LOG_MS", "DYN_RES", "DYN_RES_TARGET", "DYN_RES_STEP", "TEXTURE_DETAIL",
-    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS",
+    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP",
     "VMA_BLOCK_MB", "SYNC_WAKE_ALL", "LOG_ASYNC", "DEVICE_LOST_AT", "STAGING_FAIL_AT", "VRAM_BALLAST_MB",
     "COOP_STEAM", "COOP_SHARE", "COOP_NAMES", "COOP_CHAT",   // co-op (coop.c, coop_game.c, ui/coop_page.cpp)
     // retired: the settings of the co-op of versions up to 0.9.2; read by nothing, listed so that a file which still
@@ -147,7 +147,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"DYN_DELTA", "performance"}, {"STG_ARENA", "performance"}, {"SUBMIT_BATCH", "performance"}, {"SUBMIT_THREAD", "performance"},
     {"BUILD_FREE_MB", "performance"}, {"BUILD_RESERVE_MB", "performance"}, {"MEM_NEED_MB", "diagnostics"},
     {"ASTC_GPU_DESWIZZLE", "performance"}, {"ASTC_SCRATCH_KEEP", "performance"}, {"ASTC_ARENA", "performance"}, {"ASTC_BC1", "performance"}, {"POOL_CREATE_BUDGET", "performance"},
-    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"},
+    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"},
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"}, {"ONESHOT_BUDGET", "performance"},
     {"PIPE_FRAME_WAIT_MS", "performance"}, {"PIPE_SKIP_STEADY", "performance"},
     {"CACHE_DIE", "performance"}, {"ONE_PER_CORE", "performance"},
@@ -273,7 +273,7 @@ static const CfgMeta metas[] = {
     {"DYN_RES", "0", "0|1", LIVE}, {"DYN_RES_TARGET", "16.7", "1..100", LIVE}, {"DYN_RES_STEP", "45", "8..600", LIVE},
     // the recording thread: a core of its own (auto: with 12 or more logical processors) and the highest priority
     // (vk_exec.c rec_claim)
-    {"RECORDER_CORE", "0", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART},
+    {"RECORDER_CORE", "0", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART},
     // held submissions handed to the queue together (vk_sync.c, submit batching)
     {"SUBMIT_BATCH", "4", "1..16", RESTART},
 #ifdef _WIN32
diff --git a/runtime/kernel.c b/runtime/kernel.c
index 524c3b64..aa85d6db 100644
--- a/runtime/kernel.c
+++ b/runtime/kernel.c
@@ -87,6 +87,8 @@ struct RtThread {
     int st;                    // S_* state since st_since
     uint64_t st_since, st_ns[S_N], nblk, npre, pre_since, cpu_last;
     uint64_t sl_st[S_N];       // NX2NAVI_STALL_MS: the states' sums at the previous present
+    uint64_t hl_ns, hl_at, hl_lr;   // NX2NAVI_STALL_MS: the longest host interval since then, its caller, the guest lr
+    uint64_t h_lr;             // NX2NAVI_STALL_MS: the guest lr of the host call in progress (kern_core_away)
     uint64_t wobj;             // what the current wait is on: owner handle, key, address or first handle
     const uint32_t *whs;       // a WaitSynchronization that blocks: its handles, in the waiter's own memory (holding G)
     int wn;
@@ -178,6 +180,8 @@ static void acct(RtThread *t, int st) {
     uint64_t now = kern_now_ns();
     if (t->st_since) {
         t->st_ns[t->st] += now - t->st_since;
+        if (t->st == S_HOST && g_stall_on && now - t->st_since > t->hl_ns)
+            t->hl_ns = now - t->st_since, t->hl_at = t->wobj, t->hl_lr = t->h_lr;
         if (t->st >= S_HOST && (t == g_render || t->is_main)) {
             uint32_t waker = t->st == S_HOST || t->st == S_SLEEP ? 0 : t->waker;
             wait_add(t == g_render ? g_rw : g_mw, t->st, t->wobj, waker, now - t->st_since);
@@ -1008,8 +1012,9 @@ int kern_core_away(void) {
     lock();
     core_put(t);
     acct(t, S_HOST);
-    if (rt_trace & RT_TRACE_SCHED)   // the caller as an exe RVA (nx2navi.map)
+    if ((rt_trace & RT_TRACE_SCHED) || g_stall_on)   // the caller as an exe RVA (nx2navi.map)
         t->wobj = (uintptr_t)__builtin_return_address(0) - plat_exe_base();
+    if (g_stall_on) t->h_lr = t->cur ? t->cur->x[30] : 0;   // the game code that made the host call
     unlock();
     return 1;
 }
@@ -1369,7 +1374,11 @@ void kern_stall_frame(uint64_t frame, uint64_t interval_ns) {
     }
     if (!g_stall_on) return;
     enum { ROWS = 6, TH = 128 };
-    typedef struct { uint32_t h, tid; int prio, main, render; uint64_t st[S_N], run, rq, flt, maj, busy; } Row;
+    typedef struct {
+        uint32_t h, tid;
+        int prio, main, render;
+        uint64_t st[S_N], run, rq, flt, maj, busy, hl_ns, hl_at, hl_lr, entry;
+    } Row;
     static struct { uint32_t tid; uint64_t run, rq, flt, maj; } base[TH];   // the host's sums at the previous present
     static Row th[TH];
     Row r[ROWS];
@@ -1382,6 +1391,8 @@ void kern_stall_frame(uint64_t frame, uint64_t interval_ns) {
         x->h = t->handle, x->tid = t->tid, x->prio = t->prio, x->main = t->is_main, x->render = t == g_render;
         for (int k = 0; k < S_N; k++) x->st[k] = t->st_ns[k] - t->sl_st[k];
         memcpy(t->sl_st, t->st_ns, sizeof t->sl_st);
+        x->hl_ns = t->hl_ns, x->hl_at = t->hl_at, x->hl_lr = t->hl_lr, x->entry = t->entry;
+        t->hl_ns = 0;
     }
     unlock();
     for (int i = 0; i < nt; i++) {
@@ -1414,6 +1425,13 @@ void kern_stall_frame(uint64_t frame, uint64_t interval_ns) {
         rt_log("stall:   thread %#x p%d tid %u%s%s:%s ms; host CPU %.1f ms, run queue %.1f ms, faults %llu (major %llu)",
                r[i].h, r[i].prio, r[i].tid, r[i].main ? " main" : "", r[i].render ? " render" : "", o ? s : " idle",
                r[i].run / 1e6, r[i].rq / 1e6, (unsigned long long)r[i].flt, (unsigned long long)r[i].maj);
+        // Which thread it is and which host call held it: the caller of kern_core_away as an exe RVA (nx2navi.map),
+        // the game code that called it
+        char e[160], l[160];
+        if (!r[i].main) ldr_describe(r[i].entry, e, sizeof e);
+        if (r[i].hl_ns >= 1000000) ldr_describe(r[i].hl_lr, l, sizeof l);
+        rt_log("stall:     %#x entry %s; longest host call %.1f ms at exe+%#llx, game code %s", r[i].h,
+               r[i].main ? "main" : e, r[i].hl_ns / 1e6, (unsigned long long)r[i].hl_at, r[i].hl_ns >= 1000000 ? l : "-");
     }
 }
 
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 6000c706..c29dc91a 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -2223,13 +2223,20 @@ static int pool_load_backlog(void) {
     return n;
 }
 
+// NX2NAVI_POOL_LOAD_STEP (default 128; 0: none, the old way): the count budget of a refresh while the pool is loading.
+// Without one the frame's first refresh made the whole load, since NX2NAVI_POOL_LOAD_MS is only checked between
+// refreshes: in Hyrule Field (play26, rebase-upstream 7a35985) 3,974 textures took one 1.3 s replay frame and 839
+// another of 300 ms, the game's main thread blocked in a host call on the replay all that time. With a step, each
+// refresh makes that many and the later refreshes of the frame stop at NX2NAVI_POOL_LOAD_MS, so the load runs over
+// frames (their presents still held) and the game keeps running.
 static int pool_create_budget(void) {
-    static int n = -1;
+    static int n = -1, step;
     if (n < 0) {
         n = cfg_int("NX2NAVI_POOL_CREATE_BUDGET");
         if (n < 1) n = 1;
+        step = cfg_int("NX2NAVI_POOL_LOAD_STEP");
     }
-    return pool_loading ? 1 << 20 : n;
+    return pool_loading ? (step > 0 ? step : 1 << 20) : n;
 }
 
 // The refresh runs before every draw that binds the pools, not once per submission, so the count above held for each
