diff --git a/runtime/motion_sock.c b/runtime/motion_sock.c
new file mode 100644
index 0000000..2e568b5
--- /dev/null
+++ b/runtime/motion_sock.c
@@ -0,0 +1,111 @@
+// Motion from a Unix socket: see motion_sock.h. Called from the motion thread only (input.c motion_main).
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "host.h"
+#include "motion_sock.h"
+
+static const char magic[8] = "YAKMOT1";   // with its NUL: 8 bytes
+
+int motion_sock_default(char *out, int size) {
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    if (!dir || !*dir) return 0;
+    int n = snprintf(out, (size_t)size, "%s/yakin/motion.sock", dir);
+    return n > 0 && n < size;
+}
+
+#ifdef _WIN32
+int motion_sock_poll(MotionSock *s, const char *path, uint64_t now, float a[3], float g[3]) {
+    (void)s, (void)path, (void)now, (void)a, (void)g;
+    return 0;
+}
+void motion_sock_close(MotionSock *s) { s->fd = -1; }
+#else
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static void drop(MotionSock *s, uint64_t now, const char *why) {
+    if (s->fd >= 0) close(s->fd);
+    s->fd = -1, s->fill = 0, s->last_ns = 0;
+    s->retry_ns = now + MOTION_SOCK_RETRY_MS * 1000000ull;
+    if (why) rt_log("input: motion socket %s", why);
+}
+
+void motion_sock_close(MotionSock *s) {
+    if (s->fd >= 0) close(s->fd), rt_log("input: motion socket closed (gamepad sensors in use or motion off)");
+    s->fd = -1, s->fill = 0, s->last_ns = 0, s->retry_ns = 0;
+}
+
+static void open_sock(MotionSock *s, const char *path, uint64_t now) {
+    struct sockaddr_un sa = {.sun_family = AF_UNIX};
+    if (strlen(path) >= sizeof sa.sun_path) {
+        s->retry_ns = UINT64_MAX;   // never fits: do not retry
+        rt_log("input: motion socket path too long: %s", path);
+        return;
+    }
+    memcpy(sa.sun_path, path, strlen(path) + 1);
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (fd < 0) { drop(s, now, NULL); return; }
+    // A Unix socket connects at once or fails (missing, refused, backlog full: EAGAIN): a quiet retry in a second
+    if (connect(fd, (struct sockaddr *)&sa, sizeof sa) && errno != EINPROGRESS) {
+        close(fd);
+        drop(s, now, NULL);
+        return;
+    }
+    s->fd = fd, s->magic = sizeof magic, s->fill = 0, s->last_ns = 0;
+    rt_log("input: motion socket %s connected", path);
+}
+
+static float f32(const unsigned char *p) {
+    uint32_t u = (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+
+int motion_sock_poll(MotionSock *s, const char *path, uint64_t now, float a[3], float g[3]) {
+    if (s->fd < 0) {
+        if (!path || !*path || now < s->retry_ns) return 0;
+        open_sock(s, path, now);
+        if (s->fd < 0) return 0;
+    }
+    unsigned char in[4096];
+    for (;;) {
+        ssize_t n = recv(s->fd, in, sizeof in, MSG_DONTWAIT);
+        if (n == 0) { drop(s, now, "closed by the server"); return 0; }
+        if (n < 0) {
+            if (errno == EINTR) continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK) break;
+            drop(s, now, "read failed");
+            return 0;
+        }
+        const unsigned char *p = in;
+        while (n > 0) {
+            if (s->magic) {
+                int k = n < s->magic ? (int)n : s->magic;
+                if (memcmp(p, magic + sizeof magic - s->magic, (size_t)k)) {
+                    drop(s, now, "sent a bad magic (not YAKMOT1)");
+                    return 0;
+                }
+                s->magic -= k, p += k, n -= k;
+                continue;
+            }
+            int k = MOTION_SOCK_RECORD - s->fill;
+            if (n < k) k = (int)n;
+            memcpy(s->buf + s->fill, p, (size_t)k);
+            s->fill += k, p += k, n -= k;
+            if (s->fill < MOTION_SOCK_RECORD) break;
+            s->fill = 0, s->records++, s->last_ns = now;   // bytes 0..7: the server's timestamp, unused
+            for (int i = 0; i < 3; i++) s->a[i] = f32(s->buf + 8 + 4 * i), s->g[i] = f32(s->buf + 20 + 4 * i);
+        }
+    }
+    if (!s->last_ns || now - s->last_ns > MOTION_SOCK_STALE_MS * 1000000ull) return 0;
+    memcpy(a, s->a, sizeof s->a);
+    memcpy(g, s->g, sizeof s->g);
+    return 1;
+}
+#endif
diff --git a/runtime/motion_sock.h b/runtime/motion_sock.h
new file mode 100644
index 0000000..54b11fe
--- /dev/null
+++ b/runtime/motion_sock.h
@@ -0,0 +1,33 @@
+// Motion from a Unix socket (motion_sock.c): raw gyro and accelerometer samples served by a controller daemon
+// whose virtual gamepad has no sensors of its own. Read-only client of one SOCK_STREAM socket: the server sends the
+// 8 bytes "YAKMOT1\0", then 32-byte little-endian records: u64 CLOCK_MONOTONIC microseconds, f32 accelerometer x, y, z
+// in m/s^2, f32 gyro x, y, z in rad/s, in SDL3's gamepad sensor convention (what SDL_SENSOR_ACCEL / _GYRO carry).
+// Never blocks: connects without waiting, retries every second while the socket is missing or after the server
+// dropped us, and reads what has arrived. Off Linux and macOS it never connects.
+#ifndef MOTION_SOCK_H
+#define MOTION_SOCK_H
+#include <stdint.h>
+
+enum { MOTION_SOCK_RECORD = 32, MOTION_SOCK_RETRY_MS = 1000, MOTION_SOCK_STALE_MS = 250 };
+
+typedef struct MotionSock {
+    int fd;                       // -1 closed
+    int magic;                    // bytes of the magic still expected (8 after a connect, 0 once it matched)
+    int fill;                     // bytes of a partial record in buf
+    unsigned char buf[MOTION_SOCK_RECORD];
+    uint64_t retry_ns;            // no connect before this
+    uint64_t last_ns;             // when the newest record arrived, 0 none since the connect
+    uint64_t records;             // records read, all connections
+    float a[3], g[3];             // the newest record
+} MotionSock;
+
+#define MOTION_SOCK_INIT {.fd = -1}
+
+// The default socket: $XDG_RUNTIME_DIR/yakin/motion.sock into out; 0 without XDG_RUNTIME_DIR or room.
+int motion_sock_default(char *out, int size);
+// Poll at time now (any monotonic ns clock): (re)connects to path when due, reads what arrived. 1 with the newest
+// sample in a and g (SDL units and axes) when one arrived within MOTION_SOCK_STALE_MS, else 0.
+int motion_sock_poll(MotionSock *s, const char *path, uint64_t now, float a[3], float g[3]);
+// Closes the connection (no motion wanted); the next poll connects again at once.
+void motion_sock_close(MotionSock *s);
+#endif
diff --git a/runtime/motion_sock_probe.c b/runtime/motion_sock_probe.c
new file mode 100644
index 0000000..3575ddc
--- /dev/null
+++ b/runtime/motion_sock_probe.c
@@ -0,0 +1,120 @@
+// --probe-motion-sock: the motion socket client (motion_sock.c) against a server this probe plays itself, one thread:
+// magic, records split across writes, the newest record into the fusion (input_motion_axes, motion_feed), stale
+// samples, a bad magic, the server going away and the retry a second later. Needs no game files or gamepad.
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "host.h"
+#include "input.h"
+#include "motion_sock.h"
+
+#ifdef _WIN32
+int probe_motion_sock(void) {
+    printf("probe-motion-sock: skipped (no Unix sockets)\n");
+    return 0;
+}
+#else
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static int fails;
+#define CHECK(c, what) do { if (!(c)) { fails++; fprintf(stderr, "FAIL motion-sock: %s\n", what); } } while (0)
+enum { MS = 1000000 };
+
+static void put_record(unsigned char *p, uint64_t us, const float a[3], const float g[3]) {
+    for (int i = 0; i < 8; i++) p[i] = (unsigned char)(us >> (8 * i));
+    for (int i = 0; i < 6; i++) {
+        uint32_t u;
+        memcpy(&u, i < 3 ? &a[i] : &g[i - 3], 4);
+        for (int b = 0; b < 4; b++) p[8 + 4 * i + b] = (unsigned char)(u >> (8 * b));
+    }
+}
+
+static int listen_at(const char *path) {
+    struct sockaddr_un sa = {.sun_family = AF_UNIX};
+    snprintf(sa.sun_path, sizeof sa.sun_path, "%s", path);
+    unlink(path);
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0 || bind(fd, (struct sockaddr *)&sa, sizeof sa) || listen(fd, 4)) return -1;
+    return fd;
+}
+
+int probe_motion_sock(void) {
+    char dir[] = "/tmp/nx2navi-motion-XXXXXX", path[128];
+    if (!mkdtemp(dir)) return 1;
+    snprintf(path, sizeof path, "%s/motion.sock", dir);
+    MotionSock s = MOTION_SOCK_INIT;
+    float a[3], g[3];
+    uint64_t t = 1000ull * MS;
+
+    CHECK(!motion_sock_poll(&s, path, t, a, g) && s.fd < 0, "no socket: no motion, not connected");
+    int lfd = listen_at(path);
+    if (lfd < 0) return 1;
+    CHECK(!motion_sock_poll(&s, path, t + 500 * MS, a, g) && s.fd < 0, "retry waits a second");
+    t += 1001 * MS;
+    CHECK(!motion_sock_poll(&s, path, t, a, g) && s.fd >= 0, "connects once due, no sample yet");
+    int c = accept(lfd, NULL, NULL);
+
+    // Synthetic rotation: yaw 2 rad/s about SDL's y, lying flat (gravity on SDL's +y as the accelerometer reads it)
+    const float acc[3] = {0, 9.80665f, 0}, gyro[3] = {0.25f, 2.0f, -0.5f};
+    unsigned char out[8 + 3 * 32];
+    memcpy(out, "YAKMOT1", 8);
+    for (int i = 0; i < 3; i++) put_record(out + 8 + 32 * i, (uint64_t)i * 4000, acc, gyro);
+    CHECK(write(c, out, 5) == 5, "write");   // half the magic
+    CHECK(!motion_sock_poll(&s, path, t + 1 * MS, a, g), "partial magic: no sample");
+    CHECK(write(c, out + 5, 8 + 32 + 13 - 5) == 8 + 32 + 13 - 5, "write");   // rest of magic, a record and a part
+    CHECK(motion_sock_poll(&s, path, t + 2 * MS, a, g) && s.records == 1, "one record after the split magic");
+    CHECK(a[1] == acc[1] && g[0] == gyro[0] && g[1] == gyro[1] && g[2] == gyro[2], "record values unchanged");
+    CHECK(write(c, out + 8 + 32 + 13, sizeof out - 8 - 32 - 13) == (ssize_t)(sizeof out - 8 - 32 - 13), "write");
+    CHECK(motion_sock_poll(&s, path, t + 3 * MS, a, g) && s.records == 3, "partial record completed, newest kept");
+
+    // Into the fusion as the motion thread feeds it: Switch z = SDL y, Switch y = -SDL z; rad/s -> revolutions/s
+    MotionFusion *m = motion_new();
+    double ac[3], gy[3];
+    for (int i = 0; i < 50; i++) {
+        input_motion_axes(a, g, ac, gy);
+        motion_feed(m, ac, gy, t + (uint64_t)i * 4 * MS);
+    }
+    MotionState st;
+    CHECK(motion_read(m, &st, 1, t + 49 * 4 * MS) == 1, "fusion has a sample");
+    CHECK(fabsf(st.gyro[2] - 2.0f / (float)(2 * M_PI)) < 1e-5f && fabsf(st.gyro[1] - 0.5f / (float)(2 * M_PI)) < 1e-5f &&
+              fabsf(st.gyro[0] - 0.25f / (float)(2 * M_PI)) < 1e-5f, "gyro in revolutions/s on Switch axes");
+    CHECK(fabsf(st.acc[1] + 0.0f) < 1e-5f && fabsf(st.acc[2] + 1.0f) < 1e-4f, "lying flat reads z = -1 G");
+    CHECK(fabsf(st.angle[2] - 50 * 0.004f * 2.0f / (float)(2 * M_PI)) < 1e-3f, "yaw angle integrates (50 samples of 4 ms)");
+    printf("probe-motion-sock: fusion gyro %.4f %.4f %.4f rev/s, acc %.3f %.3f %.3f G, yaw %.4f rev\n", st.gyro[0],
+           st.gyro[1], st.gyro[2], st.acc[0], st.acc[1], st.acc[2], st.angle[2]);
+
+    // Silent server: the sample goes stale after 250 ms; the connection stays
+    CHECK(motion_sock_poll(&s, path, t + 200 * MS, a, g), "fresh at 197 ms");
+    CHECK(!motion_sock_poll(&s, path, t + 260 * MS, a, g) && s.fd >= 0, "stale at 257 ms, still connected");
+    put_record(out, 1, acc, gyro);
+    CHECK(write(c, out, 32) == 32, "write");
+    CHECK(motion_sock_poll(&s, path, t + 300 * MS, a, g), "fresh again with a new record");
+
+    // Server drops us: no motion, a retry a second later connects again
+    close(c);
+    t += 400 * MS;
+    CHECK(!motion_sock_poll(&s, path, t, a, g) && s.fd < 0, "disconnect noticed");
+    CHECK(!motion_sock_poll(&s, path, t + 900 * MS, a, g) && s.fd < 0, "no reconnect before a second");
+    t += 1001 * MS;
+    CHECK(!motion_sock_poll(&s, path, t, a, g) && s.fd >= 0, "reconnected");
+    c = accept(lfd, NULL, NULL);
+    CHECK(write(c, "NOTYAK!", 8) == 8, "write");
+    CHECK(!motion_sock_poll(&s, path, t + MS, a, g) && s.fd < 0, "bad magic drops the connection");
+    close(c);
+
+    // Socket removed: quiet retries, no motion; close() stops at once
+    close(lfd);
+    unlink(path);
+    t += 1001 * MS;
+    CHECK(!motion_sock_poll(&s, path, t, a, g) && s.fd < 0, "socket gone: not connected");
+    motion_sock_close(&s);
+    rmdir(dir);
+    printf("probe-motion-sock: %s (%d failures)\n", fails ? "FAIL" : "ok", fails);
+    return fails != 0;
+}
+#endif
