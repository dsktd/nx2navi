 #include "vk.h"
@@ -1096,11 +1098,30 @@ int input_motion_enabled(void) {
     return on;
 }
 
+// NX2NAVI_MOTION_SOCK (live): auto ($XDG_RUNTIME_DIR/yakin/motion.sock), off, or a socket path, into path; 0 off.
+// Read on the motion thread only.
+static int motion_sock_cfg(char *path, int size) {
+    static unsigned seen;
+    static int on = -1;
+    static char p[256];
+    unsigned v = cfg_version();
+    if (on < 0 || v != seen) {
+        seen = v;
+        const char *m = cfg_get("NX2NAVI_MOTION_SOCK");
+        if (!m || !*m || !strcmp(m, "auto")) on = motion_sock_default(p, sizeof p);
+        else if (!strcmp(m, "off") || !strcmp(m, "0")) on = 0;
+        else on = snprintf(p, sizeof p, "%s", m) < (int)sizeof p;
+    }
+    if (on) snprintf(path, (size_t)size, "%s", p);
+    return on;
+}
+
 // 250 Hz: the gamepads update (reports read, rumble expiry) and the newest gyro and accelerometer sample goes into the
 // fusion. Without a gamepad with sensors, or with motion off (NX2NAVI_MOTION=0, live), nothing is fed and the six-axis
 // sensor reads at rest.
 static void motion_main(void *arg) {
     (void)arg;
+    static MotionSock sock = MOTION_SOCK_INIT;
     for (;;) {
         plat_wait_ns(4000000);
         float a[3], g[3];
@@ -1110,7 +1131,13 @@ static void motion_main(void *arg) {
         if (motion_pad && SDL_GamepadConnected(motion_pad))
             have = sensors_ready() && SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_ACCEL, a, 3) &&
                    SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_GYRO, g, 3);
+        int lent = motion_pad && sensor_ok;   // a gamepad's own or lent sensors come first
         plat_mutex_unlock(&lock);
+        // Without them, the socket of a controller daemon whose virtual pad has none (NX2NAVI_MOTION_SOCK)
+        char path[256];
+        if (!lent && input_motion_enabled() && motion_sock_cfg(path, sizeof path))
+            have = motion_sock_poll(&sock, path, kern_now_ns(), a, g);
+        else if (sock.fd >= 0) motion_sock_close(&sock);
         if (!have || !input_motion_enabled()) continue;
         double acc[3], gyro[3];
         input_motion_axes(a, g, acc, gyro);
