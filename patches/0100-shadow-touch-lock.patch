From 74266d8ebb8daf185b0cc3580dc730dd5fb77776 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:24:14 -0500
Subject: [PATCH] vk_memory: NX2NAVI_SHADOW_TOUCH_LOCK=1 (0: old; ab) puts the
 touched shadow list under its own lock, so the replay's resolves no longer
 wait on shadow_lock while the completion thread merges write-backs

---
 runtime/cfg.c       |  2 +-
 runtime/vk_memory.c | 29 ++++++++++++++++++++++++++---
 2 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 97cfdb1..6988167 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -76,7 +76,7 @@ static const char *const known[] = {
     "ZSTD_CHECK", "ZSTD_NATIVE",
     "BIND_REUSE", "DYN_DELTA", "STG_ARENA", "SUBMIT_BATCH", "ASTC_GPU_DESWIZZLE", "ASTC_SCRATCH_KEEP", "ASTC_ARENA", "ASTC_BC1",
     "TEXUP_LOG_MS", "DYN_RES", "DYN_RES_TARGET", "DYN_RES_STEP", "TEXTURE_DETAIL",
-    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "POOL_LOAD_FIT", "POOL_IDLE_MS", "SHADOW_RECYCLE_MB",
+    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "POOL_LOAD_FIT", "POOL_IDLE_MS", "SHADOW_RECYCLE_MB", "SHADOW_TOUCH_LOCK",
     "VMA_BLOCK_MB", "SYNC_WAKE_ALL", "LOG_ASYNC", "DEVICE_LOST_AT",
     "COOP", "COOP_BETA", "COOP_NAME", "COOP_SERVER", "COOP_PORT", "COOP_ROOM", "COOP_AUTO", "COOP_DROP",   // co-op (coop.c); the last three have no menu row
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",   // the room's rules (coop_game.c)
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 1b65520..be516ac 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -1335,14 +1335,30 @@ static int shadow_pool(VkCtx *c, PoolRec *r, uint64_t addr, uint64_t size) {
     return 1;
 }
 
+// NX2NAVI_SHADOW_TOUCH_LOCK (default 0 = old; 1, or ab): the touched list has its own lock, touch_lock, which every
+// reader and writer of the list takes inside shadow_lock; shadow_touch then takes touch_lock alone. Before it the
+// replay's resolves waited on shadow_lock while the completion thread merged write-backs under it: play34p (bcd6e8c),
+// Hyrule Field west standing, presents 2400-3100, 2.1 s of 13.5 s on the replay thread (prof_linux.c).
+// The list is filled by the replay thread only (one recorder; replay workers resolve under use_lock).
+static PlatMutex touch_lock = PLAT_MUTEX_INIT;
+
 static void shadow_touch(PoolRec *r) {
-    plat_mutex_lock(&shadow_lock);
+    static int mode = -1;
+    if (mode < 0) {
+        mode = rt_knob("SHADOW_TOUCH_LOCK", "0");
+        rt_log("mem: the touched list is under %s (NX2NAVI_SHADOW_TOUCH_LOCK)",
+               mode == 2 ? "its own lock or shadow_lock, A/B" : mode ? "its own lock" : "shadow_lock");
+    }
+    PlatMutex *m = RT_KNOB_ON(mode) ? &touch_lock : &shadow_lock;
+    plat_mutex_lock(m);
     if (!r->stouched) {
+        if (m == &shadow_lock) plat_mutex_lock(&touch_lock);
         if (nstouch == cstouch) grow((void **)&stouch, &cstouch, sizeof *stouch);
         stouch[nstouch++] = r;
         r->stouched = 1;
+        if (m == &shadow_lock) plat_mutex_unlock(&touch_lock);
     }
-    plat_mutex_unlock(&shadow_lock);
+    plat_mutex_unlock(m);
 }
 
 // ---- base copies of the pages both write ("Pages both write" above). shadow_lock held throughout.
@@ -1597,8 +1613,10 @@ static uint64_t snap_tregs_runs(uint32_t epoch) {
 
 static void shadow_forget(PoolRec *r) {
     plat_mutex_lock(&shadow_lock);
+    plat_mutex_lock(&touch_lock);
     for (int i = 0; i < nstouch; i++)
         if (stouch[i] == r) { stouch[i] = stouch[--nstouch]; break; }
+    plat_mutex_unlock(&touch_lock);
     for (int i = 0; r->tlisted && i < ntpools; i++)
         if (tpools[i] == r) { tpools[i] = tpools[--ntpools]; break; }
     if (r->stab_i) {   // the last one takes its place
@@ -2878,6 +2896,7 @@ void vk_mem_shadow_sync(uint64_t fence) {
         }
     }
     plat_mutex_lock(&shadow_lock);
+    plat_mutex_lock(&touch_lock);   // the touched list (NX2NAVI_SHADOW_TOUCH_LOCK): shadow_touch may hold only this one
     if (nstouch || (table && nstab)) {
         plat_mutex_lock(&gen_lock);
         for (int i = 0; i < nstouch; i++) shadow_sync_pool(stouch[i], epoch, cpu);
@@ -2932,6 +2951,7 @@ void vk_mem_shadow_sync(uint64_t fence) {
         if (ahead) s_pre_ticks += qpc() - t1, s_pre_syncs++, s_pre_bytes += s_copied - copied0;
     }
     s_ticks += qpc() - t0;
+    plat_mutex_unlock(&touch_lock);
     plat_mutex_unlock(&shadow_lock);
     RT_ZONE_END(zs);
 }
@@ -4872,7 +4892,10 @@ void vk_mem_shutdown(void) {
     nsnap_pool = 0, snap_pool_bytes = 0;
     plat_mutex_unlock(&snap_pool_lock);
     plat_mutex_lock(&shadow_lock);
-    nstouch = nstab = 0, s_sb_pages = 0;   // shadows too (their base copies went with their records)
+    plat_mutex_lock(&touch_lock);
+    nstouch = 0;
+    plat_mutex_unlock(&touch_lock);
+    nstab = 0, s_sb_pages = 0;   // shadows too (their base copies went with their records)
     s_live_n = s_live_bytes = 0;
     plat_mutex_unlock(&shadow_lock);
     for (int i = 0; i < nretiring; i++) destroy_rec(c, retiring[i]);   // finalized ones whose callback never ran
-- 
2.56.0

