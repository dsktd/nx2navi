diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index d5eab61..2a18448 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -1814,6 +1814,7 @@ static struct {
     uint32_t kinds, gen, epoch, sgen;
     int retry;                         // the last sync left slots to the creation budget
     uint64_t frame, frame_ns;          // the frame of the last sync, and the sync time spent in it (pool_create_ns)
+    uint64_t draw_frame;               // the frame of the last sync (a draw bound the pools in it)
     uint64_t n_frame_stops, n_defer_skips;   // syncs that created nothing for the frame's time, lookups they skipped
     uint64_t *tok;                     // per texture slot: vk_texture_slot_token it was filled under (0: stand-ins)
     VkImageView *view;                 // [kind * VK_POOL_TEX + id]: what the entry holds
@@ -2054,6 +2055,33 @@ static int pool_load_fit(void) {
     return on;
 }
 
+// NX2NAVI_POOL_IDLE_MS (default 0 = off; milliseconds a present, e.g. 8): the textures of newly registered slots are
+// also made while no draw binds the pools. The refresh above runs when a draw binds them, and the draws of a title or
+// load screen bind none. Ocarina initialises and registers an area's textures on its loader threads all through the
+// load (about 25 a frame over the 200 frames before Market, 4,869 in all), the replay thread waits for the next
+// submission 98% of that time, and the area's first draw then finds all of them to make: the area load above, which
+// held the load screen's last picture for 1.4-1.9 s (play34, bcd6e8c, with the first frame's shadow copies 2.3-2.9 s
+// between two pictures). With the switch, the first submission of a present whose whole previous present had no
+// refresh looks the newly registered slots up (vk_exec_pool_idle) until none is left or this many milliseconds went
+// by: the textures are made a few a frame while the load screen is up, about 2 ms a frame there, and no present is
+// left out for it. If an area's first draw still finds NX2NAVI_POOL_LOAD_BACKLOG slots, the load mode works as before.
+// A texture whose storage the game writes after it was made is uploaded again when a draw binds it, as any texture is.
+static int pool_idle_ms(void) {
+    static int ms = -1;
+    if (ms < 0) {
+        ms = cfg_int("NX2NAVI_POOL_IDLE_MS");
+        if (ms > 0)
+            rt_log("vk: texture pool: newly registered slots are looked up while no draw binds the pools, up to %d ms a "
+                   "present (NX2NAVI_POOL_IDLE_MS)", ms);
+    }
+    return ms;
+}
+
+static int pool_create_budget_streaming(void) {
+    int n = cfg_int("NX2NAVI_POOL_CREATE_BUDGET");
+    return n < 1 ? 1 : n;
+}
+
 static uint64_t pool_create_ns(void);
 static int pool_create_budget(void) {
     static int n = -1, step;
@@ -2472,6 +2500,7 @@ static void pool_sync_entries(VkExec *ex);
 
 static void pool_sync(VkExec *ex) {
     if (!PL.layout) vk_pool_set_layout();
+    PL.draw_frame = __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED);   // vk_exec_pool_idle: a draw binds the pools
     uint64_t from = 0, pre = PL.logn;
     int took = PL.cur_fence != ex->fence;
     int switched = pool_take_set(ex, &from);   // every submission its own set, before the shortcut
@@ -2498,6 +2527,77 @@ static void pool_sync(VkExec *ex) {
     if (took && !PL.retry) __atomic_fetch_add(&pool_takes, 1, __ATOMIC_RELEASE);
 }
 
+// NX2NAVI_POOL_IDLE_MS: the textures of the slots registered while no draw binds the pools, at the start of a
+// submission's record (vk_exec.c vk_exec_record): once a present, and only when the present before it went by without
+// a refresh. Each slot whose token changed since this walk last saw it is looked up as the refresh would (the lookup
+// makes its entry and uploads it), the streaming count at a time until the milliseconds are up; the slots left are
+// taken up by the next present's walk. A slot that resolves to nothing (storage the game has not mapped yet) is
+// looked up again when the mapping changed. No descriptor is written: the first refresh a draw asks for finds the
+// entries made and fills its sets from them.
+// Not while a pool's shadow buffer is being allocated, nor in the present after (vk_memory.c vk_mem_shadow_making):
+// at the start of a load the game makes its large pools (four of 160 MiB after a teleport), and with this walk making
+// textures beside them the driver's allocation of such a buffer took 120-450 ms instead of 20 (inside
+// amdgpu_bo_alloc), on the loader thread the game's main thread waits for: one present 0.27-0.48 s late where the
+// load starts, against 0.09-0.12 s without the walk (play36 before this, teleports between the Graveyard and the
+// field).
+static struct {
+    uint64_t *tok;            // per slot: the token this walk last resolved or gave up on
+    uint8_t *none;            // per slot: that lookup found nothing to make
+    uint64_t frame;           // the present of the last walk
+    uint32_t mg;              // mem_map_gen at the last walk
+    uint64_t runs, ns, made;  // since the last log
+    int left;                 // slots the last walk ran out of time for
+} PW;
+
+void vk_exec_pool_idle(void) {
+    int ms = pool_idle_ms();
+    if (ms <= 0) return;
+    uint64_t f = __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED);
+    if (f < PL.draw_frame + 2 || f == PW.frame) return;
+    PW.frame = f;
+    if (vk_mem_shadow_making()) return;   // the game allocates its pools: not beside that
+    if (!PW.tok) {
+        PW.tok = calloc(VK_POOL_TEX, sizeof *PW.tok), PW.none = calloc(VK_POOL_TEX, 1);
+        if (!PW.tok || !PW.none) rt_fatal("vk: out of memory for the idle pool walk");
+    }
+    uint64_t t0 = kern_now_ns(), lim = (uint64_t)ms * 1000000, up0, up1;
+    vk_texture_stats(NULL, &up0, NULL);
+    uint32_t mg = mem_map_gen();
+    int remap = mg != PW.mg, step = pool_create_budget_streaming(), left = 0;
+    PW.mg = mg;
+    vk_texture_lock();
+    vk_texture_pool_ctx(1);   // as the refresh looks slots up: a texture evicted by disuse stays out
+    int n = vk_texture_slot_count_locked();
+    if (n > VK_POOL_TEX) n = VK_POOL_TEX;
+    vk_texture_create_budget_locked(step);
+    for (int id = 0; id < n; id++) {
+        uint64_t t = vk_texture_slot_token(id);
+        if (!t || (t == PW.tok[id] && !(PW.none[id] && remap))) continue;
+        if (left) { left++; continue; }   // time is up: counted for the log
+        const VkTexImage *img = vk_texture_by_id_locked(id, NULL, NULL);
+        if (vk_texture_create_deferred_locked()) {   // the count is used up: more while there is time
+            if (kern_now_ns() - t0 >= lim || vk_mem_shadow_making()) { left = 1; continue; }
+            vk_texture_create_budget_locked(step);
+            img = vk_texture_by_id_locked(id, NULL, NULL);
+            if (vk_texture_create_deferred_locked()) { left = 1; continue; }
+        }
+        PW.tok[id] = t, PW.none[id] = !img;
+    }
+    vk_texture_create_budget_locked(-1);
+    vk_texture_pool_ctx(0);
+    vk_texture_unlock();
+    vk_texture_stats(NULL, &up1, NULL);
+    PW.left = left;
+    PW.runs++, PW.ns += kern_now_ns() - t0, PW.made += up1 - up0;
+    if (PW.runs >= 60) {
+        if ((rt_trace & RT_TRACE_PERF) && PW.made)
+            rt_log("vk: texture pool: frame %llu: %llu walks ahead of the draws uploaded %llu textures in %.1f ms; %d slots "
+                   "left", (unsigned long long)f, (unsigned long long)PW.runs, (unsigned long long)PW.made, PW.ns / 1e6,
+                   PW.left);
+        PW.runs = PW.ns = PW.made = 0;
+    }
+}
+
 typedef struct { VkExec *ex; uint32_t used; int n, retry, spent; } PoolDirty;
 
 // A slot whose token changed: filled, or noted as left (pool_defer). With the frame's creation time spent (spent), a
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index b926751..1b65520 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -1286,6 +1286,14 @@ static uint64_t s_t_over_all;                     // shadow_lock: s_tab_over sin
 static uint64_t s_late_pages, s_late_bytes;       // shadow_lock, check: write-backs into pages the CPU wrote since their copy-in
 static uint64_t s_stale_pages;                    // shadow_lock: write-backs left out, the shadow could not hold them (shadow_write_back)
 
+static volatile int32_t shadow_making;         // shadow buffers being allocated now (any thread)
+static volatile uint64_t shadow_made_frame;    // the present during which the last one was allocated
+// 1 while a pool's shadow buffer is being allocated, or one was in this present or the one before.
+int vk_mem_shadow_making(void) {
+    return __atomic_load_n(&shadow_making, __ATOMIC_RELAXED) ||
+           __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED) <= __atomic_load_n(&shadow_made_frame, __ATOMIC_RELAXED) + 1;
+}
+
 static int shadow_pool(VkCtx *c, PoolRec *r, uint64_t addr, uint64_t size) {
     r->import_lo = addr & ~0xfffull;
     r->import_hi = (addr + size + 0xfff) & ~0xfffull;
@@ -1299,7 +1307,10 @@ static int shadow_pool(VkCtx *c, PoolRec *r, uint64_t addr, uint64_t size) {
     VmaAllocationInfo info;
     uint64_t t0 = kern_now_ns();
     int reused = srec_take(r, n);
+    plat_inc32(&shadow_making);   // vk_mem_shadow_making: the idle pool walk keeps out of the way (vk_exec_draw.c)
     VkResult res = reused ? VK_SUCCESS : vmaCreateBuffer(c->vma, &bi, &ai, &r->buf, &r->salloc, &info);
+    plat_dec32(&shadow_making);
+    __atomic_store_n(&shadow_made_frame, __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED), __ATOMIC_RELAXED);
     if (res != VK_SUCCESS) {
         rt_log("vk: pool %#llx+%#llx: shadow allocation failed (%d)", (unsigned long long)addr, (unsigned long long)size,
                (int)res);
-- 
