 runtime/vk.h           |   1 +
 runtime/vk_exec.c      |   1 +
 runtime/vk_exec.h      |   3 ++
 runtime/vk_exec_draw.c | 100 +++++++++++++++++++++++++++++++++++++++++
 runtime/vk_memory.c    |  11 +++++
 6 files changed, 119 insertions(+), 3 deletions(-)

