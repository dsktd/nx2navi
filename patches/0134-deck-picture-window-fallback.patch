From 3cfe91a297e41b0be27603a39099d27bfde4a249 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:02:02 -0500
Subject: [PATCH] Deck picture: game_res = window falls back to the window
 setting when the monitor is unknown; Resolution row offers 720 and 900 with a
 minimum of 720 or less; Steam Deck profile: picture follows the screen, 1080
 at most, low texture detail

---
 runtime/cfg.c        |  5 ++++-
 runtime/ui/menu.cpp  | 17 +++++++++++------
 runtime/widescreen.c |  8 ++++++--
 3 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 7f8b6919..c613218f 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -201,7 +201,7 @@ static const CfgMeta metas[] = {
     {"DLSS_CHAR_MASK", "65", "0|35|65|100", LIVE}, {"FXAA", "1", "0|1", LIVE},
     {"AA", "game", "game|off|fxaa|smaa|taa", LIVE},   // vk_aa.c: what runs in place of the game's SMAA
     {"GAME_ASPECT", "16:9", "16:9|window|21:9|32:9", RESTART},   // widescreen.c
-    {"GAME_RES", "1440", "1080|1440|1800|2160|2880|window", RESTART},   // widescreen.c: the picture's height
+    {"GAME_RES", "1440", "720|900|1080|1440|1800|2160|2880|window", RESTART},   // widescreen.c: the picture's height
     {"ASPECT", "fit", "fit|stretch", LIVE}, {"FOV", "100", "70..140", LIVE},
     {"ANISO", "16", "game|2|4|8|16", LIVE},   // vk_texture.c sampler_features, vk_sampler_aniso_live; 16: the game asks 1x or 2x
     {"TEXTURE_DETAIL", "auto", "auto|full|reduced|low", RESTART},   // vk_texture.c "texture detail", read at the first texture
@@ -543,6 +543,9 @@ int cfg_load(const char *path) {
 static const struct { const char *key, *value; } DECK[] = {
     {"FULLSCREEN", "1"}, {"WINDOW_SIZE", "1280x800"}, {"OUTPUT_RES", "1280x800"}, {"RENDER_SCALE", "game"},
     {"VK_PRESENT", "fifo"}, {"FPS_LIMIT", "40"}, {"CORES", "4"}, {"ASTC_BC", "1"}, {"SPIN_HANDOFF_US", "30"},
+    // ours (0120): the picture follows the 1280x800 screen (1280x720, the 16:9 that fits) and stays at 1080 lines or less,
+    // and textures at low detail: the picture's targets and the textures share 16 GB with the game (ARCHITECTURE "Steam Deck")
+    {"GAME_RES", "window"}, {"GAME_RES_MIN", "720"}, {"GAME_RES_MAX", "1080"}, {"TEXTURE_DETAIL", "low"},
 };
 static int profile = -1;   // 0 none, 1 Steam Deck
 
diff --git a/runtime/ui/menu.cpp b/runtime/ui/menu.cpp
index ee0be0bb..a931484c 100644
--- a/runtime/ui/menu.cpp
+++ b/runtime/ui/menu.cpp
@@ -1218,18 +1218,23 @@ static void row_framegen(void) {
 // within the monitor, and the picture after a restart. Native draws at the window's size and leaves the window as it is.
 // As two rows of their own, a window of one size took a picture of another and scaled it for nothing.
 static void row_resolution(void) {
-    static const int heights[] = {1080, 1440, 1800, 2160, 2880};
-    static const int wide169[] = {1920, 2560, 3200, 3840, 5120}, wide219[] = {2560, 3440, 4300, 5120, 6880},
-                     wide329[] = {3840, 5120, 6400, 7680, 10240};
-    enum { N = sizeof heights / sizeof *heights };
+    // with NX2NAVI_GAME_RES_MIN at 720 or less (widescreen.c picture_height) the row starts at 720 and 900
+    static const int all_h[] = {720, 900, 1080, 1440, 1800, 2160, 2880};
+    static const int all169[] = {1280, 1600, 1920, 2560, 3200, 3840, 5120}, all219[] = {1712, 2136, 2560, 3440, 4300, 5120, 6880},
+                     all329[] = {2560, 3200, 3840, 5120, 6400, 7680, 10240};
+    const char *lo = cfg_get("NX2NAVI_GAME_RES_MIN");
+    int skip = lo && *lo && atoi(lo) >= 360 && atoi(lo) <= 720 ? 0 : 2;
+    const int *heights = all_h + skip, *wide169 = all169 + skip, *wide219 = all219 + skip, *wide329 = all329 + skip;
+    enum { NMAX = sizeof all_h / sizeof *all_h };
+    const int N = NMAX - skip;
     const char *aspect = cfg_value("NX2NAVI_GAME_ASPECT");
     int mw = 0, mh = 0, ww = 0, wh = 0;
     int have_mon = gfx_window_monitor_size(&mw, &mh) && mw > 0 && mh > 0;
     int have_win = sscanf(cfg_value("NX2NAVI_WINDOW_SIZE"), "%dx%d", &ww, &wh) == 2 && ww > 0 && wh > 0;
     // the window's shape where the picture follows it: the monitor's in fullscreen, else the window's own
     double shape = cfg_bool("NX2NAVI_FULLSCREEN") && have_mon ? (double)mw / mh : have_win ? (double)ww / wh : 16.0 / 9.0;
-    static char sizes[N][24], names[N + 1][48];
-    const char *pn[N + 1];
+    static char sizes[NMAX][24], names[NMAX + 1][48];
+    const char *pn[NMAX + 1];
     for (int i = 0; i < N; i++) {
         int w = !strcmp(aspect, "21:9") ? wide219[i] : !strcmp(aspect, "32:9") ? wide329[i] :
                 !strcmp(aspect, "window") ? ((int)(heights[i] * shape + 0.5) & ~1) : wide169[i];
diff --git a/runtime/widescreen.c b/runtime/widescreen.c
index d418217b..bae3e6d5 100644
--- a/runtime/widescreen.c
+++ b/runtime/widescreen.c
@@ -70,8 +70,12 @@ static unsigned picture_height(void) {
     int w = 0, h = GAME_H, min = PICTURE_MIN_H, max = 4320;
     int own_min = lo && *lo && atoi(lo) >= 360;
     if (!strcmp(s, "window")) {
-        if (!screen_size(&w, &h)) h = GAME_H;
-        else if (own_min && w * 9 < h * 16) h = w * 9 / 16;
+        if (!screen_size(&w, &h)) {   // the monitor is not known yet (gamescope's X display): with a minimum, the window setting
+            h = GAME_H;
+            if (own_min) gfx_cfg_window_size(&w, &h);
+            if (h <= 0) h = GAME_H;
+        }
+        if (own_min && w > 0 && w * 9 < h * 16) h = w * 9 / 16;
         min = GAME_H;
     } else {
         h = atoi(s);
