From d61d1fd3a154002d8e90e37bb9a5e08ec5ea4abd Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:51:41 -0500
Subject: [PATCH] vk_memory: NX2NAVI_SHADOW_RECYCLE_MB=1024 (0: old) keeps
 freed pools' shadow buffers for the next pool of the same size, since making
 a shadow of a few hundred MiB held a loader 710 ms in nvnMemoryPoolInitialize
 with main waiting in QueueSubmitCommands; shadows over 20 ms are logged with
 buffer and copy time

---
 runtime/cfg.c       |  6 ++---
 runtime/vk_memory.c | 62 +++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 63 insertions(+), 5 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 448bba6..42edf6f 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -76,7 +76,7 @@ static const char *const known[] = {
     "ZSTD_CHECK", "ZSTD_NATIVE",
     "BIND_REUSE", "DYN_DELTA", "STG_ARENA", "SUBMIT_BATCH", "ASTC_GPU_DESWIZZLE", "ASTC_SCRATCH_KEEP", "ASTC_ARENA", "ASTC_BC1",
     "TEXUP_LOG_MS", "DYN_RES", "DYN_RES_TARGET", "DYN_RES_STEP", "TEXTURE_DETAIL",
-    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP",
+    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "SHADOW_RECYCLE_MB",
     "VMA_BLOCK_MB", "SYNC_WAKE_ALL", "LOG_ASYNC", "DEVICE_LOST_AT",
     "COOP", "COOP_BETA", "COOP_NAME", "COOP_SERVER", "COOP_PORT", "COOP_ROOM", "COOP_AUTO", "COOP_DROP",   // co-op (coop.c); the last three have no menu row
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",   // the room's rules (coop_game.c)
@@ -139,7 +139,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"DYN_DELTA", "performance"}, {"STG_ARENA", "performance"}, {"SUBMIT_BATCH", "performance"},
     {"BUILD_FREE_MB", "performance"}, {"BUILD_RESERVE_MB", "performance"}, {"MEM_NEED_MB", "diagnostics"},
     {"ASTC_GPU_DESWIZZLE", "performance"}, {"ASTC_SCRATCH_KEEP", "performance"}, {"ASTC_ARENA", "performance"}, {"ASTC_BC1", "performance"}, {"POOL_CREATE_BUDGET", "performance"},
-    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"},
+    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"}, {"SHADOW_RECYCLE_MB", "performance"},
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"}, {"ONESHOT_BUDGET", "performance"},
     {"PIPE_FRAME_WAIT_MS", "performance"}, {"PIPE_SKIP_STEADY", "performance"},
     {"CACHE_DIE", "performance"}, {"ONE_PER_CORE", "performance"},
@@ -266,7 +266,7 @@ static const CfgMeta metas[] = {
     {"DYN_RES", "0", "0|1", LIVE}, {"DYN_RES_TARGET", "16.7", "1..100", LIVE}, {"DYN_RES_STEP", "45", "8..600", LIVE},
     // the recording thread: a core of its own (auto: with 12 or more logical processors) and the highest priority
     // (vk_exec.c rec_claim)
-    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART},
+    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART}, {"SHADOW_RECYCLE_MB", "1024", "0..16384", RESTART},
     // held submissions handed to the queue together (vk_sync.c, submit batching)
     {"SUBMIT_BATCH", "4", "1..16", RESTART},
     {"CACHE_DIE", "1", "0|1|ab", RESTART}, {"ONE_PER_CORE", "0", "0|1|ab", RESTART},   // perf.c cpu_placement
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index e4eb358..3350684 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -278,8 +278,58 @@ static PoolRec *phys_find(const pool_t *key) {
     return NULL;
 }
 
+// NX2NAVI_SHADOW_RECYCLE_MB (default 1024; 0: off, the old way): a freed pool's shadow buffer is kept, up to that many
+// MiB, for the next pool of the same size. A shadow is a host-visible buffer of the whole pool; making one of a few
+// hundred MiB (the driver allocates and clears the pages) held a loader thread 710 ms in nvnMemoryPoolInitialize in
+// Hyrule Field (play27, rebase-upstream 1d5b12f, log play-20261111-224513 f2020), while another loader waited on it
+// and the game's main thread waited in QueueSubmitCommands. Area changes free pools and make the same sizes again.
+// Kept buffers are no longer in the device address table (pool_fini unmapped them) and the GPU is done with them.
+#define SREC_N 16
+static PlatMutex srec_lock = PLAT_MUTEX_INIT;
+static struct { VkBuffer buf; VmaAllocation alloc; uint8_t *map; uint64_t n; } srec[SREC_N];
+static int nsrec;
+static uint64_t srec_bytes, srec_hits, srec_miss;
+static uint64_t srec_cap(void) {
+    static int64_t cap = -1;
+    if (cap < 0) cap = (int64_t)cfg_int("NX2NAVI_SHADOW_RECYCLE_MB") << 20;
+    return (uint64_t)cap;
+}
+static int srec_put(PoolRec *r) {
+    uint64_t n = r->import_hi - r->import_lo;
+    int ok = 0;
+    plat_mutex_lock(&srec_lock);
+    if (srec_cap() && nsrec < SREC_N && srec_bytes + n <= srec_cap()) {
+        srec[nsrec].buf = r->buf, srec[nsrec].alloc = r->salloc, srec[nsrec].map = r->smap, srec[nsrec].n = n;
+        nsrec++, srec_bytes += n, ok = 1;
+    }
+    plat_mutex_unlock(&srec_lock);
+    return ok;
+}
+static int srec_take(PoolRec *r, uint64_t n) {
+    int ok = 0;
+    plat_mutex_lock(&srec_lock);
+    for (int i = 0; i < nsrec && !ok; i++)
+        if (srec[i].n == n) {
+            r->buf = srec[i].buf, r->salloc = srec[i].alloc, r->smap = srec[i].map;
+            srec[i] = srec[--nsrec], srec_bytes -= n, ok = 1;
+        }
+    if (srec_cap()) ok ? srec_hits++ : srec_miss++;
+    plat_mutex_unlock(&srec_lock);
+    return ok;
+}
+static void srec_drain(VkCtx *c) {
+    plat_mutex_lock(&srec_lock);
+    for (int i = 0; i < nsrec; i++) vmaDestroyBuffer(c->vma, srec[i].buf, srec[i].alloc);
+    if (srec_hits || srec_miss)
+        rt_log("vk: shadow buffers of freed pools: %llu reused, %llu made new (NX2NAVI_SHADOW_RECYCLE_MB)",
+               (unsigned long long)srec_hits, (unsigned long long)srec_miss);
+    nsrec = 0, srec_bytes = 0;
+    plat_mutex_unlock(&srec_lock);
+}
+
 static void destroy_rec(VkCtx *c, PoolRec *r) {
     if (r->mbuf) vmaDestroyBuffer(c->vma, r->mbuf, r->malloc_);
+    if (r->salloc && srec_put(r)) r->buf = VK_NULL_HANDLE, r->salloc = NULL;
     if (r->salloc) vmaDestroyBuffer(c->vma, r->buf, r->salloc), r->buf = VK_NULL_HANDLE;
     if (r->buf) vkDestroyBuffer(c->device, r->buf, NULL);
     if (r->mem) vkFreeMemory(c->device, r->mem, NULL);
@@ -1224,19 +1274,26 @@ static int shadow_pool(VkCtx *c, PoolRec *r, uint64_t addr, uint64_t size) {
                                   .requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
                                   .preferredFlags = VK_MEMORY_PROPERTY_HOST_CACHED_BIT};
     VmaAllocationInfo info;
-    VkResult res = vmaCreateBuffer(c->vma, &bi, &ai, &r->buf, &r->salloc, &info);
+    uint64_t t0 = kern_now_ns();
+    int reused = srec_take(r, n);
+    VkResult res = reused ? VK_SUCCESS : vmaCreateBuffer(c->vma, &bi, &ai, &r->buf, &r->salloc, &info);
     if (res != VK_SUCCESS) {
         rt_log("vk: pool %#llx+%#llx: shadow allocation failed (%d)", (unsigned long long)addr, (unsigned long long)size,
                (int)res);
         r->buf = VK_NULL_HANDLE, r->salloc = NULL;
         return 0;
     }
-    r->smap = info.pMappedData;
+    if (!reused) r->smap = info.pMappedData;
+    uint64_t t1 = kern_now_ns();
     r->sborn = vk_sync_issued() + 1;   // the submission being recorded now, or the next one
     plat_mutex_lock(&gen_lock);
     r->sgen = gen_now;   // the copy below holds every write stamped so far; later stamps are copied again
     plat_mutex_unlock(&gen_lock);
     memcpy(r->smap, (const void *)(uintptr_t)r->import_lo, n);
+    uint64_t t2 = kern_now_ns();
+    if (t2 - t0 >= 20000000ull)
+        rt_log("vk: shadow of pool %#llx+%#llx took %.1f ms: buffer %.1f ms (%s), copy %.1f ms", (unsigned long long)addr,
+               (unsigned long long)size, (t2 - t0) / 1e6, (t1 - t0) / 1e6, reused ? "reused" : "new", (t2 - t1) / 1e6);
     plat_mutex_lock(&shadow_lock);
     s_live_n++, s_live_bytes += (int64_t)n;
     plat_mutex_unlock(&shadow_lock);
@@ -4540,6 +4597,7 @@ void vk_mem_shutdown(void) {
     vk_queue_unlock();
     vk_gpa_report();
     vk_gpa_shutdown();
+    srec_drain(c);
     vk_texture_shutdown();
     plat_rmutex_lock(&cmd_lock);
     retire(c, 1);
-- 
2.56.0

