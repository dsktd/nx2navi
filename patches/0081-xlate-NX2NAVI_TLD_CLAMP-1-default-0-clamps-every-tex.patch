diff --git a/tests/tld_clamp_check.py b/tests/tld_clamp_check.py
new file mode 100644
index 0000000..490ecca
--- /dev/null
+++ b/tests/tld_clamp_check.py
@@ -0,0 +1,82 @@
+"""Check the translator's "tld_clamp" job option (NX2NAVI_TLD_CLAMP, #174).
+
+Translates jobs kept by NX2NAVI_XLATE_KEEP (<cache>/<key>.job, one --serve request line each) twice, without and with
+"tld_clamp": true, and checks the SPIR-V: without the option the output is unchanged from a job that never names it;
+with it every OpImageFetch on a non-buffer image without constant offsets takes its coordinate from a GLSL.std.450
+SClamp whose bounds are 0 and OpImageQuerySize(Lod) - 1. Jobs without a texel fetch only check the first part.
+
+  python tests/tld_clamp_check.py <nx2navi_xlate> <job> [<job> ...]
+"""
+
+import json
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+OP_EXT_INST_IMPORT, OP_EXT_INST, OP_IMAGE_FETCH, OP_ISUB = 11, 12, 95, 130
+OP_QUERY_SIZE_LOD, OP_QUERY_SIZE = 103, 104
+OP_TYPE_IMAGE, OP_LOAD, OP_IMAGE, DIM_BUFFER, CONST_OFFSETS = 25, 61, 100, 5, 0x8 | 0x20
+SCLAMP = 45
+
+
+def translate(exe: Path, job: dict, out: Path) -> bytes:
+    req = {"job": job, "out": str(out)}
+    subprocess.run([str(exe), "--serve"], input=json.dumps(req) + "\n", text=True, capture_output=True, check=True)
+    return (out / f"{job['key']}.spv").read_bytes()
+
+
+def insts(spv: bytes):
+    w = struct.unpack(f"<{len(spv) // 4}I", spv)
+    i = 5
+    while i < len(w):
+        n = w[i] >> 16
+        yield w[i] & 0xFFFF, w[i + 1:i + n]
+        i += max(n, 1)
+
+
+def fetches_clamped(spv: bytes) -> tuple[int, int]:
+    """(texel fetches, of them clamped to the image size)."""
+    defs, glsl, fetch, dims, rtype = {}, set(), [], {}, {}
+    for op, a in insts(spv):
+        if op == OP_TYPE_IMAGE:
+            dims[a[0]] = a[2]
+        elif op in (OP_LOAD, OP_IMAGE):
+            rtype[a[1]] = a[0]
+        if op == OP_EXT_INST_IMPORT:
+            glsl.add(a[0])
+        elif op in (OP_EXT_INST, OP_ISUB, OP_QUERY_SIZE_LOD, OP_QUERY_SIZE):
+            defs[a[1]] = (op, a)
+        if op == OP_IMAGE_FETCH and not (len(a) > 4 and a[4] & CONST_OFFSETS) and dims.get(rtype.get(a[2])) != DIM_BUFFER:
+            fetch.append(a)
+    ok = 0
+    for a in fetch:
+        d = defs.get(a[3])
+        if d and d[0] == OP_EXT_INST and d[1][2] in glsl and d[1][3] == SCLAMP:
+            hi = defs.get(d[1][6])
+            ok += bool(hi and hi[0] == OP_ISUB and defs.get(hi[1][2], (0,))[0] in (OP_QUERY_SIZE_LOD, OP_QUERY_SIZE))
+    return len(fetch), ok
+
+
+def main() -> int:
+    if len(sys.argv) < 3:
+        sys.exit(__doc__)
+    exe, fails = Path(sys.argv[1]), 0
+    for path in sys.argv[2:]:
+        job = json.loads(Path(path).read_text().splitlines()[0])["job"]
+        job.pop("tld_clamp", None)
+        with tempfile.TemporaryDirectory() as t:
+            base = translate(exe, job, Path(t))
+            off = translate(exe, dict(job, tld_clamp=False), Path(t))
+            on = translate(exe, dict(job, tld_clamp=True), Path(t))
+        n, ok = fetches_clamped(on)
+        good = base == off and ok == n and (n == 0 or on != base)
+        print(f"{'ok  ' if good else 'FAIL'} {os.path.basename(path)}: off unchanged {base == off}, fetches {n}, clamped {ok}")
+        fails += not good
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
