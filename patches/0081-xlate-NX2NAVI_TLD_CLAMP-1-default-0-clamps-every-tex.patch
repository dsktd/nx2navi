++{
++    /// <summary>
++    /// Host options the NX2navi translator sets per job (tools/xlate/Program.cs).
++    /// </summary>
++    public static class HostOptions
++    {
++        /// <summary>
++        /// "tld_clamp": integer-coordinate fetches (texelFetch) clamp their coordinates to the image size at the fetched
++        /// level, so an out-of-bounds fetch reads the edge texel instead of zero (NX2NAVI_TLD_CLAMP, #174).
++        /// </summary>
++        public static bool TldClamp;
++    }
++}
