diff --git a/tools/xlate/patches/0036-texel-fetch-clamp.patch b/tools/xlate/patches/0036-texel-fetch-clamp.patch
new file mode 100644
index 0000000..5212d10
--- /dev/null
+++ b/tools/xlate/patches/0036-texel-fetch-clamp.patch
@@ -0,0 +1,58 @@
+diff --git a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
+index e5e01ef..24836b8 100644
+--- a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
++++ b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
+@@ -1477,6 +1477,33 @@ namespace Ryujinx.Graphics.Shader.CodeGen.Spirv
+             if (intCoords)
+             {
+                 image = context.Image(declaration.ImageType, image);
++
++                // NX2navi #174: with "tld_clamp" the fetch reads the edge texel out of bounds, not zero (robustness).
++                // Fetches with constant offsets and buffer fetches stay as they are.
++                bool isBuffer = (texOp.Type & SamplerType.Mask) == SamplerType.TextureBuffer;
++
++                if (HostOptions.TldClamp && !isBuffer && !hasOffset && !hasOffsets)
++                {
++                    SpvInstruction s32 = context.TypeS32();
++                    SpvInstruction sizeType = pCount > 1 ? context.TypeVector(s32, pCount) : s32;
++                    SpvInstruction size = isMultisample
++                        ? context.ImageQuerySize(sizeType, image)
++                        : context.ImageQuerySizeLod(sizeType, image, lod ?? context.Constant(s32, 0));
++                    SpvInstruction one = context.Constant(s32, 1);
++                    SpvInstruction zero = context.Constant(s32, 0);
++
++                    if (pCount > 1)
++                    {
++                        SpvInstruction[] ones = new SpvInstruction[pCount];
++                        SpvInstruction[] zeros = new SpvInstruction[pCount];
++                        for (int i = 0; i < pCount; i++) { ones[i] = one; zeros[i] = zero; }
++                        one = context.ConstantComposite(sizeType, ones);
++                        zero = context.ConstantComposite(sizeType, zeros);
++                    }
++
++                    SpvInstruction max = context.ISub(sizeType, size, one);
++                    pCoords = context.GlslSClamp(sizeType, pCoords, zero, max);
++                }
+             }
+ 
+             SpvInstruction[] operands = operandsList.ToArray();
