diff --git a/runtime/vk_exec.c b/runtime/vk_exec.c
index 082f918..d6d009a 100644
--- a/runtime/vk_exec.c
+++ b/runtime/vk_exec.c
@@ -870,6 +870,7 @@ static void state_save(VkExec *ex, int slot) {
     if (slot >= NVN_EXEC_SLOTS) rt_fatal("vk: state slot %d", slot);
     if (!exec_slots[slot] && !(exec_slots[slot] = malloc(sizeof *ex))) rt_fatal("vk: out of memory (state slot)");
     *exec_slots[slot] = *ex;
+    vk_usnap_save(slot);
 }
 static void state_restore(VkExec *ex, int slot) {
     if (slot >= NVN_EXEC_SLOTS || !exec_slots[slot]) rt_fatal("vk: state slot %d was never saved", slot);
@@ -886,6 +887,7 @@ static void state_restore(VkExec *ex, int slot) {
     ex->tex_serial = cur.tex_serial + 1, ex->pass_serial = cur.pass_serial + 1;
     ex->dirty = VK_EXEC_DIRTY_ALL;
     ex->rt_resolved = 0;
+    vk_usnap_restore(slot);
 }
 
 static void walk(VkExec *ex, const op_hdr *h, int depth) {
@@ -970,6 +972,13 @@ static void walk(VkExec *ex, const op_hdr *h, int depth) {
         case OP_SIGNAL_EVENT: case OP_REPORT_COUNTER: case OP_RESET_COUNTER: case OP_RENDER_ENABLE: case OP_RENDER_COND:
         case OP_CLEAR_BUF:
             vk_exec_op_xfer(ex, h->op, a);
+            if (h->op == OP_SIGNAL_EVENT)   // a cut after a signal (nvn_api_cmd.c ew_run): this part ends here
+                for (int s = 0; s < NVN_EXEC_SLOTS; s++)
+                    if (__atomic_load_n(&nvn_cut_after[s], __ATOMIC_ACQUIRE) == (const void *)h) {
+                        __atomic_store_n(&nvn_cut_after[s], NULL, __ATOMIC_RELAXED);
+                        state_save(ex, s);
+                        return;
+                    }
             break;
         default: rt_fatal("vk: op %s has no replay handler", nvn_op_name(h->op));
         }
diff --git a/runtime/vk_usnap.c b/runtime/vk_usnap.c
index 5bc0d24..b6aa1f3 100644
--- a/runtime/vk_usnap.c
+++ b/runtime/vk_usnap.c
@@ -348,6 +348,37 @@ void vk_usnap_end(uint64_t fence) {
     U.on = 0, U.gen++;
 }
 
+// A submission cut at an event wait (nvn_api_cmd.c "event waits"; vk_exec.c state_save) resumes later in a recording
+// of its own. Its snapshot, taken where the first part started, already covers the whole submission (collect walks
+// past the cut) and holds the bytes as of that submit; the resumed part keeps using it instead of a new copy taken when
+// the held part is issued, by which time the game may have rewritten the blocks for its next frame. Bindings made
+// before the cut and carried over in the replay state are covered as well, where a fresh snapshot of the resumed ops
+// alone would miss them and bind live memory.
+static struct { Arena *arena; Reg *reg; int nreg, on, ncam; uint64_t cam[8]; } saved[NVN_EXEC_SLOTS];
+
+void vk_usnap_save(int slot) {
+    if (slot < 0 || slot >= NVN_EXEC_SLOTS) return;
+    if (saved[slot].arena) vk_completion_add(U.fence, arena_done, saved[slot].arena);   // never resumed
+    saved[slot].arena = NULL, saved[slot].on = 0;
+    if (!U.on || !U.arena) return;
+    free(saved[slot].reg);
+    if (!(saved[slot].reg = malloc(sizeof *U.reg * (size_t)(U.nreg ? U.nreg : 1)))) rt_fatal("vk_usnap: out of memory");
+    memcpy(saved[slot].reg, U.reg, sizeof *U.reg * (size_t)U.nreg);
+    saved[slot].nreg = U.nreg, saved[slot].on = 1, saved[slot].arena = U.arena;
+    saved[slot].ncam = U.ncam, memcpy(saved[slot].cam, U.cam, sizeof U.cam);
+    U.arena = NULL;   // freed after the resumed part instead (vk_usnap_restore, vk_usnap_end)
+}
+
+void vk_usnap_restore(int slot) {
+    if (slot < 0 || slot >= NVN_EXEC_SLOTS || !saved[slot].on) return;
+    if (U.arena) vk_completion_add(U.fence, arena_done, U.arena);
+    while (U.creg < saved[slot].nreg) U.reg = grow(U.reg, &U.creg, sizeof *U.reg);
+    memcpy(U.reg, saved[slot].reg, sizeof *U.reg * (size_t)saved[slot].nreg);
+    U.nreg = saved[slot].nreg, U.arena = saved[slot].arena, U.on = 1, U.gen++;
+    U.ncam = saved[slot].ncam, memcpy(U.cam, saved[slot].cam, sizeof U.cam);
+    saved[slot].arena = NULL, saved[slot].on = 0;
+}
+
 // First region whose end is above a.
 static int first_above(uint64_t a) {
     int lo = 0, hi = U.nreg;
-- 
2.56.0

