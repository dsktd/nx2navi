 runtime/vk.h           |   4 +
 runtime/vk_exec_draw.c |   4 +-
 runtime/vk_memory.c    | 179 ++++++++++++++++++++++++++++++++++++++++-
 4 files changed, 183 insertions(+), 6 deletions(-)

