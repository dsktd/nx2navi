From 0ba1e3c671c96395eaf16fab2153693edf26d5a1 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:49:52 -0500
Subject: [PATCH] vk_texture: NX2NAVI_TEX_RELEASED_MAX=<n>|vram|ab (default
 2048: old) sets how many released textures the sweep keeps; vram is upstream
 ee46a19 (one per 2 MiB of the VRAM budget, 2048 to 8192). Running through
 Hyrule Field the list sat at 2048 and the sweep dropped ~400 entries per 60
 frames while ~420 textures were made

---
 runtime/cfg.c        |  2 +-
 runtime/vk_texture.c | 38 ++++++++++++++++++++++++++++++++++++--
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 6988167..56dae60 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -70,7 +70,7 @@ static const char *const known[] = {
     "SVC_SLOW_MS", "STALL_MS",
     "SHOTS_FULL", "SPEED_PROBE", "SPIN", "SPIN_HANDOFF_US", "SPLIT_DRAWS", "SPLIT_IDLE", "SPLIT_IN_PASS", "SPLIT_US", "SPV_MARK_TEST", "SPV_OVERRIDE", "STICK_DEADZONE", "STICK_SENS",
     "SWKBD_ANSWER",
-    "SET_AT", "SWKBD_TEST", "TAA", "DBG_TEST", "DEBUG_MENU", "MENU_TEST_DEBUG", "FSR4", "FSR4_FG", "FG4_VERSION", "FG4_SWAPCHAIN", "TEST_PAD", "TEST_PAD_AT", "TEST_PREPARE_SHADERS", "TEX_ALIAS", "DEPTH_INIT_INLINE", "DEPTH_ALIAS_LOG", "TEX_DISUSE", "TEX_DISUSE_EVICT", "TEX_GEN_UNDO", "TEX_MEMO", "TEX_VRAM_PRESSURE", "TEX_RELEASED_MB", "TEX_REUSE", "TEX_SPLIT_FILL", "TEX_COMMIT_FREE_MB", "TEX_PROC_COMMIT_MB", "TEX_EVICT", "TEX_COMMIT_EVICT", "MIRROR_EVICT", "VRAM_BUDGET_MB", "TIMER_1MS", "TRACE", "TXD_TRANSPOSE", "UBO_SNAPSHOT", "EVO_TRACE", "EVO_ASYNC", "EVENT_AT_SYNC", "UPSCALER", "VK_DYN_A2C", "VK_DYN_VERTEX", "VK_NAN_PRESERVE", "VK_NOOPT", "VK_NO_FLOAT64",
+    "SET_AT", "SWKBD_TEST", "TAA", "DBG_TEST", "DEBUG_MENU", "MENU_TEST_DEBUG", "FSR4", "FSR4_FG", "FG4_VERSION", "FG4_SWAPCHAIN", "TEST_PAD", "TEST_PAD_AT", "TEST_PREPARE_SHADERS", "TEX_ALIAS", "DEPTH_INIT_INLINE", "DEPTH_ALIAS_LOG", "TEX_DISUSE", "TEX_DISUSE_EVICT", "TEX_GEN_UNDO", "TEX_MEMO", "TEX_VRAM_PRESSURE", "TEX_RELEASED_MB", "TEX_RELEASED_MAX", "TEX_REUSE", "TEX_SPLIT_FILL", "TEX_COMMIT_FREE_MB", "TEX_PROC_COMMIT_MB", "TEX_EVICT", "TEX_COMMIT_EVICT", "MIRROR_EVICT", "VRAM_BUDGET_MB", "TIMER_1MS", "TRACE", "TXD_TRANSPOSE", "UBO_SNAPSHOT", "EVO_TRACE", "EVO_ASYNC", "EVENT_AT_SYNC", "UPSCALER", "VK_DYN_A2C", "VK_DYN_VERTEX", "VK_NAN_PRESERVE", "VK_NOOPT", "VK_NO_FLOAT64",
     "VK_PRESENT", "VK_RECONVERGE", "VK_NAN_BITS", "VK_RECORDER", "VK_SSBO_ALIGN", "VK_SUBGROUP", "VK_SUBGROUP_PIN", "VK_VALIDATION", "VOLUME", "VRAM_HEADROOM", "VS_OUTS",
     "WALK_KEY", "WALK_SCALE", "WB_EXACT", "WB_FENCE_LIMIT", "WB_MERGE", "WB_NO_REUP", "WB_MERGE_MAX", "WB_PROBE", "WB_SPLIT", "WB_LAZY", "WB_LAZY_CHUNK", "WB_LAZY_TOUCH", "WINDOW_SIZE", "XLATE", "XLATE_ID", "XLATE_KEEP", "XLATE_PROCS",
     "ZSTD_CHECK", "ZSTD_NATIVE",
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 6f5fe0b..fa34bab 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -1782,7 +1782,40 @@ static int others_at(char *out, size_t n, const Tex *e, const Tex *skip) {
 // Each call looks at up to SWEEP_LOOK entries from where the last one stopped (sweep_at; rel_unlink moves it off an
 // entry that leaves): with thousands of entries that stay, a walk from the head at every release would cross them all.
 #define RELEASED_MAX 2048
+#define RELEASED_MAX_TOP 8192
 #define RELEASED_HARD 16384
+// NX2NAVI_TEX_RELEASED_MAX (default RELEASED_MAX): the count of released entries the sweep keeps. "vram" is upstream's
+// rule (ee46a19, after 0.9.0): one per 2 MiB of the video memory budget, from RELEASED_MAX to RELEASED_MAX_TOP; a number
+// sets it (1 to RELEASED_HARD); "ab" switches between RELEASED_MAX and the "vram" limit with the A/B blocks. Running
+// through Hyrule Field (play32/play33 load-run, frames 3240-4380) the count sat at 2,048 and the sweep dropped 400 entries
+// a 60-frame window while 415-460 textures were made in the same windows; standing, with 2,046 kept, it dropped none and
+// none were made. The memory of the kept entries stays bounded by NX2NAVI_TEX_RELEASED_MB and the VRAM pressure.
+static int released_max_mode = -1;   // -1 not read; 0 a fixed limit; 1 the "vram" rule; 2 "ab"
+static int released_max_fixed = RELEASED_MAX, released_max_vram;
+
+static int released_max(void) {
+    if (released_max_mode < 0) {
+        const char *s = cfg_get("NX2NAVI_TEX_RELEASED_MAX");
+        released_max_mode = 0;
+        if (s && !strcmp(s, "vram")) released_max_mode = 1;
+        else if (s && !strcmp(s, "ab")) released_max_mode = 2;
+        else if (s && *s) {
+            long long n = atoll(s);
+            released_max_fixed = n < 1 ? 1 : n > RELEASED_HARD ? RELEASED_HARD : (int)n;
+        }
+    }
+    if (released_max_mode && !released_max_vram) {   // read once the budget is known
+        uint64_t vused = 0, vbudget = 0;
+        int exact = 0;
+        if (!vk_mem_vram(&vused, &vbudget, &exact) || !vbudget) return RELEASED_MAX;
+        long long n = (long long)(vbudget >> 21);
+        released_max_vram = n < RELEASED_MAX ? RELEASED_MAX : n > RELEASED_MAX_TOP ? RELEASED_MAX_TOP : (int)n;
+        rt_log("vk: released textures: the sweep keeps up to %d entries %s(NX2NAVI_TEX_RELEASED_MAX)", released_max_vram,
+               released_max_mode == 2 ? "in the B blocks, 2048 in the A blocks " : "");
+    }
+    if (!released_max_mode) return released_max_fixed;
+    return RT_KNOB_ON(released_max_mode) ? released_max_vram : RELEASED_MAX;
+}
 #define SWEEP_LOOK 64
 #define SWEEP_UNSAMPLED PRESENTS(120)
 
@@ -1796,12 +1829,13 @@ static void sweep_released(void) {
     RT_ZONE_END(zr);
 }
 static void sweep_released_body(void) {
-    if (nreleased <= RELEASED_MAX) return;
+    int lim = released_max();
+    if (nreleased <= lim) return;
     {
         uint64_t now = frames_now();
         const uint64_t stale = PRESENTS(120);   // STALE_FRAMES, defined below
         Tex *e = sweep_at ? sweep_at : rel_head;
-        for (int n = 0; n < SWEEP_LOOK && nreleased > RELEASED_MAX; n++) {
+        for (int n = 0; n < SWEEP_LOOK && nreleased > lim; n++) {
             if (!e || now - e->rel_frame < stale) { e = rel_head; break; }   // the rest is younger: from the oldest again
             Tex *next = e->rel_next;
             if (comes_back_intact(e) || e->overwritten) drop_tex(e, DROP_MAX);
-- 
