diff --git a/runtime/ui/menu.cpp b/runtime/ui/menu.cpp
index e7dc2a03..08ee756e 100644
--- a/runtime/ui/menu.cpp
+++ b/runtime/ui/menu.cpp
@@ -2051,6 +2051,25 @@ static void perf_draw(const MenuTarget *t, float scale) {
     dl->AddText(ImVec2(p.x + padx, p.y + pady), SKIN_TEXT, g_perf_text);
 }
 
+// The surface pick's crosshair (#165, vk_dump.c vk_pick_*): a cross around the window's centre pixel, which stays clear
+// so the picked surface shows through; drawn on the overlay while it is on.
+static std::atomic<int> g_crosshair;
+extern "C" int menu_crosshair_toggle(void) { return g_crosshair.fetch_xor(1) ^ 1; }
+
+static void crosshair_draw(const MenuTarget *t, float scale) {
+    if (!g_crosshair.load(std::memory_order_relaxed)) return;
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    float cx = (float)(t->width / 2) + 0.5f, cy = (float)(t->height / 2) + 0.5f, gap = 3 * scale, len = 12 * scale;
+    for (int pass = 0; pass < 2; pass++) {   // a dark outline under a bright cross
+        ImU32 c = pass ? IM_COL32(255, 60, 200, 255) : IM_COL32(0, 0, 0, 200);
+        float th = pass ? 1.5f * scale : 3.5f * scale;
+        dl->AddLine(ImVec2(cx - gap - len, cy), ImVec2(cx - gap, cy), c, th);
+        dl->AddLine(ImVec2(cx + gap, cy), ImVec2(cx + gap + len, cy), c, th);
+        dl->AddLine(ImVec2(cx, cy - gap - len), ImVec2(cx, cy - gap), c, th);
+        dl->AddLine(ImVec2(cx, cy + gap), ImVec2(cx, cy + gap + len), c, th);
+    }
+}
+
 static int overlay_frame(uint64_t frame, const MenuTarget *t, const char **shot) {
     *shot = NULL;
     if (t->phys && t->phys != g_gpu_vendor_of) {   // the GPU's vendor for the rows that depend on it (dlss_offered)
@@ -2084,7 +2103,7 @@ static int overlay_frame(uint64_t frame, const MenuTarget *t, const char **shot)
             if (g_debug.load()) debug_menu_tab(0);
             set_open(1);
             open = true;
-        } else if (!g_perf_mode && !coop_draws) {
+        } else if (!g_perf_mode && !coop_draws && !g_crosshair.load(std::memory_order_relaxed)) {
             return 0;
         }
     }
@@ -2151,6 +2170,7 @@ static int overlay_frame(uint64_t frame, const MenuTarget *t, const char **shot)
     }
     perf_draw(t, scale);
     if (coop_draws) coop_overlay_draw((float)t->width, (float)t->height, scale, open);
+    crosshair_draw(t, scale);
     ImGui::Render();
     if (open) g_save_pending = opt_save_tick(0);
     g_cost_ns += plat_now_ns() - t0;
