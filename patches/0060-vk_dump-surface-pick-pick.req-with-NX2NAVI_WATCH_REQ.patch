 runtime/gfx.h          |   1 +
 runtime/gfx_shader.c   |   6 ++
 runtime/ui/menu.cpp    |  22 +++++-
 runtime/ui/menu.h      |   1 +
 runtime/vk.h           |   1 +
 runtime/vk_backend.c   |   1 +
 runtime/vk_dump.c      | 174 +++++++++++++++++++++++++++++++++++++++++
 runtime/vk_exec.c      |   1 +
 runtime/vk_exec.h      |  10 +++
 runtime/vk_exec_draw.c |  19 +++--
 runtime/vk_exec_xfer.c |   1 +
 12 files changed, 240 insertions(+), 12 deletions(-)

