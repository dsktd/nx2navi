diff --git a/runtime/vk_dump.c b/runtime/vk_dump.c
index f7ddc507..93f5d30a 100644
--- a/runtime/vk_dump.c
+++ b/runtime/vk_dump.c
@@ -1553,3 +1553,177 @@ void vk_dump_present(uint64_t frame) {
         rt_log("vk_dump: frame %llu goes to %s", (unsigned long long)dump_frame, dir);
     }
 }
+
+// ---- surface pick (#165): pick.req (boot.c, NX2NAVI_WATCH_REQ=1) or the pick key asks which draws wrote the pixel at
+// the centre of each render pass's area (the crosshair, menu_crosshair) in the next frame. Each draw of that frame
+// whose scissor holds that pixel is recorded twice: first with the scissor cut to the one pixel, inside an occlusion
+// query of its own, then as usual. The query counts the samples that passed every test before the real draw ran, so a
+// nonzero count means this draw wrote (or, with colour writes off, would have written) that pixel over what was drawn
+// before it; the last such draw of a pass is its top surface there. The extra draw changes nothing but that pixel, and
+// there only what blending and stencil increments do twice. Draws inside one of the game's own occlusion queries are
+// left out (Vulkan does not nest them). The results (read on a thread of their own, no wait on the replay) go to
+// logs/pick-<frame>.txt: per draw that hit, its pass number (as passes.txt of a dump of the same frame numbers them),
+// draw index in the pass, samples, shaders with their cache .spv paths (hot-reload targets), bound textures, storage
+// buffers and uniform blocks with their addresses (peek.req / watch.req targets); the log gets one line per pass with
+// its last hit. The pick frame takes a few ms longer (one description per draw).
+#define PICK_N 16384
+typedef struct { int pass, draw; uint32_t w, h; uint64_t c0, dep; char *text; } PickRec;
+int vk_pick_armed;
+static volatile int pick_want, pick_busy;
+static uint64_t pick_frame;
+static int pick_seq, pick_draw, pick_n, pick_q;
+static VkRect2D pick_sc;
+static PickRec *pick_recs;
+static VkQueryPool pick_pool;
+static const VkPipeInfo *pick_info;
+static const GfxShader *pick_vs, *pick_fs;
+static int pick_prim;
+
+void vk_pick_request(void) {
+    if (__atomic_load_n(&pick_busy, __ATOMIC_ACQUIRE)) {
+        rt_log("pick: the last pick is still being read: ignored");
+        return;
+    }
+    __atomic_store_n(&pick_want, 1, __ATOMIC_RELEASE);
+    __atomic_store_n(&vk_pick_armed, 1, __ATOMIC_RELEASE);
+}
+
+static void shader_line(Str *b, const char *tag, const GfxShader *s) {
+    if (!s) return;
+    char name[17], path[PLAT_PATH_MAX];
+    gfx_shader_name(s, name);
+    sp(b, "  %s %s %s\n", tag, name, gfx_shader_spv_path(s, path, sizeof path) ? path : "(no cache path)");
+}
+
+typedef struct { uint64_t frame; int n; PickRec *recs; } PickJob;
+
+static void pick_read(void *arg) {
+    PickJob *j = arg;
+    VkDevice dev = vk_ctx()->device;
+    uint64_t *v = calloc((size_t)j->n * 2 + 2, sizeof *v);
+    uint64_t t0 = plat_now_ms();
+    for (int i = 0; v && i < j->n;) {   // the frame may still be on the GPU: wait for each query's availability, 5 s
+        VkResult r = vkGetQueryPoolResults(dev, pick_pool, (uint32_t)i, (uint32_t)(j->n - i), sizeof *v * 2 * (size_t)(j->n - i),
+                                           v + 2 * i, 2 * sizeof *v, VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+        while (i < j->n && v[2 * i + 1]) i++;
+        if (i < j->n && (r < 0 || plat_now_ms() - t0 > 5000)) break;
+        if (i < j->n) plat_wait_ns(2000000);
+    }
+    char name[64], path[PLAT_PATH_MAX];
+    snprintf(name, sizeof name, "logs/pick-%05llu.txt", (unsigned long long)j->frame);
+    FILE *f = gfx_shader_beside_cache(name, path, sizeof path) ? fopen(path, "w") : NULL;
+    int hits = 0, unread = 0;
+    if (f) fprintf(f, "pick of frame %llu: draws whose test passed at the centre pixel of their pass, in order\n",
+                   (unsigned long long)j->frame);
+    for (int i = 0; i < j->n; i++) {
+        PickRec *r = &j->recs[i];
+        int got = v && v[2 * i + 1];
+        unread += !got;
+        if (got && v[2 * i]) {
+            hits++;
+            if (f) fprintf(f, "pass %04d draw %d: %llu samples at (%u,%u) of %ux%u, colour 0 at %#llx, depth at %#llx\n%s",
+                           r->pass, r->draw, (unsigned long long)v[2 * i], r->w / 2, r->h / 2, r->w, r->h,
+                           (unsigned long long)r->c0, (unsigned long long)r->dep, r->text ? r->text : "");
+            int last = 1;   // the last hit of its pass: one log line
+            for (int k = i + 1; k < j->n && j->recs[k].pass == r->pass; k++)
+                if (v[2 * k + 1] && v[2 * k]) { last = 0; break; }
+            if (last) {
+                char *nl = r->text ? strchr(r->text, '\n') : NULL, *nl2 = nl ? strchr(nl + 1, '\n') : NULL;
+                rt_log("pick: frame %llu pass %04d %ux%u draw %d (top there): %.*s", (unsigned long long)j->frame, r->pass,
+                       r->w, r->h, r->draw, nl2 ? (int)(nl2 - r->text) : 0, r->text ? r->text : "");
+            }
+        }
+    }
+    if (f) fclose(f);
+    rt_log("pick: frame %llu: %d of %d draws hit the centre pixel (%d unread), details in %s", (unsigned long long)j->frame,
+           hits, j->n, unread, f ? path : "(not written)");
+    vkResetQueryPool(dev, pick_pool, 0, PICK_N);
+    for (int i = 0; i < j->n; i++) free(j->recs[i].text);
+    free(j->recs), free(j), free(v);
+    __atomic_store_n(&pick_busy, 0, __ATOMIC_RELEASE);
+}
+
+// The replay's present of frame: the pick frame starts with the next one, and its results are read after it.
+void vk_pick_present(uint64_t frame) {
+    if (pick_frame && frame >= pick_frame) {
+        PickJob *j = calloc(1, sizeof *j);
+        if (j) {
+            j->frame = pick_frame, j->n = pick_n, j->recs = pick_recs;
+            if (!plat_thread_spawn(pick_read, j, "pick", 0)) pick_read(j);
+        }
+        pick_recs = NULL, pick_frame = 0;
+    }
+    if (!__atomic_exchange_n(&pick_want, 0, __ATOMIC_ACQ_REL)) {
+        if (!pick_frame) __atomic_store_n(&vk_pick_armed, 0, __ATOMIC_RELEASE);
+        return;
+    }
+    if (!pick_pool) {
+        VkPhysicalDeviceVulkan12Features f12 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+        VkPhysicalDeviceFeatures2 f2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &f12};
+        vkGetPhysicalDeviceFeatures2(vk_ctx()->phys, &f2);
+        VkQueryPoolCreateInfo qi = {.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, .queryType = VK_QUERY_TYPE_OCCLUSION,
+                                    .queryCount = PICK_N};
+        if (!f12.hostQueryReset || vkCreateQueryPool(vk_ctx()->device, &qi, NULL, &pick_pool) != VK_SUCCESS) {
+            rt_log("pick: no occlusion query pool (hostQueryReset needed): no picks");
+            pick_pool = VK_NULL_HANDLE;
+            __atomic_store_n(&vk_pick_armed, 0, __ATOMIC_RELEASE);
+            return;
+        }
+        vkResetQueryPool(vk_ctx()->device, pick_pool, 0, PICK_N);
+    }
+    pick_recs = calloc(PICK_N, sizeof *pick_recs);
+    if (!pick_recs) return;
+    __atomic_store_n(&pick_busy, 1, __ATOMIC_RELEASE);
+    pick_frame = frame + 1, pick_seq = pick_draw = pick_n = 0;
+    rt_log("pick: frame %llu is picked at the centre pixel of each pass", (unsigned long long)pick_frame);
+}
+
+static int pick_now(void) { return pick_frame && frame_now() == pick_frame; }
+
+void vk_pick_pass_end(void) {
+    if (pick_now()) pick_seq++, pick_draw = 0;
+}
+
+void vk_pick_note(const VkPipeState *s, const VkPipeInfo *info) {
+    if (!pick_now()) return;
+    pick_info = info, pick_vs = s->vs, pick_fs = s->fs, pick_prim = s->prim;
+}
+
+// Before a draw's own command: 1 when the draw is to be recorded once more, first, for the pick (vk_pick_post after).
+int vk_pick_pre(VkExec *ex) {
+    if (!pick_now() || !pick_info) return 0;
+    int draw = pick_draw++;
+    const VkPipeInfo *info = pick_info;
+    pick_info = NULL;
+    if (pick_n >= PICK_N || vk_exec_oq_active()) return 0;
+    VkRect2D sc = vk_exec_scissor(ex);
+    int32_t x = (int32_t)(ex->pass_w / 2), y = (int32_t)(ex->pass_h / 2);
+    if (x < sc.offset.x || y < sc.offset.y || x >= sc.offset.x + (int32_t)sc.extent.width ||
+        y >= sc.offset.y + (int32_t)sc.extent.height)
+        return 0;
+    PickRec *r = &pick_recs[pick_n];
+    r->pass = pick_seq, r->draw = draw, r->w = ex->pass_w, r->h = ex->pass_h;
+    r->c0 = ex->color[0].tex ? (uint64_t)(uintptr_t)ex->color[0].tex->mem : 0;
+    r->dep = ex->depth.tex ? (uint64_t)(uintptr_t)ex->depth.tex->mem : 0;
+    Str b = {0};
+    shader_line(&b, "vs", pick_vs);
+    shader_line(&b, "fs", pick_fs);
+    sp(&b, "  prog %llu prim %d draw: %s\n  c-banks:", (unsigned long long)(ex->prog ? ex->prog->serial : 0), pick_prim,
+       vk_dump_draw_args);
+    cbank_list(&b, ex, info);
+    sp(&b, "\n");
+    describe_bindings(&b, ex, info);
+    r->text = b.s;
+    pick_sc = sc, pick_q = pick_n++;
+    VkRect2D one = {{x, y}, {1, 1}};
+    vkCmdSetScissorWithCount(ex->cb, 1, &one);
+    vkCmdBeginQuery(ex->cb, pick_pool, (uint32_t)pick_q, 0);
+    ex->recorded += 2;
+    return 1;
+}
+
+void vk_pick_post(VkExec *ex) {
+    vkCmdEndQuery(ex->cb, pick_pool, (uint32_t)pick_q);
+    vkCmdSetScissorWithCount(ex->cb, 1, &pick_sc);
+    ex->recorded += 2;
+}
diff --git a/runtime/vk_exec.c b/runtime/vk_exec.c
index 7727c6c1..28218a8a 100644
--- a/runtime/vk_exec.c
+++ b/runtime/vk_exec.c
@@ -899,6 +899,7 @@ void vk_exec_pass_end(VkExec *ex) {
         if (ex->color[i].image && ex->color[i].img && ex->color[i].img->image != ex->color[i].image)
             bc_copy_back(ex, &ex->color[i]);
     if (vk_dump_armed) vk_dump_pass_end(ex);
+    if (__atomic_load_n(&vk_pick_armed, __ATOMIC_RELAXED)) vk_pick_pass_end();
     if (__atomic_load_n(&vk_bufcap_on, __ATOMIC_ACQUIRE)) vk_bufcap_pass_end(ex);
     uint64_t stamp = __atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED) + 1;
     // The targets are marked written outside tfr_lock: vk_texture_gpu_written takes the texture lock, and a chunk that
diff --git a/runtime/vk_exec.h b/runtime/vk_exec.h
index eb7a8b37..6764c88b 100644
--- a/runtime/vk_exec.h
+++ b/runtime/vk_exec.h
@@ -345,3 +345,13 @@ int vk_contact_pending(void);   // a contact shadows' pass waits for the next tr
 // when counting and none is active), and the open pass about to end (ends the active query).
 void vk_exec_oq_draw(VkExec *ex);
 void vk_exec_oq_pass_end(VkExec *ex);
+int vk_exec_oq_active(void);   // one of the game's occlusion queries is active in the open pass
+// Surface pick (vk_dump.c, #165): while vk_pick_armed, prepare_draw notes each draw's state, every draw command is
+// wrapped in VK_PICK, and pass ends and dispatches count the frame's passes; the present arms and reads the pick.
+extern int vk_pick_armed;
+void vk_pick_note(const VkPipeState *s, const VkPipeInfo *info);
+int vk_pick_pre(VkExec *ex);
