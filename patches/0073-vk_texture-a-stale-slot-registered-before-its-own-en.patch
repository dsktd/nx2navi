From 480a72cba842766f9240037e5346bf2b903ad238 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:54:18 -0500
Subject: [PATCH] vk_texture: a stale slot (registered before its own entry was
 released) over an initialized NVN texture of its own descriptor takes the
 entry back with NX2NAVI_TEX_STALE_LIVE=1 (default 0: blank as before); such
 slots are logged (16) and counted in the mem line (#149/#169)

---
 runtime/cfg.c        |  4 ++--
 runtime/vk_texture.c | 28 +++++++++++++++++++++++-----
 2 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 2496378..a673519 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -97,7 +97,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"},
     {"LIB_PREBUILD", "performance"}, {"LIB_PREBUILD_THREADS", "performance"}, {"PIPE_PREBUILD", "performance"},
     {"PREWARM_XLATE", "performance"}, {"GPL", "performance"}, {"ASTC", "performance"}, {"MEMORY", "performance"},
-    {"TEX_ALIAS", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_STALE_GONE", "performance"}, {"TEX_LIVE_EVICT", "performance"}, {"TEX_LIVE_IDLE", "performance"}, {"TEX_LIVE_GUARD", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"},
+    {"TEX_ALIAS", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_STALE_GONE", "performance"}, {"TEX_STALE_LIVE", "performance"}, {"TEX_LIVE_EVICT", "performance"}, {"TEX_LIVE_IDLE", "performance"}, {"TEX_LIVE_GUARD", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"},
     {"BIND_SKIP", "performance"}, {"SHADER_MEMO", "performance"}, {"PIPE_MEMO", "performance"}, {"TEX_MEMO", "performance"}, {"TEX_SAME", "performance"}, {"DESC_TEMPLATE", "performance"},
     {"PUSH_SKIP", "performance"}, {"SPLIT_DRAWS", "performance"}, {"SPLIT_US", "performance"}, {"VK_VALIDATION", "performance"},
     {"VK_DYN_VERTEX", "performance"}, {"VK_DYN_A2C", "performance"}, {"VK_SUBGROUP_PIN", "performance"},
@@ -173,7 +173,7 @@ static const CfgMeta metas[] = {
     {"PIPE_PREBUILD", "1", "0|1", RESTART}, {"PREWARM_XLATE", "", "1..64", RESTART}, {"GPL", "1", "0|1", RESTART},
     // textures and memory
     {"ASTC", "auto", "auto|gpu|native|cpu", RESTART}, {"MEMORY", "auto", "auto|import|mirror|verify", RESTART},
-    {"TEX_ALIAS", "1", "0|1", RESTART}, {"TEX_VRAM_PRESSURE", "90", "0..100", RESTART}, {"TEX_STALE_GONE", "0", "0|1", RESTART}, {"TEX_LIVE_EVICT", "85", "0..100", RESTART}, {"TEX_LIVE_IDLE", "3600", "1..1000000", RESTART}, {"TEX_LIVE_GUARD", "240", "0..1000000", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
+    {"TEX_ALIAS", "1", "0|1", RESTART}, {"TEX_VRAM_PRESSURE", "90", "0..100", RESTART}, {"TEX_STALE_GONE", "0", "0|1", RESTART}, {"TEX_STALE_LIVE", "0", "0|1", RESTART}, {"TEX_LIVE_EVICT", "85", "0..100", RESTART}, {"TEX_LIVE_IDLE", "3600", "1..1000000", RESTART}, {"TEX_LIVE_GUARD", "240", "0..1000000", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
     // render fixes
     {"LOD_GUARD", "1", "0|1", RESTART}, {"FIX_C0", "1", "0|1", RESTART}, {"FIX_ZERO", "1", "0|1", RESTART},
     {"BIND_SKIP", "1", "0|1", RESTART}, {"SHADER_MEMO", "1", "0|1", RESTART}, {"PIPE_MEMO", "1", "0|1", RESTART}, {"TEX_MEMO", "1", "0|1", RESTART}, {"TEX_SAME", "1", "0|1", RESTART},
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 825f4fa..fe7f629 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -174,6 +174,8 @@ static uint64_t n_gone_made, n_gone_blocked, n_gone_unkeyed, n_gone_resets;
 // as without the rule. Slots that resolve to nothing are counted by the path: stale rule (released own entry), gone
 // rule, create held (a failed create within 2 s), create failed.
 static uint64_t n_gone_live, n_nil_stale, n_nil_gone, n_nil_held, n_nil_failed;
+static uint64_t n_stale_live;   // stale-rule slots over a live NVN texture of their descriptor
+static int stale_live = -1;     // NX2NAVI_TEX_STALE_LIVE
 static void nil_note(const char *why, const TexKey *k, uint64_t *n) {
     if (++*n <= 16)
         rt_log("vk: slot resolves to nothing (%s): addr 0x%llx %ux%u fmt %u", why, (unsigned long long)k->addr,
@@ -2058,8 +2060,22 @@ static Tex *slot_resolve(TexSlot *s, view_t *view, int *has_view) {
         // registered again after the release is live and revives the entry.
         if (!e && any) e = any;
         else if (!e && !cpu_slot) e = own;
-        else if (!e && own && (uint32_t)(sinfo[s - tslots] >> 16) <= own->rel_serial)
-            stale = 1, nil_note("stale rule", &k, &n_nil_stale);
+        else if (!e && own && (uint32_t)(sinfo[s - tslots] >> 16) <= own->rel_serial) {
+            // NX2NAVI_TEX_STALE_LIVE=1: the storage holds an initialized NVN texture of the slot's own descriptor
+            // again (finalized and initialized anew without a new registration; the descriptor in the guest pool
+            // stays valid on the console): the slot is current and takes the entry back. Ocarina's terrain height
+            // tiles (r32f 260x260) went to the dummy this way while their colour sibling resolved (#149/#169).
+            if (stale_live < 0) stale_live = cfg_bool("NX2NAVI_TEX_STALE_LIVE");
+            tex_t lt;
+            TexKey lk;
+            int live = nvn_tex_live_at(s->t.mem, &lt) && (make_key(&lt, &lk), !memcmp(&lk, &k, sizeof k));
+            if (live) n_stale_live++;
+            if (live && n_stale_live <= 16)
+                rt_log("vk: stale slot %d over a live texture of its descriptor: addr 0x%llx %ux%u fmt %u (%s)",
+                       (int)(s - tslots), (unsigned long long)k.addr, (unsigned)k.d.width, (unsigned)k.d.height,
+                       (unsigned)k.d.format, stale_live ? "taken back" : "blank; NX2NAVI_TEX_STALE_LIVE=1 takes it back");
+            if (!(live && stale_live)) stale = 1, nil_note("stale rule", &k, &n_nil_stale);
+        }
         if (!e && !own) {   // the entry went: the same rule against the serial its key went at
             void *g = nvn_hm_get(&gone, &k);
             int live_at = 0;
@@ -3015,7 +3031,7 @@ void vk_texture_format_log(uint64_t frame) {
         g[k].n++, g[k].bytes += ai.size, g[k].src += e->t.L.size;
     }
     uint64_t gm = n_gone_made, gb = n_gone_blocked, gu = n_gone_unkeyed, gr = n_gone_resets;
-    uint64_t gl = n_gone_live, ns = n_nil_stale, nh = n_nil_held, nf = n_nil_failed;
+    uint64_t gl = n_gone_live, ns = n_nil_stale, nh = n_nil_held, nf = n_nil_failed, nsl = n_stale_live;
     uint32_t gk = gone.n;
     uint64_t dn[DC_N], db[DC_N];
     memcpy(dn, td_n, sizeof dn), memcpy(db, td_bytes, sizeof db);
@@ -3039,9 +3055,11 @@ void vk_texture_format_log(uint64_t frame) {
            (unsigned long long)frame, (unsigned long long)len, lenb / 1048576.0, (unsigned long long)letn,
            letb / 1048576.0, (unsigned long long)leg);
     rt_log("mem: textures frame %llu: gone keys with a live entry at the address (not blanked) %llu; slots resolved to "
-           "nothing: stale rule %llu, gone rule %llu, create held %llu, create failed %llu",
+           "nothing: stale rule %llu, gone rule %llu, create held %llu, create failed %llu; stale slots over a live texture "
+           "of their descriptor %llu (%s)",
            (unsigned long long)frame, (unsigned long long)gl, (unsigned long long)ns, (unsigned long long)gb,
-           (unsigned long long)nh, (unsigned long long)nf);
+           (unsigned long long)nh, (unsigned long long)nf, (unsigned long long)nsl,
+           stale_live > 0 ? "taken back" : "blank");
     for (int a = 1; a < ng; a++)
         for (int b = a; b > 0 && g[b].bytes > g[b - 1].bytes; b--) { Grp t = g[b]; g[b] = g[b - 1]; g[b - 1] = t; }
     char line[1024];
-- 
2.56.0

