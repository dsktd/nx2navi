From 66459804446b7fae21dd8623e14f1e258527cbba Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:18:37 -0500
Subject: [PATCH] vk_texture: the gone-key stale rule
 (NX2NAVI_TEX_STALE_GONE=1) blanks a slot only when no live entry is left at
 its address; slots it would have blanked although one is live are counted,
 and every slot that resolves to nothing is logged and counted by path (stale
 rule, gone rule, create held, create failed) (#169)

---
 runtime/vk_texture.c | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 0317b08..d0b2dd5 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -165,6 +165,17 @@ static uint64_t n_same_regs;   // vk_texture_register calls that changed nothing
 static nvn_hmap gone = {.klen = sizeof(TexKey)};
 static int stale_gone = -1;
 static uint64_t n_gone_made, n_gone_blocked, n_gone_unkeyed, n_gone_resets;
+// A gone key whose address still holds a live entry (any target) is not gone: VRAM pressure and the render-target
+// trim destroy entries the game still samples, and with NX2NAVI_TEX_STALE_GONE=1 Ocarina's terrain height texture
+// (a sibling of a resolved colour texture) went blank (#169). Such slots are counted (would have blanked) and resolve
+// as without the rule. Slots that resolve to nothing are counted by the path: stale rule (released own entry), gone
+// rule, create held (a failed create within 2 s), create failed.
+static uint64_t n_gone_live, n_nil_stale, n_nil_gone, n_nil_held, n_nil_failed;
+static void nil_note(const char *why, const TexKey *k, uint64_t *n) {
+    if (++*n <= 16)
+        rt_log("vk: slot resolves to nothing (%s): addr 0x%llx %ux%u fmt %u", why, (unsigned long long)k->addr,
+               (unsigned)k->d.width, (unsigned)k->d.height, (unsigned)k->d.format);
+}
 #define GONE_MAX (1u << 18)
 static void gone_note(const TexKey *k, uint32_t serial) {
     if (gone.n >= GONE_MAX) nvn_hm_clear(&gone, NULL), n_gone_resets++;
@@ -1682,12 +1693,12 @@ static Tex *entry_of(const tex_t *t) {
     make_key(t, &k);
     Tex *e = nvn_hm_get(&by_key, &k);
     if (!e) {
-        if (create_held(&k)) return NULL;
+        if (create_held(&k)) return nil_note("create held", &k, &n_nil_held), NULL;
         if (tex_alias < 0) {
             tex_alias = cfg_bool("NX2NAVI_TEX_ALIAS");
             rt_log("vk: texture aliases: %s", tex_alias ? "a new image takes the live image's content" : "a new image starts empty");
         }
-        if (!(e = create_tex(t, &k, tex_alias))) return create_failed(&k), NULL;
+        if (!(e = create_tex(t, &k, tex_alias))) return create_failed(&k), nil_note("create failed", &k, &n_nil_failed), NULL;
         perf_count(PERF_CNT_TEX_NEW);
         // released entries of another descriptor at this address are replaced by the new one; a live one holding
         // GPU-written content is the alias source, preferring the one that differs only in swizzle (same_but_swizzle)
@@ -1961,16 +1972,20 @@ static Tex *slot_resolve(TexSlot *s, view_t *view, int *has_view) {
         // registered again after the release is live and revives the entry.
         if (!e && any) e = any;
         else if (!e && !cpu_slot) e = own;
-        else if (!e && own && (uint32_t)(sinfo[s - tslots] >> 16) <= own->rel_serial) stale = 1;
+        else if (!e && own && (uint32_t)(sinfo[s - tslots] >> 16) <= own->rel_serial)
+            stale = 1, nil_note("stale rule", &k, &n_nil_stale);
         if (!e && !own) {   // the entry went: the same rule against the serial its key went at
             void *g = nvn_hm_get(&gone, &k);
-            if (g && (uint32_t)(sinfo[s - tslots] >> 16) <= (uint32_t)(uintptr_t)g) {
+            int live_at = 0;
+            for (Tex *p = g ? nvn_hm_get(&by_addr, &k.addr) : NULL; p && !live_at; p = p->next_at) live_at = !p->released;
+            if (g && live_at && (uint32_t)(sinfo[s - tslots] >> 16) <= (uint32_t)(uintptr_t)g) n_gone_live++;
+            else if (g && (uint32_t)(sinfo[s - tslots] >> 16) <= (uint32_t)(uintptr_t)g) {
                 if (stale_gone < 0) {
                     stale_gone = cfg_bool("NX2NAVI_TEX_STALE_GONE");
                     rt_log("vk: slots of finalized or freed textures whose entry went: %s",
                            stale_gone ? "resolve to nothing" : "make a new live entry (NX2NAVI_TEX_STALE_GONE=1: nothing)");
                 }
-                if (stale_gone) stale = 1, n_gone_blocked++;
+                if (stale_gone) stale = 1, n_gone_blocked++, nil_note("gone rule", &k, &n_nil_gone);
                 else gone_slot = 1;
             }
         }
@@ -2903,6 +2918,7 @@ void vk_texture_format_log(uint64_t frame) {
         g[k].n++, g[k].bytes += ai.size, g[k].src += e->t.L.size;
     }
     uint64_t gm = n_gone_made, gb = n_gone_blocked, gu = n_gone_unkeyed, gr = n_gone_resets;
+    uint64_t gl = n_gone_live, ns = n_nil_stale, nh = n_nil_held, nf = n_nil_failed;
     uint32_t gk = gone.n;
     uint64_t dn[DC_N], db[DC_N];
     memcpy(dn, td_n, sizeof dn), memcpy(db, td_bytes, sizeof db);
@@ -2918,6 +2934,10 @@ void vk_texture_format_log(uint64_t frame) {
            (unsigned long long)gr, (unsigned long long)dn[1], db[1] / 1048576.0, (unsigned long long)dn[2],
            db[2] / 1048576.0, (unsigned long long)dn[3], db[3] / 1048576.0, (unsigned long long)dn[4], db[4] / 1048576.0,
            (unsigned long long)dn[5], db[5] / 1048576.0, (unsigned long long)dn[6], db[6] / 1048576.0);
+    rt_log("mem: textures frame %llu: gone keys with a live entry at the address (not blanked) %llu; slots resolved to "
+           "nothing: stale rule %llu, gone rule %llu, create held %llu, create failed %llu",
+           (unsigned long long)frame, (unsigned long long)gl, (unsigned long long)ns, (unsigned long long)gb,
+           (unsigned long long)nh, (unsigned long long)nf);
     for (int a = 1; a < ng; a++)
         for (int b = a; b > 0 && g[b].bytes > g[b - 1].bytes; b--) { Grp t = g[b]; g[b] = g[b - 1]; g[b - 1] = t; }
     char line[1024];
-- 
2.56.0

