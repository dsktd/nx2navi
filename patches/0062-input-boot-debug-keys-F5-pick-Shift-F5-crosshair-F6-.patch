From 2de364341476065d20124acbbebf281817a39c87 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:20:29 -0500
Subject: [PATCH] input, boot: debug keys F5 pick, Shift+F5 crosshair, F6 shot,
 F12 dump the next frame (NX2NAVI_DUMP_REQ=1), Shift+F6 'broken now' and
 Shift+F12 'looks fixed' (one ANSWER line and a shot each) (#165)

---
 runtime/boot.c      | 18 ++++++++++++++++++
 runtime/input.h     |  6 ++++++
 runtime/input_sdl.c | 10 +++++++++-
 runtime/input_win.c |  1 +
 4 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/runtime/boot.c b/runtime/boot.c
index f36c3fd0..6f52d2fa 100644
--- a/runtime/boot.c
+++ b/runtime/boot.c
@@ -509,6 +509,22 @@ static void watch_req_poll(uint64_t n) {
     }
 }
 
+// The debug keys (input.h input_debug_keys; a controller daemon's chord can send them): pick, crosshair, a shot, a
+// dump of the next frame (needs NX2NAVI_DUMP_REQ=1), and Cal's two answers, each one log line with a shot.
+static void debug_keys(int k, uint64_t n, const char *dump_path) {
+    unsigned long long p = n;
+    if (k & INPUT_DBG_PICK) rt_log("pick: asked at present %llu (F5)", p), vk_pick_request();
+    if (k & INPUT_DBG_CROSSHAIR) rt_log("pick: crosshair %s (Shift+F5, present %llu)", menu_crosshair_toggle() ? "on" : "off", p);
+    if (k & INPUT_DBG_SHOT) rt_log("key: shot at present %llu (F6)", p), shot_force = 1;
+    if (k & INPUT_DBG_DUMP) {
+        FILE *f = dump_path ? fopen(dump_path, "w") : NULL;
+        if (f) fclose(f);
+        rt_log("key: dump of the next frame %s (F12, present %llu)", f ? "asked" : "needs NX2NAVI_DUMP_REQ=1", p);
+    }
+    if (k & INPUT_DBG_BROKEN) rt_log("ANSWER: BROKEN NOW at present %llu (Shift+F6)", p), shot_force = 1;
+    if (k & INPUT_DBG_FIXED) rt_log("ANSWER: LOOKS FIXED at present %llu (Shift+F12)", p), shot_force = 1;
+}
+
 static void mark_poll(uint64_t n) {
     static int init, dump_req, marks;
     static char mark_req[PLAT_PATH_MAX], dump_path[PLAT_PATH_MAX];
@@ -539,6 +555,8 @@ static void mark_poll(uint64_t n) {
     }
     watch_req_poll(n);
     plat_write_trace_rearm();
+    int keys = input_debug_keys();
+    if (keys) debug_keys(keys, n, dump_req ? dump_path : NULL);
     const char *why = input_mark_key() ? "F9" : input_mark_take() ? "gamepad chord" : NULL;
     if (!why && mark_req[0] && n % 4 == 0 && plat_file_exists(mark_req)) why = "mark.req", plat_file_delete(mark_req);
     if (!why) return;
diff --git a/runtime/input.h b/runtime/input.h
index 5ba03480..dd05e06c 100644
--- a/runtime/input.h
+++ b/runtime/input.h
@@ -77,6 +77,12 @@ int input_dump_key(void);
 // Mark this moment (boot.c rt_frame_presented): input_mark_key, F9 pressed since the last call (once per press);
 // input_mark_take, the gamepad chord NX2NAVI_MARK_CHORD held NX2NAVI_MARK_HOLD_MS since the last call (once per hold).
 int input_mark_key(void);
+// Debug keys (boot.c, #165), pressed since the last call, once per press: F5 pick the surface under the crosshair,
+// Shift+F5 crosshair on/off, F6 screenshot, Shift+F6 "broken now", F12 dump this frame, Shift+F12 "looks fixed". They
+// still reach the game's key map (f5, f6, f12 are bindable but unbound by default).
+enum { INPUT_DBG_PICK = 1, INPUT_DBG_CROSSHAIR = 2, INPUT_DBG_SHOT = 4, INPUT_DBG_BROKEN = 8, INPUT_DBG_DUMP = 16,
+       INPUT_DBG_FIXED = 32 };
+int input_debug_keys(void);
 int input_mark_take(void);
 
 // Mouse camera and cursor (input_win.c, Win32 window thread). The window procedure calls input_window_msg first for raw
diff --git a/runtime/input_sdl.c b/runtime/input_sdl.c
index 5207916f..da90a122 100644
--- a/runtime/input_sdl.c
+++ b/runtime/input_sdl.c
@@ -20,7 +20,7 @@
 
 static SDL_Window *win;
 static volatile uint8_t key_held[KEY_COUNT];
-static volatile int32_t esc_held, f8_held, insert_held, f9_mark, focused;
+static volatile int32_t esc_held, f8_held, insert_held, f9_mark, focused, dbg_keys;
 static volatile int32_t mouse_dx, mouse_dy;   // relative motion since the last ikb_mouse_take, whole counts
 static float rem_x, rem_y;                    // window thread: the fractions SDL reported beyond them
 static volatile int32_t captured;             // relative mouse mode is on
@@ -120,6 +120,7 @@ int input_flight_key(void) { return focused && f8_held; }
 int input_dump_key(void) { return focused && insert_held; }
 // F9 marks while the debug menu, which F9 opens, is off (menu_debug_enabled)
 int input_mark_key(void) { return plat_xchg32(&f9_mark, 0) && !menu_debug_enabled(); }
+int input_debug_keys(void) { return dbg_keys ? plat_xchg32(&dbg_keys, 0) : 0; }
 
 // ---- the cursor (window thread)
 static void cursor_apply(void) {
@@ -183,6 +184,13 @@ void input_sdl_event(const SDL_Event *e) {
         if (e->key.scancode == SDL_SCANCODE_F8) plat_xchg32(&f8_held, down);
         if (e->key.scancode == SDL_SCANCODE_INSERT) plat_xchg32(&insert_held, down);
         if (e->key.scancode == SDL_SCANCODE_F9 && down && !e->key.repeat) plat_xchg32(&f9_mark, 1);   // mark this moment (boot.c)
+        if (down && !e->key.repeat) {   // the debug keys (input.h input_debug_keys)
+            int sh = (e->key.mod & SDL_KMOD_SHIFT) != 0, bit = 0;
+            if (e->key.scancode == SDL_SCANCODE_F5) bit = sh ? INPUT_DBG_CROSSHAIR : INPUT_DBG_PICK;
+            if (e->key.scancode == SDL_SCANCODE_F6) bit = sh ? INPUT_DBG_BROKEN : INPUT_DBG_SHOT;
+            if (e->key.scancode == SDL_SCANCODE_F12) bit = sh ? INPUT_DBG_FIXED : INPUT_DBG_DUMP;
+            if (bit) __atomic_fetch_or(&dbg_keys, bit, __ATOMIC_RELAXED);
+        }
         int k = key_of_sc(e->key.scancode);
         if (k) key_held[k] = (uint8_t)down;
         break;
diff --git a/runtime/input_win.c b/runtime/input_win.c
index ff622d39..7c46ac6c 100644
--- a/runtime/input_win.c
+++ b/runtime/input_win.c
@@ -196,6 +196,7 @@ int input_flight_key(void) {
 }
 
 int input_dump_key(void) { return key_down(VK_INSERT); }
+int input_debug_keys(void) { return 0; }   // Linux only for now
 
 int input_mark_key(void) {   // F9's press, once
     static int was;
