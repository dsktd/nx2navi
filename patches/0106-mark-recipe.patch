 void dbg_unfreeze_all(void);
+// A mark's recipe (boot.c mark_poll): dbg_mark_take answers 1 once after the test script's "mark"
+int dbg_mark_take(void);
+// Writes the moment's recipe to path (recipe v1: area, Link's place, age, camera, game data); mark: the "# mark:" text.
