diff --git a/runtime/kernel.c b/runtime/kernel.c
index 31701e70..524c3b64 100644
--- a/runtime/kernel.c
+++ b/runtime/kernel.c
@@ -86,6 +86,7 @@ struct RtThread {
     uint32_t tid;              // host thread id
     int st;                    // S_* state since st_since
     uint64_t st_since, st_ns[S_N], nblk, npre, pre_since, cpu_last;
+    uint64_t sl_st[S_N];       // NX2NAVI_STALL_MS: the states' sums at the previous present
     uint64_t wobj;             // what the current wait is on: owner handle, key, address or first handle
     const uint32_t *whs;       // a WaitSynchronization that blocks: its handles, in the waiter's own memory (holding G)
     int wn;
@@ -171,8 +172,9 @@ static void wait_add(WaitRec *w, int st, uint64_t obj, uint32_t waker, uint64_t
 }
 
 // Close the current state's interval and enter st.
+static int g_stall_on;   // NX2NAVI_STALL_MS set: the states are counted without NX2NAVI_TRACE=sched too
 static void acct(RtThread *t, int st) {
-    if (!(rt_trace & RT_TRACE_SCHED)) return;
+    if (!(rt_trace & RT_TRACE_SCHED) && !g_stall_on) return;
     uint64_t now = kern_now_ns();
     if (t->st_since) {
         t->st_ns[t->st] += now - t->st_since;
@@ -1282,6 +1284,7 @@ void kern_sched_report(uint64_t frame) {
     uint64_t sc = g_sync_calls, sb = g_sync_blocks, sw = g_sync_woken, ss = g_sync_spared;
     for (RtThread *t = g_all; t; t = t->all) {
         memset(t->st_ns, 0, sizeof t->st_ns);
+        memset(t->sl_st, 0, sizeof t->sl_st);   // NX2NAVI_STALL_MS counts from here on
         t->nblk = t->npre = 0;
         t->lw_ns = t->lw_n = t->lw_max = t->lg_ns = t->lg_n = t->lg_max = t->sl_n = t->sl_req = t->sl_act = 0;
         t->sp_n = t->sp_ho = 0;   // racy against the thread's own increments: a few passes may be lost
@@ -1329,6 +1332,91 @@ void kern_sched_report(uint64_t frame) {
         }
 }
 
+// NX2NAVI_STALL_MS (default 0, off): a present at least that long after the previous one gets a line per busy guest
+// thread saying where its interval went: the kernel's states (run = guest code holding a core, core = waiting for a
+// virtual core, host = in a host call, sleep/sync/cv/lock/addr = blocked in that kind of SVC), what the host scheduler
+// gave it (on the CPU, waiting on a run queue) and its page faults. The frame-time summary's worst frames charge the
+// renderer only; a frame with nothing there was spent here. Costs two /proc reads per guest thread per present.
+static uint64_t g_stall_ns;
+static void stall_proc(uint32_t tid, uint64_t *run, uint64_t *rq, uint64_t *flt, uint64_t *maj) {
+    char path[64], buf[1024];
+    *run = *rq = *flt = *maj = 0;
+    snprintf(path, sizeof path, "/proc/self/task/%u/schedstat", tid);
+    FILE *f = fopen(path, "r");
+    if (f) {
+        unsigned long long a = 0, b = 0;
+        if (fscanf(f, "%llu %llu", &a, &b) == 2) *run = a, *rq = b;
+        fclose(f);
+    }
+    snprintf(path, sizeof path, "/proc/self/task/%u/stat", tid);
+    if (!(f = fopen(path, "r"))) return;
+    size_t n = fread(buf, 1, sizeof buf - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    const char *p = strrchr(buf, ')');   // fields after the name: state ppid pgrp session tty tpgid flags minflt cminflt majflt
+    unsigned long long mn = 0, mj = 0;
+    if (p && sscanf(p + 2, "%*c %*d %*d %*d %*d %*d %*u %llu %*u %llu", &mn, &mj) == 2) *flt = mn, *maj = mj;
+}
+
+void kern_stall_frame(uint64_t frame, uint64_t interval_ns) {
+    static int init;
+    if (!init) {
+        init = 1;
+        g_stall_ns = (uint64_t)(strtod(cfg_value("NX2NAVI_STALL_MS"), NULL) * 1e6);
+        g_stall_on = g_stall_ns > 0;
+        if (g_stall_on) rt_log("kernel: presents over %.0f ms log where each guest thread spent them (NX2NAVI_STALL_MS)",
+                               g_stall_ns / 1e6);
+    }
+    if (!g_stall_on) return;
+    enum { ROWS = 6, TH = 128 };
+    typedef struct { uint32_t h, tid; int prio, main, render; uint64_t st[S_N], run, rq, flt, maj, busy; } Row;
+    static struct { uint32_t tid; uint64_t run, rq, flt, maj; } base[TH];   // the host's sums at the previous present
+    static Row th[TH];
+    Row r[ROWS];
+    int nt = 0, nr = 0, slow = interval_ns >= g_stall_ns && frame > 1;
+    lock();   // the kernel's states under G; the /proc reads after it
+    for (RtThread *t = g_all; t && nt < TH; t = t->all) {
+        if (!t->tid || t->exited) continue;
+        acct(t, t->st);   // close the open interval
+        Row *x = &th[nt++];
+        x->h = t->handle, x->tid = t->tid, x->prio = t->prio, x->main = t->is_main, x->render = t == g_render;
+        for (int k = 0; k < S_N; k++) x->st[k] = t->st_ns[k] - t->sl_st[k];
+        memcpy(t->sl_st, t->st_ns, sizeof t->sl_st);
+    }
+    unlock();
+    for (int i = 0; i < nt; i++) {
+        Row *x = &th[i];
+        uint64_t run, rq, flt, maj;
+        stall_proc(x->tid, &run, &rq, &flt, &maj);
+        int j = 0;
+        while (j < TH && base[j].tid && base[j].tid != x->tid) j++;
+        if (j == TH) j = (int)(x->tid % TH);   // full: reuse a slot, that thread's next line is off once
+        int known = base[j].tid == x->tid;
+        x->run = known ? run - base[j].run : 0, x->rq = known ? rq - base[j].rq : 0;
+        x->flt = known ? flt - base[j].flt : 0, x->maj = known ? maj - base[j].maj : 0;
+        base[j].tid = x->tid, base[j].run = run, base[j].rq = rq, base[j].flt = flt, base[j].maj = maj;
+        if (!slow) continue;
+        x->busy = x->st[S_RUN] + x->st[S_CORE] + x->st[S_HOST] + x->run + (x->main ? (uint64_t)1 << 62 : 0);   // main first
+        int at = nr < ROWS ? nr++ : ROWS;
+        while (at > 0 && r[at - 1].busy < x->busy) {
+            if (at < ROWS) r[at] = r[at - 1];
+            at--;
+        }
+        if (at < ROWS) r[at] = *x;
+    }
+    if (!slow) return;
+    rt_log("stall: frame %llu: %.1f ms since the previous present", (unsigned long long)frame, interval_ns / 1e6);
+    for (int i = 0; i < nr; i++) {
+        char s[256];
+        int o = 0;
+        for (int k = S_RUN; k < S_N && o < (int)sizeof s - 32; k++)
+            if (r[i].st[k] >= 100000) o += snprintf(s + o, sizeof s - o, " %s %.1f", s_name[k], r[i].st[k] / 1e6);
+        rt_log("stall:   thread %#x p%d tid %u%s%s:%s ms; host CPU %.1f ms, run queue %.1f ms, faults %llu (major %llu)",
+               r[i].h, r[i].prio, r[i].tid, r[i].main ? " main" : "", r[i].render ? " render" : "", o ? s : " idle",
+               r[i].run / 1e6, r[i].rq / 1e6, (unsigned long long)r[i].flt, (unsigned long long)r[i].maj);
+    }
+}
+
 // ---- locks: tag word = owner handle | WAITERS_BIT
 static inline uint32_t ld32(uint64_t a) { return __atomic_load_n((uint32_t *)(uintptr_t)a, __ATOMIC_SEQ_CST); }
 static inline void st32(uint64_t a, uint32_t v) { __atomic_store_n((uint32_t *)(uintptr_t)a, v, __ATOMIC_SEQ_CST); }
diff --git a/runtime/perf.c b/runtime/perf.c
index fb0d0c8d..b9db9c98 100644
--- a/runtime/perf.c
+++ b/runtime/perf.c
@@ -824,6 +824,7 @@ void perf_present(uint64_t frame) {
     if (__atomic_load_n(&overlay, __ATOMIC_RELAXED))   // the overlay's only cost while it is off: this branch
         perfmon_frame(now, d, frame_ns, rep, __atomic_load_n(&counts[PERF_CNT_TEX_UP], __ATOMIC_RELAXED));
     kern_core_diag_frame(frame, d);
+    kern_stall_frame(frame, d);
     if (flight_on) flight_frame(frame, now, d, frame_ns, counts);
     if (!(rt_trace & RT_TRACE_PERF)) {
         memset(frame_ns, 0, sizeof frame_ns);
