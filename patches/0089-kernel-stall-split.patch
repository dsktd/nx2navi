diff --git a/runtime/host.h b/runtime/host.h
index 8a2df2e6..b15d1374 100644
--- a/runtime/host.h
+++ b/runtime/host.h
@@ -320,6 +320,7 @@ void kern_host_left(void *thread);                         // back at depth 0 wi
