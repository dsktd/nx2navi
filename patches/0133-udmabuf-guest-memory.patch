diff --git a/runtime/platform/linux.c b/runtime/platform/linux.c
index 72b636c2..d532da46 100644
--- a/runtime/platform/linux.c
+++ b/runtime/platform/linux.c
@@ -1113,6 +1113,189 @@ static void ps_set(uint64_t addr, uint64_t n, uint8_t v) {
     if (addr < PS_LIMIT) memset(pstate + addr / PG, v, (size_t)((n + PG - 1) / PG));
