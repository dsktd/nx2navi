From dd39cfcdc154b3e105054ab55fa95e771637460f Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 00:42:31 -0500
Subject: [PATCH] memory: NX2NAVI_ALIAS_EXTRA_MIB (default 0) lets
 MapPhysicalMemory map that much beyond the pool the game is told about; the
 reported total and the heap stay, the reported used size stops at the total
 (#141)

The game's HeapDef gives VirtualAddressMemory 2869248 KiB (2802 MiB) and its heap is the pool less the images and that
budget (6910 MiB of 9809), so MapPhysicalMemory has 2802.9 MiB and a larger NX2NAVI_APP_POOL would only grow the heap.
Play sessions hit that limit in bursts (LimitReached), once right before ground geometry vanished under the player.
---
 runtime/memory.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/runtime/memory.c b/runtime/memory.c
index 95774c6d..cc855ac1 100644
--- a/runtime/memory.c
+++ b/runtime/memory.c
@@ -53,6 +53,7 @@ static uint64_t heap_size, alias_bytes;
 static int heap_lazy;               // NX2NAVI_HEAP_LAZY, Windows: the heap is committed page run by page run on first use
 static uint64_t heap_lazy_faults, heap_lazy_bytes;   // accesses that committed heap pages, and the bytes they committed
 static uint64_t heap_lazy_ns, heap_lazy_max_ns;      // time in those faults, lock wait included, since the last report
+static uint64_t alias_extra;        // NX2NAVI_ALIAS_EXTRA_MIB: room for MapPhysicalMemory beyond the pool the game is told about
 static uint64_t alias_logged;       // alias_bytes at the last high-water log line
 static uint64_t refused_n, refused_ms, refused_freed;   // refusals since the last map that got new pages: count, first time, bytes unmapped since
 static uint8_t *alias_pages;        // 1 per mapped 4 KiB page of the alias region
@@ -1247,6 +1248,15 @@ void mem_init(void) {
         rt_log("mem: the heap is committed on first use (NX2NAVI_HEAP_LAZY)");
     }
 #endif
+    // The game sizes its heap as the pool less its images and its VirtualAddressMemory budget (HeapDef, 2802 MiB), so a
+    // larger pool only grows the heap. NX2NAVI_ALIAS_EXTRA_MIB=<n> (default 0) instead lets MapPhysicalMemory map n MiB
+    // more than the pool leaves: the total the game reads (GetInfo 6/21) and its heap stay as they are, and the used
+    // size it reads (GetInfo 7/22) stops at the total.
+    const char *extra = cfg_get("NX2NAVI_ALIAS_EXTRA_MIB");
+    alias_extra = extra ? strtoull(extra, NULL, 0) << 20 : 0;
+    if (alias_extra > ALIAS_SIZE / 2) alias_extra = ALIAS_SIZE / 2;
+    if (alias_extra) rt_log("mem: MapPhysicalMemory may map %llu MiB beyond the %llu MiB pool (NX2NAVI_ALIAS_EXTRA_MIB)",
+                            (unsigned long long)(alias_extra >> 20), (unsigned long long)(L.pool >> 20));
 }
 
 const RtGuestLayout *mem_layout(void) { return &L; }
@@ -1501,7 +1511,7 @@ static uint32_t alias_map(int unmap, uint64_t a, uint64_t n) {
     } else {
         uint64_t fresh = 0;
         for (uint64_t i = 0; i < count; i++) fresh += !alias_pages[first + i];
-        if (fresh * PAGE + alias_bytes + heap_size + image_bytes() > L.pool) {
+        if (fresh * PAGE + alias_bytes + heap_size + image_bytes() > L.pool + alias_extra) {
             r = R_LIMIT_REACHED;   // the SDK maps LimitReached to its recoverable out-of-memory result
             if (!refused_n++) refused_ms = plat_now_ms(), refused_freed = 0;
             goto out;
@@ -1695,6 +1705,7 @@ int mem_info(uint32_t id, uint64_t *out) {
         plat_mutex_lock_shared(&lock);
         v = image_bytes() + heap_size + alias_bytes;
         plat_mutex_unlock_shared(&lock);
+        if (v > L.pool) v = L.pool;   // NX2NAVI_ALIAS_EXTRA_MIB
         break;
     case 12: v = L.aslr.base; break;
     case 13: v = L.aslr.size; break;
