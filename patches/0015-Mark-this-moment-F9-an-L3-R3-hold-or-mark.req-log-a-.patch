diff --git a/runtime/flight.h b/runtime/flight.h
index 173c529..41bf2f1 100644
--- a/runtime/flight.h
+++ b/runtime/flight.h
@@ -51,3 +51,7 @@ void vk_thumbs_frame(uint64_t frame);    // the present thread names the frame o
 // Copies frame's thumbnail as RGBA when the ring still holds it complete; 0 when it was never written, is still in
 // flight or was overwritten. Takes the present lock for one slot copy (about 20 us); any thread.
 int vk_thumbs_read(uint64_t frame, uint8_t *rgba);
+uint64_t vk_thumbs_latest(void);   // the newest frame the ring holds complete, 0 for none
