From cd705dd6aaab4cafef4ec6e86a30df36c642b758 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:14:18 -0500
Subject: [PATCH] Mark this moment: F9, an L3+R3 hold or mark.req log a mark,
 save a shot (HDR10 too), arm a dump and write the thumbnail ring

---
 runtime/boot.c        | 81 +++++++++++++++++++++++++++++++++++++++++--
 runtime/cfg.c         |  1 +
 runtime/flight.h      |  4 +++
 runtime/gfx_present.c | 20 ++++++++++-
 runtime/input.c       | 42 ++++++++++++++++++++++
 runtime/input.h       |  4 +++
 runtime/input_sdl.c   |  6 +++-
 runtime/input_win.c   |  8 +++++
 runtime/vk_backend.c  |  2 +-
 9 files changed, 162 insertions(+), 6 deletions(-)

diff --git a/runtime/boot.c b/runtime/boot.c
index 19925c9..253b91e 100644
--- a/runtime/boot.c
+++ b/runtime/boot.c
@@ -20,7 +20,9 @@
 #include "fs.h"
 #include "kernel.h"
 #include "ipc.h"
+#include "flight.h"
 #include "gfx.h"
+#include "input.h"
 #include "mods.h"
 #include "nvn_api.h"
 #include "platform/platform.h"
@@ -253,6 +255,8 @@ static void save_shot(const tex_t *t, const char *path) {
 // pictures show what a player sees.
 // crop: the window crop the present shows (x, y, w, h; zero size for the whole image), so the picture is what a player
 // sees and not the whole swapchain texture the game renders a smaller frame into.
+static int shot_force;   // mark_poll: this present is saved like a shot.req, whatever NX2NAVI_SHADER_RELOAD says
+
 static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
     static int parsed;
     static unsigned long long lo, hi, step, next;
@@ -277,7 +281,8 @@ static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
     if (reload < 0)
         reload = cfg_get("NX2NAVI_SHADER_RELOAD") && atoi(cfg_get("NX2NAVI_SHADER_RELOAD")) == 1 &&
                  gfx_shader_beside_cache("shot.req", req_path, sizeof req_path);
-    int req = reload && plat_file_exists(req_path);
+    int req_file = reload && plat_file_exists(req_path), req = req_file || shot_force;
+    shot_force = 0;
     if (req) {
     } else if (world) {   // the first present at or after each step of the world clock
         int64_t w = frame_step_world_us();
@@ -288,7 +293,11 @@ static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
     }
     int fmt = t->d.format;
     int bgra = fmt == NVN_FORMAT_BGRA8 || fmt == NVN_FORMAT_BGRA8_SRGB;
-    if (!bgra && fmt != NVN_FORMAT_RGBA8 && fmt != NVN_FORMAT_RGBA8_SRGB) return;
+    int pq = fmt == NVN_FORMAT_RGB10A2;   // NX2NAVI_HDR=native: the game presents PQ Rec. 2020 (vk_hdr.c), decoded to sRGB
+    if (!bgra && !pq && fmt != NVN_FORMAT_RGBA8 && fmt != NVN_FORMAT_RGBA8_SRGB) {
+        if (req) rt_log("boot: shot of present %llu skipped: format %#x", (unsigned long long)n, fmt);
+        return;
+    }
     int cx = 0, cy = 0;
     uint32_t w = t->d.width, h = t->d.height;
     if (crop && crop[2] > 0 && crop[3] > 0 && (uint32_t)(crop[0] + crop[2]) <= w && (uint32_t)(crop[1] + crop[3]) <= h)
@@ -301,6 +310,7 @@ static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
     NVNcopyRegion r = {.xoffset = cx, .yoffset = cy, .width = (int)w, .height = (int)h, .depth = 1};
     if (gfx_replay_async()) gfx_backend()->finish();   // the presented frame may still be queued for the replay
     gfx_backend()->read_texels(t, &view, &r, px, 4ull * w, 4ull * w * h);
+    if (pq) vk_hdr_to_srgb8(px, px, (size_t)w * h, 0);   // in place: each pixel is read before it is written
     for (uint32_t y = 0; y < oh; y++)
         for (uint32_t x = 0; x < ow; x++) {
             uint32_t x0 = x * w / ow, x1 = (x + 1) * w / ow, y0 = y * h / oh, y1 = (y + 1) * h / oh;
@@ -322,7 +332,8 @@ static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
         gfx_shader_beside_cache(name, path, sizeof path);
     }
     rt_write_png(path, out, ow, oh);
-    if (req) plat_file_delete(req_path), rt_log("boot: shot.req: present %llu written to %s", (unsigned long long)n, path);
+    if (req_file) plat_file_delete(req_path);
+    if (req) rt_log("boot: shot: present %llu written to %s", (unsigned long long)n, path);
     free(out);
     free(px);
 }
@@ -330,8 +341,72 @@ static void series_shot(const tex_t *t, const int crop[4], uint64_t n) {
 // A --seconds run ends at the first present after the world clock (game time since the save's first frame,
 // frame_step_world_us) passed S seconds, so a run covers the same game time at any frame rate; any other frame is
 // counted by the back end only.
+// Mark this moment: F9, the gamepad chord (input.c, NX2NAVI_MARK_CHORD, default L3+R3 held 0.5 s) or a file mark.req
+// beside the shader cache folder (any tool: `touch build/v111/mark.req`). A mark logs "mark N at present P", saves this
+// present as logs/shot-<P>.png, touches dump.req when NX2NAVI_DUMP_REQ=1 (vk_dump.c dumps the next frame), and with
+// NX2NAVI_MARK_RING=1 writes the thumbnail ring's last MARK_RING_N frames (320x180, blitted on the GPU each present:
+// gfx_present.c) to logs/mark-<N>/f<frame>.png on a background thread.
+#define MARK_RING_N 30
+int mark_ring_on;
+
+typedef struct { int no, n; uint64_t first; char dir[PLAT_PATH_MAX]; uint8_t px[]; } MarkRing;
+
+static void mark_ring_write(void *arg) {
+    MarkRing *m = arg;
+    plat_file_mkdir_p(m->dir);
+    for (int i = 0; i < m->n; i++) {
+        char path[PLAT_PATH_MAX + 32];
+        snprintf(path, sizeof path, "%s/f%llu.png", m->dir, (unsigned long long)(m->first + (uint64_t)i));
+        uint8_t *px = m->px + (size_t)i * FLIGHT_THUMB_W * FLIGHT_THUMB_H * 4;
+        if (px[3]) rt_write_png(path, px, FLIGHT_THUMB_W, FLIGHT_THUMB_H);   // alpha 0: the ring no longer held it
+    }
+    rt_log("mark %d: %d ring frames written to %s", m->no, m->n, m->dir);
+    free(m);
+}
+
+static void mark_poll(uint64_t n) {
+    static int init, dump_req, marks;
+    static char mark_req[PLAT_PATH_MAX], dump_path[PLAT_PATH_MAX];
+    if (!init) {
+        init = 1;
+        if (!gfx_shader_beside_cache("mark.req", mark_req, sizeof mark_req)) mark_req[0] = 0;
+        dump_req = cfg_get("NX2NAVI_DUMP_REQ") && atoi(cfg_get("NX2NAVI_DUMP_REQ")) == 1 &&
+                   gfx_shader_beside_cache("dump.req", dump_path, sizeof dump_path);
+        if (cfg_get("NX2NAVI_MARK_RING") && atoi(cfg_get("NX2NAVI_MARK_RING")) == 1) {
+            vk_thumbs_enable(MARK_RING_N + 2);   // NX2NAVI_FLIGHT's larger ring, when it came first, serves too
+            mark_ring_on = 1;
+        }
+    }
+    const char *why = input_mark_key() ? "F9" : input_mark_take() ? "gamepad chord" : NULL;
+    if (!why && mark_req[0] && n % 4 == 0 && plat_file_exists(mark_req)) why = "mark.req", plat_file_delete(mark_req);
+    if (!why) return;
+    rt_log("mark %d at present %llu (%s)", ++marks, (unsigned long long)n, why);
+    shot_force = 1;
+    if (dump_req) {
+        FILE *f = fopen(dump_path, "w");
+        if (f) fclose(f);
+    }
+    uint64_t last = mark_ring_on ? vk_thumbs_latest() : 0;
+    if (!last) return;
+    size_t one = (size_t)FLIGHT_THUMB_W * FLIGHT_THUMB_H * 4;
+    MarkRing *m = calloc(1, sizeof *m + one * MARK_RING_N);
+    if (!m) return;
+    m->no = marks, m->n = MARK_RING_N;
+    m->first = last >= MARK_RING_N ? last - MARK_RING_N + 1 : 1;
+    for (int i = 0; i < m->n; i++) {
+        uint8_t *px = m->px + one * (size_t)i;
+        if (!vk_thumbs_read(m->first + (uint64_t)i, px)) px[3] = 0;
+        else for (size_t k = 3; k < one; k += 4) px[k] = 255;
+    }
+    char name[64];
+    snprintf(name, sizeof name, "logs/mark-%d", marks);
+    if (!gfx_shader_beside_cache(name, m->dir, sizeof m->dir)) snprintf(m->dir, sizeof m->dir, "mark-%d", marks);
+    if (!plat_thread_spawn(mark_ring_write, m, "mark ring", 0)) mark_ring_write(m);
+}
+
 void rt_frame_presented(const tex_t *t, const int crop[4], uint64_t n) {
     const RtConfig *cfg = rt_config();
+    mark_poll(n);
     series_shot(t, crop, n);
     int64_t w = cfg->seconds ? frame_step_world_us() : -1;
     if (w < 0 || (double)w < cfg->seconds * 1e6) return;
