diff --git a/runtime/gfx_present.c b/runtime/gfx_present.c
index 93ea8ce..2db8a46 100644
--- a/runtime/gfx_present.c
+++ b/runtime/gfx_present.c
@@ -637,7 +637,7 @@ static void record_thumb(VkCommandBuffer cb, VkImage dst, unsigned fence_slot) {
 }
 
 int vk_thumbs_read(uint64_t frame, uint8_t *rgba) {
-    int ok = 0;
+    int ok = 0, hdr = 0;
     plat_rmutex_lock(&g_pl);
     if (g_th_n && g_th_ptr && frame) {
         unsigned ring = (unsigned)(frame % (uint64_t)g_th_n);
@@ -646,9 +646,18 @@ int vk_thumbs_read(uint64_t frame, uint8_t *rgba) {
             vmaInvalidateAllocation(c->vma, g_th_alloc, TH_BYTES * ring, TH_BYTES);
             memcpy(rgba, g_th_ptr + TH_BYTES * ring, TH_BYTES);
             ok = g_th_fmt == VK_FORMAT_B8G8R8A8_UNORM || g_th_fmt == VK_FORMAT_B8G8R8A8_SRGB ? 2 : 1;
+            hdr = g_sc_hdr;
         }
     }
     plat_rmutex_unlock(&g_pl);
+    if (hdr)   // PQ code values in 8 bits (ensure_thumbs): widened to 10 and decoded like a capture
+        for (size_t i = 0; i < TH_BYTES; i += 4) {
+            uint32_t v = (uint32_t)rgba[i] * 1023 / 255 | ((uint32_t)rgba[i + 1] * 1023 / 255) << 10 |
+                         ((uint32_t)rgba[i + 2] * 1023 / 255) << 20;
+            uint8_t in[4];
+            memcpy(in, &v, 4);
+            vk_hdr_to_srgb8(in, rgba + i, 1, 0);
+        }
     if (ok == 2)
         for (size_t i = 0; i < TH_BYTES; i += 4) {
             uint8_t t = rgba[i];
@@ -657,6 +666,15 @@ int vk_thumbs_read(uint64_t frame, uint8_t *rgba) {
     return ok != 0;
 }
 
+uint64_t vk_thumbs_latest(void) {
+    uint64_t f = 0;
+    plat_rmutex_lock(&g_pl);
+    for (int i = 0; i < g_th_n; i++)
+        if (g_th_tag[i] > f) f = g_th_tag[i];
+    plat_rmutex_unlock(&g_pl);
+    return f;
+}
+
 void vk_present_capture(int on) {
     plat_rmutex_lock(&g_pl);
     g_capture = on;
diff --git a/runtime/input.c b/runtime/input.c
index 4454845..e93954a 100644
--- a/runtime/input.c
+++ b/runtime/input.c
@@ -818,6 +818,47 @@ static int32_t shake_stick(int held) {
     return (now - from) / SHAKE_SIDE_NS % 2 ? STICK_MAX : -STICK_MAX;
 }
 
+// Mark this moment (boot.c): NX2NAVI_MARK_CHORD, gamepad buttons by name joined with '+' (default lstick+rstick; off or
+// empty: none), held together NX2NAVI_MARK_HOLD_MS (500) fires one mark per hold. While the whole chord is held its
+// buttons are hidden from the game; a button pressed alone still reaches it. Read again when the settings change.
+static uint8_t mark_chord[PAD_COUNT];
+static int mark_chord_n;
+static unsigned mark_chord_seen = ~0u;
+static uint64_t mark_hold_ns, mark_since;
+static int mark_fired;
+static volatile int32_t mark_pending;
+
+// Under lock: pd's chord buttons cleared while the whole chord is held; a mark is pending once it was held long enough.
+static void mark_chord_check(uint8_t pd[PAD_COUNT]) {
+    unsigned ver = cfg_version();
+    if (ver != mark_chord_seen) {
+        mark_chord_seen = ver;
+        memset(mark_chord, 0, sizeof mark_chord);
+        mark_chord_n = 0;
+        const char *c = cfg_get("NX2NAVI_MARK_CHORD");
+        char buf[128];
+        snprintf(buf, sizeof buf, "%s", c ? c : "lstick+rstick");
+        for (char *save, *tok = strtok_r(buf, "+ ", &save); tok; tok = strtok_r(NULL, "+ ", &save)) {
+            int found = 0;
+            for (int p = PAD_SOUTH; p < PAD_COUNT && !found; p++)
+                if (input_pad_name(p) && !strcasecmp(input_pad_name(p), tok)) found = 1, mark_chord_n += !mark_chord[p], mark_chord[p] = 1;
+            if (!found && strcasecmp(tok, "off")) rt_log("input: NX2NAVI_MARK_CHORD: no gamepad button \"%s\"", tok);
+        }
+        const char *h = cfg_get("NX2NAVI_MARK_HOLD_MS");
+        mark_hold_ns = (uint64_t)(h && *h ? strtoul(h, NULL, 10) : 500) * 1000000ull;
+    }
+    if (!mark_chord_n) return;
+    for (int p = PAD_SOUTH; p < PAD_COUNT; p++)
+        if (mark_chord[p] && !pd[p]) { mark_since = 0, mark_fired = 0; return; }
+    uint64_t now = plat_now_ns();
+    if (!mark_since) mark_since = now;
+    if (!mark_fired && now - mark_since >= mark_hold_ns) mark_fired = 1, plat_xchg32(&mark_pending, 1);
+    for (int p = PAD_SOUTH; p < PAD_COUNT; p++)
+        if (mark_chord[p]) pd[p] = 0;
+}
+
+int input_mark_take(void) { return plat_xchg32(&mark_pending, 0); }
+
 // Under lock and inside sdl_enter (the gamepads' state is up to date), state 1: the open gamepad's inputs by position
 // (pd[PAD_*] != 0 held); 0 without a connected gamepad.
 static int pad_physical(uint8_t pd[PAD_COUNT]) {
@@ -834,6 +875,7 @@ static int pad_physical(uint8_t pd[PAD_COUNT]) {
         for (int p = PAD_SOUTH; p < PAD_COUNT && !pad_pressed_logged; p++)
             if (pd[p]) pad_pressed_logged = 1, rt_log("input: gamepad \"%s\": first press (%s)", SDL_GetGamepadName(pad), input_pad_name(p));
     }
+    mark_chord_check(pd);
     return 1;
 }
 
