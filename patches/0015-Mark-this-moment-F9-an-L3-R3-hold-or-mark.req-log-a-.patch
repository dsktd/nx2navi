@@ -179,6 +182,7 @@ void input_sdl_event(const SDL_Event *e) {
         }
         if (e->key.scancode == SDL_SCANCODE_F8) plat_xchg32(&f8_held, down);
         if (e->key.scancode == SDL_SCANCODE_INSERT) plat_xchg32(&insert_held, down);
+        if (e->key.scancode == SDL_SCANCODE_F9 && down && !e->key.repeat) plat_xchg32(&f9_mark, 1);   // mark this moment (boot.c)
