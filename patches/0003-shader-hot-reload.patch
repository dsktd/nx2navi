diff --git a/runtime/vk_pipeline.c b/runtime/vk_pipeline.c
index 37f59814..eb39907c 100644
--- a/runtime/vk_pipeline.c
+++ b/runtime/vk_pipeline.c
@@ -8045,3 +8045,130 @@ void vk_pipeline_sizes(PerfSizes *s) {
     perf_size(s, "pipeline jobs queued or running", jobs, 0, PERF_SIZE_NONE);
     perf_size(s, "pipeline keys seen", seen, 0, seen_b);
 }
+
+// ---- NX2NAVI_SHADER_RELOAD=1 (test): a rewritten <key>.spv in the shader cache replaces that shader's SPIR-V in
+// memory. Its pipelines and stage libraries leave the tables (kept, not destroyed: recorded command buffers may still use
+// them) and the next draw builds them again; vk_pipeline_epoch tells the draw memos (vk_exec_draw.c) to look again. A
+// build of the new SPIR-V that fails puts the old SPIR-V and the old entries back. One log line per reload.
+volatile uint32_t vk_pipeline_epoch;
+typedef struct { const GfxShader *s; uint32_t *old; uint64_t old_words; Pipe *pipes; Lib *libs; int frames; } Reload;
+static Reload RL[32];
+static int n_rl;
+
+static int key_has(const uint8_t *key, size_t n, const GfxShader *s) {
+    for (size_t i = 0; i + sizeof s <= n; i++)
+        if (!memcmp(key + i, &s, sizeof s)) return 1;
+    return 0;
+}
+
+// Unlinks s's entries onto *ps / *ls (NULL: dropped for good). -1 while one of them builds. Caller holds P.lock.
+static int reload_unlink(const GfxShader *s, Pipe **ps, Lib **ls) {
+    if (cs_flight_has(s)) return -1;
+    for (int i = 0; i < PIPE_BUCKETS; i++)
+        for (Pipe *p = pipes[i]; p; p = p->next)
+            if (key_has(p->key, p->key_size, s) && (p->building || p->link_queued)) return -1;
+    for (int i = 0; i < LIB_BUCKETS; i++)
+        for (Lib *b = libs[i]; b; b = b->next)
+            if (key_has(b->key, b->size, s) && b->building) return -1;
+    int n = 0;
+    for (int i = 0; i < PIPE_BUCKETS; i++)
+        for (Pipe **pp = &pipes[i]; *pp;) {
+            Pipe *p = *pp;
+            if (!key_has(p->key, p->key_size, s)) { pp = &p->next; continue; }
+            *pp = p->next, n++;
+            if (ps) p->next = *ps, *ps = p;
+        }
+    for (int i = 0; i < LIB_BUCKETS; i++)
+        for (Lib **bp = &libs[i]; *bp;) {
+            Lib *b = *bp;
+            if (!key_has(b->key, b->size, s)) { bp = &b->next; continue; }
+            *bp = b->next;
+            if (ls) b->next = *ls, *ls = b;
+        }
+    __atomic_add_fetch(&vk_pipeline_epoch, 1, __ATOMIC_RELEASE);
+    return n;
+}
+
+static void reload_relink(Reload *r) {
+    for (Pipe *p = r->pipes, *n; p; p = n) n = p->next, p->next = pipes[p->hash % PIPE_BUCKETS], pipes[p->hash % PIPE_BUCKETS] = p;
+    for (Lib *b = r->libs, *n; b; b = n) n = b->next, b->next = libs[b->hash % LIB_BUCKETS], libs[b->hash % LIB_BUCKETS] = b;
+    r->pipes = NULL, r->libs = NULL;
+}
+
+static void reload_hex(const GfxShader *s, char out[17]) { gfx_shader_name(s, out); }
+
+// Once per present: the outcome of pending reloads, then new changes.
+void vk_pipeline_reload_poll(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char *e = cfg_get("NX2NAVI_SHADER_RELOAD");
+        on = e && atoi(e) == 1 && gfx_shader_reload_start();
+    }
+    if (!on || !P.ready) return;
+    plat_mutex_lock(&P.lock);
+    for (int k = 0; k < n_rl; k++) {
+        Reload *r = &RL[k];
+        int built = 0, failed = 0, busy = 0;
+        r->frames++;
+        for (int i = 0; i < PIPE_BUCKETS; i++)
+            for (Pipe *p = pipes[i]; p; p = p->next)
+                if (key_has(p->key, p->key_size, r->s)) {
+                    if (p->building || p->link_queued) busy++;
+                    else if (p->info.pipeline || p->fast) built++;
+                    else failed++;
+                }
+        char hex[17];
+        reload_hex(r->s, hex);
+        if (failed && reload_unlink(r->s, NULL, NULL) >= 0) {
+            uint32_t *bad = (uint32_t *)gfx_shader_spirv(r->s, NULL);
+            gfx_shader_set_spirv(r->s, r->old, r->old_words);
+            free(bad);
+            reload_relink(r);
+            rt_log("vk_pipeline: reload %s failed: %d pipelines did not build, the old shader is back", hex, failed);
+        } else if (failed || busy || (!built && r->frames < 600)) {
+            continue;
+        } else {
+            rt_log("vk_pipeline: reload %s ok: %d pipelines rebuilt after %d frames", hex, built, r->frames);
+        }
+        RL[k--] = RL[--n_rl];
+    }
+    uint32_t *w;
+    uint64_t n;
+    const GfxShader *s;
+    while ((s = gfx_shader_reload_next(&w, &n))) {
+        char hex[17];
+        reload_hex(s, hex);
+        Reload *r = NULL;
+        for (int k = 0; k < n_rl; k++)
+            if (RL[k].s == s) r = &RL[k];
+        if (!r && n_rl == (int)(sizeof RL / sizeof *RL)) {
+            rt_log("vk_pipeline: reload %s failed: too many reloads pending", hex);
+            free(w);
+            continue;
+        }
+        // a build in flight: wait for it (a few frames at most) instead of racing it
+        int tries = 0, got;
+        if (!r) RL[n_rl].pipes = NULL, RL[n_rl].libs = NULL;
+        while ((got = r ? reload_unlink(s, NULL, NULL) : reload_unlink(s, &RL[n_rl].pipes, &RL[n_rl].libs)) < 0 && tries++ < 2000) {
+            plat_mutex_unlock(&P.lock);
+            plat_sleep_ms(1);
+            plat_mutex_lock(&P.lock);
+        }
+        if (got < 0) {
+            rt_log("vk_pipeline: reload %s failed: its pipelines kept building", hex);
+            free(w);
+            continue;
+        }
+        uint64_t ow;
+        uint32_t *old = (uint32_t *)gfx_shader_spirv(s, &ow);
+        if (r) {
+            free(old);   // the previous reload's SPIR-V; r keeps the original
+        } else {
+            r = &RL[n_rl++];
+            r->s = s, r->old = old, r->old_words = ow;
+        }
+        r->frames = 0;
+        gfx_shader_set_spirv(s, w, n);
+    }
+    plat_mutex_unlock(&P.lock);
+}
