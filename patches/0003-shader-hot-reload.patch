diff --git a/runtime/gfx_shader.c b/runtime/gfx_shader.c
index 7fd3bdf5..20a90ba1 100644
--- a/runtime/gfx_shader.c
+++ b/runtime/gfx_shader.c
@@ -2635,6 +2635,71 @@ int gfx_shader_write_code(const GfxShader *s, const char *path) {
     return ok;
 }
 
+// NX2NAVI_SHADER_RELOAD=1 (test): an inotify watch on the cache folder. gfx_shader_reload_next hands out a shader in
+// memory whose <key>.spv was rewritten (close after write, or a rename onto it), with the new SPIR-V read and checked
+// (malloc'd; vk_pipeline_reload_poll swaps it in). The interface (.res.json) is not read again: edits must keep it.
+#ifdef __linux__
+#include <sys/inotify.h>
+#include <unistd.h>
+static int reload_fd = -1;
+int gfx_shader_reload_start(void) {
+    paths();
+    if (!cache_dir[0] || (reload_fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC)) < 0) return 0;
+    if (inotify_add_watch(reload_fd, cache_dir, IN_CLOSE_WRITE | IN_MOVED_TO) < 0) return close(reload_fd), reload_fd = -1, 0;
+    rt_log("gfx_shader: reload: watching %s for changed .spv files", cache_dir);
+    return 1;
+}
+const GfxShader *gfx_shader_reload_next(uint32_t **spirv, uint64_t *words) {
+    static char buf[16384] __attribute__((aligned(8)));
+    static ssize_t len, at;
+    for (;;) {
+        if (at >= len) {
+            at = 0, len = reload_fd < 0 ? -1 : read(reload_fd, buf, sizeof buf);
+            if (len <= 0) return len = 0, NULL;
+        }
+        const struct inotify_event *e = (const struct inotify_event *)(buf + at);
+        at += (ssize_t)(sizeof *e + e->len);
+        uint8_t key[32];
+        int ok = e->len >= 68 && !strcmp(e->name + 64, ".spv");
+        for (int i = 0; ok && i < 32; i++) ok = sscanf(e->name + 2 * i, "%2hhx", &key[i]) == 1;
+        GfxShader *s = ok ? mem_find(key) : NULL;
+        if (!s) continue;
+        char p[PATH_CAP + 80];
+        uint64_t size = 0;
+        snprintf(p, sizeof p, "%s/%s", cache_dir, e->name);
+        uint8_t *spv = read_file(p, &size);
+        uint32_t magic = 0;
+        if (spv && size >= 20) memcpy(&magic, spv, 4);
+        if (!spv || size % 4 || magic != 0x07230203 || !spirv_complete((const uint32_t *)spv, size / 4)) {
+            rt_log("gfx_shader: reload %.16s failed: malformed SPIR-V, the old one stays", e->name);
+            free(spv);
+            continue;
+        }
+        *spirv = (uint32_t *)spv, *words = size / 4;
+        if (s->stage == GFX_STAGE_FS) vk_hdr_shader_swap(spirv, words);
+        return s;
+    }
+}
+#else
+int gfx_shader_reload_start(void) { return 0; }
+const GfxShader *gfx_shader_reload_next(uint32_t **spirv, uint64_t *words) { return (void)spirv, (void)words, NULL; }
+#endif
+// out: <cache folder>/../<name> (shot.req and logs/ beside the cache); 0 without a cache folder
+int gfx_shader_beside_cache(const char *name, char *out, size_t n) {
+    paths();
+    return cache_dir[0] && snprintf(out, n, "%s/../%s", cache_dir, name) < (int)n;
+}
+void gfx_shader_name(const GfxShader *s, char out[17]) {   // the first 16 hex digits of its cache key
+    char hex[65];
+    key_hex(s->key, hex);
+    memcpy(out, hex, 16), out[16] = 0;
+}
+// Swaps a shader's SPIR-V (the reload); the old words stay allocated, the caller keeps or frees them.
+void gfx_shader_set_spirv(const GfxShader *s, uint32_t *spirv, uint64_t words) {
+    GfxShader *m = (GfxShader *)s;
+    m->spirv = spirv, m->words = words;
+}
+
 int gfx_shader_stage(const GfxShader *s) { return s->stage; }
 
 int gfx_shader_resources(const GfxShader *s, int kind, const GfxShaderRes **res) {
