 runtime/cfg.c          |   2 +-
 runtime/gfx.h          |   5 ++
 runtime/gfx_shader.c   |  65 +++++++++++++++++++++
 runtime/vk.h           |   2 +
 runtime/vk_backend.c   |   1 +
 runtime/vk_exec_draw.c |   8 ++-
 runtime/vk_pipeline.c  | 127 +++++++++++++++++++++++++++++++++++++++++
 8 files changed, 223 insertions(+), 6 deletions(-)

