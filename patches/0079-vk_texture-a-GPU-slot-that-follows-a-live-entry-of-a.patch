From 7f437f5a5021c82170e6934f51733d81ab8ae392 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:08:35 -0500
Subject: [PATCH] vk_texture: a GPU slot that follows a live entry of another
 size or format at its address is logged (32, with the slot's descriptor) and
 counted; NX2NAVI_TEX_DESC_STRICT=1 (default 0) resolves it to its own
 descriptor's entry instead, so a storage image write is no longer clipped to
 the followed image (#172)

---
 runtime/cfg.c        |  5 +++--
 runtime/vk_texture.c | 29 ++++++++++++++++++++++++++++-
 2 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index c2b3a89..eed8ea0 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -96,6 +96,7 @@ static const char *const known[] = {
     "AO_TRACE",
     "MARK_BURST",
     "MOTION_SOCK",
+    "TEX_DESC_STRICT",
 };
 
 // The nx2navi.ini section a key cfg_set may write goes to when the file lacks it (nx2navi.ini.example's sections).
@@ -151,7 +152,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"LIB_PREBUILD", "performance"}, {"LIB_PREBUILD_THREADS", "performance"}, {"LIB_WARM", "performance"}, {"PIPE_LINK_MS", "performance"}, {"PIPE_LINK_DRAW_MS", "performance"}, {"PIPE_AHEAD", "performance"}, {"LINE_WIDTH", "performance"}, {"POOL_SHOWN_FIRST", "performance"}, {"TEX_REUSE_NAMED", "performance"}, {"TEX_OVERWRITTEN_USED", "performance"}, {"PIPE_FAST_WORKERS", "performance"}, {"GPL_FEEDBACK", "performance"}, {"FRAME_HOLD_MS", "performance"}, {"PACE_SMOOTH", "performance"}, {"OQ_BATCH", "performance"}, {"GATE_WAIT_MS", "performance"}, {"PIPE_PREBUILD", "performance"}, {"PIPE_SEED", "performance"},
     {"COMPUTE_KEEP", "performance"},
     {"PREWARM_XLATE", "performance"}, {"GPL", "performance"}, {"ASTC", "performance"}, {"MEMORY", "performance"},
-    {"TEX_ALIAS", "performance"}, {"DEPTH_INIT_INLINE", "performance"}, {"DEPTH_ALIAS_LOG", "diagnostics"}, {"TEX_DISUSE", "performance"}, {"TEX_DISUSE_EVICT", "performance"}, {"TEX_GEN_UNDO", "performance"}, {"TEX_REUSE", "performance"}, {"TEX_SPLIT_FILL", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_PROC_COMMIT_MB", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"}, {"WATER_PROJECTIVE", "performance"},
+    {"TEX_ALIAS", "performance"}, {"DEPTH_INIT_INLINE", "performance"}, {"DEPTH_ALIAS_LOG", "diagnostics"}, {"TEX_DISUSE", "performance"}, {"TEX_DISUSE_EVICT", "performance"}, {"TEX_GEN_UNDO", "performance"}, {"TEX_REUSE", "performance"}, {"TEX_SPLIT_FILL", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_DESC_STRICT", "performance"}, {"TEX_PROC_COMMIT_MB", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"}, {"WATER_PROJECTIVE", "performance"},
     {"BIND_SKIP", "performance"}, {"SHADER_CACHE_FLUSH", "performance"}, {"SHADER_CARRY", "performance"}, {"PIPELINE_CACHE_PLAY", "performance"}, {"PIPELINE_CACHE_PLAY_MB", "performance"}, {"FFX_PIPE_CACHE", "performance"}, {"SHADER_MEMO", "performance"}, {"PIPE_MEMO", "performance"}, {"TEX_MEMO", "performance"}, {"DESC_TEMPLATE", "performance"},
     {"TEX_CLOBBER", "performance"}, {"LOW_END_GPU", "performance"},
     {"PUSH_SKIP", "performance"}, {"SPLIT_DRAWS", "performance"}, {"SPLIT_IDLE", "performance"}, {"SPLIT_IN_PASS", "performance"}, {"SPLIT_US", "performance"}, {"VK_VALIDATION", "performance"},
@@ -327,7 +328,7 @@ static const CfgMeta metas[] = {
     {"PASS_TIMES", "0", "0|1", RESTART}, {"DUMP_KEY", "", NULL, RESTART},   // vk_crumbs.c, vk_dump.c
     // textures and memory
     {"ASTC", "auto", "auto|gpu|native|cpu", RESTART}, {"MEMORY", "auto", "auto|import|mirror|verify", RESTART},
-    {"TEX_ALIAS", "1", "0|1", RESTART}, {"DEPTH_INIT_INLINE", "1", "0|1", RESTART}, {"DEPTH_ALIAS_LOG", "0", "0|1", RESTART}, {"TEX_DISUSE", "1", "0|1|2", RESTART}, {"TEX_DISUSE_EVICT", "0", "0|1", RESTART}, {"TEX_GEN_UNDO", "1", "0|1", RESTART}, {"TEX_REUSE", "1", "0|1", RESTART}, {"TEX_SPLIT_FILL", "1", "0|1|2", RESTART}, {"TEX_VRAM_PRESSURE", "80", "0..100", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
+    {"TEX_ALIAS", "1", "0|1", RESTART}, {"DEPTH_INIT_INLINE", "1", "0|1", RESTART}, {"DEPTH_ALIAS_LOG", "0", "0|1", RESTART}, {"TEX_DISUSE", "1", "0|1|2", RESTART}, {"TEX_DISUSE_EVICT", "0", "0|1", RESTART}, {"TEX_GEN_UNDO", "1", "0|1", RESTART}, {"TEX_REUSE", "1", "0|1", RESTART}, {"TEX_SPLIT_FILL", "1", "0|1|2", RESTART}, {"TEX_VRAM_PRESSURE", "80", "0..100", RESTART}, {"TEX_DESC_STRICT", "0", "0|1", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
     {"TEX_CLOBBER", "0", "0|1", RESTART},
     {"LOW_END_GPU", "0", "0|1", RESTART},   // LOWEND below
     {"STG_ARENA", "1", "0|1", RESTART}, {"ASTC_GPU_DESWIZZLE", "1", "0|1", RESTART},
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 095fe36..2389c99 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -222,6 +222,14 @@ static uint32_t agen[AGEN_N];
 static uint64_t *sinfo;
 static uint32_t reg_serial;
 static uint64_t n_same_regs;   // vk_texture_register calls that changed nothing (vk_texture_same_regs)
+static int desc_strict = -1;    // NX2NAVI_TEX_DESC_STRICT
+static uint64_t n_desc_follow, n_desc_own;   // GPU slot resolutions following another size/format; of them own (#172)
+
+// Whether two keys at one address describe images of another size or format (not only another swizzle).
+static int desc_differs(const TexKey *a, const TexKey *b) {
+    return a->d.width != b->d.width || a->d.height != b->d.height || a->d.depth != b->d.depth ||
+           a->d.format != b->d.format;
+}
 
 static uint32_t agen_idx(uint64_t addr) { return (uint32_t)(addr * 0x9E3779B97F4A7C15ull >> 48); }
 
@@ -4589,11 +4597,30 @@ static Tex *slot_resolve(TexSlot *s, view_t *view, int *has_view) {
             if (same_but_swizzle(&p->key, &k) && (!cpu_slot || !s->finalized || alias_has_gpu_content(p))) { e = p; break; }
             if (!any && (!cpu_slot || alias_has_gpu_content(p)) && follow_size_ok(p, &k)) any = p;
         }
+        // A GPU slot following a live entry of another size or format (#172): a storage image bound so is written
+        // only where the two overlap (a 960x540 blur pass into a 1696x129 r11g11b10f image left the right 43% of the
+        // picture stale). Logged (32) and counted; NX2NAVI_TEX_DESC_STRICT=1 resolves the slot to its own
+        // descriptor's entry instead (taken back or made by entry_of below), so its writers and readers meet there.
+        int strict_own = 0;
+        if (!e && any && !cpu_slot && desc_differs(&any->key, &k)) {
+            if (desc_strict < 0) desc_strict = cfg_bool("NX2NAVI_TEX_DESC_STRICT");
+            if (++n_desc_follow <= 32) {
+                const nvn_texdesc *d = &s->t.d;
+                rt_log("vk: slot %d (serial %u) follows another descriptor at 0x%llx: slot target %d %ux%ux%u fmt %d "
+                       "flags 0x%x levels %u stride %u, entry %ux%ux%u fmt %d; own entry %s (%s)",
+                       (int)(s - tslots), (unsigned)(sinfo[s - tslots] >> 16), (unsigned long long)k.addr, d->target,
+                       d->width, d->height, d->depth, d->format, (unsigned)d->flags, d->levels, d->stride,
+                       any->key.d.width, any->key.d.height, any->key.d.depth, any->key.d.format,
+                       !own ? "none" : own->released ? "released" : "live",
+                       desc_strict ? "own descriptor" : "followed; NX2NAVI_TEX_DESC_STRICT=1 takes its own");
+            }
+            if (desc_strict) any = NULL, strict_own = 1, n_desc_own++;
+        }
         // A finalized CPU descriptor must not recreate its image from freed storage. The slot keeps this state even
         // after its released image was evicted; registering the descriptor again makes it current. While its own
         // entry still holds the texture (stale_kept), the slot samples that image as it is.
         if (!e && any) e = any;
-        else if (!e && !cpu_slot) e = own && own->superseded ? NULL : own;   // a superseded one: entry_of takes it back
+        else if (!e && !cpu_slot && !strict_own) e = own && own->superseded ? NULL : own;   // a superseded one: entry_of takes it back
         else if (!e && cpu_slot && s->finalized && stale_kept(own)) e = own, n_stale_kept++;
         else if (!e && cpu_slot && s->finalized) stale = 1, n_stale++, n_stale_hm += terrain_heightmap(&s->t);
     }
-- 
2.56.0

