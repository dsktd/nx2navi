From 1c44feaacbece268419587cb5cf21ed79466c675 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:53:41 -0500
Subject: [PATCH] vk_pipeline: the cache save is skipped when the driver's data
 size did not change since the last load or write; load and slow-save times
 logged, and the window-close exit logs each stage's time

The exit save of a 4.3 GB cache (copy, write, fsync) took about 23 s although the autosave had written the same data. The driver only adds to a VkPipelineCache, so an unchanged size means unchanged data.
---
 runtime/gfx_present.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/runtime/gfx_present.c b/runtime/gfx_present.c
index 2db8a46e..d8072f8b 100644
--- a/runtime/gfx_present.c
+++ b/runtime/gfx_present.c
@@ -82,15 +82,24 @@ void gfx_window_focus_changed(int in) {
 void gfx_window_closed(void) {
     int restart = plat_cas32(&g_restart, 0, 0) != 0;
     rt_log("gfx: window closed; %s", restart ? "restarting" : "exiting");
+    uint64_t t[5];
+    t[0] = plat_now_ms();
     cfg_save();   // a menu change saves 400 ms later on the render thread (option_rows.cpp); closing sooner kept the old file
+    t[1] = plat_now_ms();
     // The window closed while the boot still built its pipelines: not the driver crash the marker is there to catch.
     // Left in place, the next start took it for one and every later start skipped the prebuild (vk_pipeline.c pm_skipped).
     vk_pipeline_prewarm_marker_clear();
     vk_pipeline_save_exit();
+    t[2] = plat_now_ms();
     prof_write();   // plat_exit runs no atexit handlers
     rtss_limit_restore();   // RivaTuner Statistics Server's profile as it was
     coop_shutdown();   // leaves the room, before the process ends
+    t[3] = plat_now_ms();
     fs_save_flush();   // last: the game's threads still run until plat_exit, and a Commit after this one is refused
+    t[4] = plat_now_ms();
+    rt_log("gfx: exit took %llu ms: settings %llu, pipeline cache %llu, profile %llu, game saves %llu",
+           (unsigned long long)(t[4] - t[0]), (unsigned long long)(t[1] - t[0]), (unsigned long long)(t[2] - t[1]),
+           (unsigned long long)(t[3] - t[2]), (unsigned long long)(t[4] - t[3]));
     if (restart) {
         cfg_setenv("NX2NAVI_REEXEC", NULL);   // the new process counts its own address-space retries (memory.c)
         if (!plat_restart()) rt_log("gfx: the restart could not start the game again");
