index 9397e09..d770fdb 100644
--- a/runtime/audio_mixer.c
+++ b/runtime/audio_mixer.c
@@ -31,6 +31,7 @@
 #include "audio_reverb.h"
 #include "audren.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"   // gfx_counters.frames for the voice start lines
 #include "ipc.h"
 
@@ -820,8 +821,14 @@ static void voice_start_note(AudioRenderer *r, int i, const ServerVoice *v) {
            (unsigned long long)r->elapsed_frames);
 }
 
+static void mixer_render(AudioRenderer *r);
 void audio_mixer_render(AudioRenderer *r, double seconds) {
     (void)seconds;
+    RT_ZONE(za, "audio mix");
+    mixer_render(r);
+    RT_ZONE_END(za);
+}
+static void mixer_render(AudioRenderer *r) {
     Mixer *m = r->mixer; if (!m) return;
     const int frames = m->frame, mc = r->param.submix_count + 1;
     memset(m->buf, 0, (size_t)m->nbuf * (size_t)frames * sizeof(float));
diff --git a/runtime/nvn_api_core.c b/runtime/nvn_api_core.c
index 3cf36d7..7855d15 100644
--- a/runtime/nvn_api_core.c
+++ b/runtime/nvn_api_core.c
@@ -12,6 +12,7 @@
 #include "cfg.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_pool_index.h"
 #include "platform/platform.h"
@@ -658,7 +659,10 @@ NVN_API(nvnQueueSubmitCommands) {
     q->submits++;
     // Prepared and replayed in the order the GPU would run it: a part waiting for an event that a later submission
     // signals is held back until that one is issued (nvn_api_cmd.c, "event waits"); f is 0 when all of it is held.
+    RT_ZONE(zs, "nvn submit");
+    RT_ZONE_VALUE(zs, n);
     uint64_t f = nvn_submit_ordered(q, h, n);
+    RT_ZONE_END(zs);
     __atomic_store_n(&lod_fence[no % LOD_RING], f, __ATOMIC_RELAXED);
     __atomic_store_n(&lod_issued, no, __ATOMIC_SEQ_CST);
     // The first submission of a frame (since the last present) returns once the GPU has run it. NVN starts the GPU when
@@ -677,7 +681,11 @@ NVN_API(nvnQueueSubmitCommands) {
         if (e && *e && finish_mask == 1 && !(e[0] == '0' && (e[1] == 'x' || e[1] == 'X'))) finish_mask = -1;   // "1": all
     }
     int idx = nvn_submits_in_frame++;
-    if (finish_mask && f && (finish_mask == -1 || (idx < 63 && (finish_mask >> idx & 1)))) gfx_backend()->fence_wait(f, UINT64_MAX);
+    if (finish_mask && f && (finish_mask == -1 || (idx < 63 && (finish_mask >> idx & 1)))) {
+        RT_ZONE(zw, "submit finish wait");
+        gfx_backend()->fence_wait(f, UINT64_MAX);
+        RT_ZONE_END(zw);
+    }
 }
 
 // The producer (1.2.1 main f_70008c6460) releases the read lock on obj+0x538 at lr 0x70008c70c8; when
diff --git a/runtime/perf.c b/runtime/perf.c
index 9f89be7..979dd26 100644
--- a/runtime/perf.c
+++ b/runtime/perf.c
@@ -9,6 +9,7 @@
 #include "flight.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "perfmon.h"
 #include "prof.h"
 #include "platform/platform.h"
@@ -264,6 +265,8 @@ void perf_present(uint64_t frame) {
     if (rt_trace & RT_TRACE_SCHED) kern_sched_report(frame);
     uint64_t now = kern_now_ns(), d = last ? now - last : 0;
     prof_sampler_frame(frame, now, last ? d : 0);
+    RT_FRAME_MARK();
+    RT_TRACY_FRAME();
     if ((rt_trace & RT_TRACE_COUNTERS) && frame % 60 == 1) rt_log("counters: present %llu t=%.3f", (unsigned long long)frame, now / 1e9);   // t: CLOCK_MONOTONIC s, for tools/counter-sample
     uint64_t rep = ft_frame(frame, now, d);   // d is 0 on the first present: it only starts the period
     ab_b += rt_ab();
diff --git a/runtime/platform/linux.c b/runtime/platform/linux.c
index 4f64b30..a63f49d 100644
--- a/runtime/platform/linux.c
+++ b/runtime/platform/linux.c
@@ -948,11 +948,7 @@ static void fault_handler(int sig, siginfo_t *si, void *uc) {
     signal(sig, SIG_DFL);   // returns into the faulting instruction, which faults again with the default action
 }
 
-static void fault_install(void) {
-    static int done;
-    if (done) return;
-    done = 1;
-    alt_stack();
+static void fault_sigactions(void) {
     struct sigaction sa = {.sa_sigaction = fault_handler, .sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER};
     sigemptyset(&sa.sa_mask);
     sigaction(SIGSEGV, &sa, NULL);
@@ -961,6 +957,20 @@ static void fault_install(void) {
     sigaction(SIGFPE, &sa, NULL);
 }
 
+static void fault_install(void) {
+    static int done;
+    if (done) return;
+    done = 1;
+    alt_stack();
+    fault_sigactions();
+}
+
+// The Tracy client installs its own crash handlers when a profiler connects and aborts on the guest's write-watch
+// faults; rt_tracy.h puts ours back (a no-op before the hook exists).
+void plat_fault_reinstall(void) {
+    if (fault_hook) fault_sigactions();
+}
+
 void plat_mem_fault_hook(int (*fn)(uint64_t addr)) {
     fault_hook = fn;
     fault_install();
diff --git a/runtime/rt_tracy.h b/runtime/rt_tracy.h
new file mode 100644
index 0000000..03f1763
--- /dev/null
+++ b/runtime/rt_tracy.h
@@ -0,0 +1,34 @@
+// Tracy profiler zones, opt-in at build time (build-linux.py --tracy: -DTRACY_ENABLE and libTracyClient from nixpkgs
+// tracy). Without TRACY_ENABLE every macro here compiles to nothing. Zones mark the places perf.c already times:
+// the present (frame mark), the NVN submit replay, the shadow sync and write-back compare, pipeline binds, texture
+// uploads, the released-texture sweep and the audio mixer frame. Capture: tracy-capture -o out.tracy (port 8086).
+#pragma once
+#ifdef TRACY_ENABLE
+#include <tracy/TracyC.h>
+#define RT_ZONE(ctx, name) TracyCZoneN(ctx, name, 1)
+#define RT_ZONE_END(ctx) TracyCZoneEnd(ctx)
+#define RT_ZONE_VALUE(ctx, v) TracyCZoneValue(ctx, (uint64_t)(v))
+#define RT_ZONE_TEXT(ctx, s) TracyCZoneText(ctx, s, strlen(s))
+#define RT_FRAME_MARK() TracyCFrameMark
+#define RT_PLOT(name, v) TracyCPlot(name, (double)(v))
+void plat_fault_reinstall(void);   // platform/linux.c
+// Once per present: Tracy installs its own SIGSEGV/SIGBUS/SIGILL/SIGFPE handlers when a profiler connects (the
+// prebuilt client has no TRACY_NO_CRASH_HANDLER) and aborts on the first write-watch fault; for the 300 presents after
+// a connection the runtime's handlers go back in (the install happens shortly after IsConnected flips).
+static inline void rt_tracy_frame(void) {
+    static int was, left;
+    int now = TracyCIsConnected;
+    if (now && !was) left = 300;
+    was = now;
+    if (left) left--, plat_fault_reinstall();
+}
+#define RT_TRACY_FRAME() rt_tracy_frame()
+#else
+#define RT_TRACY_FRAME() ((void)0)
+#define RT_ZONE(ctx, name) ((void)0)
+#define RT_ZONE_END(ctx) ((void)0)
+#define RT_ZONE_VALUE(ctx, v) ((void)0)
+#define RT_ZONE_TEXT(ctx, s) ((void)0)
+#define RT_FRAME_MARK() ((void)0)
+#define RT_PLOT(name, v) ((void)0)
+#endif
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 3c7a493..3ff4818 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -20,6 +20,7 @@
 
 #include "cfg.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_hmap.h"
 #include "vk.h"
@@ -2653,7 +2654,9 @@ static void bind_resources(VkExec *ex, const VkPipeInfo *info) {
 static void bind_pipeline(VkExec *ex, VkPipelineBindPoint bp, VkPipeline p) {
     int k = bp == VK_PIPELINE_BIND_POINT_COMPUTE;
     if (B.pipe[k] == p) return;
+    RT_ZONE(zb, "bind pipeline");
     vkCmdBindPipeline(ex->cb, bp, p);
+    RT_ZONE_END(zb);
     ex->recorded++;
     B.pipe[k] = p;
     if (!k) B.st_valid = 0;
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 84e323d..1c72929 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -15,6 +15,7 @@
 #include "cfg.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_pool_index.h"
 #include "vk.h"
@@ -1070,6 +1071,8 @@ static int cstracked;
 
 void vk_mem_shadow_sync(void) {
     if (!shadow_on) return;
+    RT_ZONE(zs, "shadow sync");
+    RT_ZONE_VALUE(zs, nstouch);
     uint64_t t0 = qpc();
     plat_mutex_lock(&shadow_lock);
     if (nstouch) {
@@ -1098,6 +1101,7 @@ void vk_mem_shadow_sync(void) {
     for (int i = 0; i < nspend; i++) spend[i].sub = 1;   // the part goes to the GPU now
     s_ticks += qpc() - t0;
     plat_mutex_unlock(&shadow_lock);
+    RT_ZONE_END(zs);
 }
 
 void vk_mem_gpu_pending(uint64_t addr, uint64_t size) {
@@ -1176,9 +1180,18 @@ void vk_gpu_written(uint64_t addr, uint64_t size) {
         const pidx_ent *e = pidx_find(&pool_index, addr, size);
         PoolRec *r = e ? e->buf : NULL;
         int wb = r && r->smap && addr >= r->import_lo && addr + size <= r->import_hi;
-        if (wb) shadow_diff(r, addr, addr + size);
+        if (wb) {
+            RT_ZONE(zd, "write-back compare");
+            RT_ZONE_VALUE(zd, size);
+            shadow_diff(r, addr, addr + size);
+            RT_ZONE_END(zd);
+        }
         plat_mutex_lock(&shadow_lock);
-        if (wb) shadow_write_back(r, addr, addr + size);
+        if (wb) {
+            RT_ZONE(zw, "write-back");
+            shadow_write_back(r, addr, addr + size);
+            RT_ZONE_END(zw);
+        }
         int k = -1;   // the submitted entry, not a newer part's equal one
         for (int i = 0; i < nspend && (k < 0 || !spend[k].sub); i++)
             if (spend[i].lo == addr && spend[i].hi == addr + size) k = i;
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 81dd830..10e1ae7 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -18,6 +18,7 @@
 #include "cfg.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_hmap.h"
 #include "nvn_tex.h"
@@ -667,7 +668,14 @@ static void destroy_tex(Tex *e) {
 // Dropping all of them at once when the count passed 4096 destroyed thousands of images in one frame: 333-422 ms
 // frames every 40-50 s on a GTX 1050 Ti, then the textures still in use were created and uploaded again.
 #define RELEASED_MAX 2048
+static void sweep_released_body(void);
 static void sweep_released(void) {
+    RT_ZONE(zr, "released sweep");
+    RT_ZONE_VALUE(zr, nreleased);
+    sweep_released_body();
+    RT_ZONE_END(zr);
+}
+static void sweep_released_body(void) {
     if (rel_cap < 0) {
         const char *s = cfg_get("NX2NAVI_TEX_RELEASED_MIB");
         rel_cap = s && *s ? (int64_t)atoll(s) * 1048576 : 0;
@@ -784,7 +792,15 @@ static void astc_check(const Tex *e, const uint8_t *raw, const VkAstcRegion *ar,
 #define UPLOAD_PART (32ull << 20)   // fits the staging pool (vk_staging takes up to half of its 64 MiB block)
 
 // Copies the whole storage into the image (every level and layer the image has).
+static void upload_body(Tex *e);
 static void upload(Tex *e) {
+    RT_ZONE(zu, "texture upload");
+    RT_ZONE_VALUE(zu, e->t.L.size);
+    if (e->uploaded) RT_ZONE_TEXT(zu, "re-upload");
+    upload_body(e);
+    RT_ZONE_END(zu);
+}
+static void upload_body(Tex *e) {
     static volatile int32_t n_bad, n_undecoded, n_split;
     const tex_t *t = &e->t;
     const nvn_texdesc *d = &t->d;
