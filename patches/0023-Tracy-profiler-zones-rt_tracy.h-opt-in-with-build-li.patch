From c47d8b8e8f5268ff01c0955145bc3e317169a34f Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 13:45:52 -0500
Subject: [PATCH] Tracy profiler zones: rt_tracy.h, opt-in with build-linux.py
 --tracy (#137)

Zones where perf.c already times: the present (frame mark), nvn submit and its finish wait, shadow sync, write-back
compare and write-back, pipeline binds, texture uploads, the released-texture sweep, the audio mixer frame. Every
macro compiles to nothing without TRACY_ENABLE. The prebuilt client installs crash handlers when a profiler connects;
plat_fault_reinstall puts the runtime's back for 300 presents after each connection.
---
 runtime/audio_mixer.c    |  7 +++++++
 runtime/nvn_api_core.c   |  6 ++++++
 runtime/perf.c           |  3 +++
 runtime/platform/linux.c | 20 +++++++++++++++-----
 runtime/rt_tracy.h       | 34 ++++++++++++++++++++++++++++++++++
 runtime/vk_exec_draw.c   |  3 +++
 runtime/vk_memory.c      |  7 +++++++
 runtime/vk_texture.c     | 16 ++++++++++++++++
 8 files changed, 91 insertions(+), 5 deletions(-)
 create mode 100644 runtime/rt_tracy.h

diff --git a/runtime/audio_mixer.c b/runtime/audio_mixer.c
index bb0c266..818b0a4 100644
--- a/runtime/audio_mixer.c
+++ b/runtime/audio_mixer.c
@@ -31,6 +31,7 @@
 #include "audio_reverb.h"
 #include "audren.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"   // gfx_counters.frames for the voice start lines
 #include "ipc.h"
 
@@ -1051,8 +1052,14 @@ static void voice_start_note(AudioRenderer *r, int i, const ServerVoice *v) {
            (unsigned long long)r->elapsed_frames);
 }
 
+static void mixer_render(AudioRenderer *r);
 void audio_mixer_render(AudioRenderer *r, double seconds) {
     (void)seconds;
+    RT_ZONE(za, "audio mix");
+    mixer_render(r);
+    RT_ZONE_END(za);
+}
+static void mixer_render(AudioRenderer *r) {
     Mixer *m = r->mixer; if (!m) return;
     const int frames = m->frame, mc = r->param.submix_count + 1;
     memset(m->buf, 0, (size_t)m->nbuf * (size_t)frames * sizeof(float));
diff --git a/runtime/nvn_api_core.c b/runtime/nvn_api_core.c
index e62c4cf..c2d63e0 100644
--- a/runtime/nvn_api_core.c
+++ b/runtime/nvn_api_core.c
@@ -13,6 +13,7 @@
 #include "gfx.h"
 #include "motion_owner.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_pool_index.h"
 #include "platform/platform.h"
@@ -719,6 +720,8 @@ NVN_API(nvnQueueSubmitCommands) {
     uint64_t no = __atomic_add_fetch(&lod_entered, 1, __ATOMIC_SEQ_CST);
     q->submits++;
     uint64_t f;
+    RT_ZONE(zs, "nvn submit");
+    RT_ZONE_VALUE(zs, n);
     if (gfx_replay_async()) {
         // Prepare and queue under one lock: submit numbers follow queue order (gfx_replayed_submits).
         static PlatMutex submit_lock = PLAT_MUTEX_INIT;
@@ -737,6 +740,7 @@ NVN_API(nvnQueueSubmitCommands) {
         f = gfx_backend()->submit(h, n);
         gfx_submit_queue = 0;
     }
+    RT_ZONE_END(zs);
     uint64_t prev = __atomic_load_n(&last_fence, __ATOMIC_RELAXED);
     while (f > prev && !__atomic_compare_exchange_n(&last_fence, &prev, f, 1, __ATOMIC_RELEASE, __ATOMIC_RELAXED)) {}
     __atomic_store_n(&lod_fence[no % LOD_RING], f, __ATOMIC_RELAXED);
@@ -768,7 +772,9 @@ NVN_API(nvnQueueSubmitCommands) {
     int idx = __atomic_fetch_add(&nvn_submits_in_frame, 1, __ATOMIC_RELAXED);
     if (finish_mask && f && (finish_mask == -1 || (idx < 63 && (finish_mask >> idx & 1)))) {
         gfx_tl_note('W', 0, f, 0);
+        RT_ZONE(zw, "submit finish wait");
         gfx_backend()->exec_wait(f, UINT64_MAX);
+        RT_ZONE_END(zw);
         gfx_tl_note('w', 0, 0, 0);
     }
     nvn_call_note(0, (uintptr_t)q, 0);
diff --git a/runtime/perf.c b/runtime/perf.c
index 459e29c..fb0d0c8 100644
--- a/runtime/perf.c
+++ b/runtime/perf.c
@@ -10,6 +10,7 @@
 #include "gfx.h"
 #include "host.h"
 #include "nvn_api.h"
+#include "rt_tracy.h"
 #include "perfmon.h"
 #include "prof.h"
 #include "platform/platform.h"
@@ -813,6 +814,8 @@ void perf_present(uint64_t frame) {
     if (rt_trace & RT_TRACE_SCHED) kern_sched_report(frame);
     uint64_t now = kern_now_ns(), d = last ? now - last : 0;
     prof_sampler_frame(frame, now, last ? d : 0);
+    RT_FRAME_MARK();
+    RT_TRACY_FRAME();
     if ((rt_trace & RT_TRACE_COUNTERS) && frame % 60 == 1) rt_log("counters: present %llu t=%.3f", (unsigned long long)frame, now / 1e9);   // t: CLOCK_MONOTONIC s, for tools/counter-sample
     uint64_t rep = ft_frame(frame, now, d);   // d is 0 on the first present: it only starts the period
     ab_b += rt_ab();
diff --git a/runtime/platform/linux.c b/runtime/platform/linux.c
index 8ffa3b4..38760f2 100644
--- a/runtime/platform/linux.c
+++ b/runtime/platform/linux.c
@@ -1269,11 +1269,7 @@ static void fault_handler(int sig, siginfo_t *si, void *uc) {
     signal(sig, SIG_DFL);   // returns into the faulting instruction, which faults again with the default action
 }
 
-static void fault_install(void) {
-    static int done;
-    if (done) return;
-    done = 1;
-    alt_stack();
+static void fault_sigactions(void) {
     struct sigaction sa = {.sa_sigaction = fault_handler, .sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER};
     sigemptyset(&sa.sa_mask);
     sigaction(SIGSEGV, &sa, NULL);
@@ -1282,6 +1278,20 @@ static void fault_install(void) {
     sigaction(SIGFPE, &sa, NULL);
 }
 
+static void fault_install(void) {
+    static int done;
+    if (done) return;
+    done = 1;
+    alt_stack();
+    fault_sigactions();
+}
+
+// The Tracy client installs its own crash handlers when a profiler connects and aborts on the guest's write-watch
+// faults; rt_tracy.h puts ours back (a no-op before the hook exists).
+void plat_fault_reinstall(void) {
+    if (fault_hook) fault_sigactions();
+}
+
 void plat_mem_fault_hook(int (*fn)(uint64_t addr)) {
     fault_hook = fn;
     fault_install();
diff --git a/runtime/rt_tracy.h b/runtime/rt_tracy.h
new file mode 100644
index 0000000..03f1763
--- /dev/null
+++ b/runtime/rt_tracy.h
@@ -0,0 +1,34 @@
+// Tracy profiler zones, opt-in at build time (build-linux.py --tracy: -DTRACY_ENABLE and libTracyClient from nixpkgs
+// tracy). Without TRACY_ENABLE every macro here compiles to nothing. Zones mark the places perf.c already times:
+// the present (frame mark), the NVN submit replay, the shadow sync and write-back compare, pipeline binds, texture
+// uploads, the released-texture sweep and the audio mixer frame. Capture: tracy-capture -o out.tracy (port 8086).
+#pragma once
+#ifdef TRACY_ENABLE
+#include <tracy/TracyC.h>
+#define RT_ZONE(ctx, name) TracyCZoneN(ctx, name, 1)
+#define RT_ZONE_END(ctx) TracyCZoneEnd(ctx)
+#define RT_ZONE_VALUE(ctx, v) TracyCZoneValue(ctx, (uint64_t)(v))
+#define RT_ZONE_TEXT(ctx, s) TracyCZoneText(ctx, s, strlen(s))
+#define RT_FRAME_MARK() TracyCFrameMark
+#define RT_PLOT(name, v) TracyCPlot(name, (double)(v))
+void plat_fault_reinstall(void);   // platform/linux.c
+// Once per present: Tracy installs its own SIGSEGV/SIGBUS/SIGILL/SIGFPE handlers when a profiler connects (the
+// prebuilt client has no TRACY_NO_CRASH_HANDLER) and aborts on the first write-watch fault; for the 300 presents after
+// a connection the runtime's handlers go back in (the install happens shortly after IsConnected flips).
+static inline void rt_tracy_frame(void) {
+    static int was, left;
+    int now = TracyCIsConnected;
+    if (now && !was) left = 300;
+    was = now;
+    if (left) left--, plat_fault_reinstall();
+}
+#define RT_TRACY_FRAME() rt_tracy_frame()
+#else
+#define RT_TRACY_FRAME() ((void)0)
+#define RT_ZONE(ctx, name) ((void)0)
+#define RT_ZONE_END(ctx) ((void)0)
+#define RT_ZONE_VALUE(ctx, v) ((void)0)
+#define RT_ZONE_TEXT(ctx, s) ((void)0)
+#define RT_FRAME_MARK() ((void)0)
+#define RT_PLOT(name, v) ((void)0)
+#endif
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 220c6ff..1670209 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -21,6 +21,7 @@
 #include "cfg.h"
 #include "flight.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_hmap.h"
 #include "vk.h"
@@ -3903,7 +3904,9 @@ static void bind_pipeline(VkExec *ex, VkPipelineBindPoint bp, VkPipeline p) {
     DrawCtx *const cx = ex->dc;
     int k = bp == VK_PIPELINE_BIND_POINT_COMPUTE;
     if (cx->B.pipe[k] == p) return;
+    RT_ZONE(zb, "bind pipeline");
     vkCmdBindPipeline(ex->cb, bp, p);
+    RT_ZONE_END(zb);
     ex->recorded++;
     cx->B.pipe[k] = p;
     if (!k) cx->B.st_valid = 0;
diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 1d23714..116a3ab 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -15,6 +15,7 @@
 #include "cfg.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_pool_index.h"
 #include "vk.h"
@@ -1759,6 +1760,8 @@ static uint64_t shadow_write_back(uint64_t addr, uint64_t size) {
     plat_mutex_lock(&shadow_lock);
     if (r && r->smap && addr >= r->import_lo && addr + size <= r->import_hi) {
         if (w_hi && addr < w_hi && addr + size > w_lo) vk_watch("wb-fence", addr, size, 0, r->smap + (w_lo - r->import_lo));
+        RT_ZONE(zw, "write-back");
+        RT_ZONE_VALUE(zw, size);
         uint64_t t0 = qpc();
         mem_thaw(addr, size);
         if (bulk) plat_mem_prepare_write(addr, size);
@@ -1775,6 +1778,7 @@ static uint64_t shadow_write_back(uint64_t addr, uint64_t size) {
             a = pe;
         }
         s_wb_bytes += moved, s_wb_seen += size, s_wb_ticks += qpc() - t0;
+        RT_ZONE_END(zw);
     }
     plat_mutex_unlock(&shadow_lock);
     plat_mutex_unlock_shared(&pool_lock);
@@ -2685,6 +2689,8 @@ static int shadow_pool_clean(const PoolRec *r, uint32_t epoch, int cpu) {
 
 void vk_mem_shadow_sync(uint64_t fence) {
     if (!shadow_on) return;
+    RT_ZONE(zs, "shadow sync");
+    RT_ZONE_VALUE(zs, nstouch);
     uint64_t t0 = qpc();
     uint32_t epoch = vk_texture_epoch();
     int cpu = vk_mirror_on && wb_no_reup();   // before the locks: its first call logs
@@ -2729,6 +2735,7 @@ void vk_mem_shadow_sync(uint64_t fence) {
     }
     s_ticks += qpc() - t0;
     plat_mutex_unlock(&shadow_lock);
+    RT_ZONE_END(zs);
 }
 
 // The replay workers (vk_exec.c) bind and write from several threads at once: while a chunk records, a mirror's first
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 0005213..3f9af1b 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -20,6 +20,7 @@
 #include "flight.h"
 #include "gfx.h"
 #include "host.h"
+#include "rt_tracy.h"
 #include "nvn_api.h"
 #include "nvn_hmap.h"
 #include "nvn_tex.h"
@@ -2265,7 +2266,14 @@ static int released_max(void) {
     return max;
 }
 
+static void sweep_released_body(void);
 static void sweep_released(void) {
+    RT_ZONE(zr, "released sweep");
+    RT_ZONE_VALUE(zr, nreleased);
+    sweep_released_body();
+    RT_ZONE_END(zr);
+}
+static void sweep_released_body(void) {
     int lim = released_max();
     if (nreleased <= lim) return;
     {
@@ -3454,7 +3462,15 @@ static int chash_wanted(const Tex *e) {
     return RT_KNOB_ON(mode) && e->t.L.size <= CHASH_BIG_MAX && e->chash_miss < CHASH_MISSES && !vk_exec_pool_loading();
 }
 
+static void upload_body(Tex *e);
 static void upload(Tex *e) {
+    RT_ZONE(zu, "texture upload");
+    RT_ZONE_VALUE(zu, e->t.L.size);
+    if (e->uploaded) RT_ZONE_TEXT(zu, "re-upload");
+    upload_body(e);
+    RT_ZONE_END(zu);
+}
+static void upload_body(Tex *e) {
     static volatile int32_t n_bad, n_undecoded, n_split;
     int no_mem = 0;   // a part's ASTC decode had no memory: the texture is uploaded again later
     const tex_t *t = &e->t;
