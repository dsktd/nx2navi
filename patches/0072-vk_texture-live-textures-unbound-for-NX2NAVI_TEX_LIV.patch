From 144aae72aec17b829e84f24a959ed700b0cbc277 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:46:08 -0500
Subject: [PATCH] vk_texture: live textures unbound for NX2NAVI_TEX_LIVE_IDLE
 submits (default 3600) are dropped above NX2NAVI_TEX_LIVE_EVICT percent of
 the VRAM budget (default 85; 0 = off), only mirrored ones the GPU never
 wrote, so they come back from their storage; counted per 1800 frames with a
 detection count of drops used within NX2NAVI_TEX_LIVE_GUARD submits (#160)

---
 runtime/cfg.c        |  6 ++---
 runtime/vk_texture.c | 60 ++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 0e363d4..624f9c0 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -58,7 +58,7 @@ static const char *const known[] = {
     "SHADER_MEMO", "SHADER_RELOAD", "SHADOW_COMPARE", "SHADOW_RANGE", "SHADOW_RES", "SHADOW_SCALE", "SHARED_FONTS", "SHARPNESS", "SHOTS", "SHOTS_DIR",
     "SHOTS_FULL", "SPEED_PROBE", "SPIN", "SPIN_HANDOFF_US", "SPLIT_DRAWS", "SPLIT_US", "STICK_DEADZONE", "STICK_SENS",
     "SWKBD_ANSWER",
-    "SWKBD_TEST", "TAA", "TEST_PAD", "TEST_PAD_AT", "TEST_PREPARE_SHADERS", "TEX_ALIAS", "TEX_MEMO", "TEX_STALE_GONE", "TEX_VRAM_PRESSURE", "TIMER_1MS", "TRACE", "TXD_TRANSPOSE", "UBO_SNAPSHOT", "UNJITTER", "UPSCALER", "VK_DYN_A2C", "VK_DYN_VERTEX", "VK_NOOPT", "VK_NO_FLOAT64",
+    "SWKBD_TEST", "TAA", "TEST_PAD", "TEST_PAD_AT", "TEST_PREPARE_SHADERS", "TEX_ALIAS", "TEX_MEMO", "TEX_LIVE_EVICT", "TEX_LIVE_GUARD", "TEX_LIVE_IDLE", "TEX_STALE_GONE", "TEX_VRAM_PRESSURE", "TIMER_1MS", "TRACE", "TXD_TRANSPOSE", "UBO_SNAPSHOT", "UNJITTER", "UPSCALER", "VK_DYN_A2C", "VK_DYN_VERTEX", "VK_NOOPT", "VK_NO_FLOAT64",
     "VK_PRESENT", "VK_RECORDER", "VK_SSBO_ALIGN", "VK_SUBGROUP", "VK_SUBGROUP_PIN", "VK_VALIDATION", "VOLUME", "VRAM_HEADROOM", "VS_OUTS",
     "WALK_KEY", "WALK_SCALE", "WB_EXACT", "WB_FENCE_LIMIT", "WB_MERGE", "WINDOW_SIZE", "XLATE", "XLATE_ID", "XLATE_KEEP", "XLATE_PROCS",
     "ZSTD_CHECK", "ZSTD_NATIVE",
@@ -97,7 +97,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"},
     {"LIB_PREBUILD", "performance"}, {"LIB_PREBUILD_THREADS", "performance"}, {"PIPE_PREBUILD", "performance"},
     {"PREWARM_XLATE", "performance"}, {"GPL", "performance"}, {"ASTC", "performance"}, {"MEMORY", "performance"},
-    {"TEX_ALIAS", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_STALE_GONE", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"},
+    {"TEX_ALIAS", "performance"}, {"TEX_VRAM_PRESSURE", "performance"}, {"TEX_STALE_GONE", "performance"}, {"TEX_LIVE_EVICT", "performance"}, {"TEX_LIVE_IDLE", "performance"}, {"TEX_LIVE_GUARD", "performance"}, {"ASTC_BC", "performance"}, {"LOD_GUARD", "performance"}, {"FIX_C0", "performance"}, {"FIX_ZERO", "performance"},
     {"BIND_SKIP", "performance"}, {"SHADER_MEMO", "performance"}, {"PIPE_MEMO", "performance"}, {"TEX_MEMO", "performance"}, {"DESC_TEMPLATE", "performance"},
     {"PUSH_SKIP", "performance"}, {"SPLIT_DRAWS", "performance"}, {"SPLIT_US", "performance"}, {"VK_VALIDATION", "performance"},
     {"VK_DYN_VERTEX", "performance"}, {"VK_DYN_A2C", "performance"}, {"VK_SUBGROUP_PIN", "performance"},
@@ -173,7 +173,7 @@ static const CfgMeta metas[] = {
     {"PIPE_PREBUILD", "1", "0|1", RESTART}, {"PREWARM_XLATE", "", "1..64", RESTART}, {"GPL", "1", "0|1", RESTART},
     // textures and memory
     {"ASTC", "auto", "auto|gpu|native|cpu", RESTART}, {"MEMORY", "auto", "auto|import|mirror|verify", RESTART},
-    {"TEX_ALIAS", "1", "0|1", RESTART}, {"TEX_VRAM_PRESSURE", "90", "0..100", RESTART}, {"TEX_STALE_GONE", "0", "0|1", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
+    {"TEX_ALIAS", "1", "0|1", RESTART}, {"TEX_VRAM_PRESSURE", "90", "0..100", RESTART}, {"TEX_STALE_GONE", "0", "0|1", RESTART}, {"TEX_LIVE_EVICT", "85", "0..100", RESTART}, {"TEX_LIVE_IDLE", "3600", "1..1000000", RESTART}, {"TEX_LIVE_GUARD", "240", "0..1000000", RESTART}, {"ASTC_BC", "", "0|1", RESTART}, {"ZSTD_NATIVE", "1", "0|1", RESTART}, {"ZSTD_CHECK", "0", "0|1", RESTART},
     // render fixes
     {"LOD_GUARD", "1", "0|1", RESTART}, {"FIX_C0", "1", "0|1", RESTART}, {"FIX_ZERO", "1", "0|1", RESTART},
     {"BIND_SKIP", "1", "0|1", RESTART}, {"SHADER_MEMO", "1", "0|1", RESTART}, {"PIPE_MEMO", "1", "0|1", RESTART}, {"TEX_MEMO", "1", "0|1", RESTART},
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 8f180a3..7b4031c 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -1083,6 +1083,42 @@ static void sweep_rt_trim(uint64_t used, uint64_t budget) {   // tex_lock held;
     if (trim_ep_n >= 1024) trim_log(used, budget);   // a long run still shows up while it lasts
 }
 
+// NX2NAVI_TEX_LIVE_EVICT (percent of the driver's device-local budget, default 85; 0 = off): above it, live entries
+// the game still holds but has not bound for NX2NAVI_TEX_LIVE_IDLE submits (default 3600) go, at most PRESSURE_STEP per
+// query, oldest use first in each pass, until the heap is back under it. Only entries that come back intact are taken,
+// as for the pressure drop: mirrored, never written by the GPU, sharing no image, so the next binding makes and uploads
+// them again from their storage. Live sampled textures grew from 3.5 to 11.4 GiB in 45 minutes (ASTC 5x5 alone 0.7 to
+// 3.2 GiB, #160) while the released list was already empty, so the render-target trim above 95% destroyed released
+// render targets the game took back. NX2NAVI_TEX_LIVE_GUARD (submits, default 240): a drop of an entry used that
+// recently is counted as a detection; the idle rule makes it 0 unless the use bookkeeping misses bindings.
+static int live_evict = -1, live_idle, live_guard;
+static uint64_t le_n, le_bytes, le_guard_n, le_tot_n, le_tot_bytes;
+
+static uint32_t tex_used_at(const Tex *e) { return e->checked > e->last_use ? e->checked : e->last_use; }
+
+static void sweep_live(uint64_t used, uint64_t budget) {   // tex_lock held
+    if (used <= budget / 100 * (uint64_t)live_evict || !by_key.n) return;
+    Tex *pick[PRESSURE_STEP];
+    int np = 0;
+    for (uint32_t i = 0; i < by_key.cap; i++) {   // the PRESSURE_STEP longest-unused candidates
+        Tex *e = by_key.vals[i];
+        if (!e || e->released || !e->pub.mirrored || e->pub.gpu_owned || e->gpu_dirty || e->listed || e->share) continue;
+        uint32_t u = tex_used_at(e);
+        if (submit_epoch - u < (uint32_t)live_idle) continue;
+        if (np < PRESSURE_STEP) { pick[np++] = e; continue; }
+        int w = 0;
+        for (int k = 1; k < np; k++) if (tex_used_at(pick[k]) > tex_used_at(pick[w])) w = k;
+        if (tex_used_at(pick[w]) > u) pick[w] = e;
+    }
+    dcause = DC_YIELD;
+    for (int k = 0; k < np; k++) {
+        if (submit_epoch - tex_used_at(pick[k]) < (uint32_t)live_guard) le_guard_n++;
+        le_n++, le_bytes += own_bytes(pick[k]);
+        destroy_tex(pick[k]);
+    }
+    dcause = DC_NEW;
+}
+
 static void sweep_pressure(void) {   // tex_lock held
     if (vram_pressure < 0) {
         const char *s = cfg_get("NX2NAVI_TEX_VRAM_PRESSURE");
@@ -1105,10 +1141,23 @@ static void sweep_pressure(void) {   // tex_lock held
         rt_log("vk: released render targets in their own memory %s%d%% of the VRAM budget (NX2NAVI_TEX_RT_TRIM)",
                rt_trim ? "trimmed above " : "kept: off, ", rt_trim);
     }
-    if ((!rel_head && !trim_ep_n && !trim_pend_freed) || submit_epoch & 7) return;   // the budget query every 8 submits
+    if (live_evict < 0) {
+        const char *s = cfg_get("NX2NAVI_TEX_LIVE_EVICT"), *i = cfg_get("NX2NAVI_TEX_LIVE_IDLE"),
+                   *g = cfg_get("NX2NAVI_TEX_LIVE_GUARD");
+        live_evict = s && *s ? atoi(s) : 85;
+        if (live_evict < 0 || live_evict > 100) live_evict = 0;
+        live_idle = i && *i ? atoi(i) : 3600;
+        if (live_idle < 1) live_idle = 1;
+        live_guard = g && *g ? atoi(g) : 240;
+        if (live_guard < 0) live_guard = 0;
+        rt_log("vk: live textures unbound for %d submits %s%d%% of the VRAM budget (NX2NAVI_TEX_LIVE_EVICT, _IDLE, _GUARD %d)",
+               live_idle, live_evict ? "dropped above " : "kept: off, ", live_evict, live_guard);
+    }
+    if ((!rel_head && !trim_ep_n && !trim_pend_freed && !live_evict) || submit_epoch & 7) return;   // the budget query every 8 submits
     uint64_t used, budget;
     int exact;
-    if (!(vram_pressure || rel_yield || rt_trim) || !vk_mem_vram(&used, &budget, &exact)) return;
+    if (!(vram_pressure || rel_yield || rt_trim || live_evict) || !vk_mem_vram(&used, &budget, &exact)) return;
+    if (live_evict && exact) sweep_live(used, budget);
     if (rt_trim && exact) sweep_rt_trim(used, budget);
     if (!rel_head) return;
     // VMA keeps the blocks a drop empties only in part: their free space is reused by the next allocations and does not
@@ -2931,6 +2980,9 @@ void vk_texture_format_log(uint64_t frame) {
     uint32_t gk = gone.n;
     uint64_t dn[DC_N], db[DC_N];
     memcpy(dn, td_n, sizeof dn), memcpy(db, td_bytes, sizeof db);
+    le_tot_n += le_n, le_tot_bytes += le_bytes;
+    uint64_t len = le_n, lenb = le_bytes, letn = le_tot_n, letb = le_tot_bytes, leg = le_guard_n;
+    le_n = le_bytes = 0;
     unlock();
     // Why live textures stay (#160): live entries made again from a stale slot after their key went, the keys known
     // gone, and every destroy so far by cause (range gone, replaced, released-count, released-bytes, pressure, yield).
@@ -2943,6 +2995,10 @@ void vk_texture_format_log(uint64_t frame) {
            (unsigned long long)gr, (unsigned long long)dn[1], db[1] / 1048576.0, (unsigned long long)dn[2],
            db[2] / 1048576.0, (unsigned long long)dn[3], db[3] / 1048576.0, (unsigned long long)dn[4], db[4] / 1048576.0,
            (unsigned long long)dn[5], db[5] / 1048576.0, (unsigned long long)dn[6], db[6] / 1048576.0);
+    rt_log("mem: textures frame %llu: live entries dropped unbound under VRAM pressure (NX2NAVI_TEX_LIVE_EVICT) %llu "
+           "%.0f MiB since the last line, %llu %.0f MiB since start; of them used within NX2NAVI_TEX_LIVE_GUARD submits %llu",
+           (unsigned long long)frame, (unsigned long long)len, lenb / 1048576.0, (unsigned long long)letn,
+           letb / 1048576.0, (unsigned long long)leg);
     rt_log("mem: textures frame %llu: gone keys with a live entry at the address (not blanked) %llu; slots resolved to "
            "nothing: stale rule %llu, gone rule %llu, create held %llu, create failed %llu",
            (unsigned long long)frame, (unsigned long long)gl, (unsigned long long)ns, (unsigned long long)gb,
-- 
