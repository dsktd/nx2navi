From 84e06d8ba784f6d2cfa79a67ff52c94e74af66ac Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:21:26 -0500
Subject: [PATCH 17/18] vk_dump: NX2NAVI_DUMP_DRAWS=1 lists every draw of a
 pass in passes.txt

Each draw line gives its pipe, vertex and fragment shader, kind (arrays,
indexed, indirect), primitive, index type, count, instances, base vertex and
instance, and the index or argument buffer address, so a frame's draw list can
be diffed against another frame's.
---
 runtime/vk_dump.c      | 19 +++++++++++++++----
 runtime/vk_exec_draw.c |  7 +++++++
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/runtime/vk_dump.c b/runtime/vk_dump.c
index 52486ba..df0495c 100644
--- a/runtime/vk_dump.c
+++ b/runtime/vk_dump.c
@@ -512,6 +512,9 @@ static uint64_t shader_hash(const GfxShader *s) {
 typedef struct { VkPipeline p; uint64_t th; int draws; char *text; } Ent;
 static Ent ents[MAX_ENTS];
 static int nents, ents_over, pass_draws;
+static int dump_draws;       // NX2NAVI_DUMP_DRAWS=1: every draw of a pass listed in order with its arguments
+static Str draw_lines;       // those lines, flushed at the pass end
+char vk_dump_draw_args[128]; // set by the draw ops (vk_exec_draw.c) before prepare_draw: kind, count, instances
 typedef struct { VkImage image; VkFormat format; uint32_t w, h, d; int id, is2d; } Lut;
 static Lut luts[MAX_LUTS];          // queued for the next pass end or dispatch
 static int nluts;
@@ -726,11 +729,16 @@ void vk_dump_draw(VkExec *ex, const VkPipeState *s, VkPipeline p, const VkPipeIn
     if (!active()) goto out;
     pass_draws++;
     uint64_t th = bindings_hash(ex, info);
+    int pipe = -1;
     for (int i = 0; i < nents; i++)
-        if (ents[i].p == p && ents[i].th == th) {
-            ents[i].draws++;
-            goto out;
-        }
+        if (ents[i].p == p && ents[i].th == th) { pipe = i; break; }
+    if (dump_draws)
+        sp(&draw_lines, "    draw %d: pipe %d vs %016llx fs %016llx %s\n", pass_draws - 1, pipe < 0 ? nents : pipe,
+           (unsigned long long)shader_hash(s->vs), (unsigned long long)shader_hash(s->fs), vk_dump_draw_args);
+    if (pipe >= 0) {
+        ents[pipe].draws++;
+        goto out;
+    }
     if (nents == MAX_ENTS) {
         ents_over++;
         goto out;
@@ -812,6 +820,7 @@ void vk_dump_pass_end(VkExec *ex) {
         free(ents[i].text);
     }
     if (ents_over) fprintf(passes_f, "  ... %d more draws with other pipeline/texture sets\n", ents_over);
+    if (draw_lines.s) fputs(draw_lines.s, passes_f), free(draw_lines.s), draw_lines = (Str){0};
     if (!pass_skip) flush_luts(ex, n);
     else nluts = 0;
     buf_snap(ex, n);
@@ -967,6 +976,8 @@ void vk_dump_init(void) {
     if (lf && *lf) log_from = strtoull(lf, NULL, 10);
     const char *sr = cfg_get("NX2NAVI_DUMP_SKIP_RUNS");
     skip_runs = sr && *sr && *sr != '0';
+    const char *dd = cfg_get("NX2NAVI_DUMP_DRAWS");
+    dump_draws = dd && *dd && *dd != '0';
     const char *du = cfg_get("NX2NAVI_DUMP_UBO");
     dump_ubo = du && *du ? atoi(du) : 0;
     if (dump_ubo == 1) dump_ubo = 16;
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index e9ab84b..3c7a493 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -3882,8 +3882,12 @@ static void bind_index(VkExec *ex, const void *data, uint64_t bytes, VkIndexType
     ex->recorded++;
 }
 
+extern char vk_dump_draw_args[128];   // vk_dump.c, NX2NAVI_DUMP_DRAWS
+#define DUMP_ARGS(...) do { if (vk_dump_armed) snprintf(vk_dump_draw_args, sizeof vk_dump_draw_args, __VA_ARGS__); } while (0)
+
 static void op_draw(VkExec *ex, const p_draw *d) {
     c0_binst = (uint32_t)d->base_instance;
+    DUMP_ARGS("arrays prim %d first %d count %d inst %d base_inst %d", d->prim, d->first, d->count, d->instances, d->base_instance);
     if (d->count <= 0 || !prepare_draw(ex, d->prim, d->count, 0)) return;
     vk_exec_frame.draws++;
     uint32_t inst = d->instances > 0 ? (uint32_t)d->instances : 1, first = (uint32_t)d->first, n = (uint32_t)d->count;
@@ -3936,6 +3940,8 @@ static void op_draw_idx(VkExec *ex, const p_draw_idx *d) {
     static const uint32_t isize[3] = {1, 2, 4};
     if (d->itype < 0 || d->itype > 2) return warn_once(W_INDEX, "index type %d is unknown: draw skipped", d->itype);
     int restart = restart_for(ex, d->prim, d->itype);
+    DUMP_ARGS("indexed prim %d itype %d count %d inst %d base_vtx %d base_inst %d ib %#llx", d->prim, d->itype, d->count,
+              d->instances, d->base_vertex, d->base_instance, (unsigned long long)d->ibuf);
     if (d->count <= 0 || !prepare_draw(ex, d->prim, d->count, restart)) return;
     vk_exec_frame.draws++;
     uint64_t bytes = (uint64_t)d->count * isize[d->itype];
@@ -3980,6 +3986,7 @@ static void op_draw_idx_ind(VkExec *ex, const p_draw_idx_ind *d) {
         return warn_once(W_INDIRECT, "indirect draw arguments at %#llx are not backed or not aligned: draws skipped", (unsigned long long)d->ind);
     if (!vk_mem_resolve(d->ibuf, 1, &ib) || ib.offset % (d->itype == NVN_INDEX_TYPE_UNSIGNED_SHORT ? 2 : 4))
         return warn_once(W_INDEX, "index buffer %#llx is not backed or not aligned: indirect draws skipped", (unsigned long long)d->ibuf);
+    DUMP_ARGS("indirect prim %d itype %d args %#llx ib %#llx", d->prim, d->itype, (unsigned long long)d->ind, (unsigned long long)d->ibuf);
     if (!prepare_draw(ex, d->prim, 0x7fffffff, restart_for(ex, d->prim, d->itype))) return;
     vk_exec_frame.draws++;
     VK_MEM_USE(ip);
-- 
