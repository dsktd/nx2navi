From a3fdd2bfc20d5c377eb7b85b6822a1fdd3446592 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Sun, 8 Nov 2026 19:12:19 -0500
Subject: [PATCH] vk_usnap: zero the game's projection jitter when no temporal
 upscaler runs

Ocarina's scene context block (0x3500) carries a per-frame sub-pixel jitter in
the projection (rows 7 and 8, column 2) for its own temporal upscaler, a
tensor-core network that runs as a plain scale here. Unresolved, the jitter
makes distant edges and shadow boundaries shimmer. NX2NAVI_UNJITTER
(auto|0|1|log) zeroes the two terms in the uniform snapshot; auto when
vk_dlaa_available is false.
---
 runtime/cfg.c      |  1 +
 runtime/vk_usnap.c | 64 ++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index dd4758b..5708bfa 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -88,6 +88,7 @@ static const char *const known[] = {
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",
     "COOP_TEST_SET", "COOP_ACCEPT", "COOP_REMOVE", "COOP_RESET_POOLS",
     "DUMP_REQ",
+    "UNJITTER",
 };
 
 // The nx2navi.ini section a key cfg_set may write goes to when the file lacks it (nx2navi.ini.example's sections).
diff --git a/runtime/vk_usnap.c b/runtime/vk_usnap.c
index 274a64e..9507f05 100644
--- a/runtime/vk_usnap.c
+++ b/runtime/vk_usnap.c
@@ -18,9 +18,11 @@
 // graveyard the block of the shadow pass came out with another block's values in the frame its allocator moved on to
 // the next stretch of memory, about every 364 frames, and that frame's sunlight was all in shadow (a dark frame with
 // the interface intact). NX2NAVI_UBO_SNAPSHOT=0 binds live memory as before; =ab alternates (NX2NAVI_AB).
+#include <math.h>
 #include <stdlib.h>
 #include <string.h>
 
+#include "cfg.h"
 #include "host.h"
 #include "nvn_api.h"
 #include "vk.h"
@@ -63,6 +65,8 @@ static struct {
     int nwr, cwr;
     // since the last summary
     uint64_t subs, regions, bytes, copy_ns, hits, drops, inflight, refused, off_subs;
+    uint64_t cam[8];            // Ocarina's scene context blocks this submission binds (unjitter); gather_lock
+    int ncam;
 } U;
 
 static Arena *free_arenas;
@@ -131,6 +135,44 @@ static void arena_done(void *arg) {   // completion thread: the GPU has read it
     plat_mutex_unlock(&free_lock);
 }
 
+// Ocarina's scene context block (vk_dlaa.c OCAM_BLOCK): rows 7-10 are the projection its scene vertex shaders use.
+// The game offsets it each frame by a sub-pixel jitter (clip x and y += jitter * w, in its column 2 of rows 7 and 8)
+// for its own temporal upscaler, a tensor-core network that runs as a plain scale (vk_exec_draw.c
+// untranslated_dispatch_fallback). Nothing then resolves the jitter, and every edge and shadow boundary in the
+// distance shimmers. NX2NAVI_UNJITTER (auto|0|1|log): auto zeroes the two terms in the snapshot when no temporal
+// upscaler of ours runs (vk_dlaa_available); terms over UNJITTER_MAX (a few pixels) are left: an off-centre view.
+#define OCAM_BLOCK 0x3500u
+#define UNJITTER_MAX 0.01f
+
+static int unjitter_mode(void) {   // 0 off, 1 zero the jitter, 2 also log it
+    static int m = -1;
+    if (m < 0) {
+        const char *v = cfg_get("NX2NAVI_UNJITTER");
+        if (v && !strcmp(v, "log")) m = 2;
+        else if (v && (!strcmp(v, "0") || !strcmp(v, "1"))) m = *v - '0';
+        else m = !vk_dlaa_available();
+        rt_log("vk_usnap: unjitter %s", m == 2 ? "on, logged" : m ? "on (no temporal upscaler)" : "off");
+    }
+    return m;
+}
+
+// The copy dst of regions reg[0..nreg): the jitter terms of the scene blocks cam[0..ncam) zeroed.
+static void unjitter(uint8_t *dst, const Reg *reg, int nreg, const uint64_t *cam, int ncam) {
+    int m = ncam ? unjitter_mode() : 0;
+    if (!m) return;
+    static uint64_t logged, kept;
+    for (int c = 0; c < ncam; c++) {
+        uint64_t a = cam[c] + 7 * 16 + 2 * 4;   // row 7, column 2; row 8 column 2 is 16 bytes on
+        int i = 0;
+        while (i < nreg && !(a >= reg[i].lo && a + 20 <= reg[i].hi)) i++;
+        if (i >= nreg) continue;
+        float *x = (float *)(dst + reg[i].off + (a - reg[i].lo)), *y = x + 4;
+        if (m == 2 && logged < 600) logged++, rt_log("vk_usnap: unjitter %#llx: %.6g %.6g", (unsigned long long)cam[c], *x, *y);
+        if (fabsf(*x) < UNJITTER_MAX && fabsf(*y) < UNJITTER_MAX) *x = *y = 0;
+        else if (!kept++) rt_log("vk_usnap: unjitter left an off-centre projection (%.6g %.6g)", *x, *y);
+    }
+}
+
 static void collect(const op_hdr *h, int depth) {
     for (;;) {
         if (h->size < sizeof *h || (h->size & 7) || h->op >= OP_COUNT_)
@@ -145,6 +187,11 @@ static void collect(const op_hdr *h, int depth) {
         if (h->op == OP_BIND_UBO) {
             const p_bind_buf *b = a;
             if (b->addr && b->size) {
+                if (b->size == OCAM_BLOCK && U.ncam < 8) {
+                    int k = 0;
+                    while (k < U.ncam && U.cam[k] != b->addr) k++;
+                    if (k == U.ncam) U.cam[U.ncam++] = b->addr;
+                }
                 uint64_t n = b->size < MAX_RANGE ? b->size : MAX_RANGE;
                 // the vertex stage's object and bone blocks: also the game's other copy on either side, which still
                 // holds last frame's (vk_mvprev.c)
@@ -286,7 +333,7 @@ static void copy_down(void *arg, int lo, int hi) {
 // The bytes of regions reg[0..nreg) (total bytes in all) into a's device copy, through its host copy with DLSS. With
 // par (the replay thread at a submission's start), split over the replay workers: about 700 regions and 0.7 MiB in
 // Hyrule Field, half a millisecond of the submitting thread's time on one thread.
-static void copy_regions(Arena *a, const Reg *reg, int nreg, uint64_t total, int par) {
+static void copy_regions(Arena *a, const Reg *reg, int nreg, uint64_t total, int par, const uint64_t *cam, int ncam) {
     uint8_t *dst = a->map;
     if (vk_dlaa_available()) {
         if (!a->cpu && !(a->cpu = malloc(a->size))) rt_fatal("vk_usnap: out of memory");
@@ -295,6 +342,7 @@ static void copy_regions(Arena *a, const Reg *reg, int nreg, uint64_t total, int
     CopyJob j = {dst, a->map, reg, total};
     if (par) vk_exec_par(copy_some, &j, nreg, 48);
     else copy_some(&j, 0, nreg);
+    unjitter(dst, reg, nreg, cam, ncam);
     if (dst != a->map) {   // sequential writes into the device copy
         int slices = (int)((total + COPY_SLICE - 1) / COPY_SLICE);
         if (par) vk_exec_par(copy_down, &j, slices, 2);
@@ -319,7 +367,7 @@ void vk_usnap_take(const uint64_t *handles, int n) {
     }
     int creg = 0;
     plat_mutex_lock(&gather_lock);
-    U.ncol = 0;
+    U.ncol = 0, U.ncam = 0;
     for (int i = 0; i < n; i++)
         if (handles[i]) collect(nvn_op_first(handles[i]), 0);
     sort_col();
@@ -337,8 +385,11 @@ void vk_usnap_take(const uint64_t *handles, int n) {
         t->reg[t->nreg++] = (Reg){lo, hi, t->total, 0};
         t->total += (hi - lo + ALIGN - 1) & ~(uint64_t)(ALIGN - 1);
     }
+    uint64_t cam[8];
+    int ncam = U.ncam;
+    memcpy(cam, U.cam, sizeof cam);
     plat_mutex_unlock(&gather_lock);
-    if (t->nreg && (t->arena = arena_get(t->total))) copy_regions(t->arena, t->reg, t->nreg, t->total, 0);
+    if (t->nreg && (t->arena = arena_get(t->total))) copy_regions(t->arena, t->reg, t->nreg, t->total, 0, cam, ncam);
     t->ns = kern_now_ns() - t0;
     plat_mutex_lock(&tq_lock);
     if (tq_tail) tq_tail->next = t;
@@ -403,7 +454,7 @@ void vk_usnap_begin(const uint64_t *handles, int n, uint64_t fence) {
     }
     uint64_t t0 = kern_now_ns();
     plat_mutex_lock(&gather_lock);
-    U.ncol = 0;
+    U.ncol = 0, U.ncam = 0;
     for (int i = 0; i < n; i++)
         if (handles[i]) collect(nvn_op_first(handles[i]), 0);
     sort_col();
@@ -429,10 +480,13 @@ void vk_usnap_begin(const uint64_t *handles, int n, uint64_t fence) {
         U.reg[U.nreg++] = (Reg){lo, hi, total, 0};
         total += (hi - lo + ALIGN - 1) & ~(uint64_t)(ALIGN - 1);
     }
+    uint64_t cam[8];
+    int ncam = U.ncam;
+    memcpy(cam, U.cam, sizeof cam);
     plat_mutex_unlock(&gather_lock);
     if (!U.nreg) return;
     if (!(U.arena = arena_get(total))) return;
-    copy_regions(U.arena, U.reg, U.nreg, total, 1);   // the replay thread at the submission's start
+    copy_regions(U.arena, U.reg, U.nreg, total, 1, cam, ncam);   // the replay thread at the submission's start
     U.on = 1;
     U.subs++, U.regions += (uint64_t)U.nreg, U.bytes += total, U.copy_ns += kern_now_ns() - t0;
 }
-- 
2.56.0

