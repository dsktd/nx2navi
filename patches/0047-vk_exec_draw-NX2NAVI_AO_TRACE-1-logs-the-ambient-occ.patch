From 178e4ec113cd17c41d925cc39395ce09b9f3fdfd Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 04:28:50 -0500
Subject: [PATCH] vk_exec_draw: NX2NAVI_AO_TRACE=1 logs the ambient occlusion
 chain per frame in replay order: depth pass, occlusion, blur, with their
 images (diagnosis; the logging slows the replay) (#146)

---
 runtime/cfg.c          |  1 +
 runtime/vk_exec_draw.c | 51 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 8aca3e2..5a65db4 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -93,6 +93,7 @@ static const char *const known[] = {
     "LOG_OQ", "OQ_FORCE",
     "MOTION_PAD",
     "AO",
+    "AO_TRACE",
 };
 
 // The nx2navi.ini section a key cfg_set may write goes to when the file lacks it (nx2navi.ini.example's sections).
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index cf55489..aae458d 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -2448,6 +2448,55 @@ static void ao_clear(VkExec *ex) {
     ex->recorded++;
 }
 
+// NX2NAVI_AO_TRACE=1 (diagnosis of the ambient occlusion flicker): one log line, in replay order, for each step of
+// the ambient occlusion chain: the half-resolution depth pass, the occlusion compute, its last blur, and the lighting
+// resolve that samples the result, each with the frame, the fence and the images it binds (storage address, VkImage).
+// From the lines one reads which frame's depth the occlusion saw and whether the resolve sampled the image the blur
+// of its own frame wrote.
+static int ao_trace_on(void) {
+    static int on = -1;
+    if (on < 0) on = rt_knob("AO_TRACE", "0");
+    return on;
+}
+
+static int ao_img(char *o, size_t n, const char *name, uint64_t h) {
+    view_t v;
+    int hv = 0;
+    const VkTexImage *t = h ? vk_texture_by_id(NVN_HANDLE_TEX(h), &v, &hv) : NULL;
+    if (!t) return snprintf(o, n, " %s=none", name);
+    return snprintf(o, n, " %s=%llx/%p/%ux%u/id%d", name, (unsigned long long)t->addr, (void *)t->image, t->width, t->height,
+                    NVN_HANDLE_TEX(h));
+}
+
+static void ao_trace(VkExec *ex, const GfxShader *sh, int draw) {
+    static const struct { uint64_t h; const char *name; int8_t tex[3], img; } steps[] = {
+        {0x1b66d31cf1ac4053ull, "depth", {-1, -1, -1}, -1},     // fs: full to half resolution depth
+        {0x561cf523be84578bull, "occlusion", {0, -1, -1}, 0},   // cs: occlusion from the half resolution depth
+        {0x8b563e79bcdf41ecull, "blur", {0, -1, -1}, 0},        // cs: vertical blur (the last one writes the result)
+        {0xc6f5578c8c701891ull, "mask", {0, -1, -1}, 0},        // cs: full resolution r8 from the depth buffer
+        {0xc4fcb154221f0f5aull, "resolve", {5, 6, 1}, -1},      // fs: samples mask (5), occlusion (6), half depth (1)
+    };
+    uint64_t h = ao_hash(sh);
+    for (size_t k = 0; k < sizeof steps / sizeof *steps; k++) {
+        if (steps[k].h != h) continue;
+        char line[400];
+        int st = draw ? NVN_STAGE_FS : NVN_STAGE_CS;
+        int o = snprintf(line, sizeof line, "ao: f%llu fence %llu %s", (unsigned long long)__atomic_load_n(&gfx_counters.frames, __ATOMIC_RELAXED) + 1,
+                         (unsigned long long)ex->fence, steps[k].name);
+        for (int i = 0; i < 3; i++)
+            if (steps[k].tex[i] >= 0) {
+                char nm[8];
+                snprintf(nm, sizeof nm, "t%d", steps[k].tex[i]);
+                o += ao_img(line + o, sizeof line - (size_t)o, nm, ex->tex[st][steps[k].tex[i]]);
+            }
+        if (steps[k].img >= 0) o += ao_img(line + o, sizeof line - (size_t)o, "out", ex->img[st][steps[k].img]);
+        if (draw && ex->color[0].img)
+            snprintf(line + o, sizeof line - (size_t)o, " rt=%llx/%p/%ux%u", (unsigned long long)ex->color[0].img->addr,
+                     (void *)ex->color[0].image, ex->color[0].width, ex->color[0].height);
+        rt_log("%s", line);
+    }
+}
+
 // NX2NAVI_SKIP_SHADERS=<hash>,...: draws and dispatches whose shader's SPIR-V has one of these FNV-1a hashes (the "vs"/"fs"/
 // "cs" hashes of the frame dump's passes.txt) are skipped (diagnosis: which pass makes an effect).
 static int shader_skipped(const GfxShader *sh) {
@@ -4650,6 +4699,7 @@ static int prepare_draw_ex(VkExec *ex, int prim, int32_t count, int restart, int
     feedback_written(ex, &s, fbl);
     if (!mesh) bind_vertex_buffers(ex);
     if (vk_dump_armed) vk_dump_draw(ex, &s, p, info, mesh && !fb);
+    if (ao_trace_on() && fs) ao_trace(ex, fs, 1);
     if (vk_hdr_track) vk_hdr_draw(ex, info);
     if (vk_texture_deferred()) return 0;
     vk_exec_oq_draw(ex);
@@ -7181,6 +7231,7 @@ static void op_dispatch(VkExec *ex, const p_dispatch *d) {
     vk_pass_mark_end(ex->cb, m);
     ex->recorded++;
     if (vk_dump_armed) vk_dump_dispatch(ex, cs, p, info, d);
+    if (ao_trace_on()) ao_trace(ex, cs, 0);
     if (!ao_on() && ao_hash(cs) == 0x561cf523be84578bull) ao_clear(ex);
 }
 
-- 
2.56.0

