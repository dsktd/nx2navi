From cc2516945b6501805c1fc1ba34e5f47d5de9db1c Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:50:31 -0500
Subject: [PATCH] vk_exec_draw: NX2NAVI_DUMMY_CLEAR=1 clears the stand-in
 images (upstream 0d564a2: sampled mid grey, storage zero), 2 makes sampled
 ones magenta to show where a material samples one; default 0 leaves them
 uncleared as before

---
 runtime/cfg.c          |  6 ++---
 runtime/vk_exec_draw.c | 50 +++++++++++++++++++++++++++++++++++++-----
 2 files changed, 47 insertions(+), 9 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 97cfdb1..3b42d14 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -76,7 +76,7 @@ static const char *const known[] = {
     "ZSTD_CHECK", "ZSTD_NATIVE",
     "BIND_REUSE", "DYN_DELTA", "STG_ARENA", "SUBMIT_BATCH", "ASTC_GPU_DESWIZZLE", "ASTC_SCRATCH_KEEP", "ASTC_ARENA", "ASTC_BC1",
     "TEXUP_LOG_MS", "DYN_RES", "DYN_RES_TARGET", "DYN_RES_STEP", "TEXTURE_DETAIL",
-    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "POOL_LOAD_FIT", "POOL_IDLE_MS", "SHADOW_RECYCLE_MB",
+    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "POOL_LOAD_FIT", "POOL_IDLE_MS", "DUMMY_CLEAR", "SHADOW_RECYCLE_MB",
     "VMA_BLOCK_MB", "SYNC_WAKE_ALL", "LOG_ASYNC", "DEVICE_LOST_AT",
     "COOP", "COOP_BETA", "COOP_NAME", "COOP_SERVER", "COOP_PORT", "COOP_ROOM", "COOP_AUTO", "COOP_DROP",   // co-op (coop.c); the last three have no menu row
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",   // the room's rules (coop_game.c)
@@ -139,7 +139,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"DYN_DELTA", "performance"}, {"STG_ARENA", "performance"}, {"SUBMIT_BATCH", "performance"},
     {"BUILD_FREE_MB", "performance"}, {"BUILD_RESERVE_MB", "performance"}, {"MEM_NEED_MB", "diagnostics"},
     {"ASTC_GPU_DESWIZZLE", "performance"}, {"ASTC_SCRATCH_KEEP", "performance"}, {"ASTC_ARENA", "performance"}, {"ASTC_BC1", "performance"}, {"POOL_CREATE_BUDGET", "performance"},
-    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"}, {"POOL_LOAD_FIT", "performance"}, {"POOL_IDLE_MS", "performance"}, {"SHADOW_RECYCLE_MB", "performance"},
+    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"}, {"POOL_LOAD_FIT", "performance"}, {"POOL_IDLE_MS", "performance"}, {"DUMMY_CLEAR", "debug"}, {"SHADOW_RECYCLE_MB", "performance"},
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"}, {"ONESHOT_BUDGET", "performance"},
     {"PIPE_FRAME_WAIT_MS", "performance"}, {"PIPE_SKIP_STEADY", "performance"},
     {"CACHE_DIE", "performance"}, {"ONE_PER_CORE", "performance"},
@@ -266,7 +266,7 @@ static const CfgMeta metas[] = {
     {"DYN_RES", "0", "0|1", LIVE}, {"DYN_RES_TARGET", "16.7", "1..100", LIVE}, {"DYN_RES_STEP", "45", "8..600", LIVE},
     // the recording thread: a core of its own (auto: with 12 or more logical processors) and the highest priority
     // (vk_exec.c rec_claim)
-    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART}, {"POOL_LOAD_FIT", "0", "0|1", RESTART}, {"POOL_IDLE_MS", "0", "0..50", RESTART}, {"SHADOW_RECYCLE_MB", "1024", "0..16384", RESTART},
+    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART}, {"POOL_LOAD_FIT", "0", "0|1", RESTART}, {"POOL_IDLE_MS", "0", "0..50", RESTART}, {"DUMMY_CLEAR", "0", "0|1|2", RESTART}, {"SHADOW_RECYCLE_MB", "1024", "0..16384", RESTART},
     // held submissions handed to the queue together (vk_sync.c, submit batching)
     {"SUBMIT_BATCH", "4", "1..16", RESTART},
     {"CACHE_DIE", "1", "0|1|ab", RESTART}, {"ONE_PER_CORE", "0", "0|1|ab", RESTART},   // perf.c cpu_placement
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 2a18448..c56b172 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -352,15 +352,20 @@ static const struct { VkImageType t; VkImageViewType vt; uint32_t layers; VkSamp
     {VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, 1, VK_SAMPLE_COUNT_4_BIT, 0},
     {VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D_ARRAY, 1, VK_SAMPLE_COUNT_4_BIT, 0}};
 
-// A 1x1 stand-in image of view type dinfo[i] in `fmt`, moved to GENERAL by the upload batch (which reaches the queue before
-// the submission that uses it). *sview is the view a storage descriptor takes (a cube becomes a 2D array).
-static void make_dummy(int i, VkFormat fmt, VkImage *image, VmaAllocation *alloc, VkImageView *view, VkImageView *sview) {
+// A 1x1 stand-in image of view type dinfo[i] in `fmt`, moved to GENERAL and cleared to `clear` by the upload batch (which
+// reaches the queue before the submission that uses it). *sview is the view a storage descriptor takes (a cube becomes a
+// 2D array). Left uncleared its content was undefined, and a material that read its roughness map through one (a slot
+// with no texture yet) could see roughness near 0: on Kakariko's distant cliffs at night the specular term reached
+// 3392 in single pixels, which bloom and the temporal upscaler spread into bright white spots.
+static void make_dummy(int i, VkFormat fmt, const VkClearColorValue *clear, VkImage *image, VmaAllocation *alloc,
+                       VkImageView *view, VkImageView *sview) {
     VkCtx *c = vk_ctx();
     int ms = dinfo[i].s != VK_SAMPLE_COUNT_1_BIT;
     VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .flags = dinfo[i].f, .imageType = dinfo[i].t,
                             .format = fmt, .extent = {1, 1, 1}, .mipLevels = 1, .arrayLayers = dinfo[i].layers,
                             .samples = dinfo[i].s, .tiling = VK_IMAGE_TILING_OPTIMAL,
-                            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | (ms ? 0 : VK_IMAGE_USAGE_STORAGE_BIT),
+                            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                                     (ms ? 0 : VK_IMAGE_USAGE_STORAGE_BIT),
                             .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
     VmaAllocationCreateInfo ia = {.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
     if (vmaCreateImage(c->vma, &ii, &ia, image, alloc, NULL) != VK_SUCCESS) rt_fatal("vk: stand-in image %d failed", i);
@@ -381,10 +386,43 @@ static void make_dummy(int i, VkFormat fmt, VkImage *image, VmaAllocation *alloc
                                  .image = *image, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, dinfo[i].layers}};
     VkCommandBuffer cb = vk_upload_begin();
     VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &bar};
+    if (!clear) {   // NX2NAVI_DUMMY_CLEAR=0: the old stand-in, undefined content
+        vkCmdPipelineBarrier2(cb, &di);
+        vk_upload_end();
+        return;
+    }
+    bar.dstStageMask = VK_PIPELINE_STAGE_2_CLEAR_BIT, bar.dstAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    vkCmdPipelineBarrier2(cb, &di);
+    vkCmdClearColorImage(cb, *image, VK_IMAGE_LAYOUT_GENERAL, clear, 1, &bar.subresourceRange);
+    bar.srcStageMask = VK_PIPELINE_STAGE_2_CLEAR_BIT, bar.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    bar.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    bar.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    bar.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
     vkCmdPipelineBarrier2(cb, &di);
     vk_upload_end();
 }
 
+// Sampled stand-ins read as mid grey, opaque: a missing roughness or metalness map gives a middling value, a missing
+// two-channel normal map a flat normal, a missing colour map grey. Storage stand-ins (any format, written by shaders that
+// have no image) start at zero.
+static const VkClearColorValue DUMMY_SAMPLED = {.float32 = {0.5f, 0.5f, 0.5f, 1.0f}};
+static const VkClearColorValue DUMMY_STORAGE = {.uint32 = {0, 0, 0, 0}};
+// NX2NAVI_DUMMY_CLEAR (upstream 0d564a2 behind a knob): 0 (default) leaves the stand-ins uncleared as before; 1 clears
+// them as above; 2 makes sampled stand-ins opaque magenta, so a picture shows where a material samples one (the red,
+// black or rainbow cliffs of dump f3781: their colour layers come through bindless 2D array handles from a storage
+// buffer, which a dump's slot list does not show).
+static const VkClearColorValue DUMMY_MARK = {.float32 = {1.0f, 0.0f, 1.0f, 1.0f}};
+static int dummy_clear = -1;
+static const VkClearColorValue *dummy_sampled(void) {
+    if (dummy_clear < 0) {
+        dummy_clear = cfg_int("NX2NAVI_DUMMY_CLEAR");
+        rt_log("vk: stand-in images %s (NX2NAVI_DUMMY_CLEAR=%d)",
+               dummy_clear == 1 ? "cleared: sampled mid grey, storage zero" : dummy_clear == 2 ? "sampled magenta, storage zero" : "uncleared", dummy_clear);
+    }
+    return dummy_clear == 1 ? &DUMMY_SAMPLED : dummy_clear == 2 ? &DUMMY_MARK : NULL;
+}
+static const VkClearColorValue *dummy_storage(void) { return dummy_sampled() ? &DUMMY_STORAGE : NULL; }
+
 // Storage image stand-ins in the format a shader declares (GfxShaderRes.format: the translator's TextureFormat order); Vulkan wants
 // the view format to match the declaration. Created on first use.
 static const VkFormat tex_format[40] = {
@@ -405,7 +443,7 @@ static VkImageView storage_dummy(int di, int code) {
     for (int i = 0; i < 48; i++) {
         if (!SD[i].used) {
             SD[i].used = 1, SD[i].di = di, SD[i].fmt = fmt;
-            make_dummy(di, fmt, &SD[i].image, &SD[i].alloc, &SD[i].view, &SD[i].sview);
+            make_dummy(di, fmt, dummy_storage(), &SD[i].image, &SD[i].alloc, &SD[i].view, &SD[i].sview);
             return SD[i].sview;
         }
         if (SD[i].di == di && SD[i].fmt == fmt) return SD[i].sview;
@@ -441,7 +479,7 @@ static void dummies_init(void) {
     Z.samp_shadow = vk_sampler_for(&sp);
 
     for (int i = 0; i < DV_COUNT; i++)
-        make_dummy(i, VK_FORMAT_R8G8B8A8_UNORM, &Z.img[i].image, &Z.img[i].alloc, &Z.img[i].view, &Z.img[i].sview);
+        make_dummy(i, VK_FORMAT_R8G8B8A8_UNORM, dummy_sampled(), &Z.img[i].image, &Z.img[i].alloc, &Z.img[i].view, &Z.img[i].sview);
     Z.ready = 1;
 }
 
