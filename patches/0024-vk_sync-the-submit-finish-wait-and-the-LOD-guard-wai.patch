diff --git a/runtime/vk_sync.c b/runtime/vk_sync.c
index 98eccb1..4f23389 100644
--- a/runtime/vk_sync.c
+++ b/runtime/vk_sync.c
@@ -11,6 +11,7 @@
 #include <stdlib.h>
 #include <string.h>
 
+#include "cfg.h"
 #include "gfx.h"
 #include "host.h"
 #include "nvn_api.h"
@@ -39,6 +40,13 @@ static PlatMutex st_lock = PLAT_MUTEX_INIT;
 static PlatCond cv_work = PLAT_COND_INIT;   // a submission, a callback or stop
 static PlatCond cv_done = PLAT_COND_INIT;   // done advanced
 static uint64_t issued, done;     // newest submitted value; newest value whose side effects ran
+// Newest value the timeline reached, published before that value's callbacks run (done lags it by the callbacks:
+// write-back compares, resets, frees). A waiter that only needs the GPU to be through with its commands (the game's
+// submit finish wait, the LOD guard: ordering the GPU's reads of guest memory before the game rewrites it) waits on
+// this (vk_sync_gpu_wait); a waiter that reads what the GPU wrote (nvnSyncWait, finish, texture and mirror reads) waits
+// on done, which also covers the shadow write-back into guest memory. NX2NAVI_GPU_WAIT=0 makes vk_sync_gpu_wait wait
+// on done, as before.
+static uint64_t reached_gpu;
 static uint64_t reserved;         // asynchronous replay: newest value handed out before its submission (>= issued)
 static int stop;
 static Pending *queue;            // side effects in the order they were added
@@ -261,6 +269,10 @@ static void completion_main(void *arg) {
             vkGetSemaphoreCounterValue(c->device, c->timeline, &reached);
             plat_mutex_lock(&st_lock);
             if (reached > issued) reached = issued;
+            if (reached > reached_gpu) {
+                __atomic_store_n(&reached_gpu, reached, __ATOMIC_RELEASE);
+                plat_cond_broadcast(&cv_done);
+            }
         }
         while (qn && queue[qhead].fence <= reached) {
             Pending p = queue[qhead++];
@@ -302,7 +314,7 @@ void vk_sync_start(void) {
             now = issued;
         }
         plat_mutex_lock(&st_lock);
-        issued = done = now;
+        issued = done = reached_gpu = now;
         if (reserved < now) reserved = now;
         stop = 0;
         plat_mutex_unlock(&st_lock);
@@ -475,17 +487,8 @@ void vk_completion_add(uint64_t fence, void (*fn)(void *), void *arg) {
     plat_mutex_unlock(&st_lock);
 }
 
-static int fence_wait_impl(uint64_t value, uint64_t timeout_ns);
-
-int vk_sync_fence_wait(uint64_t value, uint64_t timeout_ns) {
-    uint64_t p0 = perf_begin();
-    int ok = fence_wait_impl(value, timeout_ns);
-    perf_end(PERF_FENCE, p0);
-    perf_gpu_wait(p0);
-    return ok;
-}
-
-static int fence_wait_impl(uint64_t value, uint64_t timeout_ns) {
+// Waits until *ctr (done or reached_gpu, both under st_lock and advanced with a cv_done broadcast) reaches value.
+static int counter_wait(const uint64_t *ctr, uint64_t value, uint64_t timeout_ns) {
     vk_sync_start();
     plat_mutex_lock(&st_lock);
     int ok;
@@ -493,7 +496,7 @@ static int fence_wait_impl(uint64_t value, uint64_t timeout_ns) {
         ok = 0;   // never submitted nor queued: never reached (as in the null back end)
     } else {
         uint64_t t0 = kern_now_ns();
-        while (done < value) {
+        while (*ctr < value) {
             if (timeout_ns < (1ull << 62)) {
                 uint64_t el = kern_now_ns() - t0;
                 if (el >= timeout_ns) break;
@@ -502,14 +505,41 @@ static int fence_wait_impl(uint64_t value, uint64_t timeout_ns) {
                 plat_cond_wait(&cv_done, &st_lock);
             }
         }
-        ok = done >= value;
+        ok = *ctr >= value;
     }
     plat_mutex_unlock(&st_lock);
     return ok;
 }
 
+int vk_sync_fence_wait(uint64_t value, uint64_t timeout_ns) {
+    uint64_t p0 = perf_begin();
+    int ok = counter_wait(&done, value, timeout_ns);
+    perf_end(PERF_FENCE, p0);
+    perf_gpu_wait(p0);
+    return ok;
+}
+
+static int gpu_wait_on(void) {   // NX2NAVI_GPU_WAIT: 1 (default) reached_gpu, 0 done
+    static int on = -1;
+    if (on < 0) {
+        const char *e = cfg_get("NX2NAVI_GPU_WAIT");
+        on = !(e && *e && strcmp(e, "0") == 0);
+    }
+    return on;
+}
+
+int vk_sync_gpu_wait(uint64_t value, uint64_t timeout_ns) {
+    uint64_t p0 = perf_begin();
+    int ok = counter_wait(gpu_wait_on() ? &reached_gpu : &done, value, timeout_ns);
+    perf_end(PERF_FENCE, p0);
+    perf_gpu_wait(p0);
+    return ok;
+}
+
 uint64_t vk_sync_fence_done(void) { return __atomic_load_n(&done, __ATOMIC_ACQUIRE); }
 
+uint64_t vk_sync_gpu_done(void) { return __atomic_load_n(gpu_wait_on() ? &reached_gpu : &done, __ATOMIC_ACQUIRE); }
+
 uint64_t vk_sync_issued(void) { return __atomic_load_n(&issued, __ATOMIC_ACQUIRE); }
 
 void vk_sync_finish(void) {
