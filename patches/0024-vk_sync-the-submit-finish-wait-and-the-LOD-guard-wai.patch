diff --git a/runtime/nvn_api_core.c b/runtime/nvn_api_core.c
index 7855d15..e60b79b 100644
--- a/runtime/nvn_api_core.c
+++ b/runtime/nvn_api_core.c
@@ -673,7 +673,10 @@ NVN_API(nvnQueueSubmitCommands) {
     // frames, 3% of them in 100 s of dialogue; none with this wait, at the same 58-59 fps: the GPU is idle at that
     // point). Copies of the data at submit made it worse, a mix of two frames' versions.
     // NX2NAVI_SUBMIT_FINISH=<mask>: bit i waits after the i-th submission of a frame (default 0x1); a plain 1 waits
-    // after every submission, 0 never.
+    // after every submission, 0 never. The wait is for the GPU to be through with the submission (gpu_wait), not for
+    // its CPU side effects: the write-back of what it wrote into CPU-visible memory lands through the completion
+    // thread as for every unwaited submission, and a CPU read of such memory goes through nvnSyncWait / Finish or the
