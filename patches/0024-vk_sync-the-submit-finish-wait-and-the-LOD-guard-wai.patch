+// For waits that order the GPU's reads of guest memory before the CPU rewrites it, not for reading what the GPU wrote.
+int vk_sync_gpu_wait(uint64_t value, uint64_t timeout_ns);
+uint64_t vk_sync_gpu_done(void);           // highest value the GPU reached (done with NX2NAVI_GPU_WAIT=0)
 uint64_t vk_sync_issued(void);             // newest submitted value (the one being recorded is this + 1)
 void vk_sync_finish(void);                 // every submitted value done
 void vk_sync_shutdown(void);               // finish, stop the completion thread, free the command buffers
