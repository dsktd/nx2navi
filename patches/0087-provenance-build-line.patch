diff --git a/runtime/provenance.c b/runtime/provenance.c
new file mode 100644
index 0000000..9076ec0
--- /dev/null
+++ b/runtime/provenance.c
@@ -0,0 +1,116 @@
+// Build provenance: one line naming the entry point, exe, source commit, translator and every NX2NAVI_* setting of this
+// run, first in the log and as build.txt beside every dump, capture, shot and mark, so a symptom is never filed
+// against the wrong build. The commit is baked in at compile time (build-linux.py passes -DNX2NAVI_BUILD_COMMIT for this
+// file only); NX2NAVI_RUN_NAME names the entry point (the tooling's `just run <name>`, "-" when unset).
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+
+#ifdef _WIN32
+#define environ _environ
+#else
+extern char **environ;
+#endif
+
+#ifndef NX2NAVI_BUILD_COMMIT
+#define NX2NAVI_BUILD_COMMIT "unknown"
+#endif
+
+static char line[8192];
+
+static int cmp_str(const void *a, const void *b) { return strcmp(*(char *const *)a, *(char *const *)b); }
+
+// A value whose name looks like a credential is written as "<redacted>".
+static int secret_like(const char *name, size_t n) {
+    static const char *const words[] = {"KEY", "TOKEN", "SECRET", "PASS", "AUTH", "CRED"};
+    for (size_t w = 0; w < sizeof words / sizeof *words; w++)
+        for (size_t i = 0, k = strlen(words[w]); i + k <= n; i++)
+            if (!strncmp(name + i, words[w], k)) return 1;
+    return 0;
+}
+
+static void add(size_t *n, const char *fmt, const char *a, size_t alen) {
+    if (*n >= sizeof line - 1) return;
+    int k = snprintf(line + *n, sizeof line - *n, fmt, (int)alen, a);
+    *n = k < 0 ? *n : *n + (size_t)k < sizeof line ? *n + (size_t)k : sizeof line - 1;
+}
+
+// The translator: its folder's name and the first 12 digits of its identity (NX2NAVI_XLATE_ID, else <translator>.id as
+// gfx_shader.c xlate_identity reads it), e.g. "xlate-rebase/e7a4625221b1".
+static void xlate_part(size_t *n, const char *exe_dir) {
+    char p[PLAT_PATH_MAX + 16], id[16] = "";
+    const char *x = cfg_get("NX2NAVI_XLATE");
+    if (x && *x) snprintf(p, sizeof p, "%s", x);
+    else snprintf(p, sizeof p, "%s/nx2navi_xlate", exe_dir);
+    const char *ide = cfg_get("NX2NAVI_XLATE_ID");
+    if (ide && *ide) snprintf(id, sizeof id, "%.12s", ide);
+    else {
+        char q[PLAT_PATH_MAX + 32];
+        char *dot = strrchr(p, '.'), *sep = plat_last_sep(p);
+        snprintf(q, sizeof q, "%.*s.id", (int)(dot && dot > sep ? dot - p : (long)strlen(p)), p);
+        FILE *f = fopen(q, "r");
+        if (!f || !fgets(id, 13, f)) snprintf(id, sizeof id, "noid");
+        if (f) fclose(f);
+    }
+    char *sep = plat_last_sep(p);
+    const char *parent = "";
+    size_t plen = 0;
+    if (sep) {
+        *sep = 0;
+        char *s2 = plat_last_sep(p);
+        parent = s2 ? s2 + 1 : p, plen = strlen(parent);
+    }
+    add(n, " xlate=%.*s", parent, plen);
+    add(n, "/%.*s", id, strlen(id));
+}
+
+const char *rt_build_line(void) {
+    if (line[0]) return line;
+    size_t n = 0;
+    const char *entry = cfg_get("NX2NAVI_RUN_NAME");
+    if (!entry || !*entry) entry = "-";
+    add(&n, "build: entry=%.*s", entry, strlen(entry));
+    char exe[PLAT_PATH_MAX] = "?";
+    if (!plat_exe_path(exe, sizeof exe)) strcpy(exe, "?");
+    char *sep = plat_last_sep(exe), *base = sep ? sep + 1 : exe;
+    add(&n, " exe=%.*s", base, strlen(base));
+    add(&n, " commit=%.*s", NX2NAVI_BUILD_COMMIT, strlen(NX2NAVI_BUILD_COMMIT));
+    if (sep) *sep = 0;
+    xlate_part(&n, sep ? exe : ".");
+    add(&n, " knobs=%.*s", "", 0);
+    size_t count = 0;
+    for (char **e = environ; e && *e; e++) count += !strncmp(*e, "NX2NAVI_", 8);
+    char **v = count ? malloc(count * sizeof *v) : NULL;
+    size_t m = 0;
+    for (char **e = environ; v && e && *e; e++)
+        if (!strncmp(*e, "NX2NAVI_", 8)) v[m++] = *e;
+    if (v) qsort(v, m, sizeof *v, cmp_str);
+    for (size_t i = 0; i < m; i++) {
+        const char *eq = strchr(v[i], '=');
+        size_t nl = eq ? (size_t)(eq - v[i]) : strlen(v[i]);
+        add(&n, i ? ",%.*s" : "%.*s", v[i], nl);
+        if (eq) add(&n, "=%.*s", secret_like(v[i], nl) ? "<redacted>" : eq + 1, secret_like(v[i], nl) ? 10 : strlen(eq + 1));
+    }
+    if (!m) add(&n, "%.*s", "-", 1);
+    free(v);
+    return line;
+}
+
+void rt_build_note_file(const char *path) {
+    const char *l = rt_build_line();
+    char buf[sizeof line + 1];
+    size_t n = strlen(l);
+    memcpy(buf, l, n);
+    buf[n++] = '\n';
+    if (!plat_file_write(path, buf, n)) rt_log("build: cannot write %s", path);
+}
+
+void rt_build_note(const char *dir) {
+    char p[PLAT_PATH_MAX + 16];
+    snprintf(p, sizeof p, "%s/build.txt", dir);
+    rt_build_note_file(p);
+}
