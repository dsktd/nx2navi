diff --git a/runtime/vk_exec.h b/runtime/vk_exec.h
index a57b80e..dda261d 100644
--- a/runtime/vk_exec.h
+++ b/runtime/vk_exec.h
@@ -113,6 +113,8 @@ typedef struct VkExec {
     uint32_t fbl_mask;                   // attachments of the open pass in that layout: bit i colour i, bit 8 depth
     uint32_t fb_dirty;                   // attachments of the open pass written by a draw or clear since the pass began
                                          // or the last in-pass barrier
+    uint32_t fb_read;                    // attachments of the open pass a draw sampled (feedback layout) since the pass
+                                         // began or the last in-pass read-to-write barrier (feedback_war)
     const void *fb_fs;                   // feedback_scan's memo: fragment shader, texture bind serial, pass serial
     uint32_t fb_serial, fb_pass, fb_sampled;
     uint32_t tex_serial, pass_serial;    // bumped by every texture or image bind and pass begin
@@ -145,6 +147,9 @@ extern int vk_hdr_track;
 void vk_hdr_draw(VkExec *ex, const VkPipeInfo *info);
 // Scissor 0 clipped to the render area of the open pass; extent 0: nothing to draw.
 VkRect2D vk_exec_scissor(const VkExec *ex);
+// vk_exec_draw.c: orders the open pass's earlier sampled reads of the attachments in written (bit i colour i, bit 8
+// depth) before a draw or clear writes them; nothing when none of them was sampled since the last such barrier.
+void vk_exec_feedback_war(VkExec *ex, uint32_t written);
 void vk_exec_noatt_dims(const VkExec *ex, uint32_t *w, uint32_t *h);   // pass size when no attachment is set
 // 1: every target of the current pass (any 1: at least one, and not only the depth target while a colour target is
 // rendered for the first time) was rendered in the previous presented frame (per-frame targets); 0 otherwise, or when
@@ -159,6 +164,8 @@ typedef struct {
     uint64_t fb_draws, fb_barriers, fb_restarts, fb_layouts;   // feedback loops: draws sampling a written target of
                                                                // their pass, in-pass barriers, pass restarts, layout
                                                                // transitions
+    uint64_t fb_war_barriers;            // in-pass barriers before a write to a target an earlier draw sampled
+    uint64_t ub_updates, ub_pass_breaks; // inline uniform updates, and those that ended an open pass
 } VkExecFrame;
 extern VkExecFrame vk_exec_frame;
 void vk_exec_frame_written(const tex_t *t);                    // vk_texture_gpu_written: t rendered or copied into
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index 4f5bf4a..ed040f2 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -1499,13 +1499,45 @@ static void feedback_barrier(VkExec *ex) {
     vk_exec_frame.fb_barriers++;
 }
 
-// Marks the attachments the draw with state s writes: colour targets with a nonzero effective write mask, depth with
-// depth writes or the stencil test on.
-static void feedback_written(VkExec *ex, const VkPipeState *s) {
-    if (vk_ctx()->feedback == VK_FEEDBACK_OFF) return;
-    if (ex->depth.image && !(ex->fb_dirty & 0x100) && ((s->ds.dt && s->ds.dw) || s->ds.st)) ex->fb_dirty |= 0x100;
+// Write after read inside the open pass: the GPU orders attachment writes after earlier attachment writes, not after
+// earlier draws' texture reads of the same image (feedback layout), so a draw or clear writing a target an earlier
+// draw of the pass sampled could land before those reads finish and they read the new value (a band of the picture
+// a frame out: the fog's flat colour, a dark shadow band). A by-region barrier from fragment shader reads to
+// attachment writes orders them; written: the attachments about to be written (bit i colour i, bit 8 depth).
+void vk_exec_feedback_war(VkExec *ex, uint32_t written) {
+    if (!(written & ex->fb_read)) return;
+    VkMemoryBarrier2 mb = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+                           .srcStageMask = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT,
+                           .srcAccessMask = VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+                           .dstStageMask = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                           VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT,
+                           .dstAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT};
+    VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .dependencyFlags = VK_DEPENDENCY_BY_REGION_BIT,
+                           .memoryBarrierCount = 1, .pMemoryBarriers = &mb};
+    vkCmdPipelineBarrier2(ex->cb, &di);
+    ex->recorded++;
+    ex->fb_read = 0;
+    vk_exec_frame.fb_war_barriers++;
+}
+
+// The attachments the draw with state s writes: colour targets with a nonzero effective write mask, depth with depth
+// writes or the stencil test on.
+static uint32_t feedback_writes(const VkExec *ex, const VkPipeState *s) {
+    uint32_t w = ex->depth.image && ((s->ds.dt && s->ds.dw) || s->ds.st) ? 0x100u : 0;
     for (uint32_t i = 0; i < ex->pass_ncolor; i++)
-        if (ex->color[i].image && !(ex->fb_dirty >> i & 1) && vk_pipeline_target_wmask(s, (int)i)) ex->fb_dirty |= 1u << i;
+        if (ex->color[i].image && vk_pipeline_target_wmask(s, (int)i)) w |= 1u << i;
+    return w;
+}
+
+// Marks the attachments the draw with state s writes, after ordering them behind earlier draws' reads of them
+// (vk_exec_feedback_war); sampled: what this draw itself samples in the feedback layout, which a later write must wait
+// for in turn (a draw reading and writing one target is the game's own feedback loop, ordered by region as it is).
+static void feedback_written(VkExec *ex, const VkPipeState *s, uint32_t sampled) {
+    if (vk_ctx()->feedback == VK_FEEDBACK_OFF) return;
+    uint32_t w = feedback_writes(ex, s);
+    vk_exec_feedback_war(ex, w);
+    ex->fb_dirty |= w;
+    ex->fb_read |= sampled;
 }
 
 static void tex_info_full(VkExec *ex, const GfxShaderRes *r, uint64_t h, int storage, int separate,
@@ -3172,7 +3204,7 @@ static int prepare_draw_ex(VkExec *ex, int prim, int32_t count, int restart, int
     repeat_stats(ex, info);
     bind_resources(ex, info);
     if (fbl & ex->fb_dirty) feedback_barrier(ex);
-    feedback_written(ex, &s);
+    feedback_written(ex, &s, fbl);
     if (!mesh) bind_vertex_buffers(ex);
     if (vk_dump_armed && (!mesh || vk_dump_mesh)) vk_dump_draw(ex, &s, p, info);
     if (__atomic_load_n(&vk_pick_armed, __ATOMIC_RELAXED)) vk_pick_note(&s, info);
@@ -4513,6 +4545,8 @@ static void op_update_ub(VkExec *ex, const p_update_ub *u) {
     VkMemSpan sp;
     if (!vk_mem_resolve(u->dst, u->size, &sp)) return warn_once(W_UB, "UpdateUniformBuffer to %#llx is not backed: dropped", (unsigned long long)u->dst);
     cb_res(ex);
+    vk_exec_frame.ub_updates++;
+    if (ex->in_pass) vk_exec_frame.ub_pass_breaks++;
     vk_exec_barrier(ex);   // earlier draws finished with the old contents
     VkBuffer b;
     VkDeviceSize o;
diff --git a/runtime/vk_sync.c b/runtime/vk_sync.c
index 01a97f1..8e8eaf4 100644
--- a/runtime/vk_sync.c
+++ b/runtime/vk_sync.c
@@ -282,11 +282,15 @@ static void completion_main(void *arg) {
             plat_mutex_lock(&st_lock);
         }
         if (reached > done) {
+            // The waiters go first (a fence wait, the frame's first submission, the acquire): freeing what the
+            // finished submissions held (vk_mem_collect: upload batches, destroyed images, views and buffers, each
