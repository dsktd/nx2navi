+    }
+    if (fw.state == F_WARP) {
+        if (dbg_busy()) {   // not found before: the area's file may be read only for the change
+            if (fw.exact > 0 && !fw.patched_n && fw.tries < 12 && tick >= fw.at) follow_exact(), fw.at = tick + 15;
+            return;
