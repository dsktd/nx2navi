+        float p[3] = {0, 0, 0};
+        uint8_t young = 0;
+        uint64_t ch = gmd_entry(0, 0x18, hash_of("Sequence_IsChildhood"));
+        int has_age = ch && rd(ch + 0x16, &young, 1);
+        const char *e = cfg_get("NX2NAVI_STATE_WARP_M");
