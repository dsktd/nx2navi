+        dx = p[0] - fw.xyz[0], dy = p[1] - fw.xyz[1], dz = p[2] - fw.xyz[2];
+        if (here && sqrtf(dx * dx + dy * dy + dz * dz) <= near_m && (fw.child < 0 || !has_age || (young & 1) == fw.child)) {
+            fw.state = F_LAND, fw.at = tick + 2;
