+static void follow_tick(Cpu *c, uint64_t tick) {
+    static int knob = -1;
+    static uint64_t after;
+    if (knob < 0) {
+        const char *e = cfg_get("NX2NAVI_STATE_FOLLOW");
+        knob = e && *e;
+        // taken once Link has been there NX2NAVI_STATE_FOLLOW_TICK (default 60) ticks; "req": only at follow.req
+        if (knob && strcmp(e, "req")) dbg_follow(e);
+        const char *x = cfg_get("NX2NAVI_STATE_EXACT"), *cm = cfg_get("NX2NAVI_STATE_CAM"), *at = cfg_get("NX2NAVI_STATE_FOLLOW_TICK");
+        fw.exact = x && *x ? atoi(x) : 2, fw.cam_on = cm && *cm ? atoi(cm) : 1, after = at && *at ? strtoull(at, NULL, 10) : 60;
+    }
+    if (fw.state == F_IDLE) {
+        if (tick < after || dbg_busy() || !__atomic_exchange_n(&fw.asked, 0, __ATOMIC_ACQ_REL)) return;
+        if (dbg_names(NULL) != 2) {   // the start positions come with the flag names
+            dbg_flags_refresh(), dbg_names(NULL), __atomic_store_n(&fw.asked, 1, __ATOMIC_RELEASE);
+            return;
+        }
+        if (follow_read())
