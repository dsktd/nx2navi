+        }
+        if (fw.child >= 0 && has_age && (young & 1) != fw.child) {
+            rt_call(c, MOD_MAIN_BASE + 0x682b20, 3, gmd(), (uint64_t)fw.child, (uint64_t)hash_of("Sequence_IsChildhood"));
+            rt_log("follow: age %s (Sequence_IsChildhood) before the teleport", fw.child ? "child" : "adult");
+        }
+        int best = -1;
+        float best_d = 0;
+        for (int i = 0; i < dbg_places(); i++) {
+            if (strcmp(places[i].area, fw.area) || !places[i].has_xyz) continue;
+            float ax = places[i].xyz[0] - fw.xyz[0], ay = places[i].xyz[1] - fw.xyz[1], az = places[i].xyz[2] - fw.xyz[2];
+            float d = sqrtf(ax * ax + ay * ay + az * az);
+            if (best < 0 || d < best_d) best = i, best_d = d;
+        }
+        if (best < 0) {
