+        if (fw.has_cam && fw.cam_on && dbg_freecam_available()) {
+            dbg_freecam_set(1, 0, 8.0f);
+            for (int i = 0; i < 3; i++) fc.pos[i] = fw.cam[i];
+            fc.yaw = (float)fw.cam[3], fc.pitch = (float)fw.cam[4], fc.reach = fw.cam[5] >= 1 && fw.cam[5] <= 50 ? fw.cam[5] : 5;
+            fc.capture = 0;
+        }
+        float p[3] = {0, 0, 0}, yaw = 0;
+        char now[64] = "";
+        text_get("Sequence_CurrentBanc", now);
+        int has_pos = dbg_player_pos(p), has_yaw = player_yaw(&yaw);
+        float dx = p[0] - fw.xyz[0], dy = p[1] - fw.xyz[1], dz = p[2] - fw.xyz[2];
+        float dyaw = has_yaw && fw.has_face ? fabsf(fmodf(yaw * 57.29578f - fw.face + 540.0f, 360.0f) - 180.0f) : -1;
+        rt_log("follow: done in %.1f s: area %s (%s), Link %s %.2f m from the recipe's place, facing %.1f deg off; start "
+               "position %s, its Trans found %d and Rot %d times (%d places replaced, %d searches); game data %d changed "
+               "after the arrival; camera %s",
+               (double)(plat_now_ns() - fw.t0) / 1e9, now, strcmp(now, fw.area) ? "NOT the recipe's" : "the recipe's",
+               has_pos ? "stands" : "is not seen,", has_pos ? sqrtf(dx * dx + dy * dy + dz * dz) : -1.0f, dyaw,
+               fw.start[0] ? fw.start : "-", fw.hits[0], fw.hits[1], patched, fw.tries, fw.applied,
+               fw.has_cam && fw.cam_on ? "the recipe's (free camera)" : "the game's own");
+        fw.start[0] = 0;
+        fw.state = F_IDLE;
+    }
+}
