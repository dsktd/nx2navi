+            fw.state = F_LAND, fw.at = tick;
+            return;
+        }
+        snprintf(fw.start, sizeof fw.start, "%s", places[best].pos);
+        memcpy(fw.start_xyz, places[best].xyz, 12), memcpy(fw.start_rot, places[best].rot, 12);
+        fw.start_has_rot = places[best].has_rot;
+        fw.state = F_AGE, fw.at = tick + 4;   // the flag setter's changes are made at the manager's next update
+        return;
+    }
+    if (fw.state == F_AGE && tick >= fw.at) {
+        follow_exact();
+        dbg_warp(fw.area, fw.start);
+        fw.state = F_WARP, fw.at = tick + 15;
