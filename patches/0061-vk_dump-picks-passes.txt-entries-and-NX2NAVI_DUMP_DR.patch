From fa69949758a26e5448b3ef357b27d4c59130d294 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:17:26 -0500
Subject: [PATCH] vk_dump: picks, passes.txt entries and NX2NAVI_DUMP_DRAWS
 lines list the vertex attributes the vertex shader reads (format, offset,
 stream) and their streams' guest address, size, stride and divisor; indexed
 draws name the index range (#164, #165)

---
 runtime/vk_dump.c      | 24 ++++++++++++++++++++++++
 runtime/vk_exec_draw.c | 12 ++++++++----
 2 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/runtime/vk_dump.c b/runtime/vk_dump.c
index 93f5d30..7c4d0ef 100644
--- a/runtime/vk_dump.c
+++ b/runtime/vk_dump.c
@@ -888,6 +888,27 @@ static void cbank_list(Str *b, const VkExec *ex, const VkPipeInfo *info) {
     }
 }
 
+// "  vertex: a<loc> fmt <nvn format> +<offset> vb<stream>, ... | vb<s>=<addr>+<size> stride <n> divisor <d> ..." for
+// the attributes the vertex shader reads and the streams they use (guest addresses: watch.req / peek.req targets).
+static void vertex_list(Str *b, const VkExec *ex, const GfxShader *vs) {
+    GfxShaderIo io[32];
+    uint32_t in = vs ? gfx_shader_inputs(vs, io) : 0, streams = 0;
+    sp(b, "  vertex:");
+    for (int i = 0; i < 16; i++) {
+        if (!(in >> i & 1)) continue;
+        va_st a;
+        memcpy(&a, &ex->pipe.vattr[i], sizeof a);
+        sp(b, " a%d fmt %#x +%#x vb%u", i, a.fmt, a.offset, a.stream);
+        if (a.stream < 16) streams |= 1u << a.stream;
+    }
+    sp(b, " |");
+    for (int s = 0; s < 16; s++)
+        if (streams >> s & 1)
+            sp(b, " vb%d=%#llx+%#llx stride %u divisor %u", s, (unsigned long long)ex->vbuf[s].address,
+               (unsigned long long)ex->vbuf[s].size, ex->pipe.vstream[s].stride, ex->pipe.vstream[s].divisor);
+    sp(b, "\n");
+}
+
 static uint64_t bindings_hash(const VkExec *ex, const VkPipeInfo *info) {
     uint64_t h = 0xcbf29ce484222325ull;
     for (uint32_t i = 0; i < info->n_bindings; i++) {
@@ -1017,6 +1038,7 @@ void vk_dump_draw(VkExec *ex, const VkPipeState *s, VkPipeline p, const VkPipeIn
            (unsigned long long)shader_hash(s->vs), (unsigned long long)shader_hash(s->fs), vk_dump_draw_args);
         cbank_list(&draw_lines, ex, info);
         sp(&draw_lines, "\n");
+        vertex_list(&draw_lines, ex, s->vs);
     }
     if (pipe >= 0) {
         ents[pipe].draws++;
@@ -1044,6 +1066,7 @@ void vk_dump_draw(VkExec *ex, const VkPipeState *s, VkPipeline p, const VkPipeIn
     sp(&b, "    depth: test %u write %u func %u; alpha func %u; cull %u; a2c %u; samples %u; mesh task %d\n", (unsigned)s->ds.dt,
        (unsigned)s->ds.dw, (unsigned)s->ds.df, (unsigned)s->color.alpha_func, (unsigned)s->poly.cull, (unsigned)s->ms.a2c,
        (unsigned)s->samples, s->ts != NULL);
+    if (!mesh) vertex_list(&b, ex, s->vs);
     describe_bindings(&b, ex, info);
     ents[nents++] = (Ent){p, th, 1, b.s};
 out:
@@ -1712,6 +1735,7 @@ int vk_pick_pre(VkExec *ex) {
        vk_dump_draw_args);
     cbank_list(&b, ex, info);
     sp(&b, "\n");
+    vertex_list(&b, ex, pick_vs);
     describe_bindings(&b, ex, info);
     r->text = b.s;
     pick_sc = sc, pick_q = pick_n++;
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index ef14a2a..d0a48ec 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -5698,6 +5698,9 @@ int vk_mvobj_execute(VkExec *ex, uint64_t cam, VkImageView mv, VkImageView depth
     return 1;
 }
 
+extern char vk_dump_draw_args[128];   // vk_dump.c, NX2NAVI_DUMP_DRAWS
+#define DUMP_ARGS(...) do { if ((vk_dump_armed && vk_dump_active()) || __atomic_load_n(&vk_pick_armed, __ATOMIC_RELAXED)) snprintf(vk_dump_draw_args, sizeof vk_dump_draw_args, __VA_ARGS__); } while (0)
+
 // NVN2 mesh draws (DrawMeshTasks): count task workgroups, or mesh workgroups for a program without a task stage, through
 // VK_EXT_mesh_shader. The stages are the translator's TaskEXT / MeshEXT modules (tools/xlate/MeshSpirv.cs).
 // The lazy lookups below store the pointer before the flag that says it was looked up: the chunks of a parallel
@@ -6059,6 +6062,7 @@ static void op_draw_mesh(VkExec *ex, const p_draw_mesh *d) {
     }
     if (!fn) return warn_once(W_MESH, "mesh draws need VK_EXT_mesh_shader (mesh_emulation = 1 emulates them): skipped");
     ex->dc->c0_binst = 0;
+    DUMP_ARGS("mesh workgroups %u", d->count);
     if (!prepare_draw_ex(ex, NVN_DRAW_PRIMITIVE_TRIANGLES, 0x7fffffff, 0, 1)) return;
     if (d->first) warn_once(W_MESH, "a mesh draw from workgroup %u: drawn from workgroup 0", d->first);
     vk_exec_frame.draws++;
@@ -6267,6 +6271,7 @@ static void op_draw_mesh_ind(VkExec *ex, const p_draw_mesh_ind *d) {
         return;
     }
     VkDeviceSize at;
+    DUMP_ARGS("mesh indirect args %#llx", (unsigned long long)d->ind);
     if (!mesh_ring_entry(ex, ex->cb, d, &ip, &at)) return warn_once(W_MESH, "the indirect mesh ring could not be created: skipped");
     if (!prepare_draw_ex(ex, NVN_DRAW_PRIMITIVE_TRIANGLES, 0x7fffffff, 0, 1)) return;
     vk_exec_frame.draws++;
@@ -6643,8 +6648,6 @@ static void bind_index(VkExec *ex, const void *data, uint64_t bytes, VkIndexType
     ex->recorded++;
 }
 
-extern char vk_dump_draw_args[128];   // vk_dump.c, NX2NAVI_DUMP_DRAWS
-#define DUMP_ARGS(...) do { if (vk_dump_armed && vk_dump_active()) snprintf(vk_dump_draw_args, sizeof vk_dump_draw_args, __VA_ARGS__); } while (0)
 
 static void op_draw(VkExec *ex, const p_draw *d) {
     ex->dc->c0_binst = (uint32_t)d->base_instance;
@@ -6701,8 +6704,9 @@ static void op_draw_idx(VkExec *ex, const p_draw_idx *d) {
     static const uint32_t isize[3] = {1, 2, 4};
     if (d->itype < 0 || d->itype > 2) return warn_once(W_INDEX, "index type %d is unknown: draw skipped", d->itype);
     int restart = restart_for(ex, d->prim, d->itype);
-    DUMP_ARGS("indexed prim %d itype %d count %d inst %d base_vtx %d base_inst %d ib %#llx", d->prim, d->itype, d->count,
-              d->instances, d->base_vertex, d->base_instance, (unsigned long long)d->ibuf);
+    DUMP_ARGS("indexed prim %d itype %d count %d inst %d base_vtx %d base_inst %d ib %#llx+%#llx", d->prim, d->itype,
+              d->count, d->instances, d->base_vertex, d->base_instance, (unsigned long long)d->ibuf,
+              (unsigned long long)d->count * isize[d->itype]);
     if (d->count <= 0 || !prepare_draw(ex, d->prim, d->count, restart)) return;
     vk_exec_frame.draws++;
     uint64_t bytes = (uint64_t)d->count * isize[d->itype];
-- 
