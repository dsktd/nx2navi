+    memcpy(ex->fbl_aspect, cur.fbl_aspect, sizeof ex->fbl_aspect);
+    ex->nfbl = cur.nfbl, ex->fbl_mask = 0, ex->fb_dirty = 0, ex->fb_fs = NULL;
+    ex->tex_serial = cur.tex_serial + 1, ex->pass_serial = cur.pass_serial + 1;
+    ex->dirty = VK_EXEC_DIRTY_ALL;
