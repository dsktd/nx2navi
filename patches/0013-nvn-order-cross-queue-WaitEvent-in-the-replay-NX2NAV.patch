+// State across a cut submission (nvn_api_cmd.c "event waits"): the held part resumes with the state its queue had at
+// the cut, not what the submissions issued in between left. Per command buffer fields stay this command buffer's.
+static VkExec *exec_slots[NVN_EXEC_SLOTS];
+static void state_save(VkExec *ex, int slot) {
+    if (slot >= NVN_EXEC_SLOTS) rt_fatal("vk: state slot %d", slot);
+    if (!exec_slots[slot] && !(exec_slots[slot] = malloc(sizeof *ex))) rt_fatal("vk: out of memory (state slot)");
+    *exec_slots[slot] = *ex;
+}
+static void state_restore(VkExec *ex, int slot) {
+    if (slot >= NVN_EXEC_SLOTS || !exec_slots[slot]) rt_fatal("vk: state slot %d was never saved", slot);
+    vk_exec_pass_end(ex);
+    VkExec cur = *ex;
+    *ex = *exec_slots[slot];
+    ex->cb = cur.cb, ex->fence = cur.fence, ex->recorded = cur.recorded, ex->in_pass = 0;
+    ex->mark = cur.mark, ex->mark_draws0 = cur.mark_draws0;
+    ex->mark_passes = cur.mark_passes, ex->mark_dispatches = cur.mark_dispatches;
+    ex->views = cur.views, ex->nviews = cur.nviews, ex->cap_views = cur.cap_views, ex->barrier_at = cur.barrier_at;
