-    if (slot >= NVN_EXEC_SLOTS || !exec_slots[slot]) rt_fatal("vk: state slot %d was never saved", slot);
+// The replay goes on in this command buffer with the queue state of *to; per command buffer fields stay as they are.
+static void state_switch(VkExec *ex, const VkExec *to) {
     vk_exec_pass_end(ex);
