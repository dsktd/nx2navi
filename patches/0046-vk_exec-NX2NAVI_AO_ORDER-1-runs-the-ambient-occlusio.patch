     if (ew_on < 0) {
         const char *e = cfg_get("NX2NAVI_EVENT_WAITS");
@@ -1533,6 +1551,7 @@ uint64_t nvn_submit_ordered(const void *q, const uint64_t *h, int n) {
     uint64_t f;
     if (!ew_on) {
         f = ew_issue(hs, n, NULL, -1);
+        keep_waiting(hs, n);
     } else if (ew_queue_held(q, ew_n)) {   // behind its queue's held work
         ew_hold(q, hs, n, NULL, -1, NULL);
         f = 0;
diff --git a/runtime/vk_exec.c b/runtime/vk_exec.c
