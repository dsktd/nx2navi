 VkImageView vk_exec_target_view(const VkTexImage *img, VkFormat format, VkImageViewType type, uint32_t aspect,
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index f7ee213..6e26354 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -1859,6 +1859,12 @@ static uint64_t ao_hash(const GfxShader *sh) {
     return h;
 }
 
+// The ambient occlusion chain: the occlusion compute and its two blur shaders (horizontal, vertical).
+static int ao_chain(const GfxShader *cs) {
+    uint64_t h = ao_hash(cs);
+    return h == 0x561cf523be84578bull || h == 0xcd6ddba0e3074332ull || h == 0x8b563e79bcdf41ecull;
+}
+
 // NX2NAVI_AO=0: no ambient occlusion. The occlusion compute's result is overwritten with 1 (no occlusion) right after
 // its dispatch, so its blur and the lighting resolve see an unoccluded picture: a steady fallback while the occlusion
 // reads the previous frame's depth (the replay runs it before the frame's depth pass). 1 (the default): the game's own.
@@ -4361,6 +4367,7 @@ static void op_dispatch(VkExec *ex, const p_dispatch *d) {
     VkPipeline p = vk_pipeline_compute(cs, &info);
     if (!p || !info) return warn_once(W_PIPELINE, "a compute pipeline could not be created: dispatches with it are skipped");
     if ((info->pool && !pool_on()) || shader_skipped(cs)) return;   // NX2NAVI_POOL=0, NX2NAVI_SKIP_SHADERS
+    if (vk_exec_rerun && !ao_chain(cs)) return;   // NX2NAVI_AO_ORDER: the second run after the event is the occlusion's alone
     vk_exec_barrier(ex);   // ends the pass; earlier writes are visible to the shader
     bind_pipeline(ex, VK_PIPELINE_BIND_POINT_COMPUTE, p);
     c0_dim[0] = (uint32_t)d->x, c0_dim[1] = (uint32_t)d->y, c0_dim[2] = (uint32_t)d->z;
