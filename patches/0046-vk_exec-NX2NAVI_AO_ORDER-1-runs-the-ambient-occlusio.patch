+// NX2NAVI_AO_ORDER=1 (vk_exec.c "ambient occlusion after its event"): the replay reads a recording that waits for an
+// event once more when a later submission signals it, so such a recording lives until 64 more submissions are replayed
+// (the replay forgets a wait after 24).
+static void keep_waiting(const uint64_t *h, int n) {
+    static int on = -1;
+    if (on < 0) on = rt_knob("AO_ORDER", "0") && gfx_replay_async();
+    if (!on) return;
+    for (int i = 0; i < n; i++)
+        for (const op_hdr *o = nvn_op_first(h[i]); o->op != OP_END; o = nvn_op_next(o)) {
+            if (o->op != OP_WAIT_EVENT) continue;
+            plat_mutex_lock(&copy_lock);
+            __atomic_store_n(&((copy_prefix *)(uintptr_t)h[i] - 1)->used_at, __atomic_load_n(&nsubmits, __ATOMIC_RELAXED) + 64,
+                             __ATOMIC_RELAXED);
+            plat_mutex_unlock(&copy_lock);
+            break;
+        }
+}
+
