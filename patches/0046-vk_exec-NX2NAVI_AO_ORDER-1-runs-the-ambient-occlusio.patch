+static void state_restore(VkExec *ex, int slot) {
+    if (slot >= NVN_EXEC_SLOTS || !exec_slots[slot]) rt_fatal("vk: state slot %d was never saved", slot);
+    state_switch(ex, exec_slots[slot]);
     vk_usnap_restore(slot);
 }
 
+// ---- ambient occlusion after its event (NX2NAVI_AO_ORDER=1)
+// The game's worker queues wait (WaitEvent) for the frame's main submission to signal that the half-resolution depth
+// is written, then compute the ambient occlusion from it; the main submission's lighting resolve samples the result.
+// Replayed in submission order the occlusion ran before the frame's depth pass and read the previous frame's depth:
+// right while nothing moves, but one frame behind whatever moves on screen (a turning camera, swaying plants), where
+// the resolve's depth-aware filter then finds no matching occlusion, so the shading comes and goes with the motion.
+// Here the replay notes each wait whose value was not signalled yet, with the queue state at that point; the
+// submission still runs to its end as before. When a later submission signals that value, the replay runs the
+// occlusion dispatches recorded after the wait once more, right after the signal op, with the noted state, and then
+// goes on with the signalling submission: the occlusion now reads this frame's depth and overwrites the early result
+// before the resolve samples it. Only binds and the occlusion dispatches are replayed again (vk_exec_rerun_wanted in
+// vk_exec_draw.c); everything else behind the wait ran once, in its old place. No submission is cut (the event waits
+// of nvn_api_cmd.c cut and hold whole submissions, which changed fences and the picture). The submit call keeps the
+// waiting recording alive for the signal (nvn_submit_ordered). Uniform blocks of the second run that the signalling
+// submission's snapshot does not hold are read from live memory (vk_usnap.c).
+#define WAITS_MAX 8
+typedef struct { const op_hdr *at; const volatile uint32_t *val; uint32_t value; uint64_t sub; VkExec st; } WaitNote;
+static WaitNote *wait_notes;
+static int n_wait_notes, ao_order = -1;
+static uint64_t replay_subs, ao_reruns;
+static struct { const volatile uint32_t *val; uint32_t value; } signalled[16];
+static int n_signalled;
+int vk_exec_rerun;   // vk_exec_draw.c: only the occlusion dispatches run
+
+static int vk_exec_ao_order(void) {
+    if (ao_order < 0) {
+        ao_order = rt_knob("AO_ORDER", "0") && gfx_replay_async();
+        rt_log("vk: ambient occlusion %s (NX2NAVI_AO_ORDER%s)", ao_order ? "runs again after the event it waits for" : "in submission order",
+               rt_knob("AO_ORDER", "0") && !ao_order ? "=1 needs NX2NAVI_REPLAY_ASYNC=1" : "");
+    }
+    return ao_order;
+}
+
+static void wait_note(VkExec *ex, const op_hdr *h) {
+    const p_wait_event *w = nvn_op_payload(h);
+    if (w->mode != 0) return;   // EQUAL waits only: the frame counter events
+    for (int i = 0; i < n_signalled; i++)
+        if (signalled[i].val == w->val && signalled[i].value == w->value) return;   // already signalled: in order
+    if (!wait_notes && !(wait_notes = malloc(sizeof *wait_notes * WAITS_MAX))) rt_fatal("vk: out of memory (wait notes)");
+    if (n_wait_notes == WAITS_MAX) memmove(wait_notes, wait_notes + 1, sizeof *wait_notes * --n_wait_notes);
+    WaitNote *n = &wait_notes[n_wait_notes++];
+    n->at = nvn_op_next(h), n->val = w->val, n->value = w->value, n->sub = replay_subs, n->st = *ex;
+}
+
+// Binds and dispatches from h to the end of its recording (called recordings are not followed: only the waiting
+// recording itself is kept alive); the dispatch handler runs only the occlusion's.
+static void walk_again(VkExec *ex, const op_hdr *h) {
+    for (;;) {
+        const void *a = nvn_op_payload(h);
+        switch (h->op) {
+        case OP_END: return;
+        case OP_JUMP: h = (const op_hdr *)(uintptr_t)((const p_jump *)a)->target; continue;
+        case OP_SET_TEX_POOL: ex->tex_pool = ((const p_set_pool *)a)->pool, ex->tex_serial++; break;
+        case OP_SET_SAMP_POOL: ex->samp_pool = ((const p_set_pool *)a)->pool; break;
+        case OP_BARRIER: vk_exec_barrier(ex); break;
+        case OP_DISPATCH:
+        case OP_BIND_PROGRAM: case OP_BIND_UBO: case OP_BIND_SSBO: case OP_BIND_TEX: case OP_BIND_SAMP: case OP_BIND_IMG:
+        case OP_PUSH_CC:
+            vk_exec_op_draw(ex, h->op, a);
+            break;
+        default: break;
+        }
+        h = nvn_op_next(h);
+    }
+}
+
+static void signal_seen(VkExec *ex, const p_signal_event *s) {
+    if (s->mode != 0) return;
+    int k = 0;
+    for (; k < n_signalled && signalled[k].val != s->val; k++) {}
+    if (k == n_signalled && n_signalled < 16) n_signalled++;
+    if (k < 16) signalled[k].val = s->val, signalled[k].value = s->value;
+    static VkExec back;   // replay thread only
+    int kept = 0;
+    for (int i = 0; i < n_wait_notes; i++) {
+        WaitNote *n = &wait_notes[i];
+        if (n->val != s->val) {   // another event's wait: kept while its recording lives (nvn_submit_ordered)
+            if (replay_subs - n->sub <= 24) wait_notes[kept++] = *n;
+            continue;
+        }
+        if (n->value != s->value || replay_subs - n->sub > 24) continue;   // an older frame's wait: dropped
+        back = *ex;
+        state_switch(ex, &n->st);
+        vk_exec_rerun = 1;
+        walk_again(ex, n->at);
+        vk_exec_rerun = 0;
+        state_switch(ex, &back);
+        if (!(++ao_reruns % 3600)) rt_log("vk: ambient occlusion ran again after its event %llu times", (unsigned long long)ao_reruns);
+    }
+    n_wait_notes = kept;
+}
+
 static void walk(VkExec *ex, const op_hdr *h, int depth) {
     for (;;) {
         if (h->size < sizeof *h || (h->size & 7) || h->op >= OP_COUNT_)
@@ -900,6 +996,7 @@ static void walk(VkExec *ex, const op_hdr *h, int depth) {
         case OP_BEGIN: break;
         case OP_WAIT_EVENT:   // a cut of nvn_submit_ordered: this part ends here, the held rest resumes with the state
             if (((const p_wait_event *)a)->slot >= 0) { state_save(ex, ((const p_wait_event *)a)->slot); return; }
+            if (!depth && vk_exec_ao_order()) wait_note(ex, h);
             break;
         case OP_EXEC_STATE:
             if (((const p_exec_state *)a)->slot >= 0) state_restore(ex, ((const p_exec_state *)a)->slot);
@@ -979,6 +1076,7 @@ static void walk(VkExec *ex, const op_hdr *h, int depth) {
                         state_save(ex, s);
                         return;
                     }
+            if (h->op == OP_SIGNAL_EVENT && vk_exec_ao_order()) signal_seen(ex, a);
             break;
         default: rt_fatal("vk: op %s has no replay handler", nvn_op_name(h->op));
         }
@@ -1006,6 +1104,7 @@ int vk_exec_record(VkCommandBuffer cb, const uint64_t *handles, int n, uint64_t
     ex->barrier_at = -1;
     ex->nfbl = 0;   // the previous command buffer ended with a full barrier: every image is in GENERAL
     vk_exec_frame.submits++;
+    replay_subs++;
     split_draws = part_start = 0;
     part_t0 = kern_now_ns();
     x_here = 1;
