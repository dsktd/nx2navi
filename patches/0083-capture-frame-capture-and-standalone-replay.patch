+
+// ---- frame capture (vk_capture.c): every pool record, in address order, under pool_lock. kind 0 import, 1 physical,
+// 2 virtual; buf: the buffer the GPU reads (a physical pool's device memory; VK_NULL_HANDLE for the others). A virtual
+// pool's mapping comes as runs of map (nvn_mapping_t, physical_pool = the physical pool's key).
+void vk_mem_capture_pools(void (*fn)(void *ctx, const pool_t *key, int kind, uint32_t flags, uint64_t lo, uint64_t size,
+                                     VkBuffer buf, const void *map, int nmap),
+                          void *ctx) {
+    plat_mutex_lock(&pool_lock);
+    for (int i = 0; i < pool_index.n; i++) {
+        const PoolRec *r = pool_index.e[i].buf;
+        nvn_mapping_t *map = NULL;
+        int nmap = 0;
+        if (r->kind == POOL_VIRT) {
+            map = calloc(r->npages ? r->npages : 1, sizeof *map);
+            if (!map) rt_fatal("vk: out of memory (capture)");
+            for (uint64_t k = 0; k < r->npages;) {
+                const VPage *v = &r->pt[k];
+                uint64_t j = k + 1;
+                while (j < r->npages && r->pt[j].phys == v->phys &&
+                       (!v->phys || r->pt[j].off == v->off + (j - k) * NVN_VPOOL_PAGE))
+                    j++;
+                if (v->phys)
+                    map[nmap++] = (nvn_mapping_t){.physical_pool = (const NVNmemoryPool *)(const void *)v->phys->key,
+                                                  .physical_offset = (int64_t)v->off,
+                                                  .virtual_offset = (int64_t)(k * NVN_VPOOL_PAGE),
+                                                  .size = (j - k) * NVN_VPOOL_PAGE};
+                k = j;
+            }
+        }
+        fn(ctx, r->key, r->kind == POOL_IMPORT ? 0 : r->kind == POOL_PHYS ? 1 : 2, r->flags, r->lo, r->size,
+           r->kind == POOL_PHYS ? r->buf : VK_NULL_HANDLE, map, nmap);
+        free(map);
+    }
+    plat_mutex_unlock(&pool_lock);
+}
