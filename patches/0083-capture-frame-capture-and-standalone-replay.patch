+// The queue state a captured frame starts from (vk_capture.c): fixed-function and pipeline state objects, bindings and
+// pools as the op stream left them. Render targets, shaders and Vulkan objects stay this run's own.
+void vk_exec_state_load(const VkExec *s) {
+    VkExec *ex = &X;
+    memcpy(ex->vp, s->vp, sizeof ex->vp), ex->has_vp = s->has_vp;
+    ex->scissor = s->scissor, ex->has_scissor = s->has_scissor;
+    memcpy(ex->depth_range, s->depth_range, sizeof ex->depth_range);
+    memcpy(ex->st_vmask, s->st_vmask, sizeof ex->st_vmask), memcpy(ex->st_wmask, s->st_wmask, sizeof ex->st_wmask);
+    memcpy(ex->st_ref, s->st_ref, sizeof ex->st_ref);
+    ex->point_size = s->point_size, ex->poly_offset = s->poly_offset, ex->prim_restart = s->prim_restart;
+    memcpy(ex->blend_color, s->blend_color, sizeof ex->blend_color);
+    ex->copy_stride = s->copy_stride, ex->tex_pool = s->tex_pool, ex->samp_pool = s->samp_pool;
+    VkPipeState *p = &ex->pipe;
+    const VkPipeState *q = &s->pipe;
+    p->depth_clamp = q->depth_clamp, p->raster_discard = q->raster_discard;
+    memcpy(p->blend, q->blend, sizeof p->blend);
+    p->color = q->color, p->chmask = q->chmask, p->ms = q->ms, p->poly = q->poly, p->ds = q->ds;
+    memcpy(p->vattr, q->vattr, sizeof p->vattr), memcpy(p->vstream, q->vstream, sizeof p->vstream);
+    ex->prog = s->prog, ex->prog_stages = s->prog_stages;
+    memcpy(ex->vbuf, s->vbuf, sizeof ex->vbuf), memcpy(ex->ubo, s->ubo, sizeof ex->ubo), memcpy(ex->ssbo, s->ssbo, sizeof ex->ssbo);
+    memcpy(ex->cs_push, s->cs_push, sizeof ex->cs_push);
+    memcpy(ex->tex, s->tex, sizeof ex->tex), memcpy(ex->samp, s->samp, sizeof ex->samp), memcpy(ex->img, s->img, sizeof ex->img);
+    ex->tex_serial++;
+    ex->dirty = VK_EXEC_DIRTY_ALL;
+}
