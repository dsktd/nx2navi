+
+// ---------------------------------------------------------------- frame capture (vk_capture.c)
+// Every used texture and sampler descriptor slot, then every live entry whose image holds content the GPU made (a
+// render target, a copy or storage target, or a mirrored texture not written back): what a standalone replay must
+// register and upload before it runs the captured frame. Texture lock held throughout.
+void vk_texture_capture(void (*slot)(void *ctx, int id, const tex_t *t, const view_t *v),
+                        void (*samp)(void *ctx, int id, const samp_par *p),
+                        void (*image)(void *ctx, const tex_t *t, const VkTexImage *img), void *ctx) {
+    lock();
+    for (int i = 0; i < ntslots; i++)
+        if (tslots[i].used) slot(ctx, i, &tslots[i].t, tslots[i].has_view ? &tslots[i].v : NULL);
+    for (int i = 0; i < nsslots; i++)
+        if (sslots[i].used) samp(ctx, i, &sslots[i].p);
+    for (uint32_t i = 0; i < by_key.cap; i++) {
+        Tex *e = by_key.vals[i];
+        if (e && !e->released && e->pub.image && (e->pub.gpu_owned || e->wr_fence || e->gpu_dirty)) image(ctx, &e->t, &e->pub);
+    }
+    unlock();
+}
