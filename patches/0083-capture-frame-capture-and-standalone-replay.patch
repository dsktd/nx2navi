+void vk_capture_present(const tex_t *t, const int crop[4], uint64_t frame);   // present_image, replay order: starts or ends one
+void vk_capture_submit(const uint64_t *handles, int n);                  // submit_sync, before the replay records it
+void vk_capture_guest(uint64_t addr, uint64_t size);                     // shadow_copy: guest bytes the GPU now gets
+void vk_capture_register(int id, const tex_t *t, const view_t *v, const samp_par *s);   // a slot registered meanwhile
