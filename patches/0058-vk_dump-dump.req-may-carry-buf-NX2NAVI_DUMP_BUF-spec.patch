From 5c2c03861c3dd04276cfa58e742382ef40c1f6c0 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:09:19 -0500
Subject: [PATCH] vk_dump: dump.req may carry buf=<NX2NAVI_DUMP_BUF spec>|off,
 ubo=<n>, draws=0|1 and skip_runs=0|1 for that dump and later ones; bufs.txt
 goes to each dump's own folder (#164)

---
 runtime/vk_dump.c | 45 +++++++++++++++++++++++++++++++++++----------
 1 file changed, 35 insertions(+), 10 deletions(-)

diff --git a/runtime/vk_dump.c b/runtime/vk_dump.c
index 5d70f34c..1621382f 100644
--- a/runtime/vk_dump.c
+++ b/runtime/vk_dump.c
@@ -1274,7 +1274,34 @@ void vk_dump_movie_frame(int k, uint64_t shown) {
 static char dump_file[400];
 static int file_more;   // consecutive frames still to dump after the one named
 
-// passes.txt and images.txt in dir (a new folder per NX2NAVI_DUMP_WHITE attempt)
+// NX2NAVI_DUMP_BUF's value, or "off"
+static void buf_spec(const char *bf) {
+    char *q;
+    bd_addr = strtoull(bf, &q, 0), bd_size = bd_off = bd_stride = 0, bd_w = bd_h = 0;
+    if (*q == ':') bd_size = strtoull(q + 1, &q, 0);
+    if (*q == ':') bd_off = strtoull(q + 1, &q, 0);
+    if (*q == ':') bd_stride = strtoull(q + 1, &q, 0) & ~3ull;
+    if (*q == ':') bd_w = (uint32_t)strtoul(q + 1, &q, 0);
+    if (*q == ':') bd_h = (uint32_t)strtoul(q + 1, &q, 0);
+    if (!bd_w || !bd_h) bd_stride = 0;
+    free(bd_prev), bd_prev = NULL;
+}
+
+// The options a dump.req may carry, space or line separated, kept for later dumps: buf=<NX2NAVI_DUMP_BUF value>|off,
+// ubo=<n> (NX2NAVI_DUMP_UBO), draws=0|1 (NX2NAVI_DUMP_DRAWS), skip_runs=0|1 (NX2NAVI_DUMP_SKIP_RUNS). An empty file
+// changes nothing.
+static void req_options(char *t) {
+    for (char *w = strtok(t, " \t\r\n"); w; w = strtok(NULL, " \t\r\n")) {
+        if (!strncmp(w, "buf=", 4)) buf_spec(w + 4);
+        else if (!strncmp(w, "ubo=", 4)) dump_ubo = atoi(w + 4) == 1 ? 16 : atoi(w + 4) < 0 ? 0 : atoi(w + 4) > 4096 ? 4096 : atoi(w + 4);
+        else if (!strncmp(w, "draws=", 6)) dump_draws = atoi(w + 6) != 0;
+        else if (!strncmp(w, "skip_runs=", 10)) skip_runs = atoi(w + 10) != 0;
+        else { rt_log("vk_dump: dump.req: '%s' unknown, ignored", w); continue; }
+        rt_log("vk_dump: dump.req: %s", w);
+    }
+}
+
+// passes.txt and images.txt in dir (a new folder per NX2NAVI_DUMP_WHITE attempt), bufs.txt with NX2NAVI_DUMP_BUF
 static void open_files(void) {
     make_dirs(dir);
     char path[600];
@@ -1365,17 +1392,10 @@ void vk_dump_init(void) {
     if (!dump_white && !movie_k && !key_mode && !dump_file[0] && !dump_req) open_files();
     const char *bf = cfg_get("NX2NAVI_DUMP_BUF");
     if (bf && *bf) {
-        char *q;
-        bd_addr = strtoull(bf, &q, 0);
-        if (*q == ':') bd_size = strtoull(q + 1, &q, 0);
-        if (*q == ':') bd_off = strtoull(q + 1, &q, 0);
-        if (*q == ':') bd_stride = strtoull(q + 1, &q, 0) & ~3ull;
-        if (*q == ':') bd_w = (uint32_t)strtoul(q + 1, &q, 0);
-        if (*q == ':') bd_h = (uint32_t)strtoul(q + 1, &q, 0);
-        if (!bd_w || !bd_h) bd_stride = 0;
+        buf_spec(bf);
         snprintf(path, sizeof path, "%s/bufs.txt", dir);
         // a dump named as the run goes opens it with its folder (open_files); a named frame's folder exists already
-        if (bd_size && !dump_white && !movie_k && !key_mode && !dump_file[0] && !dump_key && !(bufs_f = fopen(path, "w"))) bd_size = 0;
+        if (bd_size && !dump_white && !movie_k && !key_mode && !dump_file[0] && !dump_key && !dump_req && !(bufs_f = fopen(path, "w"))) bd_size = 0;
     }
     vk_dump_armed = 1;
     if (dump_key) rt_log("vk_dump: %s dumps the next frame to %s/f<frame>", dump_key_name, base_dir);
@@ -1473,7 +1493,12 @@ void vk_dump_present(uint64_t frame) {
         rt_log("vk_dump: %s: frame %llu goes to %s", dump_key_name, (unsigned long long)dump_frame, dir);
     }
     if (dump_req && dump_frame == UINT64_MAX && plat_file_exists(req_path)) {   // asked for: dump the next frame
+        uint64_t sz;
+        uint8_t *b = plat_file_read(req_path, &sz);
         plat_file_delete(req_path);
+        char *t = b ? malloc(sz + 1) : NULL;
+        if (t) memcpy(t, b, sz), t[sz] = 0, req_options(t);
+        free(t), free(b);
         dump_frame = frame + 1;
         snprintf(dir, sizeof dir, "%s/f%llu", base_dir, (unsigned long long)dump_frame);
         open_files();
