 runtime/cfg_probe.c | 15 ++++++++
 runtime/input.c     | 90 +++++++++++++++++++++++++++++++++++++--------
 runtime/input_map.c | 29 +++++++++++++++
 runtime/input_map.h |  8 ++++
 5 files changed, 129 insertions(+), 18 deletions(-)

