--- a/runtime/input_map.c
+++ b/runtime/input_map.c
@@ -359,6 +359,35 @@ void input_mouse_stick(int32_t dx, int32_t dy, double dt_s, float sens, float ca
     out[1] = (int32_t)lrint(y);
 }
 
+static int motion_auto(const char *mode) { return !mode || !*mode || !strcmp(mode, "auto"); }
+
+// A candidate for lending its sensors under mode (not "off"): the raw Steam Controller beside a virtual pad, or a match.
+static int motion_lender(const char *name, const char *mode) {
+    if (!name) return 0;
+    return motion_auto(mode) ? !strncmp(name, "Steam Controller", 16) : strstr(name, mode) != NULL;
+}
+
+int input_motion_pick(int n, const char *const names[], const unsigned char sensors[], int primary, const char *mode) {
+    int off = mode && !strcmp(mode, "off");
+    if (off || motion_auto(mode)) {
+        if (primary >= 0 && primary < n && sensors[primary]) return primary;
+        if (off) return -1;
+        for (int i = 0; i < n; i++)
+            if (i != primary && sensors[i]) return i;
+        return -1;
+    }
+    for (int i = 0; i < n; i++)
+        if (sensors[i] && names[i] && strstr(names[i], mode)) return i;
+    return -1;
+}
+
+int input_motion_only(int n, const char *const names[], const unsigned char sensors[], int i, const char *mode) {
+    if ((mode && !strcmp(mode, "off")) || i < 0 || i >= n || !sensors[i] || !motion_lender(names[i], mode)) return 0;
+    for (int k = 0; k < n; k++)
+        if (k != i && !(sensors[k] && motion_lender(names[k], mode))) return 1;
+    return 0;
+}
+
 void input_pad_stick(int32_t x, int32_t y, float dead, int32_t out[2]) {
     double fx = x / (double)STICK_MAX, fy = y / (double)STICK_MAX, m = sqrt(fx * fx + fy * fy);
     out[0] = out[1] = 0;
diff --git a/runtime/input_map.h b/runtime/input_map.h
index 299f4823..f61f9f72 100644
--- a/runtime/input_map.h
+++ b/runtime/input_map.h
@@ -132,6 +132,14 @@ float input_pad_deadzone(int stick);
 // How far a stick (x, y in -32768..32767) is from the centre, in percent of full deflection (100 at an axis's end; a
 // square gate's corner reads more).
 double input_stick_percent(int32_t x, int32_t y);
+// The gamepad that feeds the six-axis sensor, of n open ones (names, sensors[i] 1 with a gyro and an accelerometer;
+// primary is the one the game reads, -1 none). mode is NX2NAVI_MOTION_PAD: "" or "auto" the primary when it has both
+// sensors, else the first other one that has them; "off" the primary or none; any other text the first one with both
+// sensors whose name contains it (case-sensitive), none without a match. The index, -1 none.
+int input_motion_pick(int n, const char *const names[], const unsigned char sensors[], int primary, const char *mode);
+// 1 when gamepad i only lends its sensors and is never made the one the game reads: it has both sensors, is the raw
+// "Steam Controller" (auto) or matches mode, and another open gamepad is neither. mode "off": never.
+int input_motion_only(int n, const char *const names[], const unsigned char sensors[], int i, const char *mode);
 
 // ---- the remapping rows' edits, on a copy of input_map. Pure.
 // action's keys (table order) / its gamepad buttons in layout, at most max; returns how many.
