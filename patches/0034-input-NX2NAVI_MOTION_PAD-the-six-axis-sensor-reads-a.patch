-// Every connected gamepad is kept open; `pad` is the one the game reads (and the one that rumbles and feeds motion):
+// Every connected gamepad is kept open; `pad` is the one the game reads (and the one that rumbles; motion_pad feeds motion):
 // the first one found, then whichever one the player presses (pad_follow). Taking only the first gamepad SDL lists
 // left the game deaf when that one was a device nobody holds: a virtual pad of Steam Input or DS4Windows, a wheel, a
 // receiver's idle second slot, listed before the controller in the player's hands.
@@ -405,6 +407,53 @@ static SDL_Gamepad *pads[MAX_PADS];
 static int npads;
 static int pad_pressed_logged;       // the primary's first press was logged (once per primary)
 
+static int pad_sensors(SDL_Gamepad *p) {
+    return SDL_GamepadHasSensor(p, SDL_SENSOR_GYRO) && SDL_GamepadHasSensor(p, SDL_SENSOR_ACCEL);
+}
+
+// Under lock: the open gamepads' names and sensors for input_motion_pick / input_motion_only; the primary's index.
+static int pad_table(const char *names[MAX_PADS], unsigned char sensors[MAX_PADS]) {
+    int primary = -1;
+    for (int i = 0; i < npads; i++) {
+        names[i] = SDL_GetGamepadName(pads[i]);
+        sensors[i] = (unsigned char)pad_sensors(pads[i]);
+        if (pads[i] == pad) primary = i;
+    }
+    return primary;
+}
+
+// NX2NAVI_MOTION_PAD (auto, off or part of a gamepad's name).
+static const char *motion_mode(void) {
+    const char *m = cfg_get("NX2NAVI_MOTION_PAD");
+    return m ? m : "";
+}
+
+// Under lock: 1 when p only lends its sensors (input_motion_only): it is never made the gamepad the game reads.
+static int pad_motion_only(SDL_Gamepad *p) {
+    const char *names[MAX_PADS];
+    unsigned char sensors[MAX_PADS];
+    pad_table(names, sensors);
+    for (int i = 0; i < npads; i++)
+        if (pads[i] == p) return input_motion_only(npads, names, sensors, i, motion_mode());
+    return 0;
+}
+
+// Under lock: picks the gamepad that feeds the six-axis sensor again (gamepad added, removed or followed); logs a
+// change. The sensors of the new one are enabled by the motion thread (sensors_ready).
+static void motion_select(void) {
+    const char *names[MAX_PADS];
+    unsigned char sensors[MAX_PADS];
+    int primary = pad_table(names, sensors);
+    int m = input_motion_pick(npads, names, sensors, primary, motion_mode());
+    SDL_Gamepad *p = m >= 0 ? pads[m] : NULL;
+    if (p == motion_pad) return;
+    motion_pad = p, sensor_pad = 0, sensor_ok = 0;
+    if (p && p != pad)
+        rt_log("input: motion from \"%s\" (buttons from \"%s\")", names[m], pad ? SDL_GetGamepadName(pad) : "none");
+    else if (!p && npads && *motion_mode() && strcmp(motion_mode(), "auto"))
+        rt_log("input: no gamepad with gyro and accelerometer for NX2NAVI_MOTION_PAD=%s", motion_mode());
+}
+
 // Under lock: makes p the gamepad the game reads, with its labels, rumble and layout; logs it.
 static void pad_primary(SDL_Gamepad *p, const char *why) {
     pad = p;
@@ -424,10 +473,11 @@ static void pad_primary(SDL_Gamepad *p, const char *why) {
