     // Nothing drains the SDL event queue: no event per sample (the data still updates, SDL_SendJoystickSensor)
     SDL_SetEventEnabled(SDL_EVENT_GAMEPAD_SENSOR_UPDATE, false);
-    sensor_ok =SDL_GamepadHasSensor(pad, SDL_SENSOR_GYRO) && SDL_GamepadHasSensor(pad, SDL_SENSOR_ACCEL) &&
-                SDL_SetGamepadSensorEnabled(pad, SDL_SENSOR_GYRO, true) &&
-                SDL_SetGamepadSensorEnabled(pad, SDL_SENSOR_ACCEL, true);
-    if (sensor_ok) rt_log("input: motion sensors on (gyro %.0f Hz, accelerometer %.0f Hz)",
-                          (double)SDL_GetGamepadSensorDataRate(pad, SDL_SENSOR_GYRO),
-                          (double)SDL_GetGamepadSensorDataRate(pad, SDL_SENSOR_ACCEL));
+    sensor_ok = pad_sensors(motion_pad) && SDL_SetGamepadSensorEnabled(motion_pad, SDL_SENSOR_GYRO, true) &&
+                SDL_SetGamepadSensorEnabled(motion_pad, SDL_SENSOR_ACCEL, true);
+    if (sensor_ok) rt_log("input: motion sensors of \"%s\" on (gyro %.0f Hz, accelerometer %.0f Hz)",
+                          SDL_GetGamepadName(motion_pad), (double)SDL_GetGamepadSensorDataRate(motion_pad, SDL_SENSOR_GYRO),
+                          (double)SDL_GetGamepadSensorDataRate(motion_pad, SDL_SENSOR_ACCEL));
     else rt_log("input: \"%s\" has no gyro and accelerometer: the six-axis sensor reads a controller at rest",
-                SDL_GetGamepadName(pad));
+                SDL_GetGamepadName(motion_pad));
     return sensor_ok;
 }
 
@@ -1049,11 +1106,10 @@ static void motion_main(void *arg) {
         float a[3], g[3];
         int have = 0;
         plat_mutex_lock(&lock);
-        if (pad && SDL_GamepadConnected(pad)) {
-            SDL_UpdateGamepads();
-            have = sensors_ready() && SDL_GetGamepadSensorData(pad, SDL_SENSOR_ACCEL, a, 3) &&
-                   SDL_GetGamepadSensorData(pad, SDL_SENSOR_GYRO, g, 3);
-        }
+        if (pad || motion_pad) SDL_UpdateGamepads();
+        if (motion_pad && SDL_GamepadConnected(motion_pad))
+            have = sensors_ready() && SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_ACCEL, a, 3) &&
+                   SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_GYRO, g, 3);
         plat_mutex_unlock(&lock);
         if (!have || !input_motion_enabled()) continue;
         double acc[3], gyro[3];
diff --git a/runtime/input_map.c b/runtime/input_map.c
index db7f885..a009e76 100644
--- a/runtime/input_map.c
+++ b/runtime/input_map.c
@@ -351,6 +351,35 @@ void input_mouse_stick(int32_t dx, int32_t dy, double dt_s, float sens, int32_t
     out[1] = (int32_t)lrint(y);
