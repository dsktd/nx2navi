     if (had && !pad && !menu_is_open()) {
         rt_log("input: the gamepad in use went away and no other is connected: the menu opens");
         menu_toggle();
@@ -672,7 +729,8 @@ static void pad_follow(void) {
     if (npads < 2 || (pad && pad_active(pad))) return;
     int steam = pad_steam_input() >= 0;
     for (int i = 0; i < npads; i++)
-        if (pads[i] != pad && !(steam && pad_steam_raw(pads[i])) && pad_active(pads[i])) {
+        if (pads[i] != pad && !(steam && pad_steam_raw(pads[i])) && pads[i] != motion_pad && !pad_motion_only(pads[i]) &&
+            pad_active(pads[i])) {
             pad_primary(pads[i], "in use (pressed)");
             return;
         }
@@ -1276,19 +1334,18 @@ void input_motion_axes(const float a[3], const float g[3], double acc[3], double
 
 // Under lock: (re)enable the sensors when the open gamepad changed; 1 if it has both and they are on.
 static int sensors_ready(void) {
-    SDL_JoystickID id = SDL_GetGamepadID(pad);
+    SDL_JoystickID id = SDL_GetGamepadID(motion_pad);
     if (id == sensor_pad) return sensor_ok;
     sensor_pad = id;
     // Nothing drains the SDL event queue: no event per sample (the data still updates, SDL_SendJoystickSensor)
     SDL_SetEventEnabled(SDL_EVENT_GAMEPAD_SENSOR_UPDATE, false);
-    sensor_ok =SDL_GamepadHasSensor(pad, SDL_SENSOR_GYRO) && SDL_GamepadHasSensor(pad, SDL_SENSOR_ACCEL) &&
-                SDL_SetGamepadSensorEnabled(pad, SDL_SENSOR_GYRO, true) &&
-                SDL_SetGamepadSensorEnabled(pad, SDL_SENSOR_ACCEL, true);
-    if (sensor_ok) rt_log("input: motion sensors on (gyro %.0f Hz, accelerometer %.0f Hz)",
-                          (double)SDL_GetGamepadSensorDataRate(pad, SDL_SENSOR_GYRO),
-                          (double)SDL_GetGamepadSensorDataRate(pad, SDL_SENSOR_ACCEL));
+    sensor_ok = pad_sensors(motion_pad) && SDL_SetGamepadSensorEnabled(motion_pad, SDL_SENSOR_GYRO, true) &&
+                SDL_SetGamepadSensorEnabled(motion_pad, SDL_SENSOR_ACCEL, true);
+    if (sensor_ok) rt_log("input: motion sensors of \"%s\" on (gyro %.0f Hz, accelerometer %.0f Hz)",
+                          SDL_GetGamepadName(motion_pad), (double)SDL_GetGamepadSensorDataRate(motion_pad, SDL_SENSOR_GYRO),
+                          (double)SDL_GetGamepadSensorDataRate(motion_pad, SDL_SENSOR_ACCEL));
     else rt_log("input: \"%s\" has no gyro and accelerometer: the six-axis sensor reads a controller at rest",
-                SDL_GetGamepadName(pad));
+                SDL_GetGamepadName(motion_pad));
     return sensor_ok;
 }
 
@@ -1313,9 +1370,10 @@ static void motion_main(void *arg) {
         float a[3], g[3];
         int have = 0;
         plat_mutex_lock(&lock);
-        if (pad && sdl_enter()) {   // no sample while SDL finds devices again
-            have = SDL_GamepadConnected(pad) && sensors_ready() &&
-                   SDL_GetGamepadSensorData(pad, SDL_SENSOR_ACCEL, a, 3) && SDL_GetGamepadSensorData(pad, SDL_SENSOR_GYRO, g, 3);
+        if ((pad || motion_pad) && sdl_enter()) {   // no sample while SDL finds devices again
+            have = motion_pad && SDL_GamepadConnected(motion_pad) && sensors_ready() &&
+                   SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_ACCEL, a, 3) &&
+                   SDL_GetGamepadSensorData(motion_pad, SDL_SENSOR_GYRO, g, 3);
             sdl_leave();
         }
         plat_mutex_unlock(&lock);
