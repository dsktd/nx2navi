From bcd6e8c71062e66a88b773f31c5e21609cebf167 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:32:40 -0500
Subject: [PATCH] vk_exec_draw: NX2NAVI_POOL_LOAD_FIT=1 (0: fixed step) sizes a
 loading refresh's creation count to the time the frame has left of
 NX2NAVI_POOL_LOAD_MS at the measured cost per entry, so a longer POOL_LOAD_MS
 makes an area load in fewer held frames; Market made 4,869 textures over 17
 frames with one present 2.55 s late

---
 runtime/cfg.c          |  6 +++---
 runtime/vk.h           |  1 +
 runtime/vk_exec_draw.c | 34 ++++++++++++++++++++++++++++++++--
 runtime/vk_texture.c   |  1 +
 4 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/runtime/cfg.c b/runtime/cfg.c
index 42edf6f..66229a5 100644
--- a/runtime/cfg.c
+++ b/runtime/cfg.c
@@ -76,7 +76,7 @@ static const char *const known[] = {
     "ZSTD_CHECK", "ZSTD_NATIVE",
     "BIND_REUSE", "DYN_DELTA", "STG_ARENA", "SUBMIT_BATCH", "ASTC_GPU_DESWIZZLE", "ASTC_SCRATCH_KEEP", "ASTC_ARENA", "ASTC_BC1",
     "TEXUP_LOG_MS", "DYN_RES", "DYN_RES_TARGET", "DYN_RES_STEP", "TEXTURE_DETAIL",
-    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "SHADOW_RECYCLE_MB",
+    "RECORDER_CORE", "RECORDER_PRIO", "REPLAY_TIME", "LOCK_TIME", "POOL_CREATE_BUDGET", "POOL_CREATE_MS", "POOL_FINI_IDLE", "POOL_LOAD_BACKLOG", "POOL_LOAD_MS", "POOL_LOAD_STEP", "POOL_LOAD_FIT", "SHADOW_RECYCLE_MB",
     "VMA_BLOCK_MB", "SYNC_WAKE_ALL", "LOG_ASYNC", "DEVICE_LOST_AT",
     "COOP", "COOP_BETA", "COOP_NAME", "COOP_SERVER", "COOP_PORT", "COOP_ROOM", "COOP_AUTO", "COOP_DROP",   // co-op (coop.c); the last three have no menu row
     "COOP_PROGRESS", "COOP_ITEMS", "COOP_SONGS", "COOP_QUEST", "COOP_KEYS", "COOP_RUPEES", "COOP_AMMO",   // the room's rules (coop_game.c)
@@ -139,7 +139,7 @@ static const struct { const char *key, *section; } sections[] = {
     {"DYN_DELTA", "performance"}, {"STG_ARENA", "performance"}, {"SUBMIT_BATCH", "performance"},
     {"BUILD_FREE_MB", "performance"}, {"BUILD_RESERVE_MB", "performance"}, {"MEM_NEED_MB", "diagnostics"},
     {"ASTC_GPU_DESWIZZLE", "performance"}, {"ASTC_SCRATCH_KEEP", "performance"}, {"ASTC_ARENA", "performance"}, {"ASTC_BC1", "performance"}, {"POOL_CREATE_BUDGET", "performance"},
-    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"}, {"SHADOW_RECYCLE_MB", "performance"},
+    {"POOL_CREATE_MS", "performance"}, {"POOL_FINI_IDLE", "performance"}, {"FREEZE_BUDGET_US", "performance"}, {"POOL_LOAD_BACKLOG", "performance"}, {"POOL_LOAD_MS", "performance"}, {"POOL_LOAD_STEP", "performance"}, {"POOL_LOAD_FIT", "performance"}, {"SHADOW_RECYCLE_MB", "performance"},
     {"TIMER_1MS", "performance"}, {"PIPE_WAIT", "performance"}, {"PIPE_SKIP", "performance"}, {"ONESHOT_BUDGET", "performance"},
     {"PIPE_FRAME_WAIT_MS", "performance"}, {"PIPE_SKIP_STEADY", "performance"},
     {"CACHE_DIE", "performance"}, {"ONE_PER_CORE", "performance"},
@@ -266,7 +266,7 @@ static const CfgMeta metas[] = {
     {"DYN_RES", "0", "0|1", LIVE}, {"DYN_RES_TARGET", "16.7", "1..100", LIVE}, {"DYN_RES_STEP", "45", "8..600", LIVE},
     // the recording thread: a core of its own (auto: with 12 or more logical processors) and the highest priority
     // (vk_exec.c rec_claim)
-    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART}, {"SHADOW_RECYCLE_MB", "1024", "0..16384", RESTART},
+    {"RECORDER_CORE", "auto", "auto|0|1", RESTART}, {"RECORDER_PRIO", "1", "0|1", RESTART}, {"REPLAY_TIME", "0", "0|1", RESTART}, {"LOCK_TIME", "0", "0|1", RESTART}, {"POOL_CREATE_BUDGET", "16", "1..4096", RESTART}, {"POOL_CREATE_MS", "6", "0..100", RESTART}, {"POOL_FINI_IDLE", "0", "0|1", RESTART}, {"FREEZE_BUDGET_US", "1000", "0..100000", RESTART}, {"POOL_LOAD_BACKLOG", "512", "0..65536", RESTART}, {"POOL_LOAD_MS", "50", "1..1000", RESTART}, {"POOL_LOAD_STEP", "128", "0..65536", RESTART}, {"POOL_LOAD_FIT", "0", "0|1", RESTART}, {"SHADOW_RECYCLE_MB", "1024", "0..16384", RESTART},
     // held submissions handed to the queue together (vk_sync.c, submit batching)
     {"SUBMIT_BATCH", "4", "1..16", RESTART},
     {"CACHE_DIE", "1", "0|1|ab", RESTART}, {"ONE_PER_CORE", "0", "0|1|ab", RESTART},   // perf.c cpu_placement
diff --git a/runtime/vk.h b/runtime/vk.h
index 78a7d34..daa9a2c 100644
--- a/runtime/vk.h
+++ b/runtime/vk.h
@@ -550,6 +550,7 @@ const VkTexImage *vk_texture_exact_by_id_locked(int id, view_t *view, int *has_v
 uint32_t vk_texture_slots_gen(void);
 int vk_texture_slot_count_locked(void);
 void vk_texture_create_budget_locked(int n);         // slot lookups create at most n entries (mapped storage only); -1 any
+int vk_texture_create_budget_left_locked(void);    // what the budget above has left (0 with none)
 int vk_texture_create_deferred_locked(void);        // a lookup since the last call left a creation to the budget             // one past the highest texture slot registered so far (or more)
 int vk_sampler_slot_count_locked(void);
 // Bindless pools (vk_exec_draw.c, "texture and sampler pools"): set 2 of every pipeline layout. Shaders that index
diff --git a/runtime/vk_exec_draw.c b/runtime/vk_exec_draw.c
index d8bbfa6..d5eab61 100644
--- a/runtime/vk_exec_draw.c
+++ b/runtime/vk_exec_draw.c
@@ -2040,6 +2040,21 @@ static int pool_load_backlog(void) {
 // another of 300 ms, the game's main thread blocked in a host call on the replay all that time. With a step, each
 // refresh makes that many and the later refreshes of the frame stop at NX2NAVI_POOL_LOAD_MS, so the load runs over
 // frames (their presents still held) and the game keeps running.
+// NX2NAVI_POOL_LOAD_FIT (default 0: the fixed step): while the pool is loading, a refresh's count is sized to the time
+// the frame has left of NX2NAVI_POOL_LOAD_MS at the creation cost measured so far in this load (16 to 4,096), so a
+// longer NX2NAVI_POOL_LOAD_MS makes the load in fewer frames without one refresh running far past it. With the fixed
+// step of 128 and 50 ms, Market (play32, wt-rebase d9c9e0a, .lab/pr-p32-west) made 4,869 textures over 17 frames of
+// 100-170 ms, the presents held throughout (vk_backend.c frame_hold): one present 2.55 s after the last, where play13
+// (c7102bb) made the same load in 4 shown frames of 0.2-0.5 s. Each loading frame also carries the replay's other
+// work, so fewer, fuller frames finish the load sooner.
+static struct { uint64_t ns_per, frame_ns; } PL_FIT;   // creation cost per entry (running mean); this frame's sync time
+static int pool_load_fit(void) {
+    static int on = -1;
+    if (on < 0) on = cfg_int("NX2NAVI_POOL_LOAD_FIT") > 0;
+    return on;
+}
+
+static uint64_t pool_create_ns(void);
 static int pool_create_budget(void) {
     static int n = -1, step;
     if (n < 0) {
@@ -2047,7 +2062,12 @@ static int pool_create_budget(void) {
         if (n < 1) n = 1;
         step = cfg_int("NX2NAVI_POOL_LOAD_STEP");
     }
-    return pool_loading ? (step > 0 ? step : 1 << 20) : n;
+    if (!pool_loading) return n;
+    if (step > 0 && pool_load_fit() && PL_FIT.ns_per && pool_create_ns() > PL_FIT.frame_ns) {
+        uint64_t k = (pool_create_ns() - PL_FIT.frame_ns) / PL_FIT.ns_per;
+        return k < 16 ? 16 : k > 4096 ? 4096 : (int)k;
+    }
+    return step > 0 ? step : 1 << 20;
 }
 
 // The refresh runs before every draw that binds the pools, not once per submission, so the count above held for each
@@ -2603,7 +2623,10 @@ static void pool_sync_entries(VkExec *ex) {
     }
     int retry = 0;   // slots whose texture the creation budget left: filled again by the next sync
     if (fresh || gen != PL.gen || ep != PL.epoch || PL.retry) {
-        vk_texture_create_budget_locked(spent ? 0 : pool_create_budget());
+        PL_FIT.frame_ns = PL.frame_ns;
+        int budget = spent ? 0 : pool_create_budget();
+        uint64_t tb = kern_now_ns();
+        vk_texture_create_budget_locked(budget);
         PL.n_frame_stops += (uint64_t)spent;
         // Only a slot change since the last sync (no new kinds, no new submission, nothing left over): the slots that
         // changed (vk_texture_dirty_slots_locked), not the whole table. With NX2NAVI_POOL_FAST (default on) a new
@@ -2671,6 +2694,13 @@ static void pool_sync_entries(VkExec *ex) {
             PL.n_slots += (uint64_t)n, PL.n_full++, PL.full_ns += kern_now_ns() - tw;
             vk_texture_groups_unstamp_locked();   // the walk over every slot refilled members one by one
         }
+        if (pool_loading && budget > 0 && pool_load_fit()) {   // the cost of this refresh's creations, for the next
+            int made = budget - vk_texture_create_budget_left_locked();
+            if (made >= 8) {
+                uint64_t per = (kern_now_ns() - tb) / (uint64_t)made;
+                PL_FIT.ns_per = PL_FIT.ns_per ? (PL_FIT.ns_per * 3 + per) / 4 : per;
+            }
+        }
         vk_texture_create_budget_locked(-1);
     }
     PL.retry = retry != 0;
diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index da21a18..6f5fe0b 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -3859,6 +3859,7 @@ static int want_take(void) {
 }
 
 void vk_texture_create_budget_locked(int n) { create_budget = n, create_deferred = 0; }
+int vk_texture_create_budget_left_locked(void) { return create_budget < 0 ? 0 : create_budget; }
 int vk_texture_create_deferred_locked(void) { int d = create_deferred; create_deferred = 0; return d; }
 
 static Tex *slot_resolve(TexSlot *s, view_t *view, int *has_view) {
-- 
