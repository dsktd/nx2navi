From bf43c62d4dcd425d4b69a90eaae9593dddb6d053 Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Tue, 10 Nov 2026 00:26:28 -0500
Subject: [PATCH] vk_memory: log VRAM per heap every 1800 frames: driver usage
 and budget, VMA blocks and allocations, the kernel's fdinfo vram/gtt/visible
 and the shadow total, beside the texture and mirror census (#141, #132)

---
 runtime/vk_memory.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/runtime/vk_memory.c b/runtime/vk_memory.c
index 116a3ab..aad8be4 100644
--- a/runtime/vk_memory.c
+++ b/runtime/vk_memory.c
@@ -673,6 +673,7 @@ void vk_mem_census(uint64_t frame) {
     mirror_frame = frame;
     static uint64_t window_start;
     if ((rt_trace & RT_TRACE_PERF) && frame % 600 == 0) vram_log(frame), mirror_pool_log(frame);
+    else if (!(rt_trace & RT_TRACE_PERF) && frame % 1800 == 0) vram_log(frame);   // what grows over a long session
     if ((rt_trace & RT_TRACE_PERF) && frame % 60 == 0) outside_watch(frame), up_ts_log(frame), vk_gtl_log(frame, 60);
     if ((rt_trace & RT_TRACE_PERF) && !vk_mirror_on) dirty_frame(frame);
     if ((rt_trace & RT_TRACE_PERF) ? frame % 60 == 0 : frame == 600 || frame == 1800)
@@ -4340,6 +4341,42 @@ void vk_mem_stage_log(const char *stage) {
 // With NX2NAVI_TRACE=perf every 600 frames: what holds device-local memory, to see what grows over a long session.
 // VMA's blocks and allocations on the device-local heaps, texture entries with their own memory, the VRAM mirrors and
 // the objects waiting for their last submission to retire.
+// The kernel's fdinfo figures for this process (resident memory by placement, what nvtop shows) beside the shadow
+// total: the gap to the driver's and VMA's figures (heap_log) is memory held outside VMA (imports) or evicted from VRAM
+// to GTT. drm-memory-<region>: KiB per open DRM file; fds of one client share a drm-client-id, counted once.
+static void kernel_vram_log(uint64_t frame) {
+#ifdef __linux__
+    uint64_t kib[3] = {0}, ids[16];
+    int nid = 0;
+    char path[64], buf[256];
+    for (int fd = 0; fd < 1024; fd++) {
+        snprintf(path, sizeof path, "/proc/self/fdinfo/%d", fd);
+        FILE *f = fopen(path, "r");
+        if (!f) continue;
+        uint64_t id = 0, v[3] = {0};
+        int drm = 0;
+        while (fgets(buf, sizeof buf, f)) {
+            unsigned long long x;
+            if (sscanf(buf, "drm-client-id: %llu", &x) == 1) id = x, drm = 1;
+            else if (sscanf(buf, "drm-memory-vram: %llu", &x) == 1) v[0] = x;
+            else if (sscanf(buf, "drm-memory-gtt: %llu", &x) == 1) v[1] = x;
+            else if (sscanf(buf, "amd-memory-visible-vram: %llu", &x) == 1) v[2] = x;
+        }
+        fclose(f);
+        int seen = 0;
+        for (int i = 0; i < nid; i++) seen |= ids[i] == id;
+        if (!drm || seen) continue;
+        if (nid < 16) ids[nid++] = id;
+        for (int i = 0; i < 3; i++) kib[i] += v[i];
+    }
+    if (nid)
+        rt_log("mem: kernel frame %llu: vram %.0f gtt %.0f visible %.0f MiB; shadow %.0f MiB", (unsigned long long)frame,
+               kib[0] / 1024.0, kib[1] / 1024.0, kib[2] / 1024.0, s_live_bytes / 1048576.0);
+#else
+    (void)frame;
+#endif
+}
+
 static void vram_log(uint64_t frame) {
     VkCtx *c = vk_ctx();
     if (!c) return;
@@ -4363,6 +4400,7 @@ static void vram_log(uint64_t frame) {
     pool_census_log(frame);
     heap_log(c, frame, vb);
     vram_use_log(c, frame, vb, &t);
+    kernel_vram_log(frame);
 }
 
 // Device class: INTEGRATED -> uma; a discrete GPU with a DEVICE_LOCAL heap of 1 GiB or more beside a
