From 2e1f51f988c0fc0d515559d307cc3d9508b87f4b Mon Sep 17 00:00:00 2001
From: desocketed <desocketed@users.noreply.github.com>
Date: Mon, 9 Nov 2026 18:38:09 -0500
Subject: [PATCH 2/2] vk_texture: NX2NAVI_TEX_DEDUPE and
 NX2NAVI_TEX_RELEASED_LRU off by default: dedupe paints wrong terrain at the
 castle slot (3.7 MiB shared of 2 GiB), LRU alone is untested (#132)

---
 runtime/vk_texture.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/runtime/vk_texture.c b/runtime/vk_texture.c
index 3626e5a..c0d1f0e 100644
--- a/runtime/vk_texture.c
+++ b/runtime/vk_texture.c
@@ -96,7 +96,7 @@ static nvn_hmap samplers = {.klen = sizeof(samp_par)};
 static int nreleased;
 static Tex *rel_head, *rel_tail;   // released entries, the first to drop at the head (rel_append orders them)
 static uint64_t rel_bytes;         // own memory of the released entries (rel_append / rel_unlink)
-// NX2NAVI_TEX_RELEASED_LRU (default 1): the released list is kept in order of last use (last_use), so the sweeps drop
+// NX2NAVI_TEX_RELEASED_LRU (default 0 until a lab shot clears it; =1): the released list is kept in order of last use (last_use), so the sweeps drop
 // the entry unused for longest; =0: in release order (oldest release first).
 static int rel_lru = -1;
 // NX2NAVI_TEX_RELEASED_MIB (default 0: no byte cap): past this much own memory in released entries, each release
@@ -192,7 +192,7 @@ static nvn_hmap ghosts = {.klen = sizeof(TexKey)};
 static int same_but_swizzle(const TexKey *a, const TexKey *b);
 static int tex_trace(void) { return (rt_trace & RT_TRACE_TEX) != 0; }
 
-// ---- the content index (NX2NAVI_TEX_DEDUPE, default 1; the tex trace reads it too)
+// ---- the content index (NX2NAVI_TEX_DEDUPE, default 0: sharing painted wrong terrain at the castle, 2026-11-09; the tex trace reads it too)
 // Every upload of a mirrored texture hashes the storage bytes it copies (128 bits, content_hash) and the index maps the
 // hash to the entry that holds them (Content: the newest one, its key and size). A first-time upload whose bytes the
 // index knows under a compatible entry (share_compatible: the same descriptor and layout apart from the swizzle
@@ -244,7 +244,7 @@ static void content_note(Tex *e, const uint64_t h[2]) {   // e holds these bytes
 
 static int dedupe_on(void) {
     if (tex_dedupe < 0) {
-        tex_dedupe = rt_knob("TEX_DEDUPE", "1");
+        tex_dedupe = rt_knob("TEX_DEDUPE", "0");
         rt_log("vk: texture content dedupe %s (NX2NAVI_TEX_DEDUPE)", tex_dedupe ? "on: identical bytes share one image" : "off");
     }
     return tex_dedupe;
@@ -781,7 +781,7 @@ static uint64_t own_bytes(const Tex *e) {
 // last_use, so the walk from the tail is short.
 static void rel_append(Tex *e) {
     if (rel_lru < 0) {
-        rel_lru = rt_knob("TEX_RELEASED_LRU", "1");
+        rel_lru = rt_knob("TEX_RELEASED_LRU", "0");
         rt_log("vk: released textures dropped %s (NX2NAVI_TEX_RELEASED_LRU)", rel_lru ? "least recently used first" : "oldest release first");
     }
     e->rel_acct = own_bytes(e);
