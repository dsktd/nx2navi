#!/bin/bash
# lab-run <recording> <dump-frame> <label> [KEY=VALUE...]
# Replays an input recording on the private gpu-display, dumps one frame (NX2NAVI_DUMP counts PRESENTS), stops only its
# own process group, prints key stats, writes the final frame to ~/claude/nx2navi/latest-frame.png (1280x720).
# Env: LAB_BIN (game dir, default NX2navi/build/v111), LAB_EXE (binary in it, default nx2navi; e.g. nx2navi.new), LAB_KEEP=1 keep the dump (default: delete), LAB_TIMEOUT (s, 300).
# LAB_VALIDATE=1: Khronos validation layer (nixpkgs vulkan-validation-layers) + synchronization validation; messages go to
#   $OUT/validation.log, each message ID capped at 3 repeats (duplicate_message_limit). Slow; layer settings in $OUT/vk_layer_settings.txt.
# LAB_HANG=1: RADV_DEBUG=nogpl,hang and the radv_dumps_* land in $OUT/hang (radv writes them under $HOME, so HOME is
#   pointed there for the game only; XDG_CACHE_HOME stays).
# Never touches shader-cache or the binary; the game itself still writes its caches in the bin dir's cwd.
set -u
# lab-run [--show] ...: --show also writes latest-frame.png (only if the dump frame was reached); off by default.
# lab-run --dry ...: assemble the profile, print it, exit (no lock, no replay).
show=0; dry=0
while :; do case ${1:-} in --show) show=1; shift;; --dry) dry=1; shift;; *) break;; esac; done
rec=$1 frame=$2 label=$3; shift 3
ROOT=$HOME/claude/nx2navi
BIN=${LAB_BIN:-$ROOT/NX2navi/build/v111}
OUT=$ROOT/.lab/$label; log=$OUT/run.log
# lock shared with every other lab/investigation run (held by the game via fd 9, gone when it exits)
[ $dry = 1 ] || {
exec 9>/tmp/nx2navi-lab.lock; flock -w ${LAB_LOCK_WAIT:-3600} 9 || { echo "lab-run: lock busy" >&2; exit 3; }
# guard: any other nx2navi game process (argv0 basename nx2navi, or gdb --args .../nx2navi)
busy=$(for p in /proc/[0-9]*; do [ "${p#/proc/}" = $$ ] && continue
  a=(); mapfile -d '' a < $p/cmdline 2>/dev/null || continue; [ ${#a[@]} -gt 0 ] || continue   # the process may be gone
  [ "${a[0]##*/}" = nx2navi ] && echo ${p#/proc/} && continue
  [ "${a[0]##*/}" = gdb ] && [[ " ${a[*]} " == *"/nx2navi "* ]] && echo ${p#/proc/}; done)
# Cal's game runs on the host, invisible to /proc here: refuse while its play log is being written (a GPU fault in a
# replay resets the GPU and takes his game down with it, 2026-11-08). LAB_FORCE=1 overrides.
hostlog=$(ls -t "$ROOT"/NX2navi/build/v111/logs/play-*.log 2>/dev/null | head -1)
[ -z "${LAB_FORCE:-}" ] && [ -n "$hostlog" ] && [ $(( $(date +%s) - $(stat -c %Y "$hostlog") )) -lt 120 ] && {
  echo "lab-run: Cal's game is running (${hostlog##*/} written <2 min ago); refusing" >&2; exit 3; }
[ -n "$busy" ] && { echo "lab-run: another nx2navi game is running (pid $busy); refusing" >&2; exit 3; }
}
rm -rf "$OUT"; mkdir -p "$OUT"
case $rec in /*) ;; *) rec=$PWD/$rec;; esac
envs=(); for kv in "$@"; do envs+=("$kv"); done
radv=nogpl; [ -n "${LAB_HANG:-}" ] && { radv=nogpl,hang; mkdir -p "$OUT/hang"; envs+=("XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}" "HOME=$OUT/hang"); }
if [ -n "${LAB_VALIDATE:-}" ]; then
  vvl=$(nix build nixpkgs#vulkan-validation-layers --no-link --print-out-paths | tail -1) || exit 4
  cat >"$OUT/vk_layer_settings.txt" <<EOF
khronos_validation.validate_sync = $([ "$LAB_VALIDATE" = core ] && echo false || echo true)
khronos_validation.thread_safety = ${LAB_VALIDATE_THREADS:-true}
khronos_validation.fine_grained_locking = ${LAB_VALIDATE_FGL:-true}
khronos_validation.check_shaders = ${LAB_VALIDATE_SHADERS:-false}
khronos_validation.debug_action = VK_DBG_LAYER_ACTION_LOG_MSG
khronos_validation.log_filename = $OUT/validation.log
khronos_validation.duplicate_message_limit = 3
khronos_validation.report_flags = error,warn
EOF
  # LAB_VALIDATE_SETTINGS="key=value;...": more khronos_validation settings (bisecting the layer)
  tr ';' '\n' <<<"${LAB_VALIDATE_SETTINGS:-}" | sed -n 's/^ *\([a-z_]*\) *= */khronos_validation.\1 = /p' >>"$OUT/vk_layer_settings.txt"
  envs+=("VK_ADD_LAYER_PATH=$vvl/share/vulkan/explicit_layer.d" VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation
    "VK_LAYER_SETTINGS_PATH=$OUT/vk_layer_settings.txt" ${LAB_VK_LOADER_DEBUG:+VK_LOADER_DEBUG=layer})
fi
# live profile allowed (Cal, 2026-11-09): snapshot his saves first and restore them after the run
prof=""; for e in "${envs[@]}"; do [[ $e == NX2NAVI_PROFILE_DIR=* ]] && prof=${e#*=}; done
live=$(realpath -m "$BIN/profile")
# recording bundle: `just play` saves logs/profile-<ts>/ next to input-<ts>.txt; replay from that save in a scratch
# profile (live profile copied for account.uid/cache, its save dirs replaced by the bundle's)
bundle=""; [[ ${rec##*/} =~ ^input-(.+)\.txt$ ]] && bundle=$(dirname "$rec")/profile-${BASH_REMATCH[1]}
if [[ -z $prof && -d $bundle ]]; then
  prof=$OUT/profile; mkdir -p "$prof"
  cp -a "$live"/. "$prof"/ && rm -rf "$prof"/save "$prof"/save-tx "$prof"/save-backup && cp -a "$bundle"/. "$prof"/ || exit 4
  envs+=("NX2NAVI_PROFILE_DIR=$prof"); echo "lab-run: profile from bundle ${bundle##*/}"
elif [[ -z $prof ]]; then echo "lab-run: no bundle for ${rec##*/}; using the live profile (saves restored after)" >&2; fi
[ $dry = 1 ] && { echo "profile: ${prof:-$live}"; ls -la "${prof:-$live}"; exit 0; }
if [[ -z $prof || $(realpath -m "$prof") == "$live" ]]; then
  snap=$(mktemp -d "${TMPDIR:-/tmp}/nx2navi-save.XXXXXX")
  cp -a "$live/save" "$live/save-tx" "$live/save-backup" "$snap"/ 2>/dev/null
  restore_saves() { for d in save save-tx save-backup; do [[ -d $snap/$d ]] && { rm -rf "$live/$d"; cp -a "$snap/$d" "$live/$d"; }; done; rm -rf "$snap"; }
else restore_saves() { :; }; fi
t0=$(date +%s.%N)
FEED=$HOME/claude/.services/screensavers/feeds/nx2navi-lab.log
echo "$(date +%H:%M) run $label: replay to frame $frame ${envs[*]}" >>"$FEED"
setsid nice -n 19 env WAYLAND_DISPLAY=${LAB_DISPLAY:-gpu-display} XDG_RUNTIME_DIR=${LAB_RUNTIME:-$HOME/claude/.services/gpu-display/runtime} \
  nix develop $ROOT --command env TERM=dumb SDL_VIDEODRIVER=wayland SDL_JOYSTICK_HIDAPI_STEAM=0 RADV_DEBUG=$radv \
  ${LAB_AUDIO:+PULSE_SERVER=unix:/run/user/1000/pulse/native} NX2NAVI_PIPE_SKIP=strict NX2NAVI_INPUT_SCRIPT="$rec" NX2NAVI_DUMP=$frame NX2NAVI_DUMP_DIR=$OUT/dump "${envs[@]}" \
  bash -c 'cd "$0" && exec nixVulkanIntel "./$1"' "$BIN" "${LAB_EXE:-nx2navi}" </dev/null >"$log" 2>&1 &
pgid=$!
trap 'kill -- -$pgid 2>/dev/null; sleep 1; restore_saves' EXIT
tmo=${LAB_TIMEOUT:-300}; hit=0
for ((i=0; i<tmo*2; i++)); do sleep 0.5
  echo "$((i/2)) $(wc -l <"$log")" >>"$OUT/trace"   # elapsed s, log lines: lab-when <label> <regex> maps a log line to a time
  grep -aqE "vk_dump: frame $frame: [0-9]+ passes" "$log" && { hit=1; break; }
  grep -aqE 'FATAL|=== end' "$log" && break
  kill -0 $pgid 2>/dev/null || break
done
t1=$(date +%s.%N)
# let the completion thread finish the PNGs: wait until the dump dir stops growing
prev=-1; for ((i=0;i<120;i++)); do s=$(du -sb "$OUT/dump" 2>/dev/null | cut -f1); [ "$s" = "$prev" ] && break; prev=$s; sleep 2; done
kill -- -$pgid 2>/dev/null; sleep 2; kill -9 -- -$pgid 2>/dev/null
D=$OUT/dump
printf 'time-to-dump %.0f s (hit=%s), dump %s\n' "$(awk "BEGIN{print $t1-$t0}")" $hit "$(du -sh $D 2>/dev/null | cut -f1)"
grep -aE "vk_dump: frame $frame: |FATAL" "$log" | tail -2 | cut -c1-150
echo "$(date +%H:%M) done $label: hit=$hit in $(awk "BEGIN{printf \"%.0f\", $t1-$t0}") s" >>"$FEED"
echo "NaN images: $(grep -cE ' nan [1-9]' $D/images.txt 2>/dev/null)"
P=$(grep -E '^pass [0-9]+: dispatch 8x9x12' $D/passes.txt 2>/dev/null | head -1 | awk '{print $2}' | tr -d :)
[ -n "$P" ] && { echo "first 8x9x12 dispatch = pass $P:"; grep -E "^pass_${P}_img[0-9]" $D/images.txt | cut -c1-170; }
F=$(ls $D/pass_*_t0_*_43_rgba8srgb.png 2>/dev/null | tail -1)
if [ -n "$F" ]; then
  [ $hit = 1 ] && [ $show = 1 ] && doshow=1 || doshow=0
  echo "final: ${F##*/}"; cp "$F" "$OUT/final.png"
  nix shell nixpkgs#imagemagick -c sh -c "if [ $doshow = 1 ]; then magick '$F' -resize 1280x720! '$ROOT/latest-frame.png.tmp' && mv '$ROOT/latest-frame.png.tmp' '$ROOT/latest-frame.png'; fi; magick '$F' -colorspace Gray -format 'final mean brightness %[fx:mean*100]%% max %[fx:maxima*100]%%\n' info:"
fi
grep -aiE 'shadow (write|storage)|write-?back' "$log" | head -5 | cut -c1-160
grep -aE 'frametime|frame rate:' "$log" | tail -3 | cut -c1-160
[ -n "${LAB_KEEP:-}" ] || rm -rf "$D"
