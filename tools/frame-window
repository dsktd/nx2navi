#!/usr/bin/env python3
"""frame-window [--json] <run.log> <t0-t1>...: fps mean / p99 / replay ms over game-time windows (60 Hz ticks, the
recording's clock), from NX2NAVI_TRACE=perf,present lines. Ticks per present come from the 'input: script frame F tick
T' anchors, with the present intervals integrated between them (game speed is 1.0 away from loads).
Was NX2navi-opt/gopt-scripts/an.py (field standing window, NOTES-perf-2026-11-09.md); tools/scenario uses it."""
import bisect
import json
import re
import sys


def windows(log, spans):
    perf = [(int(m[1]), float(m[2]), float(m[3])) for m in re.finditer(
        r'perf: frame (\d+): interval avg.*?render busy avg ([\d.]+) ms; replay avg ([\d.]+) ms;', log)]
    pres = [(int(m[1]), float(m[2])) for m in re.finditer(r'present: frame (\d+) interval ([\d.]+) ms', log)]
    anch = sorted({(int(m[1]), int(m[2])) for m in re.finditer(r'input: script frame (\d+) tick (\d+)', log)})
    af = [a[0] for a in anch]
    cum, t = {}, 0.0
    for f, d in pres:
        t += d
        cum[f] = t

    def tick(f):
        i = bisect.bisect_right(af, f) - 1
        if i < 0 or f not in cum or af[i] not in cum:
            return None
        return anch[i][1] + (cum[f] - cum[af[i]]) * 0.06

    out = []
    for t0, t1 in spans:
        sel = [(f, d) for f, d in pres if (x := tick(f)) is not None and t0 <= x < t1]
        if not sel:
            out.append({"ticks": [t0, t1], "frames": 0})
            continue
        f0, f1 = sel[0][0], sel[-1][0]
        iv = sorted(d for _, d in sel)
        pf = [p for p in perf if f0 + 60 <= p[0] <= f1]
        mean = sum(iv) / len(iv)
        pct = lambda q: iv[min(len(iv) - 1, int(q * len(iv)))]
        out.append({"ticks": [t0, t1], "presents": [f0, f1], "frames": len(iv), "fps": round(1000 / mean, 2),
                    "mean_ms": round(mean, 2), "p50_ms": round(pct(.5), 2), "p99_ms": round(pct(.99), 2),
                    "max_ms": round(iv[-1], 1),
                    "render_ms": round(sum(p[1] for p in pf) / max(1, len(pf)), 2),
                    "replay_ms": round(sum(p[2] for p in pf) / max(1, len(pf)), 2)})
    return out


def main(argv):
    as_json = argv[:1] == ["--json"]
    argv = argv[1:] if as_json else argv
    log = open(argv[0], errors="replace").read()
    res = windows(log, [tuple(map(float, w.split("-"))) for w in argv[1:]])
    if as_json:
        print(json.dumps(res))
        return
    for w in res:
        if not w["frames"]:
            print(f"  ticks {w['ticks']}: no data")
            continue
        print(f"  ticks {w['ticks']} (presents {w['presents']}): {w['frames']} frames, {w['fps']} fps, mean "
              f"{w['mean_ms']} p50 {w['p50_ms']} p99 {w['p99_ms']} max {w['max_ms']} ms; render busy "
              f"{w['render_ms']} ms, replay {w['replay_ms']} ms")


if __name__ == "__main__":
    main(sys.argv[1:])
