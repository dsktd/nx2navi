#!/usr/bin/env python3
"""nightly: the overnight regression run (ARCHITECTURE.md 11). Picks builds from builds.tsv, runs tools/suite on each
under the lab lock, bisects metric moves along the builds.tsv parent chains, writes results.tsv rows tagged `suite nightly`
and a summary to .lab/nightly/<date>.md. Not for iteration: iteration is one targeted ab-cell/load-cell; recommendations
wait for a nightly.

Picks, each logged with its reason: (1) baselines play13 and the default exe of runs/play.sh, every night as controls;
(2) the newest build on each active line (a leaf of the parent chains, built in the last 3 days) not yet suite-tested;
(3) any untested build whose change vs parent is significant (base bump, translator change, a patch whose knob is default
on), not knob-off experiments; (4) midpoints queued by an earlier bisect (.lab/nightly/queue.txt).
Bisect: a suite metric that moves between two tested builds on one chain by more than their summed half-ranges queues the
chain's untested midpoint (run the same night while time is left); adjacent builds that moved name the change.
Stops without running when a play log is under 2 min old (Cal is playing) or the lab lock is held for 30 min.
NIGHTLY_BUDGET_MIN (default 180) bounds the start of new suites (a suite is ~40 min at 3 reps); NIGHTLY_DRY=1 prints the plan.
About 3 h for 4 builds. Schedule: `tools/nightly` (e.g. 01:00).
"""
import datetime, fcntl, glob, os, re, subprocess, sys, time

R = os.path.expanduser('~/claude/nx2navi')
DRY = bool(os.environ.get('NIGHTLY_DRY'))
BUDGET = int(os.environ.get('NIGHTLY_BUDGET_MIN', '180')) * 60
T0 = time.time()
HIGHER = ('fps', 'fps_1pc_low')


def tsv(p):
    if not os.path.exists(p):
        return []
    l = [x.split('\t') for x in open(p).read().split('\n') if x]
    return [dict(zip(l[0], r)) for r in l[1:]]


B = tsv(R + '/builds.tsv')
order = [b['exe'] for b in B]
bx = {b['exe']: b for b in B}


def chain(e):
    c = []
    while e in bx and e not in c:
        c.append(e)
        e = bx[e]['parent']
    return c[::-1]


def tested():
    return {r['exe'] for r in tsv(R + '/results.tsv') if 'suite' in r['tool']}


def default_exe():
    m = re.search(r'NX2NAVI_EXE:-(\w+)', open(R + '/runs/play.sh').read())
    return m[1] if m else None


def significant(b):
    ch = b['changed']
    if 'base ' in ch or 'xlate ' in ch:
        return 'base/translator change'
    for n in re.findall(r'\+([0-9,]+)', ch):
        for p in n.split(','):
            for f in glob.glob('%s/patches/%s-*.patch' % (R, p)):
                s = open(f, errors='replace').read()
                if re.search(r'default[s ]*(1|on)\b|=1 \(0:', s) and not re.search(r'default[s ]*(0|off)\b', s[:6000]):
                    return 'patch %s has a default-on knob' % p
    return None


def pick():
    done, out = tested(), []
    add = lambda e, why: e in bx and e not in [x[0] for x in out] and out.append((e, why))
    add('play13', 'baseline')
    add(default_exe(), 'baseline: current default of runs/play.sh')
    q = R + '/.lab/nightly/queue.txt'
    if os.path.exists(q):
        for l in open(q).read().split('\n'):
            if l.strip() and l.strip() not in done:
                add(l.strip(), 'bisect midpoint from an earlier night')
    leaves = [e for e in order if e not in {b['parent'] for b in B}]
    cutoff = (datetime.date.today() - datetime.timedelta(days=3)).isoformat()
    for e in leaves:
        if e not in done and bx[e]['date'] >= cutoff and 'variant' not in bx[e]['note'] and 'lab variant' not in bx[e]['note']:
            add(e, 'newest build on its line (leaf of the parent chain)')
    for e in order:
        if e not in done:
            w = significant(bx[e])
            if w:
                add(e, 'significant change vs parent: ' + w)
    return out


def lock_wait():
    t = time.time()
    while subprocess.run(['flock', '-n', '/tmp/nx2navi-lab.lock', 'true']).returncode:
        if time.time() - t > 1800:
            return False
        time.sleep(30)
    return True


def cal_playing():
    logs = glob.glob(R + '/NX2navi/build/v111/logs/play-*.log')
    return bool(logs) and time.time() - max(os.path.getmtime(l) for l in logs) < 120


LOCKFD = None


def quiet_host():
    """Hold the build lock for the whole run (builds take `flock /tmp/nx2navi-build.lock`, so none lands beside a cell)."""
    global LOCKFD
    if DRY:
        return True
    LOCKFD = open('/tmp/nx2navi-build.lock', 'w')
    t = time.time()
    while True:
        try:
            fcntl.flock(LOCKFD, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.time() - t > 1800:
                print('a build holds /tmp/nx2navi-build.lock for 30 min: stop')
                return False
            time.sleep(30)


def host_state():
    g = {}
    for k in ('power_dpm_force_performance_level', 'pp_dpm_sclk'):
        for f in glob.glob('/sys/class/drm/card*/device/' + k):
            try:
                g[k] = open(f).read().replace('\n', ' ').strip()
                break
            except OSError:
                pass
    return 'load %s; gpu %s' % (open('/proc/loadavg').read().split()[0], g or 'clocks not readable')


def run_suite(e):
    if DRY:
        print('would run: SUITE_DRY=1 tools/suite', e)
        return True
    if cal_playing():
        print('Cal is playing: stop'); return False
    if subprocess.run([R + '/tools/store-build', 'verify', e]).returncode:
        print('%s is not the stored build (or not stored): skipped' % e); return None
    HOST.append('%s: %s' % (e, host_state()))
    if not lock_wait():
        print('lab lock held over 30 min: stop'); return False
    env = dict(os.environ, RESULTS_TAG='suite nightly')
    return subprocess.run([R + '/tools/suite', e], env=env).returncode == 0


def metrics():
    M = {}
    for r in tsv(R + '/results.tsv'):
        if 'suite' in r['tool']:
            M.setdefault((r['scenario'], r['metric']), {})[r['exe']] = (float(r['mean']), float(r['min']), float(r['max']))
    return M


def bisect(M):
    """-> (queue of untested midpoints, list of isolated changes)"""
    q, found = [], []
    for k, d in M.items():
        for a in d:
            for b in d:
                ca = chain(b)
                if a == b or a not in ca:
                    continue
                (ma, lo_a, hi_a), (mb, lo_b, hi_b) = d[a], d[b]
                if abs(mb - ma) <= (hi_a - lo_a) / 2 + (hi_b - lo_b) / 2 + 1e-9:
                    continue
                between = ca[ca.index(a) + 1:-1]
                if any(x in d for x in between):
                    continue                      # a nearer tested pair covers it
                if between:
                    q.append(between[len(between) // 2])
                else:
                    found.append((k, a, b, ma, mb, bx[b]['changed']))
    return sorted(set(q)), found


def prune(queue, ran):
    """Cal's rule: a build leaves the store once a nightly has recorded it, unless it is a baseline, the default, a pending
    bisect candidate or endpoint, or the newest build on an active line. Frees build/store/<exe>-<commit> and build/v111/nx2navi.<exe>."""
    nightly = {r['exe'] for r in tsv(R + '/results.tsv') if 'nightly' in r['tool']}
    keep = {'play13', default_exe()} | set(queue)
    keep |= {e for e in order if e not in {b['parent'] for b in B} and bx[e]['date'] >= (datetime.date.today() - datetime.timedelta(days=3)).isoformat()}
    for k, d in metrics().items():   # endpoints of an unresolved move stay
        for a in d:
            for b in d:
                if a != b and a in chain(b):
                    between = chain(b)[chain(b).index(a) + 1:-1]
                    if any(x in queue for x in between):
                        keep |= {a, b}
    freed, gone = 0, []
    for e in sorted(nightly - keep):
        r = bx[e]
        if ' sha256:' not in r.get('store', ''):
            continue
        d = R + '/' + r['store'].split(' sha256:')[0]
        sz = sum(os.path.getsize(os.path.join(a, f)) for a, _, fs in os.walk(d) for f in fs)
        gone.append('%s (%.0f MB)' % (e, sz / 1e6))
        freed += sz
        if not DRY:
            subprocess.run(['chmod', '-R', 'u+w', d]); subprocess.run(['rm', '-rf', d])
            x = '%s/NX2navi/build/v111/nx2navi.%s' % (R, e)
            if os.path.exists(x):
                freed += os.path.getsize(x); os.remove(x)
            lines = [l.split('\t') for l in open(R + '/builds.tsv').read().split('\n') if l]
            for l in lines[1:]:
                if l[0] == e:
                    l[-1] = 'pruned ' + datetime.date.today().isoformat()
            tmp = R + '/builds.tsv.nightly'
            open(tmp, 'w').write(''.join('\t'.join(l) + '\n' for l in lines)); os.rename(tmp, R + '/builds.tsv')
    return 'pruned from the store: %s; %.1f GB freed' % (', '.join(gone) or 'none', freed / 1e9)


def summary(plan, queue, found, ran, pruned=''):
    M, day = metrics(), datetime.date.today().isoformat()
    de = default_exe()
    L = ['# Nightly %s' % day, '', 'Picked (reason):'] + ['- %s: %s%s' % (e, w, '' if e in ran else ' (not run)') for e, w in plan]
    L += ['', '| metric | best build | default %s | regressions vs default (beyond spread) |' % de, '|---|---|---|---|']
    for k, d in sorted(M.items()):
        if k[1].startswith('ab_'):
            continue
        hi = k[1] in HIGHER
        best = (max if hi else min)(d, key=lambda e: d[e][0])
        reg = []
        if de in d:
            m0, l0, h0 = d[de]
            for e, (m, lo, h_) in d.items():
                if e != de and abs(m - m0) > (h0 - l0) / 2 + (h_ - lo) / 2 and (m < m0 if hi else m > m0):
                    reg.append('%s %.2f' % (e, m))
        L.append('| %s / %s | %s %.2f | %s | %s |' % (k[0], k[1], best, d[best][0], ('%.2f' % d[de][0]) if de in d else '-', ', '.join(reg) or '-'))
    bad = [r for r in tsv(R + '/results.tsv') if r.get('status', 'ok') != 'ok' and r['exe'] in ran and 'suite' in r['tool']]
    L += ['', 'Crashes / device loss / no start (count as regressions): ' + (', '.join('%s %s %s' % (r['exe'], r['scenario'], r['status']) for r in bad) or 'none')]
    L += ['', 'Host at start of each build: ' + '; '.join(HOST)]
    L += ['', 'Bisect:'] + ['- %s / %s moved %.2f -> %.2f between adjacent builds %s and %s; change: %s' % (k[0], k[1], ma, mb, a, b, ch) for k, a, b, ma, mb, ch in found]
    L += ['- queued for the next night: ' + (', '.join(queue) or 'none')]
    L += ['', pruned]
    L += ['', 'Shots flagged for Cal (not pass/fail):']
    for e in ran:
        f = '%s/.lab/suite/%s/shots.txt' % (R, e)
        if os.path.exists(f):
            L += ['- ' + x for x in open(f).read().split('\n') if 'FLAG' in x]
    os.makedirs(R + '/.lab/nightly', exist_ok=True)
    open('%s/.lab/nightly/%s.md' % (R, day), 'w').write('\n'.join(L) + '\n')
    open(R + '/.lab/nightly/queue.txt', 'w').write('\n'.join(queue) + '\n')
    print('\n'.join(L))


HOST = []


def main():
    plan, ran = pick(), []
    if not quiet_host():
        return
    todo = list(plan)
    while todo:
        e, why = todo.pop(0)
        if time.time() - T0 > BUDGET - 2400 and not DRY:
            print('budget: not starting %s' % e); break
        print('nightly: %s (%s)' % (e, why), flush=True)
        ok = run_suite(e)
        if ok is None:
            continue
        if not ok:
            break
        ran.append(e)
        if not DRY:
            q, _ = bisect(metrics())
            for m in q:
                if m not in ran and m not in [x[0] for x in todo]:
                    todo.append((m, 'bisect midpoint'))
                    plan.append((m, 'bisect midpoint (same night)'))
    q, found = bisect(metrics())
    queue = [x for x in q if x not in ran]
    pr = prune(queue, ran)
    summary(plan, queue, found, ran, pr)
    # morning digest one-liner and the regressions list for tracker notes (ARCHITECTURE.md 11)
    dd = os.path.expanduser('~/claude/.services/digest/inputs')
    if DRY:
        return
    os.makedirs(dd, exist_ok=True)
    open(dd + '/nx2navi.txt', 'w').write('NX2navi nightly %s: %d build(s) tested (%s); %d bisect move(s) isolated; see .lab/nightly/%s.md\n' % (
        datetime.date.today(), len(ran), ', '.join(ran), len(found), datetime.date.today()))


main()
