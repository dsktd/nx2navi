#!/usr/bin/env python3
"""nightly: the overnight regression run (ARCHITECTURE.md 11). Picks builds from builds.tsv, runs tools/suite on each
under the lab lock, bisects metric moves along the builds.tsv parent chains, writes results.tsv rows tagged `suite nightly`
and a summary to .lab/nightly/<date>.md. Not for iteration: iteration is one targeted ab-cell/load-cell; recommendations
wait for a nightly.

Picks, each logged with its reason: (1) baselines play13 and the default exe of runs/play.sh, every night as controls;
(2) the newest build on each active line (a leaf of the parent chains, built in the last 3 days) not yet suite-tested;
(3) any untested build whose change vs parent is significant (base bump, translator change, a patch whose knob is default
on), not knob-off experiments; (4) midpoints queued by an earlier bisect (.lab/nightly/queue.txt).
Bisect: a suite metric that moves between two tested builds on one chain by more than their summed half-ranges queues the
chain's untested midpoint (run the same night while time is left); adjacent builds that moved name the change.
Stops without running when a play log is under 2 min old (Cal is playing) or the lab lock is held for 30 min.
NIGHTLY_BUDGET_MIN (default 180) bounds the start of new suites (a suite is ~25 min at 3 reps); NIGHTLY_DRY=1 prints the plan.
About 2 h for 4 builds. Schedule: `tools/nightly` (e.g. 01:00).
"""
import datetime, fcntl, glob, hashlib, os, re, shutil, subprocess, sys, time

R = os.environ.get('NIGHTLY_ROOT') or os.path.expanduser('~/claude/nx2navi')   # NIGHTLY_ROOT: a fake tree (tests)
V = R + '/NX2navi/build/v111'
STORE = R + '/NX2navi/build/store'
DRY = bool(os.environ.get('NIGHTLY_DRY'))
BUDGET = int(os.environ.get('NIGHTLY_BUDGET_MIN', '180')) * 60
T0 = time.time()
SUITE_S = 25 * 60   # one tools/suite at 3 reps (10 boots)
HIGHER = ('fps', 'fps_1pc_low')


def tsv(p):
    if not os.path.exists(p):
        return []
    l = [x.split('\t') for x in open(p).read().split('\n') if x]
    return [dict(zip(l[0], r)) for r in l[1:]]


B, order, bx = [], [], {}


def load_builds():
    global B, order, bx
    B = tsv(R + '/builds.tsv')
    order = [b['exe'] for b in B]
    bx = {b['exe']: b for b in B}


load_builds()


def chain(e):
    c = []
    while e in bx and e not in c:
        c.append(e)
        e = bx[e]['parent']
    return c[::-1]


def tested():
    return {r['exe'] for r in tsv(R + '/results.tsv') if 'suite' in r['tool']}


def default_exe():
    m = re.search(r'NX2NAVI_EXE:-(\w+)', open(R + '/runs/play.sh').read())
    return m[1] if m else None


def significant(b):
    ch = b['changed']
    if 'base ' in ch or 'xlate ' in ch:
        return 'base/translator change'
    for n in re.findall(r'\+([0-9,]+)', ch):
        for p in n.split(','):
            for f in glob.glob('%s/patches/%s-*.patch' % (R, p)):
                s = open(f, errors='replace').read()
                if re.search(r'default[s ]*(1|on)\b|=1 \(0:', s) and not re.search(r'default[s ]*(0|off)\b', s[:6000]):
                    return 'patch %s has a default-on knob' % p
    return None


def pick():
    done, out = tested(), []
    add = lambda e, why: e in bx and e not in [x[0] for x in out] and out.append((e, why))
    add('play13', 'baseline')
    add(default_exe(), 'baseline: current default of runs/play.sh')
    q = R + '/.lab/nightly/queue.txt'
    if os.path.exists(q):
        for l in open(q).read().split('\n'):
            if l.strip() and l.strip() not in done:
                add(l.strip(), 'bisect midpoint from an earlier night')
    leaves = [e for e in order if e not in {b['parent'] for b in B}]
    cutoff = (datetime.date.today() - datetime.timedelta(days=3)).isoformat()
    for e in leaves:
        if e not in done and bx[e]['date'] >= cutoff and 'variant' not in bx[e]['note'] and 'lab variant' not in bx[e]['note']:
            add(e, 'newest build on its line (leaf of the parent chain)')
    for e in order:
        if e not in done:
            w = significant(bx[e])
            if w:
                add(e, 'significant change vs parent: ' + w)
    return out


def lock_wait():
    t = time.time()
    while subprocess.run(['flock', '-n', '/tmp/nx2navi-lab.lock', 'true']).returncode:
        if time.time() - t > 1800:
            return False
        time.sleep(30)
    return True


def cal_playing():
    logs = glob.glob(V + '/logs/play-*.log')
    return bool(logs) and time.time() - max(os.path.getmtime(l) for l in logs) < 120


def cal_exes():
    """Exes Cal may be running: the one named in the newest play log's build line (any age), plus any nx2navi.* a visible
    process runs from build/v111. Never pruned."""
    out = set()
    logs = sorted(glob.glob(V + '/logs/play-*.log'), key=os.path.getmtime)
    if logs:
        m = re.search(r'build: entry=\S+ exe=nx2navi\.(\S+)', open(logs[-1], errors='replace').read(60000))
        if m:
            out.add(m[1])
    for p in glob.glob('/proc/[0-9]*/exe'):
        try:
            x = os.readlink(p)
        except OSError:
            continue
        if x.startswith(V + '/nx2navi.'):
            out.add(x[len(V) + 9:].replace(' (deleted)', ''))
    return out


LOCKFD = None


def quiet_host():
    """Hold the build lock for the whole run (builds take `flock /tmp/nx2navi-build.lock`, so none lands beside a cell)."""
    global LOCKFD
    if DRY:
        return True
    LOCKFD = open('/tmp/nx2navi-build.lock', 'w')
    t = time.time()
    while True:
        try:
            fcntl.flock(LOCKFD, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.time() - t > 1800:
                print('a build holds /tmp/nx2navi-build.lock for 30 min: stop')
                return False
            time.sleep(30)


def host_state():
    g = {}
    for k in ('power_dpm_force_performance_level', 'pp_dpm_sclk'):
        for f in glob.glob('/sys/class/drm/card*/device/' + k):
            try:
                g[k] = open(f).read().replace('\n', ' ').strip()
                break
            except OSError:
                pass
    return 'load %s; gpu %s' % (open('/proc/loadavg').read().split()[0], g or 'clocks not readable')


def run_suite(e):
    if DRY:
        print('would run: SUITE_DRY=1 tools/suite', e)
        return True
    if cal_playing():
        print('Cal is playing: stop'); return False
    if subprocess.run([R + '/tools/store-build', 'verify', e]).returncode:
        print('%s is not the stored build (or not stored): skipped' % e); return None
    HOST.append('%s: %s' % (e, host_state()))
    if not lock_wait():
        print('lab lock held over 30 min: stop'); return False
    env = dict(os.environ, RESULTS_TAG='suite nightly')
    return subprocess.run([R + '/tools/suite', e], env=env).returncode == 0


def metrics():
    M = {}
    for r in tsv(R + '/results.tsv'):
        if 'suite' in r['tool']:
            M.setdefault((r['scenario'], r['metric']), {})[r['exe']] = (float(r['mean']), float(r['min']), float(r['max']), r.get('env', ''))
    return M


def bisect(M):
    """-> (queue of untested midpoints, list of isolated changes, unresolved ranges as (a, b, [between])).
    Rows from different host envs (env column) are not compared: that is drift, reported apart."""
    q, found, ranges = [], [], []
    for k, d in M.items():
        for a in d:
            for b in d:
                ca = chain(b)
                if a == b or a not in ca:
                    continue
                (ma, lo_a, hi_a, ea), (mb, lo_b, hi_b, eb) = d[a], d[b]
                if ea and eb and ea != eb:
                    continue
                if abs(mb - ma) <= (hi_a - lo_a) / 2 + (hi_b - lo_b) / 2 + 1e-9:
                    continue
                between = ca[ca.index(a) + 1:-1]
                if any(x in d for x in between):
                    continue                      # a nearer tested pair covers it
                if between:
                    q.append(between[len(between) // 2])
                    ranges.append((a, b, between))
                else:
                    found.append((k, a, b, ma, mb, bx[b]['changed']))
    return sorted(set(q)), found, ranges


def prune(ranges, assume_tested=()):
    """Cal's rule (2026-11-12): a build not yet tested by a nightly stays. After its nightly it stays only as a baseline
    (play13, the default exe of runs/play.sh), the newest build on an active line (a parent-chain leaf built in the last 3
    days), a bisect endpoint or a build inside an unresolved bisect range; the rest leave: build/store/<exe>-<commit>/ and
    build/v111/nx2navi.<exe>. Never touched: Cal's exe (cal_exes), anything while a play log is under 2 min old, anything
    outside build/store and build/v111/nx2navi.play*. assume_tested: builds counted as nightly-tested (the dry-run report
    of what tonight would delete once its picks have run). -> (report line, [(exe, why kept)])"""
    if cal_playing():
        return 'prune skipped: a play log is under 2 min old (Cal is playing)', []
    nightly = {r['exe'] for r in tsv(R + '/results.tsv') if 'nightly' in r['tool']} | set(assume_tested)
    cutoff = (datetime.date.today() - datetime.timedelta(days=3)).isoformat()
    parents = {b['parent'] for b in B}
    why = {}
    for e in order:
        if e not in nightly:
            why[e] = 'not yet tested by a nightly'
    why.setdefault('play13', 'baseline')
    why.setdefault(default_exe(), 'baseline: default of runs/play.sh')
    for e in order:
        if e not in parents and bx[e]['date'] >= cutoff:
            why.setdefault(e, 'newest on an active line')
    for a, b, between in ranges:
        why.setdefault(a, 'bisect endpoint'); why.setdefault(b, 'bisect endpoint')
        for x in between:
            why.setdefault(x, 'inside an unresolved bisect range %s..%s' % (a, b))
    for e in cal_exes():
        why[e] = "Cal's exe (newest play log or running)"
    freed, gone, store_real, v_real = 0, [], os.path.realpath(STORE), os.path.realpath(V)
    for e in order:
        if e in why or not re.fullmatch(r'play\w+', e):
            continue
        st_ = bx[e].get('store', '')
        if ' sha256:' not in st_:
            continue
        d = os.path.realpath(R + '/' + st_.split(' sha256:')[0])
        if os.path.dirname(d) != store_real or not os.path.basename(d).startswith(e + '-') or not os.path.isdir(d):
            print('prune: %s store path %s is not a build/store/<exe>-<commit> dir: left alone' % (e, d)); continue
        x = '%s/nx2navi.%s' % (V, e)
        sz = sum(os.path.getsize(os.path.join(a, f)) for a, _, fs in os.walk(d) for f in fs)
        if os.path.isfile(x) and not os.path.islink(x) and os.path.dirname(os.path.realpath(x)) == v_real:
            sz += os.path.getsize(x)
        else:
            x = None
        gone.append('%s (%.0f MB)' % (e, sz / 1e6)); freed += sz
        if DRY:
            continue
        subprocess.run(['chmod', '-R', 'u+w', d]); shutil.rmtree(d)
        if x:
            os.remove(x)
        lines = [l.split('\t') for l in open(R + '/builds.tsv').read().split('\n') if l]
        si = lines[0].index('store')
        for l in lines[1:]:
            if l[0] == e:
                l += [''] * (si + 1 - len(l))
                l[si] = 'pruned %s (was %s)' % (datetime.date.today().isoformat(), l[si].split(' sha256:')[0])
        tmp = R + '/builds.tsv.nightly'
        open(tmp, 'w').write(''.join('\t'.join(l) + '\n' for l in lines)); os.rename(tmp, R + '/builds.tsv')
    verb = 'would prune' if DRY else 'pruned'
    return '%s from the store: %s; %.1f GB %s' % (verb, ', '.join(gone) or 'none', freed / 1e9, 'to free' if DRY else 'freed'), \
        sorted((e, w) for e, w in why.items() if e in bx and ' sha256:' in bx[e].get('store', ''))


def summary(plan, queue, found, ran, pruned='', extra=()):
    M, day = metrics(), datetime.date.today().isoformat()
    de = default_exe()
    L = ['# Nightly %s' % day, '', 'Picked (reason):'] + ['- %s: %s%s' % (e, w, '' if e in ran else ' (not run)') for e, w in plan]
    L += ['', '| metric | best build | default %s | regressions vs default (beyond spread) |' % de, '|---|---|---|---|']
    for k, d in sorted(M.items()):
        if k[1].startswith('ab_'):
            continue
        hi = k[1] in HIGHER
        best = (max if hi else min)(d, key=lambda e: d[e][0])
        reg = []
        if de in d:
            m0, l0, h0, e0 = d[de]
            for e, (m, lo, h_, ee) in d.items():
                if e != de and abs(m - m0) > (h0 - l0) / 2 + (h_ - lo) / 2 and (m < m0 if hi else m > m0):
                    reg.append('%s %.2f%s' % (e, m, ' (host env differs: drift, not a regression)' if ee and e0 and ee != e0 else ''))
        L.append('| %s / %s | %s %.2f | %s | %s |' % (k[0], k[1], best, d[best][0], ('%.2f' % d[de][0]) if de in d else '-', ', '.join(reg) or '-'))
    bad = [r for r in tsv(R + '/results.tsv') if r.get('status', 'ok') != 'ok' and r['exe'] in ran and 'suite' in r['tool']]
    L += ['', 'Crashes / device loss / no start (count as regressions): ' + (', '.join('%s %s %s' % (r['exe'], r['scenario'], r['status']) for r in bad) or 'none')]
    L += ['', 'Host at start of each build: ' + '; '.join(HOST)]
    L += ['', 'Bisect:'] + ['- %s / %s moved %.2f -> %.2f between adjacent builds %s and %s; change: %s' % (k[0], k[1], ma, mb, a, b, ch) for k, a, b, ma, mb, ch in found]
    L += ['- queued for the next night: ' + (', '.join(queue) or 'none')]
    L += ['', pruned] + list(extra)
    vis = [v for v in tsv(R + '/visual.tsv') if v['date'] == day and v['status'] == 'flagged']
    vis.sort(key=lambda v: -float(v['score'] or 0))
    L += ['', 'Needs Cal (visual pairs flagged tonight, top 3 by score of %d; never a blocker; /results/review.html): %s' % (
        len(vis), '; '.join('#%s %s %s|%s %s' % (v['id'], v['scenario'], v['a'], v['b'], v['score']) for v in vis[:3]) or 'none')]
    os.makedirs(R + '/.lab/nightly', exist_ok=True)
    open('%s/.lab/nightly/%s.md' % (R, day), 'w').write('\n'.join(L) + '\n')
    open(R + '/.lab/nightly/queue.txt', 'w').write('\n'.join(queue) + '\n')
    print('\n'.join(L))


HOST = []


def env_drift():
    """Host env of tonight vs the last nightly's (results.tsv `env` hashes, .lab/env/<hash>.txt): reported apart from
    build regressions."""
    now = subprocess.run([R + '/tools/host-env'], capture_output=True, text=True).stdout.split()[:1]
    now = now[0] if now else '?'
    prev = [r.get('env', '') for r in tsv(R + '/results.tsv') if 'nightly' in r['tool'] and r.get('env')]
    if not prev or prev[-1] == now:
        return ['Host env: %s%s' % (now, '' if prev else ' (first nightly with an env hash)')]
    rd = lambda h: set(open('%s/.lab/env/%s.txt' % (R, h)).read().split('\n')) if os.path.exists('%s/.lab/env/%s.txt' % (R, h)) else set()
    a, b = rd(prev[-1]), rd(now)
    return ['Host env DRIFT %s -> %s: %s' % (prev[-1], now, '; '.join(sorted(x for x in b - a if x)) or 'details not kept')]


def upstream():
    """Fetch upstream (origin of the NX2navi worktree) and flag new commits that touch a file one of our patches touches."""
    g = ['git', '-C', R + '/NX2navi']
    if not DRY:
        subprocess.run(g + ['fetch', '-q', 'origin'])
    seenf = R + '/.lab/nightly/upstream-seen'
    seen = open(seenf).read().strip() if os.path.exists(seenf) else ''
    head = subprocess.run(g + ['rev-parse', 'origin/main'], capture_output=True, text=True).stdout.strip()
    if not head:
        return ['Upstream: fetch/rev-parse failed']
    if not seen:
        seen = subprocess.run(g + ['merge-base', 'rebase-upstream', 'origin/main'], capture_output=True, text=True).stdout.strip()
    ours = set()
    for f in glob.glob(R + '/patches/*.patch'):
        ours |= set(re.findall(r'^diff --git a/(\S+)', open(f, errors='replace').read(), re.M))
    log = subprocess.run(g + ['log', '--format=@%h %s', '--name-only', *(['%s..%s' % (seen, head)] if seen else ['-20', head])],
                         capture_output=True, text=True).stdout
    L, n = [], 0
    for c in log.split('@')[1:]:
        lines = [x for x in c.split('\n') if x]
        n += 1
        hit = sorted(f for f in set(lines[1:]) & ours if f != 'runtime/cfg.c' and not f.startswith('docs/'))   # cfg.c: every knob
        if hit:
            L.append('- FLAG %s touches our patched files: %s' % (lines[0][:90], ', '.join(hit[:6])))
    if not DRY:
        os.makedirs(os.path.dirname(seenf), exist_ok=True)
        open(seenf, 'w').write(head + '\n')
    return ['Upstream: %d new commit(s) since %s, %d touch files our patches touch (cfg.c and docs not counted)%s' % (
        n, seen[:9] or '?', len(L), ':' if L else '')] + L[:12] + (['- ... %d more: git -C NX2navi log %s..origin/main' % (len(L) - 12, seen[:9])] if len(L) > 12 else [])


def ingest_cal():
    """Cal's play logs (build/v111/logs/play-*.log, finished: over 2 min old) into results.tsv, tool `cal` (results-add cal;
    rows already there are skipped)."""
    if DRY:
        return []
    logs = [l for l in sorted(glob.glob(V + '/logs/play-*.log')) if time.time() - os.path.getmtime(l) > 120]
    r = subprocess.run([R + '/tools/results-add', 'cal'] + logs, capture_output=True, text=True)
    return ['Cal play logs: ' + (r.stderr.strip().split('\n')[-1] if r.stderr.strip() else 'none')]


def main():
    plan, ran = pick(), []
    extra = env_drift() + upstream() + ingest_cal()
    if DRY:
        _, _, ranges = bisect(metrics())
        fit = max(1, (BUDGET - 1500) // SUITE_S + 1)   # suites started while under BUDGET - 25 min
        line, kept = prune(ranges, assume_tested=[e for e, _ in plan[:fit]])
        print('Tonight would test (in order, budget %d min, ~%d suites fit):' % (BUDGET // 60, fit))
        for k, (e, w) in enumerate(plan):
            print('  %s: %s%s' % (e, w, '' if k < fit else ' (beyond the budget: a later night)'))
        print('Prune, once those are tested (dry run, nothing deleted): ' + line)
        print('Kept in the store: ' + '; '.join('%s (%s)' % kw for kw in kept))
        print('\n'.join(extra))
        return
    if not quiet_host():
        return
    os.environ['CELL_REDO'] = '1'   # cells whose load average rose above the threshold during a run redo it once
    todo = list(plan)
    while todo:
        e, why = todo.pop(0)
        if time.time() - T0 > BUDGET - 1500:
            print('budget: not starting %s' % e); break
        print('nightly: %s (%s)' % (e, why), flush=True)
        ok = run_suite(e)
        if ok is None:
            continue
        if not ok:
            break
        ran.append(e)
        q, _, _ = bisect(metrics())
        for m in q:
            if m not in ran and m not in [x[0] for x in todo]:
                todo.append((m, 'bisect midpoint'))
                plan.append((m, 'bisect midpoint (same night)'))
    q, found, ranges = bisect(metrics())
    queue = [x for x in q if x not in ran]
    pr, _ = prune(ranges)
    summary(plan, queue, found, ran, pr, extra)
    dd = os.path.expanduser('~/claude/.services/digest/inputs')
    os.makedirs(dd, exist_ok=True)
    open(dd + '/nx2navi.txt', 'w').write('NX2navi nightly %s: %d build(s) tested (%s); %d bisect move(s) isolated; %s; see .lab/nightly/%s.md\n' % (
        datetime.date.today(), len(ran), ', '.join(ran), len(found), pr, datetime.date.today()))


if __name__ == '__main__':
    main()
