#!/usr/bin/env python3
"""Fake yakin motion socket: serves YAKMOT1 records of a steady yaw at 250 Hz.

Usage: yakmot-fake [PATH] [YAW_RAD_S]   (default $XDG_RUNTIME_DIR/yakin/motion.sock, 1.0)
Controller lying flat (accel +y = 9.80665 m/s^2), gyro y = YAW_RAD_S, SDL3 axes and units.
"""
import os
import socket
import struct
import sys
import threading
import time


def serve(conn, yaw):
    conn.sendall(b"YAKMOT1\0")
    try:
        while True:
            us = time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000
            conn.sendall(struct.pack("<Q6f", us, 0.0, 9.80665, 0.0, 0.0, yaw, 0.0))
            time.sleep(0.004)
    except OSError:
        pass
    finally:
        conn.close()


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.environ["XDG_RUNTIME_DIR"], "yakin", "motion.sock")
    yaw = float(sys.argv[2]) if len(sys.argv) > 2 else 1.0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        os.unlink(path)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    srv.listen(4)
    print(f"yakmot-fake: {path}, yaw {yaw} rad/s", flush=True)
    try:
        while True:
            conn, _ = srv.accept()
            print("yakmot-fake: client", flush=True)
            threading.Thread(target=serve, args=(conn, yaw), daemon=True).start()
    finally:
        os.unlink(path)


if __name__ == "__main__":
    main()
