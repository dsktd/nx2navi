#!/usr/bin/env python3
"""warp-save <profile-dir> scene=<name> [entrance=<index|name>] [pos=x,y,z] [yaw=<deg>] [face=<deg>] [age=child|adult] [slot=<n>]

Teleport by save edit: rewrites progress.sav in a profile COPY so loading it puts Link in that scene at that spot.
Refuses Cal's live profile. Edits every slot_*/progress.sav (or only slot=<n>) under <profile>/save/<uid>/.
scene: a tools/scenes.toml name, matched case/space/underscore-insensitively, with the age suffix tried
(scene="lost woods" age=child -> LostWood_Child). entrance: index or name in the scene's StartPos list (default 0);
pos/yaw override it. yaw= writes Player_Rot_For_Map/0xa4aee8cd only, which the spawn IGNORES (2026-11-12): kept so
old scenarios keep their view. face=<deg> turns Link: the spawn takes his facing from float 0x1ea93bd8 (= -face in
radians); face is the recipes' convention (the actor's matrix, atan2(m[6], m[8]); 0xa4aee8cd = 180 - face). age defaults from the scene suffix, else the save's own. time= is not supported yet.
gd=<recipe file>: also writes the recipe's `# gd <kind> <hash> <value hex>` lines (a mark's game data, recipe v1) into
the save: each into the pair of that hash in the save's section of that kind (the save holds the game data's kinds in
order, each section opened by a pair {0, kind}); values of kinds kept inline (bool 0, int 2, float 4, enum 6, uint 20)
only, and `# gda <kind> <hash> <count> <index>:<value hex>...` arrays of 4-byte elements (int 3, float 5, enum 7,
uint 21; the save holds a u32 count, then the elements, at the pair's offset; elements not listed are 0; an array whose
count differs is left). Recipe v2 adds `# gdv 10 <hash> <x>,<y>,<z>` vectors (float bits in hex) and `# gdt 16 <hash>
<text>` 64-character texts (%XX escapes; the Sequence_Reserved* texts of a change of area under way are left), both
values the save holds at an offset. Applied before scene/pos/yaw/age, so those win. Prints how many changed and how
many hashes the save lacks.
Save layout (1.1.1, found 2026-11-11): magic 04030201, then (u32 murmur3 hash, u32 value) pairs from 0x28;
String64/Vector3 values are offsets to the data. Keys used: 0x1d6189da current scene (String64), Player_Pos_For_Map
+ 0x960ad56a, 0xc884818d, 0x8773f02d (Vector3, all hold Link's position), Player_Rot_For_Map + 0xa4aee8cd (float
yaw, degrees), Sequence_IsChildhood (bool).
"""
import glob, math, os, re, struct, subprocess, sys, tomllib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mm3 import mm3

HERE = os.path.dirname(os.path.abspath(__file__))
K_SCENE = 0x1D6189DA
K_POS = [mm3("Player_Pos_For_Map"), 0x960AD56A, 0xC884818D, 0x8773F02D]
K_YAW = [mm3("Player_Rot_For_Map"), 0xA4AEE8CD]
K_CHILD = mm3("Sequence_IsChildhood")
K_FACE = 0x1EA93BD8   # float, kind 4: -facing in radians, what the spawn turns Link to


def die(msg):
    sys.exit(f"warp-save: {msg}")


def parse(args):
    spec = {}
    for a in args:
        k, _, v = a.partition("=")
        if not v: die(f"bad argument {a!r}")
        spec[k] = v
    for k in spec:
        if k not in ("scene", "entrance", "pos", "yaw", "age", "slot", "time", "gd", "face"): die(f"unknown key {k}")
    if "time" in spec: die("time= is not supported yet")
    if "scene" not in spec: die("scene= is required")
    return spec


def find_scene(scenes, want, age):
    norm = lambda s: re.sub(r"[\s_]", "", s).lower()
    by = {norm(n): n for n in scenes}
    w = norm(want)
    for w in (w, w.rstrip("s")):
        for c in ([w + norm("_" + age)] if age else []) + [w, w + "child", w + "adult"]:
            if c in by: return by[c]
    die(f"no scene {want!r} (see tools/scenes.toml)")


INLINE = {0, 2, 4, 6, 20}


ARRAYS = {3, 5, 7, 21}


K_RESERVED = {mm3(n) for n in ("Sequence_ReservedNextBanc", "Sequence_ReservedNextStartPosName",
                                 "Sequence_ReservedBootEventName", "Sequence_ReservedEventStarterName")}


def unescape(s):
    return re.sub(rb"%([0-9A-Fa-f]{2})", lambda m: bytes([int(m.group(1), 16)]), s.encode())


def read_gd(path):
    """{(kind, hash): u32 | (count, {index: u32}) | ("vec", bytes) | ("text", bytes)} from a recipe's # gd / # gda
    (v1) and # gdv / # gdt (v2) lines."""
    gd = {}
    for l in open(path):
        f = l.split()
        if len(f) == 5 and f[:3] == ["#", "gdv", "10"]:
            gd[(10, int(f[3], 16))] = ("vec", struct.pack("<3I", *(int(x, 16) for x in f[4].split(","))))
            continue
        if len(f) in (4, 5) and f[:3] == ["#", "gdt", "16"] and int(f[3], 16) not in K_RESERVED:
            gd[(16, int(f[3], 16))] = ("text", unescape(f[4] if len(f) == 5 else "")[:63].ljust(64, b"\0"))
            continue
        if len(f) == 5 and f[:2] == ["#", "gd"] and int(f[2]) in INLINE:
            gd[(int(f[2]), int(f[3], 16))] = int(f[4], 16)
        elif len(f) >= 5 and f[:2] == ["#", "gda"] and int(f[2]) in ARRAYS:
            el = {int(i): int(v, 16) for i, v in (x.split(":") for x in f[5:])}
            gd[(int(f[2]), int(f[3], 16))] = (int(f[4]), el)
    return gd


def apply_gd(b, gd):
    """{(kind, hash): u32} into the save's sections; returns (changed, missing)."""
    kind, seen, changed = 0, set(), 0
    for o in range(0x28, struct.unpack_from("<I", b, 8)[0], 8):   # +8: where the pairs end and their data starts
        h, v = struct.unpack_from("<II", b, o)
        if h == 0:
            if v <= kind: break
            kind = v
            continue
        want = gd.get((kind, h))
        if want is None: continue
        seen.add((kind, h))
        if isinstance(want, tuple) and want[0] in ("vec", "text"):
            data = want[1]
            if b[v:v + len(data)] != data: b[v:v + len(data)] = data; changed += 1
        elif isinstance(want, tuple):
            n, el = want
            if struct.unpack_from("<I", b, v)[0] != n: continue
            new = struct.pack(f"<{n}I", *(el.get(i, 0) for i in range(n)))
            if b[v + 4:v + 4 + 4 * n] != new: b[v + 4:v + 4 + 4 * n] = new; changed += 1
        elif want != v: struct.pack_into("<I", b, o + 4, want); changed += 1
    return changed, len(gd) - len(seen)


def edit(path, scene, pos, yaw, child, gd=None, face=None):
    b = bytearray(open(path, "rb").read())
    if b[:4] != b"\x04\x03\x02\x01": die(f"{path}: not a progress.sav")
    if gd:
        changed, missing = apply_gd(b, gd)
        print(f"warp-save: {path}: game data {changed} values changed, {missing} not in the save")
    idx = {}
    for o in range(0x28, len(b) - 8, 8):
        h = struct.unpack_from("<I", b, o)[0]
        idx.setdefault(h, o)
    def slot(h):
        if h not in idx: die(f"{path}: key {h:#x} missing")
        return idx[h] + 4
    o = struct.unpack_from("<I", b, slot(K_SCENE))[0]
    b[o:o + 64] = scene.encode().ljust(64, b"\0")
    for h in K_POS:
        o = struct.unpack_from("<I", b, slot(h))[0]
        struct.pack_into("<3f", b, o, *pos)
    for h in K_YAW:
        struct.pack_into("<f", b, slot(h), yaw if face is None else (360.0 - face) % 360.0 - 180.0)
    if face is not None:
        struct.pack_into("<f", b, slot(K_FACE), -math.radians(face))
    if child is not None:
        struct.pack_into("<I", b, slot(K_CHILD), int(child))
    tmp = path + ".warp"
    open(tmp, "wb").write(b); os.replace(tmp, path)


def main():
    if len(sys.argv) < 3: die(__doc__)
    prof = os.path.realpath(sys.argv[1])
    if subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "not-live"), prof]).returncode:
        die("never edits the live profile; pass a copy")
    spec = parse(sys.argv[2:])
    scenes = tomllib.load(open(os.path.join(HERE, "scenes.toml"), "rb"))["scene"]
    name = find_scene(scenes, spec["scene"], spec.get("age"))
    ents = scenes[name]["entrance"]
    e = spec.get("entrance", "0")
    ent = ents[int(e)] if e.isdigit() and int(e) < len(ents) else next((x for x in ents if x[0] == e), None)
    if ent is None and "pos" not in spec: die(f"{name}: no entrance {e!r}: {[x[0] for x in ents]}")
    pos = tuple(map(float, spec["pos"].split(","))) if "pos" in spec else tuple(ent[1:4])
    yaw = float(spec["yaw"]) if "yaw" in spec else (ent[4] if ent else 0.0)
    face = float(spec["face"]) if "face" in spec else None
    age = spec.get("age") or {"child": "child", "adult": "adult"}.get(scenes[name]["age"])
    child = None if age is None else age == "child"
    pat = f"slot_{int(spec['slot']):02d}" if "slot" in spec else "slot_*"
    files = sorted(glob.glob(os.path.join(prof, "save", "*", pat, "progress.sav")))
    if not files: die(f"no {pat}/progress.sav under {prof}/save")
    gd = read_gd(spec["gd"]) if "gd" in spec else None
    for f in files: edit(f, name, pos, yaw, child, gd, face)
    print(f"warp-save: {name} entrance {ent[0] if ent else '-'!r} pos {pos} yaw {yaw} age {age or 'kept'}, {len(files)} slot(s)")


main()
