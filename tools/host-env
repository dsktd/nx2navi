#!/usr/bin/env python3
"""host-env [run.log]: the host environment a measurement ran in, as `<hash> <one-line summary>`; the full key=value list is
kept in .lab/env/<hash>.txt (ARCHITECTURE.md 11). Keys: Mesa (from the run log's `vk caps` line when given, else the newest
lab run log), kernel, GPU firmware (vbios), GPU clock policy and levels, CPU governor, RADV/Mesa/ACO env vars. results-add
puts the hash in results.tsv column `env`; tools/nightly reports a change of hash as drift, apart from build regressions."""
import glob, hashlib, os, re, sys

R = os.path.expanduser('~/claude/nx2navi')


def rd(p):
    try:
        return open(p).read().strip()
    except OSError:
        return ''


def env(log=None):
    if not log:
        logs = sorted(glob.glob(R + '/.lab/*/run.log'), key=os.path.getmtime)
        log = logs[-1] if logs else None
    mesa = ''
    if log and os.path.exists(log):
        m = re.search(r'driver \w+ "([^"]+)"', open(log, errors='replace').read(200000))
        mesa = m[1] if m else ''
    k = {'mesa': mesa, 'kernel': os.uname().release}
    for d in sorted(glob.glob('/sys/class/drm/card[0-9]/device')):
        if rd(d + '/vendor') != '0x1002':
            continue
        k['vbios'] = rd(d + '/vbios_version')
        k['gpu_perf_level'] = rd(d + '/power_dpm_force_performance_level')
        k['gpu_sclk_levels'] = ','.join(re.sub(r'^\w+: |\*', '', x).strip() for x in rd(d + '/pp_dpm_sclk').split('\n') if x and not x.startswith('S:'))
        k['gpu_mclk_levels'] = ','.join(re.sub(r'^\w+: |\*', '', x).strip() for x in rd(d + '/pp_dpm_mclk').split('\n') if x and not x.startswith('S:'))
        k['gpu_power_cap'] = ''.join(rd(f) for f in glob.glob(d + '/hwmon/hwmon*/power1_cap'))
        break
    k['cpu_governor'] = rd('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor')
    for v in sorted(os.environ):
        if re.match(r'(RADV_|MESA_|ACO_|AMD_|VK_ICD|VK_DRIVER)', v):
            k['env ' + v] = os.environ[v]
    lines = ['%s=%s' % kv for kv in k.items()]
    h = hashlib.sha256('\n'.join(lines).encode()).hexdigest()[:8]
    os.makedirs(R + '/.lab/env', exist_ok=True)
    f = '%s/.lab/env/%s.txt' % (R, h)
    if not os.path.exists(f):
        open(f, 'w').write('\n'.join(lines) + '\n')
    return h, 'mesa %s, kernel %s, gpu %s' % (mesa or '?', k['kernel'], k.get('gpu_perf_level', '?'))


if __name__ == '__main__':
    h, s = env(sys.argv[1] if len(sys.argv) > 1 else None)
    print(h, s)
