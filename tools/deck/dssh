#!/bin/sh
# dssh <ssh args...>: ssh to the Deck as tally over the LAN (the dock's Ethernet, 10.0.2.180; DECK_HOST overrides).
# Host key: the Deck's, kept under steamdeckoled.local.
exec nix shell nixpkgs#openssh -c ssh -i $HOME/.config/gh/ssh/claude-steamdeck -o IdentitiesOnly=yes -o BatchMode=yes \
  -o ConnectTimeout=15 -o UserKnownHostsFile=$HOME/claude/steamdeck-known_hosts -o HostKeyAlias=steamdeckoled.local \
  tally@${DECK_HOST:-10.0.2.180} "$@"
