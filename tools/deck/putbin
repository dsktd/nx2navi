#!/bin/sh
# putbin <local file> <remote path>: copy a (large) file to the Deck as deck and check its sha256
P=$HOME/.config/gh/ssh/steamdeck-tally.pass
{ cat $P; cat "$1"; } | $(dirname "$0")/dssh "sudo -S -p '' -u deck sh -c 'cat > \"$2.tmp\" && sha256sum \"$2.tmp\" | cut -c1-64'" > /tmp/putbin.$$ 2>&1
a=$(sha256sum "$1" | cut -c1-64); b=$(tail -1 /tmp/putbin.$$); rm -f /tmp/putbin.$$
[ "$a" = "$b" ] || { echo "putbin: sha mismatch for $1 ($b)" >&2; exit 1; }
$(dirname "$0")/dk "chmod $(stat -c %a "$1") '$2.tmp' && mv '$2.tmp' '$2'" && echo "putbin: $2 ok"
