#!/bin/bash
# visual-cell <exe> <recipe> <A KEY=VAL> <B KEY=VAL> [FLAG=1]: one visual A/B from a tools/scenarios recipe: two short
# runs (FRAME, default 1800) of <exe>, one per side, their final shots stored as a visual pair (tools/visual-pair).
# FLAG=1 marks the pair flagged for Cal whatever its score. Never a blocker. Stops (exit 9) when Cal is back.
R=$HOME/claude/nx2navi; B=$R/NX2navi/build/v111; P=$R/.lab/parity
exe=$1 rc=$2 ka=$3 kb=$4
grep -q "^$exe	" $R/builds.tsv || { echo "no builds.tsv row for $exe"; exit 8; }
$R/tools/store-build verify $exe || [ $? = 2 ] || exit 8
. $R/tools/cell-lib.sh
SCENARIO_RECIPES=1 cell_scenario $rc
for side in A B; do
  kv=$ka; [ $side = B ] && kv=$kb
  log=$(ls -t $B/logs/play-*.log | head -1)
  [ $(( $(date +%s) - $(stat -c %Y $log) )) -lt 180 ] && { echo "CAL BACK"; exit 9; }
  name=vis-$exe-$rc-$side; l0=$(cell_wait); cache=$(cell_cache $P/scR $P/pcR.bin)
  (cd $R && LAB_EXE=nx2navi.$exe LAB_TIMEOUT=300 taskset -c 0-7,16-23 tools/lab-run --warp "$w" .lab/parity/load-west.txt ${FRAME:-1800} $name \
    NX2NAVI_ALIAS_EXTRA_MIB=512 NX2NAVI_GPU_WAIT=0 NX2NAVI_MARK_CHORD=off NX2NAVI_NVIDIA=0 NX2NAVI_MODS_DIR=$B/mods-text \
    NX2NAVI_REPLAY_ASYNC=1 NX2NAVI_TEX_DESC_STRICT=1 NX2NAVI_VK_RECORDER=1 NX2NAVI_SHADOW_NT=1 NX2NAVI_PIPE_SKIP=any \
    NX2NAVI_TRACE=perf,present NX2NAVI_RUN_NAME=$name NX2NAVI_SHADOW_BULK_WRITE=1 NX2NAVI_TEX_RELEASED_MB=3072 \
    NX2NAVI_XLATE=${XLATE:-$(cell_xlate $exe)} NX2NAVI_SHADER_CACHE=$P/scR NX2NAVI_PIPELINE_CACHE=$P/pcR.bin \
    ${rdbg:+"NX2NAVI_DBG_TEST=$rdbg"} $kv > $R/.lab/$name.out 2>&1)
  cell_note $name $cache "$rhash" $l0
done
out=$($R/tools/visual-pair $R/.lab/vis-$exe-$rc-A/final.png $R/.lab/vis-$exe-$rc-B/final.png $rc "$exe ${ka#NX2NAVI_}" "$exe ${kb#NX2NAVI_}" ab) || exit 1
echo "$out"
if [ "${FLAG:-0}" = 1 ]; then
  id=$(echo "$out" | sed -n 's/^visual pair \([0-9]*\):.*/\1/p')
  curl -s -XPOST -d "{\"id\":\"$id\",\"status\":\"flagged\",\"note\":\"flagged for Cal regardless of score\"}" 127.0.0.1:8434/review >/dev/null
fi
