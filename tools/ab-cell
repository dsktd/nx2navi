#!/bin/bash
# ab-cell <exe> <scene> <tag> <reps> <knob>  [KEY=VAL...]
# One A/B cell, repeated: warp straight into <scene> (lab-run --warp, no title walk beyond the save load), stand,
# and run <knob>=ab with NX2NAVI_AB=${AB_S:-5} s ABBA blocks in the same run; just ab per run, then mean/spread.
# Scenes: west grave mid (standing). FRAME (default 5400) ends the run; ab_summary skips SKIP (40) world seconds.
# Warm caches: the parity copies in .lab/parity (sc*/pc*.bin). Stops (exit 9) when a new play log appears.
R=$HOME/claude/nx2navi; P=$R/.lab/parity; B=$R/NX2navi/build/v111
exe=$1 sc=$2 tag=$3 reps=$4 knob=$5; shift 5
start=$(ls -t $B/logs/play-*.log | head -1)
i=0; tries=0
while [ $i -lt $reps ] && [ $tries -lt $((reps * 2)) ]; do
  i=$((i + 1)); tries=$((tries + 1))
  [ "$(ls -t $B/logs/play-*.log | head -1)" != "$start" ] && { echo "CAL BACK"; exit 9; }
  case $sc in
    west) w="scene=HyruleField_Adult entrance=HyruleField_FrontOfMarket yaw=180 age=adult"; rec=.lab/parity/load-west.txt;;
    grave) w='scene=Graveyard_Adult entrance=GraveYard_KakarikoSide age=adult'; rec=lab-profile-flicker/load-slot01.txt;;
    mid) w='scene=HyruleField_Adult entrance=HyruleField_FromLakeHylia age=adult'; rec=lab-profile-flicker/load-slot01.txt;;
  esac
  name=ab-$tag-$sc-$i
  (cd $R && LAB_EXE=nx2navi.$exe LAB_TIMEOUT=${LAB_TIMEOUT:-400} taskset -c 0-7,16-23 tools/lab-run --warp "$w" $rec ${FRAME:-5400} $name \
    NX2NAVI_ALIAS_EXTRA_MIB=512 NX2NAVI_GPU_WAIT=0 NX2NAVI_MARK_CHORD=off NX2NAVI_NVIDIA=0 NX2NAVI_MODS_DIR=$B/mods-text \
    NX2NAVI_REPLAY_ASYNC=1 NX2NAVI_TEX_DESC_STRICT=1 NX2NAVI_VK_RECORDER=1 NX2NAVI_SHADOW_NT=1 NX2NAVI_PIPE_SKIP=any \
    NX2NAVI_TRACE=perf,present NX2NAVI_RUN_NAME=$name NX2NAVI_SHADOW_BULK_WRITE=1 NX2NAVI_TEX_RELEASED_MB=3072 \
    NX2NAVI_XLATE=${XLATE:-$B/xlate-rebase/nx2navi_xlate} NX2NAVI_SHADER_CACHE=${SC:-$P/scR} NX2NAVI_PIPELINE_CACHE=${PC:-$P/pcR.bin} \
    NX2NAVI_AB=${AB_S:-5} $knob=ab "$@" > $R/.lab/$name.out 2>&1)
  # a boot that the SDK aborts (svc 0x26 Break before the title, seen 4 of 5 on 2026-11-12) is retried
  if grep -q "the SDK aborted" $R/.lab/$name/run.log; then echo "$name boot abort, retry" >&2; i=$((i - 1)); continue; fi
  # the perf windows up to the dump frame only: the dump's own window (~280 ms a frame) lands on one side and read as
  # a 13 ms B-A interval with a null knob (2026-11-12)
  awk -v f=${FRAME:-5400} 'match($0, /perf: frame [0-9]+:/) { n = substr($0, RSTART + 12, RLENGTH - 13) + 0; if (n >= f) next } { print }' \
    $R/.lab/$name/run.log > $R/.lab/$name/run-ab.log
  python3 -I $R/NX2navi/tools/ab_summary.py $R/.lab/$name/run-ab.log --skip ${SKIP:-40} | sed "s/^/$name /"
done | tee $R/.lab/ab-$tag-$sc.txt
python3 - $R/.lab/ab-$tag-$sc.txt <<'P'
import re, sys, statistics as st
d = [float(m[1]) for m in re.finditer(r'B - A: interval ([-+0-9.]+) ms', open(sys.argv[1]).read())]
r = [float(m[1]) for m in re.finditer(r'replay ([-+0-9.]+) ms \(', open(sys.argv[1]).read())]
if d: print(f"cell: {len(d)} runs, B-A interval mean {st.mean(d):+.2f} ms, spread {min(d):+.2f}..{max(d):+.2f}; replay B-A mean {st.mean(r):+.2f} ms, spread {min(r):+.2f}..{max(r):+.2f}")
P
