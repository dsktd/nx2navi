#!/usr/bin/env python3
"""burst-scan [--threshold T] [--sheet out.png] <burst dir>...: finds single-frame glitches in a mark's frames.

Reads the PNGs a mark writes with NX2NAVI_MARK_RING=<n> / NX2NAVI_MARK_BURST=<n> (logs/burst-<present>/<frame>.png,
also the older logs/mark-<N>/f<frame>.png), and for each frame: mean luminance, the fraction of near-black (< 8) and
near-white (> 247) pixels, and the mean luminance of a 4x4 grid of regions. A frame is suspicious when it differs from
both neighbours while the neighbours agree with each other (a blank, a flash, a missing object for one frame):
score = min(diff to previous, diff to next) - diff(previous, next), on the regions, in luminance steps 0-255; or when
its near-black / near-white fraction jumps by 0.25 against both neighbours. Prints one line per frame over the
threshold (default 10) and writes a contact sheet (default <dir>/scan.png): one row per suspect, previous / frame / next.
Standard library only; no GPU."""
import os
import re
import struct
import sys
import zlib

GRID = 4


def read_png(path):
    data = open(path, 'rb').read()
    if data[:8] != b'\x89PNG\r\n\x1a\n':
        raise ValueError(f'{path}: not a PNG')
    pos, idat, w = 8, [], 0
    while pos < len(data):
        n, kind = struct.unpack('>I4s', data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + n]
        if kind == b'IHDR':
            w, h, depth, ctype = struct.unpack('>IIBB', body[:10])
            if depth != 8 or ctype not in (2, 6):
                raise ValueError(f'{path}: only 8-bit RGB/RGBA')
            bpp = 4 if ctype == 6 else 3
        elif kind == b'IDAT':
            idat.append(body)
        pos += 12 + n
    raw, stride = zlib.decompress(b''.join(idat)), w * bpp
    out, prev = bytearray(), bytearray(stride)
    for y in range(h):
        f, row = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if f:   # filters 1-4 (the runtime writes 0; other tools may not)
            for i in range(stride):
                a = row[i - bpp] if i >= bpp else 0
                b, c = prev[i], prev[i - bpp] if i >= bpp else 0
                if f == 1: p = a
                elif f == 2: p = b
                elif f == 3: p = (a + b) // 2
                else:
                    pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                    p = a if pa <= pb and pa <= pc else b if pb <= pc else c
                row[i] = (row[i] + p) & 255
        out += row
        prev = row
    if bpp == 4:   # to RGB
        out = bytearray(b for i in range(0, len(out), 4) for b in out[i:i + 3])
    return w, h, bytes(out)


def write_png(path, w, h, rgb):
    raw = b''.join(b'\0' + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))

    def chunk(kind, body):
        return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body))
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) +
                chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))


def stats(w, h, rgb):
    lum = [(54 * rgb[i] + 183 * rgb[i + 1] + 19 * rgb[i + 2]) >> 8 for i in range(0, len(rgb), 3)]
    regions = []
    for gy in range(GRID):
        for gx in range(GRID):
            x0, x1, y0, y1 = gx * w // GRID, (gx + 1) * w // GRID, gy * h // GRID, (gy + 1) * h // GRID
            s = sum(sum(lum[y * w + x0:y * w + x1]) for y in range(y0, y1))
            regions.append(s / ((x1 - x0) * (y1 - y0)))
    n = len(lum)
    return {'luma': sum(lum) / n, 'black': sum(v < 8 for v in lum) / n, 'white': sum(v > 247 for v in lum) / n,
            'regions': regions}


def rdiff(a, b):
    return sum(abs(x - y) for x, y in zip(a['regions'], b['regions'])) / len(a['regions'])


def frames(d):
    out = []
    for name in os.listdir(d):
        m = re.fullmatch(r'f?(\d+)\.png', name)
        if m:
            out.append((int(m[1]), os.path.join(d, name)))
    return sorted(out)


def scan(d, threshold, sheet):
    fs = frames(d)
    if len(fs) < 3:
        print(f'{d}: {len(fs)} frames, need 3 or more')
        return []
    imgs = [read_png(p) for _, p in fs]
    st = [stats(*im) for im in imgs]
    suspects = []
    for i in range(1, len(fs) - 1):
        a, s, b = st[i - 1], st[i], st[i + 1]
        if fs[i + 1][0] - fs[i - 1][0] != 2:
            continue   # a missed frame between: no neighbour to compare with
        score = min(rdiff(a, s), rdiff(s, b)) - rdiff(a, b)
        jump = max(min(abs(s[k] - a[k]), abs(s[k] - b[k])) for k in ('black', 'white'))
        if score > threshold or jump > 0.25:
            suspects.append((i, score, jump))
            print(f'{d}: frame {fs[i][0]} score {score:.1f} luma {a["luma"]:.0f} > {s["luma"]:.0f} > {b["luma"]:.0f} '
                  f'black {s["black"]:.2f} white {s["white"]:.2f} (neighbours {fs[i - 1][0]}, {fs[i + 1][0]})')
    print(f'{d}: {len(fs)} frames {fs[0][0]}-{fs[-1][0]}, {len(suspects)} suspicious, '
          f'luma {min(x["luma"] for x in st):.0f}-{max(x["luma"] for x in st):.0f}')
    if suspects:
        rows = sorted(suspects, key=lambda x: -max(x[1], x[2] * 100))[:16]
        rows.sort()
        w, h = imgs[0][0], imgs[0][1]
        gap = 4
        sw, sh = 3 * w + 2 * gap, len(rows) * (h + gap) - gap
        out = bytearray(b'\x20' * (sw * sh * 3))
        for r, (i, _, _) in enumerate(rows):
            for c, j in enumerate((i - 1, i, i + 1)):
                iw, ih, px = imgs[j]
                if (iw, ih) != (w, h):
                    continue
                for y in range(h):
                    o = ((r * (h + gap) + y) * sw + c * (w + gap)) * 3
                    out[o:o + w * 3] = px[y * w * 3:(y + 1) * w * 3]
        path = sheet or os.path.join(d, 'scan.png')
        write_png(path, sw, sh, bytes(out))
        print(f'{d}: contact sheet {path} (rows: {", ".join(str(fs[i][0]) for i, _, _ in rows)}; previous, frame, next)')
    return suspects


def main(argv):
    threshold, sheet, dirs = 10.0, None, []
    it = iter(argv)
    for a in it:
        if a == '--threshold':
            threshold = float(next(it))
        elif a == '--sheet':
            sheet = next(it)
        elif a in ('-h', '--help'):
            print(__doc__)
            return 0
        else:
            dirs.append(a)
    if not dirs:
        print(__doc__)
        return 2
    found = 0
    for d in dirs:
        found += len(scan(d, threshold, sheet if len(dirs) == 1 else None))
    return 0 if found == 0 else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
