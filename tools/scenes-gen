#!/usr/bin/env bash
# scenes-gen: writes tools/scenes.toml (scene names, groups, ages, entrances with position and yaw) from the game's
# own RomFS: Banc/<group>/<scene>_{Static,Dynamic}.bcett.byml.zs (scene list) and Banc/BancBasedResource/StartPos.byml.zs
# (entrance table: scene -> start-position name -> Trans, Rot radians). Game data stays private: this repo is private.
exec "$HOME/claude/nx2navi/NX2navi/.venv-py314/bin/python" - "$@" <<'PY'
import math, re, sys
sys.path.insert(0, f"{__import__('os').environ['HOME']}/claude/nx2navi/tools")
import byml, msgmod
read = msgmod.romfs_reader(msgmod.TREE); dicts = msgmod.dictionaries(read)
import json
index = json.loads((msgmod.TREE / "build/extracted/v111/romfs/index.json").read_text())
groups = {}
for f in index["files"]:
    m = re.match(r"Banc/([^/]+)/(.+?)_(Static|Dynamic)\.bcett\.byml\.zs$", f["path"])
    if m and m.group(1) != "BancBasedResource": groups.setdefault(m.group(2), m.group(1))
start = byml.load(msgmod.unpack_zs(read("Banc/BancBasedResource/StartPos.byml.zs"), dicts)[0])
def yaw(rot):
    # Rot is XYZ euler radians; (pi, y, pi) is the same heading as (0, pi - y, 0)
    x, y, _ = rot
    d = math.degrees(math.pi - y) if abs(x) > 1.5 else math.degrees(y)
    return round((d + 180) % 360 - 180, 2)
out = ["# Generated by tools/scenes-gen from the game's RomFS (private data). Do not edit by hand.",
       "# [scene.<Name>]: group (Banc folder), age (child|adult|any), entrance = [[name, x, y, z, yaw_deg], ...]",
       "# in StartPos order; warp.req / tools/warp-save take entrance=<index|name>. Shared with the reference library.", ""]
for name in sorted(groups):
    age = "child" if name.endswith("_Child") else "adult" if "_Adult" in name else "any"
    out += [f"[scene.{name}]", f'group = "{groups[name]}"', f'age = "{age}"', "entrance = ["]
    for en, v in (start.get(name) or {}).items():
        x, y, z = (round(c, 3) for c in v["Trans"])
        out.append(f'  ["{en}", {x}, {y}, {z}, {yaw(v["Rot"])}],')
    out += ["]", ""]
p = msgmod.TREE.parent / "tools/scenes.toml"; p.write_text("\n".join(out)); print(p, len(groups), "scenes")
PY
