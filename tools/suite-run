#!/bin/bash
# suite-run <exe> <tag> <reps>: the scripted running replay (.lab/parity/load-run.txt from the field-west warp), <reps> runs
# of 5400 frames, then results-add windows `field-running` (>25 ms frames per minute, fps, 1% low). Same env as ab-cell.
R=$HOME/claude/nx2navi; P=$R/.lab/parity; B=$R/NX2navi/build/v111
exe=$1 tag=$2 reps=$3
w="scene=HyruleField_Adult entrance=HyruleField_FrontOfMarket yaw=180 age=adult"
logs=
for i in $(seq $reps); do
  name=$tag-$i
  while [ "$(awk '{print ($1 < 6)}' /proc/loadavg)" != 1 ]; do sleep 20; done
  (cd $R && LAB_EXE=nx2navi.$exe LAB_TIMEOUT=400 taskset -c 0-7,16-23 tools/lab-run --warp "$w" .lab/parity/load-run.txt 5400 $name \
    NX2NAVI_ALIAS_EXTRA_MIB=512 NX2NAVI_GPU_WAIT=0 NX2NAVI_MARK_CHORD=off NX2NAVI_NVIDIA=0 NX2NAVI_MODS_DIR=$B/mods-text \
    NX2NAVI_REPLAY_ASYNC=1 NX2NAVI_TEX_DESC_STRICT=1 NX2NAVI_VK_RECORDER=1 NX2NAVI_SHADOW_NT=1 NX2NAVI_PIPE_SKIP=any \
    NX2NAVI_TRACE=perf,present NX2NAVI_RUN_NAME=$name NX2NAVI_SHADOW_BULK_WRITE=1 NX2NAVI_TEX_RELEASED_MB=3072 \
    NX2NAVI_XLATE=${XLATE:-$B/xlate-rebase/nx2navi_xlate} NX2NAVI_SHADER_CACHE=${SC:-$P/scR} NX2NAVI_PIPELINE_CACHE=${PC:-$P/pcR.bin} \
    > $R/.lab/$name.out 2>&1)
  logs="$logs $R/.lab/$name/run.log"
  ls -t $B/logs/play-*.log | head -1 | xargs stat -c %Y | awk -v n=$(date +%s) '{ exit (n - $1 < 120) ? 1 : 0 }' || { echo CAL BACK; exit 9; }
done
$R/tools/results-add windows field-running $logs
