#!/bin/bash
# load-cell <exe> <tag> <reps> [KEY=VAL...]
# Area-load cell (scene entry freezes): ONE session that loads the save in front of the Market (lab-run --warp) and then
# teleports with upstream's live warp (NX2NAVI_DBG_TEST) Graveyard -> Hyrule Field west -> Graveyard ..., <reps> times
# each, standing still in between. Every teleport is a full area load (fade, load screen, the area's textures), so
# <reps> repeats per area cost about GAP/60 s each instead of a boot. tools/load-stat prints the loads of the run.
# Not for builds before the rebase (play13 has no NX2NAVI_DBG_TEST): those take cold loads, one per boot
# (COLD=west|grave: no teleports, the save's own load only; also the like-for-like baseline for the rebase builds).
# GAP (default 900) = pad ticks between teleports; FIRST (default 600) = tick of the first one. Stops (exit 9) when a
# new play log appears. Caches: the parity copies in .lab/parity. Sibling of tools/ab-cell (steady A/B).
R=$HOME/claude/nx2navi; P=$R/.lab/parity; B=$R/NX2navi/build/v111
exe=$1 tag=$2 reps=$3; shift 3
log=$(ls -t $B/logs/play-*.log | head -1)
[ $(( $(date +%s) - $(stat -c %Y $log) )) -lt 180 ] && { echo "CAL BACK"; exit 9; }
gap=${GAP:-900} first=${FIRST:-600}
west="scene=HyruleField_Adult entrance=HyruleField_FrontOfMarket yaw=180 age=adult"
grave='scene=Graveyard_Adult entrance=GraveYard_KakarikoSide age=adult'
name=lc-$tag; w=$west; rec=.lab/parity/load-west.txt; script=""; frame=1500
case ${COLD:-} in
  west) name=lc-$tag-west-$reps;;                       # reps is the run's number here
  grave) name=lc-$tag-grave-$reps; w=$grave; rec=lab-profile-flicker/load-slot01.txt;;
  *) t=$first
     for ((i = 0; i < reps; i++)); do
       script+="$t:warp Graveyard_Adult GraveYard_KakarikoSide;"; t=$((t + gap))
       script+="$t:warp HyruleField_Adult HyruleField_FrontOfMarket;"; t=$((t + gap))
     done
     frame=$((1100 + t));;
esac
if [ $exe = play13 ]; then
  c=(NX2NAVI_XLATE=$B/xlate-i2f/nx2navi_xlate NX2NAVI_SHADER_CACHE=$P/sc13 NX2NAVI_PIPELINE_CACHE=$P/pc13.bin
     NX2NAVI_AO_ORDER=1 NX2NAVI_TEX_LIVE_IDLE=900 NX2NAVI_TEX_RELEASED_LRU=1 NX2NAVI_TEX_RELEASED_MIB=1536
     NX2NAVI_TEX_RELEASED_YIELD=85 NX2NAVI_TEX_RT_RECYCLE=1 NX2NAVI_TEX_RT_TRIM=85 NX2NAVI_TEX_RT_TRIM_PER_MIN=0
     NX2NAVI_TEX_STALE_LIVE=1)
else
  c=(NX2NAVI_STALL_MS=100 NX2NAVI_SHADOW_BULK_WRITE=1 NX2NAVI_TEX_RELEASED_MB=3072
     NX2NAVI_XLATE=${XLATE:-$B/xlate-rebase/nx2navi_xlate} NX2NAVI_SHADER_CACHE=${SC:-$P/scR} NX2NAVI_PIPELINE_CACHE=${PC:-$P/pcR.bin})
  [ -n "$script" ] && c+=("NX2NAVI_DBG_TEST=$script")
fi
for try in 1 2 3; do
  l0=$(cut -d" " -f1 /proc/loadavg)
  [ "$(ls -t $B/logs/play-*.log | head -1)" != "$log" ] && { echo "CAL BACK"; exit 9; }
  (cd $R && LAB_EXE=nx2navi.$exe LAB_TIMEOUT=${LAB_TIMEOUT:-$((frame / 25 + 120))} taskset -c 0-7,16-23 tools/lab-run --warp "$w" $rec $frame $name \
    NX2NAVI_ALIAS_EXTRA_MIB=512 NX2NAVI_GPU_WAIT=0 NX2NAVI_MARK_CHORD=off NX2NAVI_NVIDIA=0 NX2NAVI_MODS_DIR=$B/mods-text \
    NX2NAVI_REPLAY_ASYNC=1 NX2NAVI_TEX_DESC_STRICT=1 NX2NAVI_VK_RECORDER=1 NX2NAVI_SHADOW_NT=1 NX2NAVI_PIPE_SKIP=any \
    NX2NAVI_TRACE=perf,present NX2NAVI_RUN_NAME=$name "${c[@]}" "$@" > $R/.lab/$name.out 2>&1)
  # other load on the machine during the run (a build beside it made 30-40 ms frames and 4x the lost time, 2026-11-12)
  echo "loadavg $l0 -> $(cut -d" " -f1 /proc/loadavg) (1 min, before -> after; the run itself is about 3-5)" >> $R/.lab/$name.out
  # a boot that the SDK aborts before the title (seen 2026-11-12) is retried
  grep -q "the SDK aborted" $R/.lab/$name/run.log || break
  echo "$name boot abort, retry" >&2
done
$R/tools/load-stat $R/.lab/$name/run.log
grep loadavg $R/.lab/$name.out | tail -1 | sed "s/^/   /"
